   "assertsize:id=fst.shop.filter.new|40x40",
   "assertsize:id=fst.shop.filter.available|40x40",
   "assertsize:id=fst.shop.filter.leaving|40x40",
   "assertsize:id=fst.shop.filter.reset|0x40",
   "assertat:id=fst.shop.filter.new|0,-18.5",
   "assertat:id=fst.shop.filter.new|0,18.5",
   "assertat:id=fst.shop.filter.new|-18.5,0",
   "assertat:id=fst.shop.filter.new|18.5,0",
   "assertat:id=fst.shop.filter.reset|0,-18.5",
   "assertat:id=fst.shop.filter.reset|0,18.5",
   "assertapart:id=fst.shop.filter.new|id=fst.shop.filter.available",
   "assertapart:id=fst.shop.filter.available|id=fst.shop.filter.leaving",
   "assertapart:id=fst.shop.filter.leaving|id=fst.shop.filter.reset",
   "narrate:id=FilterFlyout",
   "shot:{stem}.png"
  ],
  "teardown": [
   "collapse:id=fst.shop.filter",
   "waitgone:id=fst.shop.filter.reset@5"
  ],
  "skip_modes": [
   "text-200",
   "text-225"
  ]
 },
