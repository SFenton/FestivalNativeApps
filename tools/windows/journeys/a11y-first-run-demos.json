[
  {
    "name": "frd-songs-placeholder",
    "tab": "songs",
    "first_run": "force",
    "fixture": [
      "--songs-unavailable"
    ],
    "scan": true,
    "tabs": 8,
    "ready": [
      "waitfor:id=fst.first-run.dialog@20",
      "assertstatus:id=fst.first-run.demo.songs-song-list|~^placeholder( |$)@20"
    ],
    "after_ready": [
      "wait:1",
      "waitgone:id=fst.first-run.demo.songs-song-list@1",
      "assertread:name=Song List&class=FlipViewItem|Song List, list item, selected",
      "assertapart:raw=fst.first-run.demo.songs-song-list|name=Song List&class=TextBlock",
      "focus:name=Song List&class=FlipViewItem",
      "key:tab",
      "assertfocus:name=Page 1&class=Button@3",
      "assertorder:name=Page 1&class=Button|id=PrimaryButton",
      "scrollinto:id=fst.first-run.pips",
      "assertorder:name=Song List&class=FlipViewItem|id=fst.first-run.pips|id=PrimaryButton|id=SecondaryButton|id=fst.first-run.close"
    ],
    "teardown": [
      "focus:name=Song List&class=FlipViewItem",
      "assertfocus:name=Song List&class=FlipViewItem@3",
      "key:enter",
      "assertstatus:id=fst.first-run.demo.songs-sort|~^placeholder( |$)@5",
      "waitgone:id=fst.first-run.demo.songs-sort@1",
      "assertread:name=Sort Songs&class=FlipViewItem|Sort Songs, list item, selected@5",
      "assertstate:id=SecondaryButton|enabled=true",
      "key:esc",
      "waitgone:id=fst.first-run.dialog@5"
    ]
  },
  {
    "name": "frd-songs-catalogue",
    "tab": "songs",
    "first_run": "force",
    "scan": true,
    "tabs": 8,
    "ready": [
      "waitfor:id=fst.first-run.dialog@20",
      "assertstatus:id=fst.first-run.demo.songs-song-list|~^catalogue( |$)@30"
    ],
    "after_ready": [
      "wait:1",
      "waitgone:id=fst.first-run.demo.songs-song-list@1",
      "assertread:name=Song List&class=FlipViewItem|Song List, list item, selected",
      "assertapart:raw=fst.first-run.demo.songs-song-list|name=Song List&class=TextBlock",
      "scrollinto:id=fst.first-run.pips",
      "assertorder:name=Song List&class=FlipViewItem|id=fst.first-run.pips|id=PrimaryButton|id=SecondaryButton|id=fst.first-run.close"
    ]
  },
