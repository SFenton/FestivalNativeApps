                   "assertstate:id=fst.settings.path-default-view.image|selected=true@5",
                   "assertstate:id=fst.settings.path-default-view.text|selected=false",
                   "assertbelow:id=fst.settings.path-default-view|id=fst.settings.enable-visual-order",
                   "shot:{stem}-image.png", "scan:{stem}-axe/image"]},
  {"name": "settings-path-view-text", "tab": "settings", "tabs": 0,
   "settings": {"pathDefaultView": "Text"},
   "ready": ["waitfor:id=fst.settings.show-instrument-icons@30"],
   "after_ready": ["scrollinto:id=fst.settings.feedback.feature@20", "scrollto:id=fst.settings,0", "scrollinto:id=fst.settings.path-default-view", "wait:0.5",
                   "assertstate:id=fst.settings.path-default-view.text|selected=true@5",
                   "assertstate:id=fst.settings.path-default-view.image|selected=false",
                   "shot:{stem}-text.png", "scan:{stem}-axe/text"]},
  {"name": "kb-settings-path-view", "tab": "settings", "tabs": 0,
