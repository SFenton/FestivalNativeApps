   "after_ready": ["scrollinto:id=fst.settings.feedback.feature@20", "scrollto:id=fst.settings,0", "scrollinto:id=fst.settings.path-default-view", "focus:id=fst.settings.enable-visual-order",
                   "key:tab", "assertfocus:id=fst.settings.path-default-view.image@3",
                   "key:down", "assertfocus:id=fst.settings.path-default-view.text@3",
                   "assertstate:id=fst.settings.path-default-view.text|selected=true@3",
                   "assertstate:id=fst.settings.path-default-view.image|selected=false",
                   "wait:0.5", "shot:{stem}-focus-text.png",
                   "key:tab", "key:shift+tab", "assertfocus:id=fst.settings.path-default-view.text@3",
                   "key:up", "assertfocus:id=fst.settings.path-default-view.image@3",
                   "assertstate:id=fst.settings.path-default-view.image|selected=true@3",
                   "key:shift+tab", "assertfocus:id=fst.settings.enable-visual-order@3",
                   "scrollinset:id=fst.settings.path-default-view|id=fst.settings|8"]}
