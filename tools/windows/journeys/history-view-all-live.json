[
  {
    "name": "history-view-all-live",
    "route": "/songs/fefd057e-ebe2-4909-ba35-1752d86b6b17",
    "profile": "195e93ef108143b2975ee46662d4d0e1:SFentonX",
    "sizes": [
      "compact",
      "medium",
      "wide",
      "maximized",
      "snap-left",
      "snap-right"
    ],
    "ready": [
      "waitfor:id=fst.history.chart@30",
      "scrollinto:id=fst.history.view-all@10"
    ],
    "after_ready": [
      "assertname:id=fst.history.view-all|View All Scores, Lead",
      "shot:{stem}-0-view-all.png",
      "tree:{stem}-view-all.txt",
      "focus:id=fst.history.view-all",
      "key:shift+tab",
      "key:tab",
      "assertfocus:id=fst.history.view-all",
      "shot:{stem}-0k-focus.png",
      "key:enter",
      "waitfor:id=fst.history.sort.open@15",
      "waitfor:id=fst.history.list@5",
      "waitgone:id=fst.history.view-all@5",
      "assertname:id=fst.history.sort.open|Sort by Score, descending",
      "shot:{stem}-1-history-page.png",
      "tree:{stem}-history.txt",
      "invoke:id=fst.history.sort.open",
      "waitfor:id=fst.history.sort.mode.date@5",
      "toggle:id=fst.history.sort.mode.date",
      "wait:0.8",
      "assertname:id=fst.history.sort.open|Sort by Date, descending",
      "shot:{stem}-2-sorted-date.png",
      "key:alt+left",
      "waitfor:id=fst.song-detail@15",
      "waitfor:id=fst.history.chart@30",
      "scrollinto:id=fst.history.view-all@10",
      "shot:{stem}-3-back.png"
    ],
    "tabs": 0
  }
]
