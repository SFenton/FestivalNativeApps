[
  {
    "name": "modal-contrast-first-run-desert",
    "tab": "songs",
    "first_run": "force",
    "modes": ["hc-desert"],
    "tabs": 6,
    "ready": [
      "wait:15",
      "waitfor:id=fst.first-run.dialog@20",
      "assertname:id=PrimaryButton|Next",
      "assertname:id=fst.first-run.close|Close"
    ],
    "after_ready": [
      "waitfor:name=Songs@5",
      "waitfor:id=fst.first-run.slides@5",
      "assertread:id=PrimaryButton|Next, button",
      "assertread:id=SecondaryButton|Back, button, unavailable",
      "assertread:id=fst.first-run.close|Close, button",
      "assertpaint:id=PrimaryButton|fill:L6,M0|C-12,M-5,C12,M5=@fill~16",
      "scrollto:id=fst.first-run.body,100",
      "wait:1",
      "assertpaint:id=fst.first-run.pips|L6,M-8=#903909~24|L6,M0=#FFFAEF~40|L18,M0=#202020~40",
      "focus:id=PrimaryButton",
      "key:tab",
      "assertfocus:id=fst.first-run.close@3"
    ],
    "teardown": [
      "key:esc",
      "waitgone:id=fst.first-run.dialog@5"
    ]
  },
