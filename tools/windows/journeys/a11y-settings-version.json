                   "assertbelow:id=fst.settings.service-version|id=fst.settings.app-version",
                   "assertbelow:id=fst.settings.whats-new|id=fst.settings.service-version",
                   "scan:{stem}-axe/version"]},
  {"name": "kb-settings-version", "tab": "settings", "tabs": 0,
   "ready": ["waitfor:id=fst.settings.show-instrument-icons@30"],
   "after_ready": ["reveal:id=fst.settings.save-data", "waitfor:id=fst.settings.save-data@5", "focus:id=fst.settings.save-data",
                   "key:tab", "assertfocus:id=fst.settings.whats-new@3", "wait:0.5", "shot:{stem}-focus.png",
