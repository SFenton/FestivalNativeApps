      "assertsize:id=fst.song-leaderboard.row.fixture-player-2|40x40",
      "assertorder:id=fst.song-leaderboard.row.fixture-player-1|id=fst.song-leaderboard.row.fixture-player-2",
      "focus:id=fst.song-leaderboard.row.fixture-player-1",
      "key:down",
      "assertfocus:id=fst.song-leaderboard.row.fixture-player-2@3",
      "assertapart:raw=fst.score.season.fixture-player-2|raw=fst.score.accuracy.fixture-player-2"
    ]
  },
