[
  {
    "name": "metadata-season-detail",
    "route": "/songs/fixture-pulse",
    "profile": "fixture-player-1:Fixture Player 1",
    "sizes": ["compact"],
    "tabs": 0,
    "scan": true,
    "axe_allow": ["framework-popup"],
    "ready": [
      "scrollinto:id=fst.history.bar.1@40",
      "scrollinset:id=fst.history.bar.1|id=fst.song-detail|72",
      "toggle:id=fst.history.bar.1",
      "scrollinto:id=fst.history.detail@10",
      "waitfor:raw=fst.score.season.history.20240105000000.detail@5"
    ],
    "after_ready": [
      "assertstate:id=fst.history.detail|type=text",
      "assertstate:id=fst.history.detail|invoke=false",
      "assertsize:raw=fst.score.season.history.20240105000000.detail|48x24",
      "assertname:raw=fst.score.season.history.20240105000000.detail|S40",
      "assertread:id=fst.history.detail|~^.+, score 850,000, accuracy 99\\.1%, full combo, season 40, text$",
      "assertapart:raw=fst.score.season.history.20240105000000.detail|raw=fst.score.accuracy.history.20240105000000.detail",
      "assertorder:id=fst.history.bar.1|id=fst.history.detail",
      "assertsize:id=fst.history.bar.1|40x40",
      "assertstate:id=fst.history.detail|focusable=false"
    ]
  },
  {
    "name": "metadata-current-season",
    "route": "/songs/fixture-pulse/Solo_Guitar",
    "profile": "fixture-player-1:Fixture Player 1",
    "sizes": ["medium"],
    "tabs": 0,
    "scan": true,
