      "waitfor:id=fst.licenses.summary@20",
      "waitfor:id=fst.licenses.row.microsoft.netcore.app.runtime.win-x64@10"
    ]
  },
  {
    "name": "licenses-keyboard",
    "route": "/settings/licenses",
    "tabs": 0,
