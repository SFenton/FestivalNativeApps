      "waitfor:name=CommunityToolkit.Mvvm · MIT@5",
      "assertfocus:id=fst.licenses.detail.text@3",
      "key:tab",
      "assertfocus:name=Project page for CommunityToolkit.Mvvm@3",
      "key:tab",
      "assertfocus:id=fst.licenses.detail.close@3",
      "key:esc",
      "waitgone:id=fst.licenses.detail@5",
      "assertfocus:id=fst.licenses.row.communitytoolkit.mvvm@3",
      "key:enter",
      "waitfor:id=fst.licenses.detail@5",
      "invoke:id=fst.licenses.detail.close",
      "waitgone:id=fst.licenses.detail@5",
      "assertfocus:id=fst.licenses.row.communitytoolkit.mvvm@3"
    ]
  },
  {
    "name": "licenses-detail",
    "route": "/settings/licenses",
    "tabs": 4,
