[
  {
    "name": "launch-order-carousel-then-whats-new",
    "route": "/songs",
    "preset": "medium",
    "extra": {"FST_DEBUG_FIRST_RUN": "force", "FST_DEBUG_WHATS_NEW": "force"},
    "steps": [
      "waitfor:id=fst.first-run.dialog@20",
      "wait:1.5",
      "waitgone:id=fst.whats-new.dialog@1",
      "shot:{shots}/first-run.png",
      "key:esc",
      "waitfor:id=fst.whats-new.dialog@10",
      "waitfor:id=fst.whats-new.list",
      "waitfor:id=fst.whats-new.section.0",
      "assertfocus:id=fst.whats-new.list@3",
      "shot:{shots}/whats-new.png",
      "key:esc",
      "waitgone:id=fst.whats-new.dialog@5",
      "wait:1",
      "expand:id=fst.songs.sort",
      "waitfor:id=fst.songs.sort.reset@5",
      "key:esc"
    ]
  },
  {
    "name": "presented-dismiss-records",
    "route": "/songs",
    "preset": "medium",
    "extra": {"FST_DEBUG_WHATS_NEW": "fresh", "FST_DEBUG_DATA_DIR": "{shots}/whats-new-data"},
    "steps": [
      "waitfor:id=fst.whats-new.dialog@20",
      "waitfor:id=fst.whats-new.section.0",
      "assertstate:id=fst.whats-new.dismiss|name=Dismiss@3",
      "assertfocus:id=fst.whats-new.list@3",
      "key:tab",
      "assertfocus:id=fst.whats-new.dismiss@3",
      "key:enter",
      "waitgone:id=fst.whats-new.dialog@5",
      "waitfor:id=fst.songs.sort@10"
    ]
  },
  {
    "name": "dismissed-relaunch-hidden-seen",
    "route": "/songs",
    "preset": "medium",
    "extra": {"FST_DEBUG_WHATS_NEW": "on", "FST_DEBUG_DATA_DIR": "{shots}/whats-new-data"},
    "steps": [
      "waitfor:id=fst.songs.sort@20",
      "wait:3",
      "waitgone:id=fst.whats-new.dialog@1",
      "expand:id=fst.songs.sort",
      "waitfor:id=fst.songs.sort.reset@5",
      "key:esc"
    ]
  },
  {
    "name": "presented-resize-across-breakpoints",
    "route": "/songs",
    "preset": "compact",
    "extra": {"FST_DEBUG_WHATS_NEW": "force"},
    "steps": [
      "waitfor:id=fst.whats-new.dialog@20",
      "waitfor:id=fst.whats-new.dismiss@5",
      "resize:wide",
      "wait:1",
      "waitfor:id=fst.whats-new.section.0@5",
      "waitfor:id=fst.whats-new.dismiss@5",
      "resize:medium",
      "wait:1",
      "waitfor:id=fst.whats-new.dismiss@5",
      "resize:compact",
      "wait:1",
      "waitfor:id=fst.whats-new.section.0@5",
      "waitfor:id=fst.whats-new.dismiss@5",
      "shot:{shots}/whats-new-compact-after-resize.png",
      "key:esc",
      "waitgone:id=fst.whats-new.dialog@5"
    ]
  },
  {
    "name": "replay-from-settings-keyboard",
    "route": "/settings",
    "preset": "medium",
    "steps": [
      "waitfor:id=fst.settings.show-instrument-icons@20",
      "wait:2",
      "waitgone:id=fst.whats-new.dialog@1",
      "scrollinto:id=fst.settings.whats-new",
      "waitfor:id=fst.settings.whats-new@5",
      "focus:id=fst.settings.whats-new",
      "key:enter",
      "waitfor:id=fst.whats-new.dialog@10",
      "waitfor:id=fst.whats-new.section.0",
      "assertfocus:id=fst.whats-new.list@3",
      "shot:{shots}/whats-new-replay.png",
      "key:esc",
      "waitgone:id=fst.whats-new.dialog@5",
      "assertfocus:id=fst.settings.whats-new@3"
    ]
  },
  {
    "name": "tester-grouped-headings",
    "route": "/songs",
    "preset": "medium",
    "extra": {"FST_DEBUG_WHATS_NEW": "force", "FST_DEBUG_DISTRIBUTION": "tester",
              "FST_DEBUG_WHATS_NEW_FILE": "{repo}\\tools\\windows\\fixtures\\whats-new-grouped.json"},
    "steps": [
      "waitfor:id=fst.whats-new.dialog@20",
      "assertname:id=fst.whats-new.section.0|Changes Since Release 2610.08.01",
      "waitgone:name=Version 2610.09.01@1",
      "assertname:id=fst.whats-new.group.0.0|Songs",
      "waitfor:name=Fixture tester note one is new in this build.@3",
      "waitfor:name=Fixture tester note two shares the Songs heading.@3",
      "assertname:id=fst.whats-new.group.0.1|Song Details",
      "assertbelow:id=fst.whats-new.group.0.1|id=fst.whats-new.group.0.0",
      "assertname:id=fst.whats-new.group.0.2|Rivals",
      "assertbelow:id=fst.whats-new.group.0.2|id=fst.whats-new.group.0.1",
      "shot:{shots}/whats-new-tester-grouped.png",
      "reveal:id=fst.whats-new.group.0.5",
      "assertname:id=fst.whats-new.group.0.3|Navigation",
      "assertname:id=fst.whats-new.group.0.4|General",
      "assertname:id=fst.whats-new.group.0.5|Other",
      "assertbelow:id=fst.whats-new.group.0.4|id=fst.whats-new.group.0.3",
      "assertbelow:id=fst.whats-new.group.0.5|id=fst.whats-new.group.0.4",
      "waitfor:name=Fixture tester note seven has no category and comes last.@3",
      "reveal:id=fst.whats-new.section.2",
      "assertname:id=fst.whats-new.section.1|Version 2610.08.01",
      "assertname:id=fst.whats-new.group.1.0|Leaderboards",
      "assertname:id=fst.whats-new.group.1.1|Other",
      "assertname:id=fst.whats-new.section.2|Version 2610.07.01",
      "waitgone:id=fst.whats-new.group.2.0@1",
      "reveal:name=Fixture note from a document without groups.",
      "waitfor:name=Fixture note from a document without groups.@3",
      "shot:{shots}/whats-new-tester-grouped-end.png",
      "key:esc",
      "waitgone:id=fst.whats-new.dialog@5"
    ]
  },
  {
    "name": "store-grouped-headings",
    "route": "/songs",
    "preset": "medium",
    "extra": {"FST_DEBUG_WHATS_NEW": "force", "FST_DEBUG_DISTRIBUTION": "store",
              "FST_DEBUG_WHATS_NEW_FILE": "{repo}\\tools\\windows\\fixtures\\whats-new-grouped.json"},
    "steps": [
      "waitfor:id=fst.whats-new.dialog@20",
      "assertname:id=fst.whats-new.section.0|Version 2610.09.01",
      "waitgone:name=Changes Since Release 2610.08.01@1",
      "waitgone:name=Fixture tester note one is new in this build.@1",
      "assertname:id=fst.whats-new.group.0.0|Songs",
      "assertname:id=fst.whats-new.group.0.1|Item Shop",
      "assertname:id=fst.whats-new.group.0.2|Settings",
      "assertname:id=fst.whats-new.group.0.3|Other",
      "assertbelow:id=fst.whats-new.group.0.1|id=fst.whats-new.group.0.0",
      "assertbelow:id=fst.whats-new.group.0.2|id=fst.whats-new.group.0.1",
      "assertbelow:id=fst.whats-new.group.0.3|id=fst.whats-new.group.0.2",
      "waitfor:name=Fixture release note without a category comes last.@3",
      "shot:{shots}/whats-new-store-grouped.png",
      "reveal:id=fst.whats-new.section.2",
      "assertname:id=fst.whats-new.section.1|Version 2610.08.01",
      "assertname:id=fst.whats-new.section.2|Version 2610.07.01",
      "waitgone:id=fst.whats-new.group.2.0@1",
      "key:esc",
      "waitgone:id=fst.whats-new.dialog@5"
    ]
  },
  {
    "name": "replay-tester-grouped",
    "route": "/settings",
    "preset": "compact",
    "extra": {"FST_DEBUG_DISTRIBUTION": "tester",
              "FST_DEBUG_WHATS_NEW_FILE": "{repo}\\tools\\windows\\fixtures\\whats-new-grouped.json"},
    "steps": [
      "waitfor:id=fst.settings.show-instrument-icons@20",
      "wait:2",
      "waitgone:id=fst.whats-new.dialog@1",
      "scrollinto:id=fst.settings.whats-new",
      "waitfor:id=fst.settings.whats-new@5",
      "invoke:id=fst.settings.whats-new",
      "waitfor:id=fst.whats-new.dialog@10",
      "assertname:id=fst.whats-new.section.0|Changes Since Release 2610.08.01",
      "assertname:id=fst.whats-new.group.0.0|Songs",
      "assertfocus:id=fst.whats-new.list@3",
      "shot:{shots}/whats-new-tester-replay-compact.png",
      "key:esc",
      "waitgone:id=fst.whats-new.dialog@5"
    ]
  },
  {
    "name": "invalid-document-never-presents",
    "route": "/songs",
    "preset": "medium",
    "extra": {"FST_DEBUG_WHATS_NEW": "force", "FST_DEBUG_DISTRIBUTION": "tester",
              "FST_DEBUG_WHATS_NEW_FILE": "{repo}\\tools\\windows\\fixtures\\missing-whats-new.json"},
    "steps": [
      "waitfor:id=fst.songs.sort@20",
      "wait:3",
      "waitgone:id=fst.whats-new.dialog@1",
      "expand:id=fst.songs.sort",
      "waitfor:id=fst.songs.sort.reset@5",
      "key:esc"
    ]
  },
  {
    "name": "invalid-document-replay-never-presents",
    "route": "/settings",
    "preset": "medium",
    "extra": {"FST_DEBUG_DISTRIBUTION": "tester",
              "FST_DEBUG_WHATS_NEW_FILE": "{repo}\\tools\\windows\\fixtures\\missing-whats-new.json"},
    "steps": [
      "waitfor:id=fst.settings.show-instrument-icons@20",
      "wait:2",
      "waitgone:id=fst.whats-new.dialog@1",
      "scrollinto:id=fst.settings.whats-new",
      "waitfor:id=fst.settings.whats-new@5",
      "invoke:id=fst.settings.whats-new",
      "wait:2",
      "waitgone:id=fst.whats-new.dialog@1",
      "focus:id=fst.settings.whats-new",
      "key:enter",
      "wait:2",
      "waitgone:id=fst.whats-new.dialog@1",
      "assertfocus:id=fst.settings.whats-new@3"
    ]
  }
]
