[
  {
    "name": "player-bands-groups-paging-detail",
    "route": "/bands/player/fixture-player-1",
    "preset": "medium",
    "steps": [
      "waitfor:id=fst.player-bands.title@15",
      "waitfor:id=fst.player-bands.row.fixture-band-1@10",
      "waitfor:id=fst.player-bands.page-next@5",
      "invoke:id=fst.player-bands.page-next",
      "waitfor:id=fst.player-bands.row.fixture-pband-quad-1@10",
      "shot:{shots}\\player-bands-page2.png",
      "select:id=fst.player-bands.group.trios",
      "waitfor:id=fst.player-bands.row.fixture-pband-trio-1@10",
      "select:id=fst.player-bands.group.duos",
      "waitfor:id=fst.player-bands.row.fixture-band-1@10",
      "invoke:id=fst.player-bands.row.fixture-band-1",
      "waitfor:id=fst.band.title@10",
      "waitfor:id=fst.band.member.fixture-band-1-a@10",
      "waitfor:id=fst.band.stat.rank@10",
      "invoke:id=fst.quick-links.open",
      "waitfor:id=fst.quick-links.item.songs@5",
      "invoke:id=fst.quick-links.item.songs",
      "waitfor:id=fst.band.song-row.fixture-pulse@15",
      "shot:{shots}\\band-detail-songs.png",
      "invoke:id=fst.band.song-row.fixture-pulse",
      "waitfor:id=fst.song-detail.title@10",
      "key:alt+left",
      "waitfor:id=fst.band.title@10",
      "invoke:id=fst.band.member.fixture-band-1-a",
      "wait:2",
      "key:alt+left",
      "waitfor:id=fst.band.title@10",
      "key:alt+left",
      "waitfor:id=fst.player-bands.title@10"
    ]
  },
  {
    "name": "player-bands-mixed-sizes",
    "route": "/bands/player/fixture-player-1",
    "preset": "wide",
    "steps": [
      "waitfor:id=fst.player-bands.row.fixture-band-1@15",
      "scrollinto:id=fst.player-bands.row.fixture-pband-trio-7@10",
      "shot:{shots}\\player-bands-page1-trios.png",
      "invoke:id=fst.player-bands.page-last",
      "waitfor:id=fst.player-bands.row.fixture-pband-trio-8@10",
      "waitfor:id=fst.player-bands.row.fixture-pband-quad-1@10",
      "scrollinto:id=fst.player-bands.row.fixture-pband-quad-4@10",
      "shot:{shots}\\player-bands-page2-quads.png",
      "select:id=fst.player-bands.group.quads",
      "waitfor:name=Quads · 4 bands@10",
      "waitgone:id=fst.player-bands.page-next@5",
      "waitfor:id=fst.player-bands.row.fixture-pband-quad-4@10"
    ]
  },
  {
    "name": "player-bands-empty",
    "route": "/bands/player/fixture-player-2",
    "preset": "compact",
    "steps": [
      "waitfor:id=fst.player-bands.empty@15",
      "waitfor:name=No bands have been recorded for this player yet.@5",
      "waitgone:id=fst.player-bands.page-next@5",
      "select:id=fst.player-bands.group.quads",
      "waitfor:name=No Quads have been recorded for this player yet.@10",
      "shot:{shots}\\player-bands-empty.png"
    ]
  },
  {
    "name": "player-bands-error",
    "route": "/bands/player/missing-player",
    "preset": "medium",
    "steps": [
      "waitfor:name=Failed to load bands@15",
      "waitfor:id=fst.service-status.retry@5",
      "waitfor:id=fst.player-bands.title@5",
      "shot:{shots}\\player-bands-error.png",
      "invoke:id=fst.service-status.retry",
      "waitfor:name=Failed to load bands@15"
    ]
  },
  {
    "name": "band-detail-rank-history-chart",
    "route": "/bands/player/fixture-player-1",
    "preset": "medium",
    "steps": [
      "waitfor:id=fst.player-bands.row.fixture-band-1@15",
      "invoke:id=fst.player-bands.row.fixture-band-1",
      "waitfor:id=fst.band.title@10",
      "invoke:id=fst.quick-links.open",
      "waitfor:id=fst.quick-links.item.rank-history@5",
      "invoke:id=fst.quick-links.item.rank-history",
      "waitfor:id=fst.band.history-chart@10",
      "shot:{shots}\\band-history.png"
    ]
  },
  {
    "name": "song-band-leaderboard-switch-and-detail",
    "route": "/songs/fixture-pulse/bands/Band_Duets",
    "preset": "wide",
    "steps": [
      "waitfor:id=fst.song-band-leaderboard.title@15",
      "waitfor:id=fst.song-band-leaderboard.row.fixture-band-1:1@10",
      "shot:{shots}\\song-band-leaderboard-rows.png",
      "select:id=fst.song-band-leaderboard.band-type.Band_Trios",
      "waitfor:id=fst.song-band-leaderboard.empty@10",
      "waitfor:name=No Trios scores have been recorded for this song yet.@5",
      "shot:{shots}\\song-band-leaderboard-empty.png",
      "select:id=fst.song-band-leaderboard.band-type.Band_Quad",
      "waitfor:name=No Quads scores have been recorded for this song yet.@10",
      "select:id=fst.song-band-leaderboard.band-type.Band_Duets",
      "waitfor:id=fst.song-band-leaderboard.row.fixture-band-2:2@10",
      "invoke:id=fst.song-band-leaderboard.row.fixture-band-2:2",
      "waitfor:id=fst.band.title@10",
      "waitfor:id=fst.band.member.fixture-band-2-b@10",
      "shot:{shots}\\band-detail-from-song.png",
      "invoke:id=PART_BackButton",
      "waitfor:id=fst.song-band-leaderboard.song@10",
      "invoke:id=fst.song-band-leaderboard.song",
      "waitfor:id=fst.song-detail.title@10"
    ]
  },
  {
    "name": "song-band-leaderboard-error",
    "route": "/songs/missing-song/bands/Band_Trios",
    "preset": "medium",
    "steps": [
      "waitfor:name=Failed to load band leaderboard@15",
      "waitfor:id=fst.service-status.retry@5",
      "waitfor:id=fst.song-band-leaderboard.title@5",
      "shot:{shots}\\song-band-leaderboard-error.png"
    ]
  },
  {
    "name": "band-detail-unresolved",
    "route": "/bands/some-band-id",
    "preset": "compact",
    "steps": [
      "waitfor:name=Band Not Available@15",
      "shot:{shots}\\band-detail-unresolved.png"
    ]
  },
  {
    "name": "bands-not-found",
    "route": "/bands",
    "preset": "medium",
    "steps": [
      "waitfor:id=fst.bands.title@15",
      "waitfor:name=Band not found@10",
      "shot:{shots}\\bands-not-found.png"
    ]
  }
]
