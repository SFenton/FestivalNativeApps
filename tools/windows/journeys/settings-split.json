[
  {
    "name": "settings-split-details",
    "route": "/settings",
    "sizes": [
      "wide",
      "maximized"
    ],
    "tabs": 0,
    "settings": {
      "enableVisualOrder": true,
      "filterInvalidScores": true
    },
    "ready": [
      "waitfor:id=fst.settings.detail.placeholder.title@20",
      "assertstate:id=fst.settings.detail.placeholder.title|name=Settings@5",
      "assertstate:id=fst.settings.detail.placeholder.message|name=Select a setting to see more options here",
      "waitgone:id=fst.settings.detail.title@2"
    ],
    "after_ready": [
      "scrollinto:id=fst.settings.show-instrument-icons@5",
      "toggle:id=fst.settings.show-instrument-icons",
      "assertstate:id=fst.settings.show-instrument-icons|toggle=off@3",
      "waitfor:id=fst.settings.detail.placeholder.title@2",
      "waitgone:id=fst.settings.detail.title@2",
      "toggle:id=fst.settings.show-instrument-icons",
      "assertstate:id=fst.settings.show-instrument-icons|toggle=on@3",
      "scrollinto:id=fst.settings.detail-row.show-instruments@5",
      "invoke:id=fst.settings.detail-row.show-instruments",
      "assertstate:id=fst.settings.detail.title|name=Show Instruments@5",
      "assertstatus:id=fst.settings.detail-row.show-instruments|~Selected$@3",
      "waitgone:id=fst.settings.detail.placeholder.title@3",
      "waitfor:id=fst.settings.instrument.Solo_Guitar@5",
      "assertorder:id=fst.settings.detail-row.show-instruments|id=fst.settings.detail.title|id=fst.settings.instrument.Solo_Guitar",
      "scrollinto:id=fst.settings.show-instrument-icons@5",
      "toggle:id=fst.settings.show-instrument-icons",
      "assertstate:id=fst.settings.show-instrument-icons|toggle=off@3",
      "assertstate:id=fst.settings.detail.title|name=Show Instruments@2",
      "assertstatus:id=fst.settings.detail-row.show-instruments|Selected@2",
      "toggle:id=fst.settings.show-instrument-icons",
      "assertstate:id=fst.settings.show-instrument-icons|toggle=on@3",
      "shot:{stem}-instruments.png",
      "scrollinto:id=fst.settings.detail-row.song-row-order@5",
      "invoke:id=fst.settings.detail-row.song-row-order",
      "assertstate:id=fst.settings.detail.title|name=Song Row Visual Order@5",
      "assertstatus:id=fst.settings.detail-row.song-row-order|~Selected$@3",
      "waitgone:id=fst.settings.detail.placeholder.title@3",
      "waitfor:id=fst.settings.song-row-order@5",
      "assertorder:id=fst.settings.detail-row.song-row-order|id=fst.settings.detail.title|id=fst.settings.song-row-order",
      "assertstatus:id=fst.settings.detail-row.show-instruments|~^(?!.*Selected).*$@3",
      "scrollinto:id=fst.settings.detail-row.path-default-view@5",
      "invoke:id=fst.settings.detail-row.path-default-view",
      "assertstate:id=fst.settings.detail.title|name=CHOpt Path Default View@5",
      "assertstatus:id=fst.settings.detail-row.path-default-view|~Selected$@3",
      "waitgone:id=fst.settings.detail.placeholder.title@3",
      "waitfor:id=fst.settings.path-default-view@5",
      "assertorder:id=fst.settings.detail-row.path-default-view|id=fst.settings.detail.title|id=fst.settings.path-default-view",
      "assertstatus:id=fst.settings.detail-row.song-row-order|~^(?!.*Selected).*$@3",
      "scrollinto:id=fst.settings.detail-row.path-column-order@5",
      "invoke:id=fst.settings.detail-row.path-column-order",
      "assertstate:id=fst.settings.detail.title|name=CHOpt Text Path Column Order@5",
      "assertstatus:id=fst.settings.detail-row.path-column-order|~Selected$@3",
      "waitgone:id=fst.settings.detail.placeholder.title@3",
      "waitfor:id=fst.settings.path-column-order@5",
      "assertorder:id=fst.settings.detail-row.path-column-order|id=fst.settings.detail.title|id=fst.settings.path-column-order",
      "assertstatus:id=fst.settings.detail-row.path-default-view|~^(?!.*Selected).*$@3",
      "scrollinto:id=fst.settings.detail-row.leeway@5",
      "invoke:id=fst.settings.detail-row.leeway",
      "assertstate:id=fst.settings.detail.title|name=Maximum Score Leeway@5",
      "assertstatus:id=fst.settings.detail-row.leeway|~Selected$@3",
      "waitgone:id=fst.settings.detail.placeholder.title@3",
      "waitfor:id=fst.settings.leeway@5",
      "assertorder:id=fst.settings.detail-row.leeway|id=fst.settings.detail.title|id=fst.settings.leeway",
      "assertstatus:id=fst.settings.detail-row.path-column-order|~^(?!.*Selected).*$@3",
      "scrollinto:id=fst.settings.detail-row.item-shop@5",
      "invoke:id=fst.settings.detail-row.item-shop",
      "assertstate:id=fst.settings.detail.title|name=Item Shop@5",
      "assertstatus:id=fst.settings.detail-row.item-shop|~Selected$@3",
      "waitgone:id=fst.settings.detail.placeholder.title@3",
      "waitfor:id=fst.settings.hide-shop@5",
      "assertorder:id=fst.settings.detail-row.item-shop|id=fst.settings.detail.title|id=fst.settings.hide-shop",
      "assertstatus:id=fst.settings.detail-row.leeway|~^(?!.*Selected).*$@3",
      "scrollinto:id=fst.settings.detail-row.show-metadata@5",
      "invoke:id=fst.settings.detail-row.show-metadata",
      "assertstate:id=fst.settings.detail.title|name=Show Instrument Metadata@5",
      "assertstatus:id=fst.settings.detail-row.show-metadata|~Selected$@3",
      "waitgone:id=fst.settings.detail.placeholder.title@3",
      "waitfor:id=fst.settings.metadata.score@5",
      "assertorder:id=fst.settings.detail-row.show-metadata|id=fst.settings.detail.title|id=fst.settings.metadata.score",
      "assertstatus:id=fst.settings.detail-row.item-shop|~^(?!.*Selected).*$@3",
      "scrollinto:id=fst.settings.detail-row.accessibility@5",
      "invoke:id=fst.settings.detail-row.accessibility",
      "assertstate:id=fst.settings.detail.title|name=Accessibility@5",
      "assertstatus:id=fst.settings.detail-row.accessibility|~Selected$@3",
      "waitgone:id=fst.settings.detail.placeholder.title@3",
      "waitfor:id=fst.settings.reduce-motion@5",
      "assertorder:id=fst.settings.detail-row.accessibility|id=fst.settings.detail.title|id=fst.settings.reduce-motion",
      "assertstatus:id=fst.settings.detail-row.show-metadata|~^(?!.*Selected).*$@3",
      "scrollinto:id=fst.settings.detail-row.version@5",
      "invoke:id=fst.settings.detail-row.version",
      "assertstate:id=fst.settings.detail.title|name=Festival Score Tracker Version@5",
      "assertstatus:id=fst.settings.detail-row.version|~Selected$@3",
      "waitgone:id=fst.settings.detail.placeholder.title@3",
      "waitfor:id=fst.settings.app-version@5",
      "assertorder:id=fst.settings.detail-row.version|id=fst.settings.detail.title|id=fst.settings.app-version",
      "assertstatus:id=fst.settings.detail-row.accessibility|~^(?!.*Selected).*$@3",
      "scrollinto:id=fst.settings.detail-row.service-info@5",
      "invoke:id=fst.settings.detail-row.service-info",
      "assertstate:id=fst.settings.detail.title|name=Service Info@5",
      "assertstatus:id=fst.settings.detail-row.service-info|~Selected$@3",
      "waitgone:id=fst.settings.detail.placeholder.title@3",
      "waitfor:id=fst.settings.service-info.state@5",
      "assertorder:id=fst.settings.detail-row.service-info|id=fst.settings.detail.title|id=fst.settings.service-info.state",
      "assertstatus:id=fst.settings.detail-row.version|~^(?!.*Selected).*$@3",
      "scrollinto:id=fst.settings.detail-row.first-run@5",
      "invoke:id=fst.settings.detail-row.first-run",
      "assertstate:id=fst.settings.detail.title|name=First Run Guides@5",
      "assertstatus:id=fst.settings.detail-row.first-run|~Selected$@3",
      "waitgone:id=fst.settings.detail.placeholder.title@3",
      "waitfor:id=fst.settings.first-run.songs@5",
      "assertorder:id=fst.settings.detail-row.first-run|id=fst.settings.detail.title|id=fst.settings.first-run.songs",
      "assertstatus:id=fst.settings.detail-row.service-info|~^(?!.*Selected).*$@3",
      "scrollinto:id=fst.settings.detail-row.licenses@5",
      "invoke:id=fst.settings.detail-row.licenses",
      "waitfor:id=fst.licenses.summary@10",
      "assertstatus:id=fst.settings.detail-row.licenses|Selected@3",
      "assertstatus:id=fst.settings.detail-row.first-run|~^(?!.*Selected).*$@3",
      "waitgone:id=fst.settings.detail.placeholder.title@2",
      "waitgone:id=fst.settings.first-run.songs@2",
      "assertorder:id=fst.settings.detail-row.licenses|id=fst.licenses.summary",
      "shot:{stem}-licenses.png",
      "scrollinto:id=fst.settings.detail-row.privacy-policy@5",
      "invoke:id=fst.settings.detail-row.privacy-policy",
      "assertstate:id=fst.settings.detail.title|name=Privacy Policy@5",
      "assertstatus:id=fst.settings.detail-row.privacy-policy|~Selected$@3",
      "waitgone:id=fst.settings.detail.placeholder.title@3",
      "waitfor:id=fst.privacy-policy.effective-date@5",
      "assertorder:id=fst.settings.detail-row.privacy-policy|id=fst.settings.detail.title|id=fst.privacy-policy.effective-date",
      "assertstatus:id=fst.settings.detail-row.licenses|~^(?!.*Selected).*$@3",
      "waitgone:id=fst.privacy-policy.dialog@2",
      "waitgone:id=fst.licenses.summary@2",
      "shot:{stem}-privacy.png"
    ]
  },
  {
    "name": "settings-split-row-gone",
    "route": "/settings",
    "sizes": [
      "wide"
    ],
    "tabs": 0,
    "settings": {
      "filterInvalidScores": true
    },
    "ready": [
      "waitfor:id=fst.settings.detail.placeholder.title@20",
      "assertstate:id=fst.settings.detail.placeholder.title|name=Settings@5",
      "assertstate:id=fst.settings.detail.placeholder.message|name=Select a setting to see more options here",
      "waitgone:id=fst.settings.detail.title@2"
    ],
    "after_ready": [
      "scrollinto:id=fst.settings.detail-row.leeway@5",
      "invoke:id=fst.settings.detail-row.leeway",
      "assertstate:id=fst.settings.detail.title|name=Maximum Score Leeway@5",
      "assertstatus:id=fst.settings.detail-row.leeway|~Selected$@3",
      "waitgone:id=fst.settings.detail.placeholder.title@3",
      "waitfor:id=fst.settings.leeway@5",
      "assertorder:id=fst.settings.detail-row.leeway|id=fst.settings.detail.title|id=fst.settings.leeway",
      "scrollinto:id=fst.settings.filter-invalid-scores@5",
      "toggle:id=fst.settings.filter-invalid-scores",
      "assertstate:id=fst.settings.filter-invalid-scores|toggle=off@3",
      "waitgone:id=fst.settings.detail-row.leeway@3",
      "waitfor:id=fst.settings.detail.placeholder.title@3",
      "waitgone:id=fst.settings.detail.title@2"
    ]
  },
  {
    "name": "settings-split-narrow",
    "route": "/settings",
    "sizes": [
      "wide"
    ],
    "tabs": 0,
    "ready": [
      "waitfor:id=fst.settings.detail.placeholder.title@20",
      "assertstate:id=fst.settings.detail.placeholder.title|name=Settings@5",
      "assertstate:id=fst.settings.detail.placeholder.message|name=Select a setting to see more options here",
      "waitgone:id=fst.settings.detail.title@2"
    ],
    "after_ready": [
      "scrollinto:id=fst.settings.detail-row.item-shop@5",
      "invoke:id=fst.settings.detail-row.item-shop",
      "assertstate:id=fst.settings.detail.title|name=Item Shop@5",
      "assertstatus:id=fst.settings.detail-row.item-shop|~Selected$@3",
      "waitgone:id=fst.settings.detail.placeholder.title@3",
      "waitfor:id=fst.settings.hide-shop@5",
      "assertorder:id=fst.settings.detail-row.item-shop|id=fst.settings.detail.title|id=fst.settings.hide-shop",
      "resize:medium",
      "wait:1.5",
      "waitgone:id=fst.settings.detail-row.item-shop@3",
      "waitgone:id=fst.settings.detail.title@2",
      "waitgone:id=fst.settings.detail.placeholder.title@2",
      "scrollinto:id=fst.settings.hide-shop@5",
      "assertbelow:id=fst.settings.hide-shop|id=fst.settings.feedback.feature",
      "scrollinto:id=fst.settings.instrument.Solo_Guitar@5",
      "waitfor:id=fst.settings.instrument.Solo_Guitar@3",
      "scrollinto:id=fst.settings.privacy-policy@5",
      "invoke:id=fst.settings.privacy-policy",
      "waitfor:id=fst.privacy-policy.dialog@10",
      "invoke:id=fst.privacy-policy.close",
      "waitgone:id=fst.privacy-policy.dialog@5",
      "resize:wide",
      "wait:1.5",
      "assertstate:id=fst.settings.detail.title|name=Item Shop@5",
      "assertstatus:id=fst.settings.detail-row.item-shop|Selected@3",
      "waitfor:id=fst.settings.hide-shop@3",
      "waitgone:id=fst.settings.detail.placeholder.title@2"
    ]
  }
]
