  {
    "name": "instrument-selector-lab-states",
    "route": "/songs",
    "env": {
      "FST_DEBUG_CONTROL_LAB": "instrument-selector"
    },
    "ready": [
      "scrollinto:id=fst.instrument-selector.disabled.value@20"
    ],
    "after_ready": [
      "scrollinto:id=fst.instrument-selector.muted.Solo_Bass@5",
      "hover:20,20",
      "key:esc",
      "wait:0.5"
    ],
    "tabs": 0
  },
  {
    "name": "instrument-selector-lab-compact",
    "note": "Issue #571: the UIA toggle focuses the Detail content Lead circle, and WinUI opens a circle's tooltip for UIA-sourced focus by design (ToolTipService::OnOwnerGotFocus); Esc does not close it, tooltips are always windowed, and every focusable control in the lab has a tooltip, so focus cannot move to a tooltip-free control before the scan. The allowance drops only WinUI's windowed PopupHost finding (windows-accessibility open item 8), as for a11y-history-swap's post-pick tooltip; every other finding still fails.",
    "axe_allow": [
      "framework-popup"
    ],
    "route": "/songs",
    "env": {
      "FST_DEBUG_CONTROL_LAB": "instrument-selector"
    },
    "ready": [
      "scrollinto:id=fst.instrument-selector.deferred.value@20"
    ],
    "after_ready": [
      "scrollinto:id=fst.instrument-selector.detail.Solo_Guitar@5",
      "toggle:id=fst.instrument-selector.detail.Solo_Guitar",
      "scrollinto:id=fst.instrument-selector.detail.value@5",
      "hover:20,20",
      "key:esc",
      "wait:0.5"
    ],
    "tabs": 0
  },
  {
    "name": "instrument-selector-songs-filter",
    "tab": "songs",
    "profile": "fixture-player-1:Demo Player",
    "ready": [
      "waitfor:id=fst.songs.row.fixture-pulse@20"
    ],
    "after_ready": [
      "invoke:id=fst.songs.filter",
      "waitfor:id=fst.songs.filter.reset@5",
      "scrollinto:id=fst.songs.filter.instrument.group@5",
      "wait:0.5"
    ],
    "teardown": [
      "key:esc",
      "wait:0.5"
    ],
    "tabs": 0
  },
  {
    "name": "instrument-selector-history",
    "route": "/songs/fixture-pulse",
    "profile": "fixture-player-1:Demo Player",
    "ready": [
      "waitfor:id=fst.song-detail.paths@20",
      "scrollinto:id=fst.history.instrument.group@10"
    ],
    "after_ready": [
      "wait:0.5"
    ],
    "tabs": 0
  },
  {
    "name": "instrument-selector-paths",
    "route": "/songs/fixture-pulse",
    "ready": [
      "waitfor:id=fst.song-detail.paths@20"
    ],
    "after_ready": [
      "invoke:id=fst.song-detail.paths",
      "waitfor:id=fst.paths@10",
      "waitfor:id=fst.paths.warning@15",
      "invoke:id=fst.paths.warning.ok",
      "waitgone:id=fst.paths.warning@3",
      "wait:1"
    ],
    "teardown": [
      "key:esc",
      "wait:0.5"
    ],
    "tabs": 0
  },
  {
    "name": "instrument-selector-swap-compact",
    "route": "/songs",
    "env": {
      "FST_DEBUG_CONTROL_LAB": "instrument-selector"
    },
    "sizes": [
      "compact"
    ],
    "setup": [
      "resize:medium",
      "wait:1.5",
      "scrollinto:id=fst.instrument-selector.auto.Solo_Bass@20",
      "focus:id=fst.instrument-selector.auto.Solo_Bass",
      "key:shift+tab",
      "assertfocus:id=fst.instrument-selector.auto.Solo_Guitar@3",
      "waitfor:name=Lead&class=ToolTip@5",
      "resize:compact",
      "wait:1.5"
    ],
    "ready": [
      "waitfor:id=fst.instrument-selector.auto.compact@10"
    ],
    "after_ready": [
      "waitgone:name=Lead&class=ToolTip@3",
      "assertfocus:id=fst.instrument-selector.auto.compact@3"
    ],
    "tabs": 0
  },
  {
    "name": "instrument-selector-swap-full",
    "route": "/songs",
    "env": {
      "FST_DEBUG_CONTROL_LAB": "instrument-selector"
    },
    "sizes": [
