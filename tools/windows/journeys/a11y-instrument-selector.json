      "focus:id=fst.instrument-selector.auto.previous",
      "key:tab",
      "assertfocus:id=fst.instrument-selector.auto.compact@3",
      "waitfor:name=Lead&class=ToolTip@5",
      "resize:medium",
      "wait:1.5"
    ],
    "ready": [
      "waitfor:id=fst.instrument-selector.auto.Solo_Bass@10"
    ],
    "after_ready": [
      "waitgone:name=Lead&class=ToolTip@3",
      "assertfocus:id=fst.instrument-selector.auto.Solo_Guitar@3"
    ],
    "tabs": 0
  }
