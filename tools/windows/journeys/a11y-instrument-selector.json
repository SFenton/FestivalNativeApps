[
  {
    "name": "instrument-selector-swap-narrow",
    "route": "/songs",
    "env": {
      "FST_DEBUG_CONTROL_LAB": "instrument-selector"
    },
    "tabs": 0,
    "sizes": ["compact"],
    "setup": ["resize:medium", "wait:1.5", "scrollinto:id=fst.instrument-selector.auto.group@20",
