              "key:right",
              "assertfocus:id=fst.instrument-selector.auto.Solo_Bass@3", "waitfor:name=Bass&class=ToolTip@5",
              "resize:compact", "wait:1.5"],
    "ready": ["scrollinto:id=fst.instrument-selector.auto.compact@20"],
    "after_ready": ["assertfocus:id=fst.instrument-selector.auto.compact@3", "wait:1.5", "waitgone:class=ToolTip@3"]
  },
