[
  {
    "name": "instrument-selector-states",
    "route": "/songs",
    "preset": "wide",
    "extra": {
      "FST_DEBUG_CONTROL_LAB": "instrument-selector"
    },
    "steps": [
      "scrollinto:id=fst.instrument-selector.group@20",
      "assertstate:id=fst.instrument-selector.group|name=None",
      "assertstate:id=fst.instrument-selector.value|name=Selected: none",
      "assertstate:id=fst.instrument-selector.Solo_Guitar|toggle=off",
      "scrollinto:id=fst.instrument-selector.Solo_Drums@5",
      "toggle:id=fst.instrument-selector.Solo_Drums",
      "assertstate:id=fst.instrument-selector.Solo_Drums|toggle=on",
      "assertstate:id=fst.instrument-selector.value|name=Selected: Drums",
      "scrollinto:id=fst.instrument-selector.Solo_Drums@5",
      "toggle:id=fst.instrument-selector.Solo_Drums",
      "assertstate:id=fst.instrument-selector.Solo_Drums|toggle=off",
      "assertstate:id=fst.instrument-selector.value|name=Selected: none",
      "shot:{shots}/instrument-selector-none.png",
      "assertstate:id=fst.instrument-selector.selected.Solo_Guitar|toggle=on",
      "assertstate:id=fst.instrument-selector.selected.Solo_Bass|toggle=off",
      "assertstate:id=fst.instrument-selector.selected.value|name=Selected: Lead",
      "scrollinto:id=fst.instrument-selector.required.Solo_Bass@5",
      "toggle:id=fst.instrument-selector.required.Solo_Bass",
      "assertstate:id=fst.instrument-selector.required.Solo_Bass|toggle=on",
      "assertstate:id=fst.instrument-selector.required.value|name=Selected: Bass",
      "scrollinto:id=fst.instrument-selector.required.Solo_Guitar@5",
      "toggle:id=fst.instrument-selector.required.Solo_Guitar",
      "assertstate:id=fst.instrument-selector.required.Solo_Guitar|toggle=on",
      "assertstate:id=fst.instrument-selector.required.Solo_Bass|toggle=off",
      "assertstate:id=fst.instrument-selector.required.value|name=Selected: Lead",
      "scrollinto:id=fst.instrument-selector.hidden.Solo_Guitar@5",
      "scrollinto:id=fst.instrument-selector.hidden.value@5",
      "waitgone:id=fst.instrument-selector.hidden.Solo_PeripheralVocals@2",
      "scrollinto:id=fst.instrument-selector.hidden.value@5",
      "waitgone:id=fst.instrument-selector.hidden.Solo_PeripheralBass@2",
      "scrollinto:id=fst.instrument-selector.disabled.group@5",
      "assertstate:id=fst.instrument-selector.disabled.Solo_Drums|enabled=false",
      "assertstate:id=fst.instrument-selector.disabled.Solo_PeripheralGuitar|enabled=false",
      "assertstate:id=fst.instrument-selector.disabled.Solo_Bass|enabled=true",
      "assertstate:id=fst.instrument-selector.disabled.value|name=Selected: none",
      "assertstatus:id=fst.instrument-selector.muted.Solo_Bass|Conflicts with current selection",
      "assertstatus:id=fst.instrument-selector.muted.Solo_Vocals|Conflicts with current selection",
      "assertstate:id=fst.instrument-selector.muted.Solo_Guitar|toggle=on",
      "scrollinto:id=fst.instrument-selector.muted.Solo_Bass@5",
      "toggle:id=fst.instrument-selector.muted.Solo_Bass",
      "assertstate:id=fst.instrument-selector.muted.Solo_Bass|toggle=on",
      "assertstate:id=fst.instrument-selector.muted.value|name=Selected: Bass",
      "shot:{shots}/instrument-selector-disabled-muted.png",
      "scrollinto:id=fst.instrument-selector.compact-mode.compact@5",
      "scrollinto:id=fst.instrument-selector.compact-mode.value@5",
      "waitgone:id=fst.instrument-selector.compact-mode.Solo_Guitar@2",
      "assertstate:id=fst.instrument-selector.compact-mode.compact|name=Lead",
      "assertstate:id=fst.instrument-selector.compact-mode.compact|toggle=on",
      "scrollinto:id=fst.instrument-selector.compact-mode.next@5",
      "invoke:id=fst.instrument-selector.compact-mode.next",
      "assertstate:id=fst.instrument-selector.compact-mode.compact|name=Bass",
      "assertstate:id=fst.instrument-selector.compact-mode.value|name=Selected: Bass",
      "scrollinto:id=fst.instrument-selector.compact-mode.previous@5",
      "invoke:id=fst.instrument-selector.compact-mode.previous",
      "scrollinto:id=fst.instrument-selector.compact-mode.previous@5",
      "invoke:id=fst.instrument-selector.compact-mode.previous",
      "assertstate:id=fst.instrument-selector.compact-mode.compact|name=Pro Drums",
      "assertstate:id=fst.instrument-selector.compact-mode.value|name=Selected: Pro Drums",
      "assertstate:id=fst.instrument-selector.deferred.compact|name=Lead",
      "assertstate:id=fst.instrument-selector.deferred.compact|toggle=off",
      "scrollinto:id=fst.instrument-selector.deferred.next@5",
      "invoke:id=fst.instrument-selector.deferred.next",
      "assertstate:id=fst.instrument-selector.deferred.compact|name=Bass",
      "assertstate:id=fst.instrument-selector.deferred.compact|toggle=off",
      "assertstate:id=fst.instrument-selector.deferred.value|name=Selected: none",
      "scrollinto:id=fst.instrument-selector.deferred.compact@5",
      "toggle:id=fst.instrument-selector.deferred.compact",
      "assertstate:id=fst.instrument-selector.deferred.compact|toggle=on",
      "assertstate:id=fst.instrument-selector.deferred.value|name=Selected: Bass",
      "scrollinto:id=fst.instrument-selector.deferred.compact@5",
      "toggle:id=fst.instrument-selector.deferred.compact",
      "assertstate:id=fst.instrument-selector.deferred.value|name=Selected: none",
      "shot:{shots}/instrument-selector-compact-deferred.png",
      "scrollinto:id=fst.instrument-selector.detail.group@5",
      "scrollinto:id=fst.instrument-selector.detail.value@5",
      "waitgone:id=fst.instrument-selector.detail.content@2",
      "scrollinto:id=fst.instrument-selector.detail.Solo_Guitar@5",
      "toggle:id=fst.instrument-selector.detail.Solo_Guitar",
      "scrollinto:id=fst.instrument-selector.detail.content@5",
      "shot:{shots}/instrument-selector-detail.png",
      "scrollinto:id=fst.instrument-selector.detail.Solo_Guitar@5",
      "toggle:id=fst.instrument-selector.detail.Solo_Guitar",
      "scrollinto:id=fst.instrument-selector.detail.value@5",
      "waitgone:id=fst.instrument-selector.detail.content@5",
      "scan:{shots}/scans/instrument-selector-lab"
    ]
  },
  {
    "name": "instrument-selector-keyboard",
    "route": "/songs",
    "preset": "wide",
    "extra": {
      "FST_DEBUG_CONTROL_LAB": "instrument-selector"
    },
    "steps": [
      "scrollinto:id=fst.instrument-selector.group@20",
      "scrollinto:id=fst.instrument-selector.Solo_Guitar@5",
      "focus:id=fst.instrument-selector.Solo_Guitar",
      "assertfocus:id=fst.instrument-selector.Solo_Guitar@3",
      "key:right",
      "assertfocus:id=fst.instrument-selector.Solo_Bass@3",
      "key:tab",
      "assertfocus:id=fst.instrument-selector.Solo_Drums@3",
      "key:space",
      "assertstate:id=fst.instrument-selector.value|name=Selected: Drums",
      "key:left",
      "assertfocus:id=fst.instrument-selector.Solo_Bass@3",
      "key:enter",
      "assertstate:id=fst.instrument-selector.value|name=Selected: Bass",
      "scrollinto:id=fst.instrument-selector.disabled.Solo_Bass@5",
      "focus:id=fst.instrument-selector.disabled.Solo_Bass",
      "key:right",
      "assertfocus:id=fst.instrument-selector.disabled.Solo_Vocals@3",
      "key:shift+tab",
      "assertfocus:id=fst.instrument-selector.disabled.Solo_Bass@3",
      "scrollinto:id=fst.instrument-selector.deferred.next@5",
      "focus:id=fst.instrument-selector.deferred.next",
      "key:space",
      "assertstate:id=fst.instrument-selector.deferred.compact|name=Bass",
      "key:left",
      "assertfocus:id=fst.instrument-selector.deferred.compact@3",
      "key:space",
      "assertstate:id=fst.instrument-selector.deferred.value|name=Selected: Bass",
      "shot:{shots}/instrument-selector-keyboard-focus.png@screen"
    ]
  },
  {
    "name": "instrument-selector-resize-focus",
    "route": "/songs",
    "preset": "wide",
    "extra": {
      "FST_DEBUG_CONTROL_LAB": "instrument-selector"
    },
    "steps": [
      "scrollinto:id=fst.instrument-selector.auto.group@20",
      "scrollinto:id=fst.instrument-selector.auto.Solo_Bass@5",
      "scrollinto:id=fst.instrument-selector.auto.Solo_Bass@5",
      "toggle:id=fst.instrument-selector.auto.Solo_Bass",
      "scrollinto:id=fst.instrument-selector.auto.Solo_Bass@5",
      "focus:id=fst.instrument-selector.auto.Solo_Bass",
      "resize:compact",
      "scrollinto:id=fst.instrument-selector.auto.compact@5",
      "assertfocus:id=fst.instrument-selector.auto.compact@3",
      "assertstate:id=fst.instrument-selector.auto.compact|name=Bass",
      "resize:wide",
      "scrollinto:id=fst.instrument-selector.auto.Solo_Bass@5",
      "assertfocus:id=fst.instrument-selector.auto.Solo_Bass@3"
    ]
  },
  {
    "name": "instrument-selector-reduced-motion",
    "route": "/songs",
    "preset": "wide",
    "args": [
      "--reduce-motion"
    ],
    "extra": {
      "FST_DEBUG_CONTROL_LAB": "instrument-selector"
    },
    "steps": [
      "scrollinto:id=fst.instrument-selector.group@20",
      "assertstate:id=fst.control-lab.motion|name=Motion: reduced",
      "scrollinto:id=fst.instrument-selector.Solo_Bass@5",
      "toggle:id=fst.instrument-selector.Solo_Bass",
      "shot:{shots}/instrument-selector-reduced-motion.png@screen",
      "assertstate:id=fst.instrument-selector.Solo_Bass|toggle=on",
      "scrollinto:id=fst.instrument-selector.detail.group@5",
      "scrollinto:id=fst.instrument-selector.detail.Solo_Guitar@5",
      "toggle:id=fst.instrument-selector.detail.Solo_Guitar",
      "scrollinto:id=fst.instrument-selector.detail.content@2"
    ]
  }
]
