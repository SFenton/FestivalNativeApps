[
  {
    "name": "preview-rows-anonymous",
    "route": "/songs/fixture-pulse",
    "fixture": ["--song-leaderboard", "anonymous"],
    "tabs": 0,
    "note": "Issues #63, #425: a Song Details top-ten row without an account reads as text (no Invoke, not focusable) in its place between the rows with accounts, which stay 40+ epx Button stops that open the profile by Enter; Down skips the text row.",
    "ready": [
      "waitfor:id=fst.song-detail.title@20",
      "scrollinto:id=fst.song-detail.preview-row.Solo_Guitar.fixture-player-4@20",
      "wait:1"
    ],
    "after_ready": [
      "assertread:id=fst.song-detail.preview-row.Solo_Guitar.rank-3|Rank 3, Unknown player, 99,700 points, text",
      "assertstate:id=fst.song-detail.preview-row.Solo_Guitar.rank-3|type=text",
      "assertstate:id=fst.song-detail.preview-row.Solo_Guitar.rank-3|invoke=false",
      "assertstate:id=fst.song-detail.preview-row.Solo_Guitar.rank-3|focusable=false",
      "assertread:id=fst.song-detail.preview-row.Solo_Guitar.fixture-player-2|~^Rank 2, Fixture Player 2, 99,800 points, 98% accuracy, full combo(, season 9)?, button$",
      "assertstate:id=fst.song-detail.preview-row.Solo_Guitar.fixture-player-2|invoke=true",
      "assertstate:id=fst.song-detail.preview-row.Solo_Guitar.fixture-player-4|type=button",
      "assertstate:id=fst.song-detail.preview-row.Solo_Guitar.fixture-player-4|invoke=true",
      "assertsize:id=fst.song-detail.preview-row.Solo_Guitar.fixture-player-2|40x40",
      "assertsize:id=fst.song-detail.preview-row.Solo_Guitar.fixture-player-4|40x40",
      "assertorder:id=fst.song-detail.preview-row.Solo_Guitar.fixture-player-2|id=fst.song-detail.preview-row.Solo_Guitar.rank-3|id=fst.song-detail.preview-row.Solo_Guitar.fixture-player-4",
      "focus:id=fst.song-detail.preview-row.Solo_Guitar.fixture-player-2",
      "assertfocus:id=fst.song-detail.preview-row.Solo_Guitar.fixture-player-2@3",
      "key:down",
      "assertfocus:id=fst.song-detail.preview-row.Solo_Guitar.fixture-player-4@3",
      "key:enter",
      "waitfor:id=fst.player.name@15",
      "waitgone:id=fst.song-detail.title@5",
      "key:alt+left",
      "waitfor:id=fst.song-detail.title@15",
      "waitgone:id=fst.player.name@5"
    ]
  },
