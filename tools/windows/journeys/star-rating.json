      "waitfor:name=Rank #6, Fixture Player 6, 99,400 points, 98% accuracy, full combo@5",
      "waitfor:name=Rank #7, Fixture Player 7, 99,300 points, 98% accuracy, 3 stars@5",
      "assertstatus:id=fst.star-rating.white-3|white-3@5",
