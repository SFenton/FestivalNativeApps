[
  {
    "name": "frrd-songs-sort",
    "tab": "settings",
    "scan": true,
    "tabs": 8,
    "ready": [
      "waitfor:id=fst.settings.show-instrument-icons@30"
    ],
    "after_ready": [
      "scrollinto:id=fst.settings.feedback.feature@20",
      "scrollinto:id=fst.settings.licenses",
      "wait:0.5",
      "scrollinto:id=fst.settings.first-run.songs",
      "focus:id=fst.settings.first-run.songs",
      "key:enter",
      "waitfor:id=fst.first-run.dialog@20",
      "assertfocus:name=Song List&class=FlipViewItem@5",
      "key:enter",
      "wait:0.6",
      "wait:1",
      "assertstatus:id=fst.first-run.demo.songs-sort|~^catalogue( |$)@30",
      "assertstate:raw=fst.first-run.demo.songs-sort|help=~^controls=(?=.*\\bDropDownButton\\b)(?=.*\\bRadioButtons\\b)(?=.*\\bSongSortForm\\b)@15",
      "waitgone:id=fst.first-run.demo.songs-sort@1",
      "assertread:name=Sort Songs&class=FlipViewItem|Sort Songs, list item, selected",
      "assertapart:raw=fst.first-run.demo.songs-sort|name=Sort Songs&class=TextBlock",
      "focus:name=Sort Songs&class=FlipViewItem",
      "key:tab",
      "assertfocus:name=Page 2&class=Button@3",
      "scrollinto:id=fst.first-run.pips",
      "assertorder:name=Sort Songs&class=FlipViewItem|id=fst.first-run.pips|id=PrimaryButton|id=SecondaryButton|id=fst.first-run.close",
      "assertsize:id=fst.first-run.close|40x40"
    ],
    "teardown": [
      "key:esc",
      "waitgone:id=fst.first-run.dialog@5",
      "assertfocus:id=fst.settings.first-run.songs@3"
    ]
  },
