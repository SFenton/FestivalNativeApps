  {
    "name": "frrd-infinite-scroll",
    "tab": "settings",
    "scan": true,
    "tabs": 8,
    "ready": [
      "waitfor:id=fst.settings.show-instrument-icons@30"
    ],
    "skip_modes": [
      "no-animations",
      "app-reduced"
    ],
    "after_ready": [
      "scrollinto:id=fst.settings.feedback.feature@20",
      "scrollinto:id=fst.settings.licenses",
      "wait:0.5",
      "scrollinto:id=fst.settings.first-run.suggestions",
      "focus:id=fst.settings.first-run.suggestions",
      "key:enter",
      "waitfor:id=fst.first-run.dialog@20",
      "assertfocus:name=Suggestion Cards&class=FlipViewItem@5",
      "key:enter",
      "wait:0.6",
      "key:enter",
      "wait:0.6",
      "key:enter",
      "wait:0.6",
      "wait:1",
      "assertstatus:id=fst.first-run.demo.suggestions-infinite-scroll|~^catalogue scroll=running pos=mid wraps=0 fade=top\\+bottom$@15",
      "assertstate:raw=fst.first-run.demo.suggestions-infinite-scroll|help=~^controls=(?=.*\\bScrollViewer\\b)(?=.*\\bSuggestionSongRow\\b)@15",
      "waitgone:id=fst.first-run.demo.suggestions-infinite-scroll.card.0@1",
      "waitgone:id=fst.first-run.demo.suggestions-infinite-scroll@1",
      "assertread:name=More Suggestions&class=FlipViewItem|More Suggestions, list item, selected",
      "assertapart:raw=fst.first-run.demo.suggestions-infinite-scroll|name=More Suggestions&class=TextBlock",
      "focus:name=More Suggestions&class=FlipViewItem",
      "key:tab",
      "assertfocus:name=Page 4&class=Button@3",
      "scrollinto:id=fst.first-run.pips",
      "assertorder:name=More Suggestions&class=FlipViewItem|id=fst.first-run.pips|id=PrimaryButton|id=SecondaryButton|id=fst.first-run.close",
      "assertsize:id=fst.first-run.close|40x40"
    ],
    "teardown": [
      "resize:minimized",
      "assertstatus:id=fst.first-run.demo.suggestions-infinite-scroll|~^catalogue scroll=paused pos=\\w+ wraps=\\d+ fade=[a-z+]+$@10",
      "resize:restored",
      "assertstatus:id=fst.first-run.demo.suggestions-infinite-scroll|~^catalogue scroll=running pos=\\w+ wraps=\\d+ fade=[a-z+]+$@10",
      "key:esc",
      "waitgone:id=fst.first-run.dialog@5",
      "assertfocus:id=fst.settings.first-run.suggestions@3"
    ]
  },
