  {"name": "settings-service-info-monotonic", "tab": "songs", "tabs": 0, "sizes": ["compact"], "modes": ["normal"],
   "fixture": ["service_info_fixture.py", "--service-info", "monotonic"],
   "ready": ["waitfor:id=fst.songs.list@20"],
   "after_ready": ["listen:announcements", "key:ctrl+comma",
                   "assertannounced:Registered Player Band Discovery. 24.8%. 1,240 of 5,000 accounts completed. 1,310 attempted this pass · 70 temporarily unavailable · 1,240 of 5,000 completed@15",
                   "scrollinto:id=fst.settings.feedback.feature@20", "reveal:id=fst.settings.service-info.attempt",
                   "assertname:id=fst.settings.service-info.attempt|1,310 attempted this pass · 70 temporarily unavailable · 1,240 of 5,000 completed",
                   "wait:6",
                   "assertname:id=fst.settings.service-info.attempt|1,310 attempted this pass · 70 temporarily unavailable · 1,240 of 5,000 completed",
                   "assertannouncedcount:1|~1,310 attempted this pass",
                   "assertannouncedcount:0|~1,200 attempted this pass",
                   "assertname:id=fst.settings.service-info.attempt@15|1,400 attempted this pass · 80 temporarily unavailable · 1,240 of 5,000 completed",
                   "assertname:id=fst.settings.service-info.phase|*1,400 attempted this pass · 80 temporarily unavailable · 1,240 of 5,000 completed",
                   "assertannounced:Registered Player Band Discovery. 24.8%. 1,240 of 5,000 accounts completed. 1,400 attempted this pass · 80 temporarily unavailable · 1,240 of 5,000 completed@5",
                   "wait:6",
                   "assertannouncedcount:1|~1,310 attempted this pass",
                   "assertannouncedcount:1|~1,400 attempted this pass",
                   "assertannouncedcount:0|~1,200 attempted this pass"]},
