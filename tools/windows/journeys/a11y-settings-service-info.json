                   "assertname:id=fst.settings.service-info.last-published|Jan 1, 2026, *",
                   "waitgone:id=fst.settings.service-info.phase",
                   "assertbelow:id=fst.settings.service-info.last-published|id=fst.settings.service-info.state",
                   "shot:{stem}-idle.png", "scan:{stem}-axe/idle"]},
