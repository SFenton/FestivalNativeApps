      "waitgone:id=fst.quick-links.item.instrument-Solo_Drums@5",
      "wait:1",
      "assertinset:name=Drums, 1 total entry&class=AccessibleGroup|id=fst.song-detail|89.7",
      "assertstate:id=fst.quick-links.open|name=Quick Links, current section Drums@5",
      "shot:{stem}-drums.png",
      "scrollinto:id=fst.quick-links.open@5",
      "expand:id=fst.quick-links.open",
