      "assertstate:id=fst.quick-links.item.global|selected=true@5"
    ],
    "after_ready": [
      "invoke:id=fst.quick-links.item.instrument:Solo_Drums",
      "assertinset:id=fst.player.section.Solo_Drums|id=fst.player.available|40",
      "assertstate:id=fst.quick-links.item.instrument:Solo_Drums|selected=true@5",
      "shot:{stem}-drums.png",
      "invoke:id=fst.quick-links.item.instrument:Solo_PeripheralGuitar",
      "assertstate:id=fst.quick-links.item.instrument:Solo_PeripheralGuitar|selected=true@5"
