[
  {
    "name": "qlj-profile-menu",
    "route": "/statistics",
    "profile": "fixture-player-1:Demo Player",
    "sizes": [
      "compact",
      "medium",
      "snap-left"
    ],
    "tabs": 0,
    "ready": [
      "waitfor:id=fst.quick-links.open@20",
      "assertstate:id=fst.quick-links.open|name=Quick Links, current section Global Statistics@10"
    ],
    "after_ready": [
      "assertsize:id=fst.quick-links.open|40x40",
      "scan:{stem}-axe/closed",
      "listen:announcements",
      "focus:id=fst.quick-links.open",
      "key:enter",
      "waitfor:id=fst.quick-links.item.bands@5",
      "assertfocus:id=fst.quick-links.item.global@3",
      "assertstate:id=fst.quick-links.item.global|toggle=on",
      "assertstate:id=fst.quick-links.item.global|name=Global Statistics, current section",
      "assertstate:id=fst.quick-links.item.bands|toggle=off",
      "assertstate:id=fst.quick-links.item.bands|name=Bands",
      "assertbelow:id=fst.quick-links.item.instrument:Solo_Guitar|id=fst.quick-links.item.global",
      "assertbelow:id=fst.quick-links.item.instrument:Solo_Bass|id=fst.quick-links.item.instrument:Solo_Guitar",
      "assertbelow:id=fst.quick-links.item.instrument:Solo_Drums|id=fst.quick-links.item.instrument:Solo_Bass",
      "assertbelow:id=fst.quick-links.item.instrument:Solo_Vocals|id=fst.quick-links.item.instrument:Solo_Drums",
      "assertbelow:id=fst.quick-links.item.instrument:Solo_PeripheralGuitar|id=fst.quick-links.item.instrument:Solo_Vocals",
      "assertbelow:id=fst.quick-links.item.instrument:Solo_PeripheralBass|id=fst.quick-links.item.instrument:Solo_PeripheralGuitar",
      "assertbelow:id=fst.quick-links.item.instrument:Solo_PeripheralVocals|id=fst.quick-links.item.instrument:Solo_PeripheralBass",
      "assertbelow:id=fst.quick-links.item.instrument:Solo_PeripheralCymbals|id=fst.quick-links.item.instrument:Solo_PeripheralVocals",
      "assertbelow:id=fst.quick-links.item.instrument:Solo_PeripheralDrums|id=fst.quick-links.item.instrument:Solo_PeripheralCymbals",
      "assertbelow:id=fst.quick-links.item.bands|id=fst.quick-links.item.instrument:Solo_PeripheralDrums",
      "key:down",
      "assertfocus:id=fst.quick-links.item.instrument:Solo_Guitar@3",
      "key:down",
      "key:down",
      "key:down",
      "key:down",
      "key:down",
      "key:down",
      "key:down",
      "key:down",
      "key:down",
      "assertfocus:id=fst.quick-links.item.bands@3",
      "key:enter",
      "waitgone:id=fst.quick-links.item.bands@5",
      "assertannounced:Bands section@5",
      "assertstate:id=fst.quick-links.open|name=Quick Links, current section Bands@5",
      "wait:1",
      "assertstate:id=fst.quick-links.open|name=Quick Links, current section Bands",
      "assertinset:id=fst.player.bands-section|id=fst.player.available|32",
      "scrollinto:id=fst.quick-links.open@5",
      "assertstate:id=fst.quick-links.open|name=Quick Links, current section Global Statistics@5",
      "focus:id=fst.quick-links.open",
      "key:enter",
      "waitfor:id=fst.quick-links.item.instrument:Solo_Drums@5",
      "assertstate:id=fst.quick-links.item.global|toggle=on",
      "assertstate:id=fst.quick-links.item.bands|toggle=off",
      "assertstate:id=fst.quick-links.item.bands|name=Bands",
      "toggle:id=fst.quick-links.item.instrument:Solo_Drums",
      "waitgone:id=fst.quick-links.item.instrument:Solo_Drums@5",
      "assertannounced:Drums section@5",
      "assertstate:id=fst.quick-links.open|name=Quick Links, current section Drums@5",
      "wait:1",
      "assertstate:id=fst.quick-links.open|name=Quick Links, current section Drums",
      "assertinset:id=fst.player.section.Solo_Drums|id=fst.player.available|40",
      "scrollinto:id=fst.quick-links.open@5",
      "focus:id=fst.quick-links.open",
      "key:enter",
      "waitfor:id=fst.quick-links.item.bands@5",
      "key:esc",
      "waitgone:id=fst.quick-links.item.bands@5",
      "assertfocus:id=fst.quick-links.open@3",
      "scrollinto:id=fst.player.stat.overview.songs-played@10",
      "focus:id=fst.player.stat.overview.songs-played",
      "assertfocus:id=fst.player.stat.overview.songs-played@3"
    ]
  },
  {
    "name": "qlj-profile-pane",
    "route": "/statistics",
    "profile": "fixture-player-1:Demo Player",
    "sizes": [
      "wide",
      "maximized"
    ],
    "tabs": 0,
    "ready": [
      "waitfor:id=fst.quick-links.list@20",
      "waitgone:id=fst.quick-links.open@3",
      "assertstate:id=fst.quick-links.item.global|selected=true@10"
    ],
    "after_ready": [
      "assertstate:id=fst.quick-links.item.global|name=Global Statistics",
      "assertorder:id=fst.quick-links.item.global|id=fst.quick-links.item.instrument:Solo_Guitar|id=fst.quick-links.item.instrument:Solo_Bass|id=fst.quick-links.item.instrument:Solo_Drums|id=fst.quick-links.item.instrument:Solo_Vocals|id=fst.quick-links.item.instrument:Solo_PeripheralGuitar|id=fst.quick-links.item.instrument:Solo_PeripheralBass|id=fst.quick-links.item.instrument:Solo_PeripheralVocals|id=fst.quick-links.item.instrument:Solo_PeripheralCymbals|id=fst.quick-links.item.instrument:Solo_PeripheralDrums|id=fst.quick-links.item.bands",
      "assertsize:id=fst.quick-links.item.global|0x40",
      "assertsize:id=fst.quick-links.item.bands|0x40",
      "listen:announcements",
      "focus:id=fst.quick-links.item.bands",
      "assertfocus:id=fst.quick-links.item.bands@3",
      "key:enter",
      "assertannounced:Bands section@5",
      "assertstate:id=fst.quick-links.item.bands|selected=true@5",
      "wait:1",
      "assertstate:id=fst.quick-links.item.bands|selected=true",
      "assertstate:id=fst.quick-links.item.bands|name=Bands",
      "assertstate:id=fst.quick-links.item.global|selected=false",
      "assertstate:id=fst.quick-links.item.global|name=Global Statistics",
      "focus:id=fst.quick-links.item.instrument:Solo_Drums",
      "assertfocus:id=fst.quick-links.item.instrument:Solo_Drums@3",
      "key:enter",
      "assertannounced:Drums section@5",
      "assertstate:id=fst.quick-links.item.instrument:Solo_Drums|selected=true@5",
      "wait:1",
      "assertstate:id=fst.quick-links.item.instrument:Solo_Drums|selected=true",
      "assertstate:id=fst.quick-links.item.instrument:Solo_Drums|name=Drums",
      "assertstate:id=fst.quick-links.item.bands|selected=false",
      "assertinset:id=fst.player.section.Solo_Drums|id=fst.player.available|40",
      "shot:{stem}-drums-selected.png@screen"
    ]
  }
]
