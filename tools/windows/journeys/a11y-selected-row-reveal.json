[
  {
    "name": "reveal-song-score",
    "note": "Issues #323, #470: Song Details' 'your score' row (rank 17, row eleven) opens the Lead board with navToPlayer by keyboard. The reveal waits for the row's entrance, then centres it: the row reads 'Your rank, 17th.', paints its purple fill, keeps a 40 epx target clear of the pinned row, reads rows 16 -> 17 -> 18 -> pinned row -> Next, and Down/Up/Tab move from it in place.",
    "route": "/songs/fixture-pulse",
    "profile": "fixture-player-17:Fixture Player 17",
    "fixture": [
      "fade_fixture.py",
      "--large-rankings"
    ],
    "scan": true,
    "tabs": 0,
    "ready": [
      "scrollinto:id=fst.song-detail.preview-row.Solo_Guitar.fixture-player-17@30",
      "wait:1"
    ],
    "after_ready": [
      "scrollinto:id=fst.song-detail.preview-row.Solo_Guitar.fixture-player-17@10",
      "assertread:id=fst.song-detail.preview-row.Solo_Guitar.fixture-player-17|~^Rank 17, Fixture Player 17, 98,300 points, 98% accuracy, you\\. Jump to your position, button$",
      "assertsize:id=fst.song-detail.preview-row.Solo_Guitar.fixture-player-17|0x40",
      "focus:id=fst.song-detail.preview-row.Solo_Guitar.fixture-player-17",
      "assertfocus:id=fst.song-detail.preview-row.Solo_Guitar.fixture-player-17@3",
      "key:enter",
      "waitfor:id=fst.song-leaderboard.list@30",
      "waitfor:id=fst.song-leaderboard.row.fixture-player-17@20",
      "wait:1",
      "assertread:id=fst.song-leaderboard.row.fixture-player-17|~^Your rank, 17th\\. Fixture Player 17, 98,300 points, 98% accuracy, .+, button$",
      "assertread:id=fst.song-leaderboard.spotlight-footer|~^Your rank, 17th\\. Open your statistics\\. Fixture Player 17, .+, button$",
      "assertsize:id=fst.song-leaderboard.row.fixture-player-17|0x40",
      "assertapart:id=fst.song-leaderboard.row.fixture-player-17|id=fst.song-leaderboard.spotlight-footer",
      "assertorder:id=fst.song-leaderboard.row.fixture-player-16|id=fst.song-leaderboard.row.fixture-player-17|id=fst.song-leaderboard.row.fixture-player-18|id=fst.song-leaderboard.spotlight-footer|id=fst.song-leaderboard.page-next",
      "assertpaint:id=fst.song-leaderboard.row.fixture-player-17|above:L40,T-20|L40,T6!=@above~20",
      "assertmotion:id=fst.song-leaderboard.row.fixture-player-17|still",
      "focus:id=fst.song-leaderboard.row.fixture-player-17",
      "assertfocus:id=fst.song-leaderboard.row.fixture-player-17@3",
      "key:down",
      "assertfocus:id=fst.song-leaderboard.row.fixture-player-18@3",
      "key:up",
      "assertfocus:id=fst.song-leaderboard.row.fixture-player-17@3",
      "assertapart:id=fst.song-leaderboard.row.fixture-player-17|id=fst.song-leaderboard.spotlight-footer",
      "key:tab",
      "assertfocus:id=fst.song-leaderboard.spotlight-footer@3",
      "key:tab",
      "assertfocus:id=fst.song-leaderboard.page-next@3",
      "key:shift+tab",
      "assertfocus:id=fst.song-leaderboard.spotlight-footer@3",
      "focus:id=fst.song-leaderboard.row.fixture-player-17",
      "waitgone:class=ToolTip@5",
      "shot:{stem}.png"
    ]
  },
  {
    "name": "reveal-full-rankings-card",
