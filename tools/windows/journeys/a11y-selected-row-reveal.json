      "assertsize:id=fst.leaderboards.card.Solo_Guitar.spotlight|0x40",
      "focus:id=fst.leaderboards.card.Solo_Guitar.spotlight",
      "assertfocus:id=fst.leaderboards.card.Solo_Guitar.spotlight@3",
      "key:enter",
      "waitfor:id=fst.full-rankings.list@30",
      "waitfor:id=fst.rankings.row.fixture-rank-60@20",
      "wait:1",
      "assertread:id=fst.rankings.row.fixture-rank-60|~^Your rank, 60th\\. Fixture Rank 60\\. Total Score 30,000,000, .+, button$",
      "assertsize:id=fst.rankings.row.fixture-rank-60|0x40",
      "assertapart:id=fst.rankings.row.fixture-rank-60|id=fst.full-rankings.spotlight-footer",
      "assertorder:id=fst.rankings.row.fixture-rank-59|id=fst.rankings.row.fixture-rank-60|id=fst.rankings.row.fixture-rank-61|id=fst.full-rankings.spotlight-footer|id=fst.full-rankings.page-first",
      "assertpaint:id=fst.rankings.row.fixture-rank-60|above:L40,T-20|L40,T6!=@above~20",
      "assertmotion:id=fst.rankings.row.fixture-rank-60|still",
      "focus:id=fst.rankings.row.fixture-rank-60",
      "assertfocus:id=fst.rankings.row.fixture-rank-60@3",
      "key:down",
      "assertfocus:id=fst.rankings.row.fixture-rank-61@3",
      "key:up",
      "assertfocus:id=fst.rankings.row.fixture-rank-60@3",
      "assertapart:id=fst.rankings.row.fixture-rank-60|id=fst.full-rankings.spotlight-footer",
      "key:tab",
      "assertfocus:id=fst.full-rankings.spotlight-footer@3",
      "key:tab",
      "assertfocus:id=fst.full-rankings.page-first@3",
      "key:shift+tab",
      "assertfocus:id=fst.full-rankings.spotlight-footer@3",
      "focus:id=fst.rankings.row.fixture-rank-60",
      "waitgone:class=ToolTip@5",
      "shot:{stem}.png"
    ]
  },
