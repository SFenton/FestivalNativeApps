[
  {
    "name": "fr-swap-rank-by",
    "note": "Issue #524 (for #270): a Rank By or instrument reload takes the pinned row (Fixture Rank 40, off page) out of the UIA view, the reading order and Tab with the old rows and pager, so only the named ring is read and Tab goes from Rank By to the title bar; the new value then returns as a 40x40 Button in rows -> pinned row -> pager order and Tab order.",
    "route": "/leaderboards/all?instrument=Solo_Guitar",
    "settings": {"experimentalRanks": true},
    "profile": "fixture-rank-40:Fixture Rank 40",
    "fixture": ["rankings_fixture.py", "--rankings-delay", "6"],
    "tabs": 0,
    "scan": true,
    "ready": [
      "waitfor:id=fst.rankings.row.fixture-player-1@30",
      "waitfor:id=fst.full-rankings.spotlight-footer@10",
      "waitgone:name=Busy Loading rankings@8",
      "wait:1"
    ],
    "after_ready": [
      "assertread:id=fst.full-rankings.spotlight-footer|~^Your rank, 40th\\. Jump to your position\\. Fixture Rank 40\\. Total Score .+, button$",
      "invoke:id=fst.rankings.rank-by-menu",
      "waitfor:id=fst.rankings.rank-by.fcrate@5",
      "toggle:id=fst.rankings.rank-by.fcrate",
      "waitfor:name=Busy Loading rankings@3",
      "waitgone:id=fst.full-rankings.spotlight-footer@2",
      "waitgone:id=fst.full-rankings.page-next@1",
      "assertread:name=Busy Loading rankings|Busy Loading rankings, ProgressRing",
      "assertorder:id=fst.full-rankings.title|id=fst.rankings.rank-by-menu|name=Busy Loading rankings",
      "assertfocus:id=fst.rankings.rank-by-menu@3",
      "key:tab",
      "assertfocus:id=PART_BackButton@3",
      "key:shift+tab",
      "assertfocus:id=fst.rankings.rank-by-menu@3",
      "waitfor:name=Busy Loading rankings@1",
      "waitgone:id=fst.full-rankings.spotlight-footer@1",
      "waitfor:id=fst.full-rankings.spotlight-footer@20",
      "waitgone:name=Busy Loading rankings@5",
      "assertread:id=fst.full-rankings.spotlight-footer|~^Your rank, 40th\\. Jump to your position\\. Fixture Rank 40\\. FC Rate .+, button$@3",
      "assertorder:id=fst.rankings.rank-by-menu|id=fst.rankings.row.fixture-player-1|id=fst.full-rankings.spotlight-footer|id=fst.full-rankings.page-first|id=fst.full-rankings.page-next",
      "assertstate:id=fst.full-rankings.spotlight-footer|focusable=true",
      "assertstate:id=fst.full-rankings.spotlight-footer|invoke=true",
      "assertsize:id=fst.full-rankings.spotlight-footer|40x40",
      "assertapart:id=fst.full-rankings.spotlight-footer|id=fst.full-rankings.page-next",
      "expand:id=fst.full-rankings.instrument-menu",
      "waitfor:id=fst.full-rankings.instrument.Solo_Bass@5",
      "toggle:id=fst.full-rankings.instrument.Solo_Bass",
      "waitfor:name=Busy Loading rankings@3",
      "waitgone:id=fst.full-rankings.spotlight-footer@2",
      "waitgone:id=fst.full-rankings.page-next@1",
      "assertread:name=Busy Loading rankings|Busy Loading rankings, ProgressRing",
      "assertorder:id=fst.full-rankings.instrument-menu|id=fst.rankings.rank-by-menu|name=Busy Loading rankings",
      "waitfor:id=fst.full-rankings.spotlight-footer@20",
      "waitgone:name=Busy Loading rankings@5",
      "assertread:id=fst.full-rankings.spotlight-footer|~^Your rank, 40th\\. Jump to your position\\. Fixture Rank 40\\. FC Rate .+, button$@3",
      "assertsize:id=fst.full-rankings.spotlight-footer|40x40",
      "focus:id=fst.rankings.row.fixture-player-1",
      "assertfocus:id=fst.rankings.row.fixture-player-1@3",
      "key:tab",
      "assertfocus:id=fst.full-rankings.spotlight-footer@3",
      "key:tab",
      "assertfocus:id=fst.full-rankings.page-next@3",
      "key:shift+tab",
      "assertfocus:id=fst.full-rankings.spotlight-footer@3",
      "focus:id=fst.rankings.row.fixture-player-1",
      "wait:1"
    ]
  },
  {
