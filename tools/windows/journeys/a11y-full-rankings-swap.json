      "assertstate:id=fst.full-rankings.spotlight-footer|focusable=true",
      "assertsize:id=fst.full-rankings.spotlight-footer|40x40",
      "assertapart:name=Busy Loading rankings|id=fst.full-rankings.spotlight-footer",
      "key:shift+tab",
      "assertfocus:id=fst.full-rankings.spotlight-footer@3",
      "key:tab",
      "assertfocus:id=fst.full-rankings.page-next@3",
      "waitfor:name=Busy Loading rankings@1",
      "waitfor:id=fst.rankings.row.fixture-rank-40@20",
      "waitgone:name=Busy Loading rankings@5",
      "assertname:id=fst.full-rankings.page-info|Page 2 of 48",
      "assertread:id=fst.full-rankings.spotlight-footer|~^Your rank, 40th\\. Open your statistics\\. Fixture Rank 40\\. Total Score .+, button$@3",
      "assertorder:id=fst.rankings.row.fixture-rank-40|id=fst.full-rankings.spotlight-footer|id=fst.full-rankings.page-first|id=fst.full-rankings.page-previous|id=fst.full-rankings.page-info|id=fst.full-rankings.page-next",
      "focus:id=fst.rankings.row.fixture-rank-40",
      "wait:1"
    ]
  },
