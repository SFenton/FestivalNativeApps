      "expand:id=fst.songs.filter.double-bass",
      "assertread:id=fst.songs.filter.double-bass|Double Bass, button, expanded",
      "scrollinto:id=fst.songs.filter.double-bass.unsupported@5",
      "assertread:id=fst.songs.filter.double-bass.supported|Double Bass Support, toggle switch, on",
