      "assertread:id=fst.songs.filter.double-bass.unsupported|No Double Bass Support, toggle switch, on",
      "toggle:id=fst.songs.filter.double-bass.unsupported",
      "assertread:id=fst.songs.filter.double-bass.unsupported|No Double Bass Support, toggle switch, off",
