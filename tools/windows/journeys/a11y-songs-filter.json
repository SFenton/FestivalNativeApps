      "assertstatus:id=fst.songs.filter|Filters applied@5",
      "wait:0.5"
    ],
    "teardown": [
      "key:esc",
      "wait:0.5",
      "assertread:id=fst.songs.filter|Filter Songs, button, collapsed, Filters applied"
    ]
  },
