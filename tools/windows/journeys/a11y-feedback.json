      "assertorder:id=fst.settings.feedback.title|id=fst.settings.feedback.validation|id=PrimaryButton|id=fst.settings.feedback.cancel",
      "focus:id=fst.settings.feedback.title",
      "key:tab", "assertfocus:id=fst.settings.feedback.description@3",
      "assertread:id=fst.settings.feedback.description|Description, edit, What went wrong? Include the page, song, instrument or player involved.",
      "key:tab", "assertfocus:id=fst.settings.feedback.repro@3",
      "assertread:id=fst.settings.feedback.repro|Steps to Reproduce, edit, List the steps that make the problem happen, one per line.",
      "key:tab", "assertfocus:id=fst.settings.feedback.expected@3",
      "assertread:id=fst.settings.feedback.expected|Expected Behavior, edit, What did you expect to happen instead?",
      "key:tab", "assertfocus:id=fst.settings.feedback.attach@3",
      "assertread:id=fst.settings.feedback.attach|Attach Media, button",
      "assertstate:name=Media|heading=3",
      "assertorder:name=Media|id=fst.settings.feedback.attach",
      "assertsize:id=fst.settings.feedback.attach|40x40",
      "key:tab", "assertfocus:id=fst.settings.feedback.cancel@3"
    ]
