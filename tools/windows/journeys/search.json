[
  {
    "name": "wide-suggestions-page-scopes-bands",
    "route": "/songs",
    "preset": "wide",
    "steps": [
      "waitfor:id=fst.songs.list@20",
      "key:ctrl+e",
      "type:fix",
      "waitfor:name=Player, Fixture Player 1@10",
      "shot:{shots}\\search-suggestions-wide.png@screen",
      "key:down",
      "key:enter",
      "waitfor:id=fst.song-detail.title@10",
      "key:alt+left",
      "waitfor:id=fst.songs.list@10",
      "key:ctrl+e",
      "type:ab",
      "key:escape",
      "key:escape",
      "key:ctrl+e",
      "type:fixture",
      "key:enter",
      "waitfor:id=fst.global-search.result.song@10",
      "waitfor:id=fst.global-search.result.player@5",
      "shot:{shots}\\search-wide.png",
      "select:id=fst.global-search.scope.songs",
      "waitfor:id=fst.global-search.result.song@5",
      "waitgone:id=fst.global-search.result.player@5",
      "select:id=fst.global-search.scope.bands",
      "waitfor:id=fst.global-search.result.band@10",
      "waitgone:id=fst.global-search.result.song@5",
      "shot:{shots}\\search-bands-wide.png",
      "invoke:id=fst.global-search.result.band",
      "waitfor:id=fst.band.title@15",
      "key:alt+left",
      "waitfor:id=fst.global-search.field@10"
    ]
  },
  {
    "name": "medium-detail-player-select-statistics",
    "route": "/songs/fixture-pulse",
    "preset": "medium",
    "steps": [
      "waitfor:id=fst.song-detail.title@20",
      "key:ctrl+e",
      "type:fixture player 1",
      "waitfor:name=Player, Fixture Player 1@10",
      "shot:{shots}\\search-suggestions-medium.png@screen",
      "key:down",
      "key:enter",
      "waitfor:id=fst.player.name@15",
      "key:alt+left",
      "waitfor:id=fst.song-detail.title@10",
      "key:ctrl+e",
      "type:fixture player 1",
      "key:enter",
      "waitfor:id=fst.global-search.result.player@10",
      "shot:{shots}\\search-medium.png",
      "invoke:id=fst.global-search.result.player",
      "waitfor:id=fst.player.select@15",
      "invoke:id=fst.player.select",
      "wait:1",
      "key:ctrl+e",
      "type:fixture player 1",
      "waitfor:name=Player, Fixture Player 1, selected, opens Statistics@10",
      "key:down",
      "key:enter",
      "waitfor:id=fst.statistics@15"
    ]
  },
  {
    "name": "compact-button-empty-player-back",
    "route": "/leaderboards",
    "preset": "compact",
    "steps": [
      "waitfor:id=fst.leaderboards@20",
      "invoke:id=fst.global-search.open",
      "waitfor:id=fst.global-search.field@10",
      "assertname:id=fst.global-search.hint|Enter at least two characters to search for songs, players, or bands.",
      "shot:{shots}\\search-compact-hint.png",
      "type:zzzz",
      "waitfor:id=fst.global-search.empty.title@10",
      "waitgone:id=fst.global-search.retry",
      "click:id=fst.global-search.field",
      "key:escape",
      "type:fixture",
      "waitfor:id=fst.global-search.result.player@10",
      "shot:{shots}\\search-compact.png",
      "select:id=fst.global-search.scope.players",
      "waitfor:id=fst.global-search.result.player@5",
      "invoke:id=fst.global-search.result.player",
      "waitfor:id=fst.player.name@15",
      "key:alt+left",
      "waitfor:id=fst.global-search.field@10",
      "key:escape",
      "waitfor:id=fst.leaderboards@10"
    ]
  },
  {
    "name": "snap-left-players-error",
    "route": "/songs",
    "preset": "snap-left",
    "steps": [
      "waitfor:id=fst.songs.list@20",
      "key:ctrl+f",
      "key:ctrl+e",
      "type:busy",
      "key:enter",
      "waitfor:id=fst.service-status.title@10",
      "waitgone:id=fst.service-status.retry",
      "shot:{shots}\\search-snap-left-error.png"
    ]
  },
  {
    "name": "narrow-683-button",
    "route": "/songs",
    "preset": "683x768",
    "steps": [
      "waitfor:id=fst.songs.list@20",
      "shot:{shots}\\search-683.png",
      "key:ctrl+e",
      "waitfor:id=fst.global-search.field@10",
      "type:orbit",
      "waitfor:id=fst.global-search.result.song@10",
      "invoke:id=fst.global-search.result.song",
      "waitfor:id=fst.song-detail.title@10",
      "key:alt+left",
      "waitfor:id=fst.global-search.field@10"
    ]
  },
  {
    "name": "issue-299-hints-spinner-no-titles",
    "route": "/search",
    "preset": "medium",
    "steps": [
      "waitfor:id=fst.global-search.field@20",
      "assertname:id=fst.global-search.hint|Enter at least two characters to search for songs, players, or bands.",
      "shot:{shots}\\search-299-hint-all.png",
      "select:id=fst.global-search.scope.songs",
      "assertname:id=fst.global-search.hint|Enter at least two characters to search for songs.",
      "select:id=fst.global-search.scope.players",
      "assertname:id=fst.global-search.hint|Enter at least two characters to search for players.",
      "select:id=fst.global-search.scope.bands",
      "assertname:id=fst.global-search.hint|Enter at least two characters to search for bands.",
      "setvalue:id=fst.global-search.field|ab",
      "waitfor:id=fst.global-search.empty.title@10",
      "assertname:id=fst.global-search.empty.title|No bands found",
      "waitgone:id=fst.global-search.hint",
      "waitgone:id=fst.global-search.retry",
      "setvalue:id=fst.global-search.field|fixture",
      "waitfor:id=fst.global-search.result.band@10",
      "waitgone:id=fst.global-search.result.player@5",
      "waitgone:id=fst.global-search.empty.title",
      "shot:{shots}\\search-320-bands.png",
      "select:id=fst.global-search.scope.all",
      "setvalue:id=fst.global-search.field|slow",
      "waitfor:id=fst.global-search.loading@5",
      "assertaligned:id=fst.global-search.loading|id=fst.global-search.results",
      "assertlevel:id=fst.global-search.loading|id=fst.global-search.results",
      "shot:{shots}\\search-299-loading.png",
      "waitgone:id=fst.global-search.loading@15",
      "waitfor:id=fst.global-search.empty.title@5",
      "waitgone:id=fst.global-search.retry",
      "waitgone:id=fst.service-status.retry",
      "setvalue:id=fst.global-search.field|fixture",
      "waitfor:id=fst.global-search.result.song@10",
      "waitfor:id=fst.global-search.result.player@10",
      "waitgone:id=fst.global-search.loading",
      "waitgone:id=fst.global-search.section.songs",
      "waitgone:id=fst.global-search.section.players",
      "shot:{shots}\\search-299-results.png",
      "select:id=fst.global-search.scope.players",
      "waitfor:id=fst.global-search.result.player@5",
      "waitgone:id=fst.global-search.result.song@5",
      "setvalue:id=fst.global-search.field|busy",
      "waitfor:id=fst.service-status.title@10",
      "waitgone:id=fst.service-status.retry",
      "shot:{shots}\\search-299-players-error.png",
      "select:id=fst.global-search.scope.bands",
      "waitfor:id=fst.service-status.title@5",
      "waitgone:id=fst.service-status.retry",
      "waitgone:id=fst.global-search.empty.title",
      "shot:{shots}\\search-320-bands-error.png"
    ]
  }
]