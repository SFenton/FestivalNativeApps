[
  {
    "name": "wide-suggestions-page-scopes-bands",
    "route": "/songs",
    "preset": "wide",
    "steps": [
      "waitfor:id=fst.songs.list@20",
      "key:ctrl+e",
      "type:fix",
      "waitfor:name=Player, Fixture Player 1@10",
      "shot:{shots}\\search-suggestions-wide.png@screen",
      "key:down",
      "key:enter",
      "waitfor:id=fst.song-detail.title@10",
      "key:alt+left",
      "waitfor:id=fst.songs.list@10",
      "key:ctrl+e",
      "type:ab",
      "key:escape",
      "key:escape",
      "key:ctrl+e",
      "type:fixture",
      "key:enter",
      "waitfor:id=fst.global-search.section.players@10",
      "waitfor:id=fst.global-search.result.song@5",
      "waitfor:id=fst.global-search.result.player@5",
      "shot:{shots}\\search-wide.png",
      "click:id=fst.global-search.scope.songs",
      "waitfor:id=fst.global-search.section.songs@5",
      "click:id=fst.global-search.scope.bands",
      "waitfor:id=fst.global-search.bands-unavailable.rankings@5",
      "shot:{shots}\\search-bands-wide.png",
      "invoke:id=fst.global-search.bands-unavailable.rankings",
      "waitfor:id=fst.band-rankings.list@15",
      "key:alt+left",
      "waitfor:id=fst.global-search.field@10"
    ]
  },
  {
    "name": "medium-detail-player-select-statistics",
    "route": "/songs/fixture-pulse",
    "preset": "medium",
    "steps": [
      "waitfor:id=fst.song-detail.title@20",
      "key:ctrl+e",
      "type:fixture player 1",
      "waitfor:name=Player, Fixture Player 1@10",
      "shot:{shots}\\search-suggestions-medium.png@screen",
      "key:down",
      "key:enter",
      "waitfor:id=fst.player.name@15",
      "key:alt+left",
      "waitfor:id=fst.song-detail.title@10",
      "key:ctrl+e",
      "type:fixture player 1",
      "key:enter",
      "waitfor:id=fst.global-search.result.player@10",
      "shot:{shots}\\search-medium.png",
      "invoke:id=fst.global-search.result.player",
      "waitfor:id=fst.player.select@15",
      "invoke:id=fst.player.select",
      "wait:1",
      "key:ctrl+e",
      "type:fixture player 1",
      "waitfor:name=Player, Fixture Player 1, selected, opens Statistics@10",
      "key:down",
      "key:enter",
      "waitfor:id=fst.statistics@15"
    ]
  },
  {
    "name": "compact-button-empty-retry-player-back",
    "route": "/leaderboards",
    "preset": "compact",
    "steps": [
      "waitfor:id=fst.leaderboards@20",
      "invoke:id=fst.global-search.open",
      "waitfor:id=fst.global-search.field@10",
      "waitfor:name=Enter at least two characters to search.@5",
      "shot:{shots}\\search-compact-hint.png",
      "type:zzzz",
      "waitfor:name=No results found.@10",
      "waitfor:id=fst.global-search.retry@5",
      "invoke:id=fst.global-search.retry",
      "waitfor:name=No results found.@10",
      "click:id=fst.global-search.field",
      "key:escape",
      "type:fixture",
      "waitfor:id=fst.global-search.result.player@10",
      "shot:{shots}\\search-compact.png",
      "click:id=fst.global-search.scope.players",
      "waitfor:id=fst.global-search.result.player@5",
      "invoke:id=fst.global-search.result.player",
      "waitfor:id=fst.player.name@15",
      "key:alt+left",
      "waitfor:id=fst.global-search.field@10",
      "key:escape",
      "waitfor:id=fst.leaderboards@10"
    ]
  },
  {
    "name": "snap-left-players-error-retry",
    "route": "/songs",
    "preset": "snap-left",
    "steps": [
      "waitfor:id=fst.songs.list@20",
      "key:ctrl+f",
      "key:ctrl+e",
      "type:busy",
      "key:enter",
      "waitfor:id=fst.global-search.section.players@10",
      "waitfor:id=fst.service-status.retry@10",
      "shot:{shots}\\search-snap-left-error.png",
      "invoke:id=fst.service-status.retry",
      "waitfor:id=fst.service-status.retry@10"
    ]
  },
  {
    "name": "narrow-683-button",
    "route": "/songs",
    "preset": "683x768",
    "steps": [
      "waitfor:id=fst.songs.list@20",
      "shot:{shots}\\search-683.png",
      "key:ctrl+e",
      "waitfor:id=fst.global-search.field@10",
      "type:orbit",
      "waitfor:id=fst.global-search.result.song@10",
      "invoke:id=fst.global-search.result.song",
      "waitfor:id=fst.song-detail.title@10",
      "key:alt+left",
      "waitfor:id=fst.global-search.field@10"
    ]
  }
]
