      "assertsize:id=fst.quick-links.item.band-Band_Duets|0x40",
      "collapse:id=fst.song-detail.pinned-quick-links",
      "waitgone:id=fst.quick-links.item.band-Band_Duets@5",
      "focus:id=fst.song-detail.band-view-all.Band_Duets",
      "assertfocus:id=fst.song-detail.band-view-all.Band_Duets@3",
      "scrollsweep:id=fst.song-detail,100,0",
      "assertstate:id=fst.quick-links.open|name=Quick Links, current section Intensity@5",
      "wait:1",
      "assertstate:id=fst.quick-links.open|name=Quick Links, current section Intensity",
      "assertorder:id=fst.song-detail.title|id=fst.song-detail.paths|id=fst.song-detail.shop|id=fst.quick-links.open",
      "assertsize:id=fst.quick-links.open|40x40",
      "focus:id=fst.quick-links.open",
      "assertfocus:id=fst.quick-links.open@3",
      "focus:id=fst.song-detail.paths",
      "assertfocus:id=fst.song-detail.paths@3",
      "waitgone:class=ToolTip@5"
