[
  {"name": "xr-settings-toggle", "tab": "settings", "tabs": 0,
   "ready": ["waitfor:id=fst.settings.show-instrument-icons@20"],
   "after_ready": ["scrollinto:id=fst.settings.feedback.feature@25", "scrollinto:id=fst.settings.experimental-ranks@5",
                   "assertname:id=fst.settings.experimental-ranks|Enable Experimental Leaderboard Ranks",
                   "assertstate:id=fst.settings.experimental-ranks|enabled=true",
                   "assertstate:id=fst.settings.experimental-ranks|toggle=off",
                   "assertsize:id=fst.settings.experimental-ranks|40x32",
                   "focus:id=fst.settings.experimental-ranks", "assertfocus:id=fst.settings.experimental-ranks@3",
                   "key:space", "assertstate:id=fst.settings.experimental-ranks|toggle=on@3",
                   "key:ctrl+2", "waitfor:id=fst.leaderboards.card.Solo_Guitar.view-all@20",
                   "waitfor:id=fst.rankings.rank-by-menu@10",
                   "assertread:id=fst.rankings.rank-by-menu|Rank by: Total Score, button, collapsed",
                   "assertsize:id=fst.rankings.rank-by-menu|0x40",
                   "key:ctrl+comma", "scrollinto:id=fst.settings.feedback.feature@25",
                   "scrollinto:id=fst.settings.experimental-ranks@5", "toggle:id=fst.settings.experimental-ranks",
                   "assertstate:id=fst.settings.experimental-ranks|toggle=off@3",
                   "key:ctrl+2", "waitfor:id=fst.leaderboards.card.Solo_Guitar.view-all@20",
                   "waitgone:id=fst.rankings.rank-by-menu@10"]},
  {"name": "xr-leaderboards-on", "route": "/leaderboards", "settings": {"experimentalRanks": true, "leaderboardRankBy": "fcrate"},
   "tabs": 0, "ready": ["waitfor:id=fst.leaderboards.card.Solo_Guitar.view-all@20"],
   "after_ready": ["assertread:id=fst.rankings.rank-by-menu|Rank by: FC Rate, button, collapsed",
                   "assertsize:id=fst.rankings.rank-by-menu|0x40",
                   "assertorder:id=fst.rankings.rank-by-menu|id=fst.leaderboards.card.Solo_Guitar.view-all",
                   "expand:id=fst.rankings.rank-by-menu",
                   "waitfor:id=fst.rankings.rank-by.adjusted@5", "waitfor:id=fst.rankings.rank-by.weighted",
                   "waitfor:id=fst.rankings.rank-by.maxscore"],
   "teardown": ["collapse:id=fst.rankings.rank-by-menu", "wait:0.5"]},
  {"name": "xr-leaderboards-off", "route": "/leaderboards", "settings": {"leaderboardRankBy": "fcrate"}, "tabs": 0,
   "ready": ["waitfor:id=fst.leaderboards.card.Solo_Guitar.view-all@20"],
   "after_ready": ["waitgone:id=fst.rankings.rank-by-menu@5"]},
  {"name": "xr-full-rankings-off", "route": "/leaderboards/all?instrument=Solo_Guitar&rankBy=fcrate", "tabs": 0,
   "ready": ["waitfor:id=fst.full-rankings.list@20"],
   "after_ready": ["waitgone:id=fst.rankings.rank-by-menu@5", "waitfor:id=fst.full-rankings.instrument-menu"]},
  {"name": "xr-band-rankings-off", "route": "/leaderboards/bands/Band_Duets", "tabs": 0,
   "ready": ["waitfor:id=fst.band-rankings.list@20"],
   "after_ready": ["waitgone:id=fst.band-rankings.rank-by-menu@5", "waitfor:id=fst.band-rankings.band-type-menu"]}
]
