# Shop scroll and Settings toggle (local-only preference), then restore it.
route:/shop
wait:3
anims:start
scroll:1200
wait:1.5
shot:{out}/shop-scrolled.png
route:/settings
wait:2.5
?click:css=[role=switch]@2
wait:1
shot:{out}/settings-toggled.png
?click:css=[role=switch]@2
wait:1
scroll:1500
wait:1.2
shot:{out}/settings-scrolled.png
anims:stop:{out}/shop-settings.anims.json
