# Page sweep (settled states only; run pages.steps once first for first-visit carousels).
# Skipped for service safety: player-profile (GET /stats may store tiers), band-detail
# (GET /api/bands/{id} rebuilds rows), player-bands/rival-detail/rivalry (need an identity).
# {out} is the output directory. First visits capture the page's first-run carousel, if any.
?click:text=Dismiss@2   # What's New after an update/fresh profile
# home-redirect
route:/
wait:3.5
?click:testid=fre-close@1
?click:text=Dismiss@0.5
wait:0.8
shot:{out}/home-redirect.png
# songs
route:/songs
wait:3.5
?click:testid=fre-close@1
?click:text=Dismiss@0.5
wait:0.8
shot:{out}/songs.png
# song-detail
route:/songs/75d14ea0-99b6-41a6-8c68-bca89bddded7
wait:3.5
?click:testid=fre-close@1
?click:text=Dismiss@0.5
wait:0.8
shot:{out}/song-detail.png
# song-leaderboard
route:/songs/75d14ea0-99b6-41a6-8c68-bca89bddded7/Solo_Guitar
wait:3.5
?click:testid=fre-close@1
?click:text=Dismiss@0.5
wait:0.8
shot:{out}/song-leaderboard.png
