<UserControl
    x:Class="Festival.App.Controls.LeaderboardEntryRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls">
    <!--
        The one leaderboard row (operator batch 7.7; web entryRow + LeaderboardEntry / RankingEntry): its own frosted
        48 epx row with a 12 epx radius, 4 epx apart in a list (no card around the rows). Columns, left to right:
        rank · name · season or songs label · score or rating (+ Bayesian) · accuracy badge · stars · in-card chevron.
        Which columns show and their widths come from one per-section plan (Festival.Core LeaderboardColumnLayout, issue
        #37), measured over every row of the section and its pinned row, so columns line up vertically like the web; a
        row without a value keeps the column's space. One UIA stop per row (Android one-stop learning): the Button's name reads
        everything, and its parts are Raw so Narrator scan mode doesn't read them a second time. A row without a destination
        (empty account ID) is not hit-testable or tabbable and its peer is Text with no Invoke (issue #63). The selected player's row is purpleHighlight with a purple border and
        bold rank and name. The surface is a Border behind a transparent Button, so hover/press add a white tint on top
        of the frosted fill instead of replacing it.
    -->
    <Grid>
        <!-- Pinned rows float over scrolling rows: an opaque backplate stands in for the web's backdrop blur (no per-frame blur). -->
        <Border x:Name="Backplate" CornerRadius="12" IsHitTestVisible="False" Visibility="Collapsed"
                Background="{ThemeResource FSTFloatingBackplateBrush}" />
        <Border x:Name="Surface" CornerRadius="12" BorderThickness="1" IsHitTestVisible="False"
                Background="{ThemeResource FSTCardSurfaceBrush}" BorderBrush="{ThemeResource FSTCardStrokeBrush}" />
        <controls:LeaderboardRowButton x:Name="RowButton" Click="OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                VerticalAlignment="Stretch" Padding="12,0" MinHeight="48" CornerRadius="12" BorderThickness="0"
                Background="Transparent" SizeChanged="OnSizeChanged">
            <controls:LeaderboardRowButton.Resources>
                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="FSTRowHoverBrush" />
                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="FSTRowPressedBrush" />
                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
            </controls:LeaderboardRowButton.Resources>
            <Grid x:Name="RowGrid" ColumnSpacing="12">
                <!-- Extra lines only when large text in a narrow row moves columns under the name: a rankings songs label
                     (and, when even that leaves no room, the rating; issue #208), or a score row's values (a third line
                     when a pinned season and the score don't fit side by side; issue #207). -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RankColumn" Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="MetaColumn" Width="Auto" />
                    <ColumnDefinition x:Name="ValueColumn" Width="Auto" />
                    <ColumnDefinition x:Name="PillColumn" Width="Auto" />
                    <ColumnDefinition x:Name="StarsColumn" Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RankText" Grid.RowSpan="3" AutomationProperties.AccessibilityView="Raw" VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="NoWrap" />
                <!-- Names truncate, never marquee (web colName; operator batch 7.14). -->
                <TextBlock x:Name="NameText" AutomationProperties.AccessibilityView="Raw" Grid.Column="1" Grid.RowSpan="3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <!-- Season (score rows, ≥ 520 epx like the web) or the small "X / Y" songs label (rankings rows), right-aligned in the shared column. -->
                <TextBlock x:Name="MetaText" AutomationProperties.AccessibilityView="Raw" Grid.Column="2" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <StackPanel x:Name="ValueStack" Grid.Column="3" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="ValueText" AutomationProperties.AccessibilityView="Raw" FontWeight="SemiBold" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="NoWrap" />
                    <TextBlock x:Name="BayesianText" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right"
                               Visibility="Collapsed" />
                </StackPanel>
                <!-- Web AccuracyDisplay: accuracy-tinted pill, or the skewed gold outline for a full combo; sized for at
                     most "XX.X%" (operator batch 7.1). -->
                <Border x:Name="Pill" AutomationProperties.AccessibilityView="Raw" Grid.Column="4" Grid.RowSpan="3" CornerRadius="4" Padding="4,1" Width="58" BorderThickness="2"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="PillText" AutomationProperties.AccessibilityView="Raw" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                </Border>
                <Border x:Name="StarsHost" Grid.Column="5" Grid.RowSpan="3" VerticalAlignment="Center" Visibility="Collapsed">
                    <controls:StarRow x:Name="StarsView" StarSize="14" AutomationProperties.AccessibilityView="Raw" />
                </Border>
                <!-- In-card chevron on rows with a destination (operator batch 7.3). -->
                <FontIcon x:Name="Chevron" Grid.Column="6" Grid.RowSpan="3" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                          AutomationProperties.AccessibilityView="Raw" />
            </Grid>
        </controls:LeaderboardRowButton>
    </Grid>
</UserControl>
