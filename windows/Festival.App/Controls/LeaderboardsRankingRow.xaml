<UserControl
    x:Class="Festival.App.Controls.LeaderboardsRankingRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        One rankings row (account or band): rank, name, songs subtitle, rating (+ Bayesian value).
        The whole row is the target (no chevron); the selected player's row gets the accent fill and border.
    -->
    <Button x:Name="RowButton" Click="OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
            Padding="8,6" MinHeight="44" CornerRadius="6" BorderThickness="1"
            Background="Transparent" BorderBrush="Transparent">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RankText" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Style="{StaticResource FSTSecondaryTextStyle}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="NameText" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock x:Name="SongsText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource FSTSecondaryTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock x:Name="RatingText" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right" />
                <TextBlock x:Name="BayesianText" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right"
                           Foreground="{ThemeResource FSTSecondaryTextBrush}" />
            </StackPanel>
        </Grid>
    </Button>
</UserControl>
