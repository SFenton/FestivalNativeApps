<UserControl
    x:Class="Festival.App.Controls.ServiceStatusView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared failed-read status (service-status control): heading, message, countdown, Retry. -->
    <Border Style="{StaticResource FSTCardStyle}" MaxWidth="480" HorizontalAlignment="Center">
        <StackPanel Spacing="12">
            <TextBlock Text="{x:Bind Status.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                       AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="fst.service-status.title" />
            <TextBlock Text="{x:Bind Status.Message, Mode=OneWay}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{x:Bind Status.CountdownText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                       AutomationProperties.Name="{x:Bind Status.CountdownAnnouncement, Mode=OneWay}"
                       AutomationProperties.AutomationId="fst.service-status.countdown" />
            <Button Content="{x:Bind Status.RetryLabel, Mode=OneWay}" Command="{x:Bind Status.RetryCommand}"
                    Style="{StaticResource AccentButtonStyle}" MinWidth="120" MinHeight="36"
                    AutomationProperties.AutomationId="fst.service-status.retry" />
        </StackPanel>
    </Border>
</UserControl>
