<UserControl
    x:Class="Festival.App.Controls.ServiceStatusView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared failed-read status (service-status control): heading, message, countdown, optional Retry. -->
    <Border Style="{StaticResource FSTCardStyle}" MaxWidth="480" HorizontalAlignment="Center">
        <StackPanel Spacing="12">
            <TextBlock x:Name="TitleBlock" Text="{x:Bind Status.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                       AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind Status.Message, Mode=OneWay}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <!-- Collapsed unless a scrape-freeze countdown runs, so other states have no blank line above Retry. -->
            <TextBlock x:Name="CountdownBlock" Text="{x:Bind Status.CountdownText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                       Visibility="{x:Bind Status.HasCountdown, Mode=OneWay, FallbackValue=Collapsed}"
                       AutomationProperties.Name="{x:Bind Status.CountdownAnnouncement, Mode=OneWay}" />
            <!-- Contrast themes draw the accent button as HighlightText on Highlight; WinUI's automatic
                 adjustment would otherwise paint a Window backplate box behind the label. -->
            <Button x:Name="RetryButton" Content="{x:Bind Status.RetryLabel, Mode=OneWay}" Command="{x:Bind Status.RetryCommand, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" MinWidth="120" MinHeight="{StaticResource FSTMinTargetSize}"
                    Visibility="{x:Bind ShowsRetry, Mode=OneWay}" HighContrastAdjustment="None" />
        </StackPanel>
    </Border>
</UserControl>
