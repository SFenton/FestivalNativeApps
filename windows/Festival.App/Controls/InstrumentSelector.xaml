<UserControl
    x:Class="Festival.App.Controls.InstrumentSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    IsTabStop="False">
    <UserControl.Resources>
        <!-- Web instrument circle: 64 epx, transparent until selected, then a green disc grows behind the 48 epx icon. Under a
             contrast theme the role brushes (Themes/Styles.xaml) give every circle a ButtonText ring (GrayText when disabled,
             Highlight on hover) and a Highlight selected disc, so targets and selection never rest on brand hue alone. -->
        <Style x:Key="FSTInstrumentCircleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="-2" />
            <Setter Property="CornerRadius" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="Root" Background="Transparent" CornerRadius="32">
                            <Ellipse x:Name="Hover" Fill="{ThemeResource FSTInstrumentHoverBrush}" Opacity="0" />
                            <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            <Ellipse x:Name="Ring" Stroke="{ThemeResource FSTInstrumentRingBrush}" StrokeThickness="2" IsHitTestVisible="False" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Hover.Opacity" Value="1" />
                                            <Setter Target="Ring.Stroke" Value="{ThemeResource FSTInstrumentRingHoverBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Hover.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Ring.Stroke" Value="{ThemeResource FSTInstrumentRingDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked" />
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Hover.Opacity" Value="1" />
                                            <Setter Target="Ring.Stroke" Value="{ThemeResource FSTInstrumentRingHoverBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Hover.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="Ring.Stroke" Value="{ThemeResource FSTInstrumentRingDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                    <VisualState x:Name="IndeterminatePointerOver" />
                                    <VisualState x:Name="IndeterminatePressed" />
                                    <VisualState x:Name="IndeterminateDisabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FSTInstrumentArrowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Named UIA group ("Instrument, group"; the UserControl itself has no peer) around the full row, which auto-switches
             to compact arrows when it would not fit. Arrow keys move between circles (XY focus) as well as Tab. -->
        <controls:AccessibleGroup x:Name="Group">
            <Grid>
                <StackPanel x:Name="Row" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center"
                            XYFocusKeyboardNavigation="Enabled" />
                <StackPanel x:Name="CompactRow" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Visibility="Collapsed"
                            XYFocusKeyboardNavigation="Enabled">
                    <Button x:Name="PreviousButton" Style="{StaticResource FSTInstrumentArrowButtonStyle}" Click="OnPrevious"
                            AutomationProperties.Name="Previous instrument" ToolTipService.ToolTip="Previous instrument">
                        <FontIcon Glyph="&#xE76B;" FontSize="14" />
                    </Button>
                    <Border x:Name="CompactHost" />
                    <Button x:Name="NextButton" Style="{StaticResource FSTInstrumentArrowButtonStyle}" Click="OnNext"
                            AutomationProperties.Name="Next instrument" ToolTipService.ToolTip="Next instrument">
                        <FontIcon Glyph="&#xE76C;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </controls:AccessibleGroup>
        <!-- Children expand under the row once an instrument is selected (web instrumentFiltersWrap); they fade in unless
             motion is reduced. -->
        <ContentPresenter x:Name="DetailsPresenter" Visibility="Collapsed" Opacity="0" />
    </StackPanel>
</UserControl>
