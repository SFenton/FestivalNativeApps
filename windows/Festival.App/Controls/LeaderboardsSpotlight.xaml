<UserControl
    x:Class="Festival.App.Controls.LeaderboardsSpotlight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls">
    <!-- Selected player's rank below a board: loading, inline failure, unranked, or their row (+ Jump to your page). -->
    <StackPanel x:Name="Root" Spacing="6" Visibility="{x:Bind Spotlight.IsVisible, Mode=OneWay, FallbackValue=Collapsed}">
        <!-- The neutral loading ring only (implicit ProgressRing style; audit 2026-09-28: no "Loading your rank…" subtitle); UIA keeps the name. -->
        <!-- Floating (Full Rankings footer), the loading, failure and unranked cards get the pinned row's opaque backplate
             under their frosted surface so scrolling rows never show through their text (issue #208). -->
        <!-- The ring sits on a bar-less placeholder of the canonical row, fitted to the board's columns, so the loading row
             is as tall as the pinned row that replaces it at every text size (issue #281; leaderboard-row R2). -->
        <Grid Visibility="{x:Bind Spotlight.ShowLoading, Mode=OneWay, FallbackValue=Collapsed}">
            <controls:LeaderboardEntryRow x:Name="LoadingRow" Row="{x:Bind Spotlight.LoadingRow, Mode=OneWay, FallbackValue={x:Null}}" />
            <ProgressRing x:Name="LoadingRing" IsActive="{x:Bind Spotlight.ShowLoading, Mode=OneWay, FallbackValue=False}" Width="20" Height="20"
                          Margin="12,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                          AutomationProperties.Name="Loading your rank" />
        </Grid>
        <Grid Visibility="{x:Bind Spotlight.ShowFailed, Mode=OneWay, FallbackValue=Collapsed}">
            <Border x:Name="FailedBackplate" CornerRadius="12" IsHitTestVisible="False" Visibility="Collapsed"
                    Background="{ThemeResource FSTFloatingBackplateBrush}" />
            <Border Padding="12,8" CornerRadius="12" BorderThickness="1"
                    Background="{ThemeResource FSTCardSurfaceBrush}" BorderBrush="{ThemeResource FSTCardStrokeBrush}">
                <controls:ServiceStatusInline x:Name="Failed" Status="{x:Bind Spotlight.Status, Mode=OneWay}" />
            </Border>
        </Grid>
        <!-- Board rows are separate frosted rows (operator batch 7.7), so the unranked note sits on the same surface. -->
        <Grid Visibility="{x:Bind Spotlight.ShowUnranked, Mode=OneWay, FallbackValue=Collapsed}">
            <Border x:Name="UnrankedBackplate" CornerRadius="12" IsHitTestVisible="False" Visibility="Collapsed"
                    Background="{ThemeResource FSTFloatingBackplateBrush}" />
            <Border Style="{StaticResource FSTCardStyle}" Padding="12,10" CornerRadius="12">
                <TextBlock x:Name="Unranked" Text="{x:Bind Spotlight.UnrankedText, Mode=OneWay}" Style="{StaticResource FSTSecondaryTextStyle}" />
            </Border>
        </Grid>
        <!-- The pinned row is full width like the board's rows, so its rank, name and value line up with them
             (operator batch 7.9); "Your Page" sits above it instead of taking its width. -->
        <StackPanel x:Name="RowHost" Spacing="4" Visibility="{x:Bind Spotlight.ShowRow, Mode=OneWay, FallbackValue=Collapsed}">
            <Button x:Name="Jump" HorizontalAlignment="Right" MinHeight="32"
                        Background="{ThemeResource FSTCardSurfaceBrush}" BorderBrush="{ThemeResource FSTCardStrokeBrush}" Foreground="{ThemeResource FSTSecondaryTextBrush}"
                    Command="{x:Bind Spotlight.JumpCommand, Mode=OneWay}" Click="OnJumpClick"
                    Visibility="{x:Bind Spotlight.CanJump, Mode=OneWay, FallbackValue=Collapsed}"
                    ToolTipService.ToolTip="Jump to your page" AutomationProperties.Name="Jump to your page">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                    <TextBlock x:Name="JumpText" Text="Your Page" />
                </StackPanel>
            </Button>
            <controls:LeaderboardEntryRow x:Name="PinnedRow" Row="{x:Bind Spotlight.Row, Mode=OneWay}" />
        </StackPanel>
    </StackPanel>
</UserControl>
