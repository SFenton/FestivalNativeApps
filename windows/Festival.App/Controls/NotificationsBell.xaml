<UserControl
    x:Class="Festival.App.Controls.NotificationsBell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels">
    <UserControl.Resources>
        <!-- Web NotificationRow (operator batch 6.34/7.20): leading media rail (song art, else the instrument), title,
             sentence, flag + time, then the unread dot beside the chevron on the trailing edge. -->
        <DataTemplate x:Key="RowTemplate" x:DataType="vm:NotificationRowViewModel">
            <Grid ColumnSpacing="12" Padding="0,8" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                  AutomationProperties.AutomationId="{x:Bind AutomationId}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="44" Height="44" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw">
                    <controls:SongArt Art="{x:Bind Art}" Width="44" Height="44" Visibility="{x:Bind HasArt}" />
                    <controls:InstrumentIcon File="{x:Bind MediaIconFile}" Width="36" Height="36" HorizontalAlignment="Center"
                                             VerticalAlignment="Center" Visibility="{x:Bind HasMediaIcon}" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" Foreground="{ThemeResource FSTSecondaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1" Visibility="{x:Bind HasFlag}">
                            <TextBlock Text="{x:Bind Flag}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                        <TextBlock Text="{x:Bind TimeText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource FSTDeemphasisTextBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorCautionBrush}"
                             Visibility="{x:Bind IsUnread, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
                    <FontIcon Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" Visibility="{x:Bind HasDestination}"
                              AutomationProperties.AccessibilityView="Raw" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Button x:Name="BellButton" Padding="4" Margin="0,0,4,0" Background="Transparent" BorderThickness="0"
            AutomationProperties.Name="{x:Bind Model.BellName, Mode=OneWay}"
            AutomationProperties.AutomationId="fst.shell.notifications"
            ToolTipService.ToolTip="Notifications">
        <!-- The badge sits inside this box (no negative margins): the button's rounded content clip and the title-bar row
             would otherwise cut its top and right edge. MinWidth lets "99+" grow leftwards over the bell. -->
        <Grid MinWidth="36" Height="32">
            <FontIcon Glyph="&#xEA8F;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                      AutomationProperties.AccessibilityView="Raw" />
            <InfoBadge Value="{x:Bind Model.UnreadCount, Mode=OneWay}" Visibility="{x:Bind Model.HasUnread, Mode=OneWay}"
                       HorizontalAlignment="Right" VerticalAlignment="Top" MaxHeight="16"
                       AutomationProperties.AccessibilityView="Raw" />
        </Grid>
        <Button.Flyout>
            <Flyout x:Name="Panel" Placement="BottomEdgeAlignedRight" Opening="OnOpening" Closed="OnClosed">
                <Grid Width="380" MaxHeight="560" RowSpacing="8" AutomationProperties.AutomationId="fst.notifications.sheet">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Notifications" Style="{StaticResource FSTSectionHeaderStyle}" Margin="0" AutomationProperties.HeadingLevel="Level2" />

                    <StackPanel Grid.Row="1" Spacing="12" Visibility="{x:Bind Model.IsNoPlayer, Mode=OneWay}" Padding="0,8"
                                AutomationProperties.AutomationId="fst.notifications.no-player">
                        <TextBlock Text="Select a player profile to see their notifications." TextWrapping="Wrap" />
                    </StackPanel>
                    <ProgressRing Grid.Row="1" IsActive="{x:Bind Model.IsLoading, Mode=OneWay}" Visibility="{x:Bind Model.IsLoading, Mode=OneWay}"
                                  HorizontalAlignment="Center" Margin="0,24" AutomationProperties.Name="Loading notifications" />
                    <StackPanel Grid.Row="1" Spacing="12" Visibility="{x:Bind Model.IsFailed, Mode=OneWay}" Padding="0,8"
                                AutomationProperties.AutomationId="fst.notifications.failed">
                        <TextBlock Text="{x:Bind Model.ErrorText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <Button Content="Retry" Command="{x:Bind Model.RefreshCommand}" Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.AutomationId="fst.notifications.retry" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="6" Visibility="{x:Bind Model.IsEmpty, Mode=OneWay}" Padding="0,8"
                                AutomationProperties.AutomationId="fst.notifications.empty">
                        <TextBlock Text="{x:Bind Model.EmptyTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Model.EmptyBody, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource FSTSecondaryTextBrush}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Visibility="{x:Bind Model.IsLoaded, Mode=OneWay}" Padding="0,0,12,0"
                                  AutomationProperties.AutomationId="fst.notifications.list">
                        <StackPanel Spacing="4">
                            <TextBlock Text="New" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="White" Visibility="{x:Bind Model.HasNew, Mode=OneWay}"
                                       AutomationProperties.HeadingLevel="Level3" />
                            <ListView ItemsSource="{x:Bind Model.NewItems, Mode=OneWay}" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="64" ItemTemplate="{StaticResource RowTemplate}"
                                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnRowClick" ScrollViewer.VerticalScrollMode="Disabled"
                                      Visibility="{x:Bind Model.HasNew, Mode=OneWay}" AutomationProperties.Name="New notifications" />
                            <TextBlock Text="Older" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="White" Visibility="{x:Bind Model.HasOlder, Mode=OneWay}"
                                       AutomationProperties.HeadingLevel="Level3" />
                            <ListView ItemsSource="{x:Bind Model.OlderItems, Mode=OneWay}" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="64" ItemTemplate="{StaticResource RowTemplate}"
                                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnRowClick" ScrollViewer.VerticalScrollMode="Disabled"
                                      Visibility="{x:Bind Model.HasOlder, Mode=OneWay}" AutomationProperties.Name="Older notifications" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
