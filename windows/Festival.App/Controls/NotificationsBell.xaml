<UserControl
    x:Class="Festival.App.Controls.NotificationsBell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels">
    <UserControl.Resources>
        <!-- Web NotificationRow (operator batch 6.34/7.20, issues #76, #272). The ListViewItem is the card (container style
             below): web surfaceSubtle fill, 1 epx borderSubtle stroke, 10 epx radius and padding, 8 epx apart, so hover, press
             and the focus rectangle follow the card. Inside: a 64 epx media rail (54 epx song art; 44 epx art above a
             two-column grid of 18 epx instrument icons when the row touches several charts; else a 36 epx instrument icon), a
             one-line marquee title, the white message with the web's bold values (statement-style clauses on their own
             paragraphs) and the colour-coded flag pills (one wrapping line, or one line per chart behind a 20 epx icon on
             multi-chart rows; no visible time, like the web), then a 20 epx trailing column with the centred chevron and
             the 9 epx gold unread dot 24 epx above its centre. Media, dot and chevron are decorative (Raw); the ListViewItem
             carries the name and AutomationId (OnContainerContentChanging), so Narrator reads one item instead of an item
             plus a nested group. -->
        <DataTemplate x:Key="RowTemplate" x:DataType="vm:NotificationRowViewModel">
            <Border Margin="4,2" BorderBrush="{ThemeResource FSTNotificationRowStrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="64" MinHeight="64" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                        <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind HasArt}">
                            <controls:SongArt Art="{x:Bind Art}" Width="{x:Bind ArtSize}" Height="{x:Bind ArtSize}" HorizontalAlignment="Center" />
                            <Grid HorizontalAlignment="Center" Visibility="{x:Bind HasGrid}"
                                  controls:NotificationRowVisuals.IconFiles="{x:Bind GridIconFiles}" />
                        </StackPanel>
                        <controls:InstrumentIcon File="{x:Bind MediaIconFile}" Width="36" Height="36" HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" Visibility="{x:Bind HasMediaIcon}"
                                                 AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <controls:MarqueeText Text="{x:Bind Title}" TextStyle="{StaticResource FSTMarqueeTitleStyle}" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock controls:NotificationRowVisuals.Parts="{x:Bind MessageParts}" TextWrapping="Wrap" />
                        <StackPanel controls:NotificationRowVisuals.Flags="{x:Bind Presentation}" Visibility="{x:Bind HasFlags}" />
                    </StackPanel>
                    <Grid Grid.Column="2" Width="20" Margin="2,0,0,0" AutomationProperties.AccessibilityView="Raw"
                          Visibility="{x:Bind HasTrailing, Mode=OneWay}">
                        <FontIcon Glyph="&#xE76C;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="{x:Bind HasDestination}" AutomationProperties.AccessibilityView="Raw" />
                        <Ellipse Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{ThemeResource FSTNotificationUnreadDotBrush}"
                                 Visibility="{x:Bind IsUnread, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw">
                            <Ellipse.RenderTransform>
                                <TranslateTransform Y="-24" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- The row card (see RowTemplate): the ListViewItem's presenter draws the fill, so hover/press keep the card shape.
             Its default template binds neither BorderBrush, BorderThickness nor CornerRadius (the radius is the
             ListViewItemCornerRadius theme resource, overridden in each ListView), so the template's root Border draws the
             stroke and padding. The presenter insets its rounded fill 4,2 epx, so the Border does too and the 4 epx item
             margin leaves the web's 8 epx between cards. -->
        <Style x:Key="RowContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Background" Value="{ThemeResource FSTNotificationRowSurfaceBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Button x:Name="BellButton" Padding="4" Margin="0,0,4,0" Background="Transparent" BorderThickness="0"
            MinWidth="{StaticResource FSTMinTargetSize}" MinHeight="{StaticResource FSTMinTargetSize}"
            AutomationProperties.Name="{x:Bind Model.BellName, Mode=OneWay}"
            AutomationProperties.AutomationId="fst.shell.notifications"
            ToolTipService.ToolTip="Notifications">
        <!-- The badge sits inside this box (no negative margins): the button's rounded content clip and the title-bar row
             would otherwise cut its top and right edge. MinWidth lets "99+" grow leftwards over the bell. -->
        <Grid MinWidth="36" Height="32">
            <FontIcon Glyph="&#xEA8F;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                      AutomationProperties.AccessibilityView="Raw" />
            <!-- A fixed 16 epx indicator: scaled text would spill out of it and hide the bell (the count is in the bell's UIA name).
                 Its count opts out of the contrast-theme text backplate (OnBadgeLayout): InfoBadge already pairs
                 HighlightText with Highlight there, and the backplate drew a clipped dark box inside the circle (issue #253). -->
            <InfoBadge x:Name="UnreadBadge" Value="{x:Bind Model.UnreadCount, Mode=OneWay}" Visibility="{x:Bind Model.HasUnread, Mode=OneWay}"
                       HorizontalAlignment="Right" VerticalAlignment="Top" MaxHeight="16" IsTextScaleFactorEnabled="False"
                       HighContrastAdjustment="None" Loaded="OnBadgeLayout" SizeChanged="OnBadgeLayout"
                       AutomationProperties.AccessibilityView="Raw" />
        </Grid>
        <Button.Flyout>
            <Flyout x:Name="Panel" Placement="BottomEdgeAlignedRight" Opening="OnOpening" Opened="OnOpened" Closed="OnClosed">
                <Grid x:Name="PanelRoot" Width="380" MaxHeight="560" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Panels have no UIA peer, so the state IDs sit on each state's first text (like the Shop's empty/hidden headings). -->
                    <TextBlock Text="Notifications" Style="{StaticResource FSTSectionHeaderStyle}" Margin="0" AutomationProperties.HeadingLevel="Level2"
                               AutomationProperties.AutomationId="fst.notifications.sheet" />

                    <StackPanel Grid.Row="1" Spacing="12" Visibility="{x:Bind Model.IsNoPlayer, Mode=OneWay}" Padding="0,8">
                        <TextBlock Text="Select a player profile to see their notifications." TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="fst.notifications.no-player" />
                    </StackPanel>
                    <ProgressRing Grid.Row="1" IsActive="{x:Bind Model.IsLoading, Mode=OneWay}" Visibility="{x:Bind Model.IsLoading, Mode=OneWay}"
                                  HorizontalAlignment="Center" Margin="0,24" AutomationProperties.Name="Loading notifications"
                                  AutomationProperties.AutomationId="fst.notifications.loading" />
                    <StackPanel Grid.Row="1" Spacing="12" Visibility="{x:Bind Model.IsFailed, Mode=OneWay}" Padding="0,8">
                        <TextBlock Text="{x:Bind Model.ErrorText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.AutomationId="fst.notifications.failed" />
                        <Button Content="Retry" Command="{x:Bind Model.RefreshCommand}" Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.AutomationId="fst.notifications.retry" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="6" Visibility="{x:Bind Model.IsEmpty, Mode=OneWay}" Padding="0,8">
                        <TextBlock Text="{x:Bind Model.EmptyTitle}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   AutomationProperties.AutomationId="fst.notifications.empty" />
                        <TextBlock Text="{x:Bind Model.EmptyBody, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource FSTSecondaryTextBrush}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Visibility="{x:Bind Model.IsLoaded, Mode=OneWay}" Padding="0,0,12,0"
                                  AutomationProperties.AutomationId="fst.notifications.list">
                        <StackPanel Spacing="4">
                            <TextBlock Text="New" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource FSTSectionHeaderBrush}" Visibility="{x:Bind Model.HasNew, Mode=OneWay}"
                                       AutomationProperties.HeadingLevel="Level3" />
                            <ListView ItemsSource="{x:Bind Model.NewItems, Mode=OneWay}" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="94" ItemTemplate="{StaticResource RowTemplate}" ItemContainerStyle="{StaticResource RowContainerStyle}"
                                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnRowClick" ScrollViewer.VerticalScrollMode="Disabled"
                                      ContainerContentChanging="OnContainerContentChanging"
                                      Visibility="{x:Bind Model.HasNew, Mode=OneWay}" AutomationProperties.Name="New notifications">
                                <ListView.Resources>
                                    <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="FSTNotificationRowPointerOverBrush" />
                                    <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="FSTNotificationRowPressedBrush" />
                                    <CornerRadius x:Key="ListViewItemCornerRadius">10</CornerRadius>
                                </ListView.Resources>
                            </ListView>
                            <TextBlock Text="Older" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource FSTSectionHeaderBrush}" Visibility="{x:Bind Model.HasOlder, Mode=OneWay}"
                                       AutomationProperties.HeadingLevel="Level3" />
                            <ListView ItemsSource="{x:Bind Model.OlderItems, Mode=OneWay}" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="94" ItemTemplate="{StaticResource RowTemplate}" ItemContainerStyle="{StaticResource RowContainerStyle}"
                                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnRowClick" ScrollViewer.VerticalScrollMode="Disabled"
                                      ContainerContentChanging="OnContainerContentChanging"
                                      Visibility="{x:Bind Model.HasOlder, Mode=OneWay}" AutomationProperties.Name="Older notifications">
                                <ListView.Resources>
                                    <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="FSTNotificationRowPointerOverBrush" />
                                    <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="FSTNotificationRowPressedBrush" />
                                    <CornerRadius x:Key="ListViewItemCornerRadius">10</CornerRadius>
                                </ListView.Resources>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
