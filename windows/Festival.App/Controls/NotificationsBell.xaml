<UserControl
    x:Class="Festival.App.Controls.NotificationsBell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls">

    <Button x:Name="BellButton" Padding="4" Margin="0,0,4,0" Background="Transparent" BorderThickness="0"
            MinWidth="{StaticResource FSTMinTargetSize}" MinHeight="{StaticResource FSTMinTargetSize}"
            AutomationProperties.Name="{x:Bind Model.BellName, Mode=OneWay}"
            AutomationProperties.AutomationId="fst.shell.notifications"
            ToolTipService.ToolTip="Notifications" Click="OnBellClick">
        <!-- The badge sits inside this box (no negative margins): the button's rounded content clip and the title-bar row
             would otherwise cut its top and right edge. MinWidth lets "99+" grow leftwards over the bell. -->
        <Grid MinWidth="36" Height="32">
            <FontIcon Glyph="&#xEA8F;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                      AutomationProperties.AccessibilityView="Raw" />
            <!-- A fixed 16 epx indicator: scaled text would spill out of it and hide the bell (the count is in the bell's UIA name).
                 Its count opts out of the contrast-theme text backplate (OnBadgeLayout): InfoBadge already pairs
                 HighlightText with Highlight there, and the backplate drew a clipped dark box inside the circle (issue #253). -->
            <InfoBadge x:Name="UnreadBadge" Value="{x:Bind Model.UnreadCount, Mode=OneWay}" Visibility="{x:Bind Model.HasUnread, Mode=OneWay}"
                       HorizontalAlignment="Right" VerticalAlignment="Top" MaxHeight="16" IsTextScaleFactorEnabled="False"
                       HighContrastAdjustment="None" Loaded="OnBadgeLayout" SizeChanged="OnBadgeLayout"
                       AutomationProperties.AccessibilityView="Raw" />
        </Grid>
    </Button>
</UserControl>
