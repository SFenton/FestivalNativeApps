<UserControl
    x:Class="Festival.App.Controls.RivalRowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Festival.App.Controls"
    IsTabStop="False">
    <!-- Web RivalRow: tint bar; name (+ leaderboard rank); "ahead"/"behind" pills across the full width. No shared-song
         count (owner decision, issues #40/#67): it is always ahead + behind. -->
    <Grid ColumnSpacing="12" MinHeight="52">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="4" CornerRadius="2" Margin="0,4" Background="{x:Bind local:RivalsUi.Accent(Item.IsWinning), Mode=OneWay}" />
        <Grid Grid.Column="1" RowSpacing="4" ColumnSpacing="8" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Item.RankText, Mode=OneWay}" Visibility="{x:Bind Item.HasRank, Mode=OneWay}"
                       Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource FSTSecondaryTextBrush}" />
            <TextBlock Grid.Column="1" Text="{x:Bind Item.Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <local:WrapPanel Grid.Row="1" Grid.ColumnSpan="2">
                <Border Style="{StaticResource FSTRivalPillStyle}" Background="{ThemeResource FSTRivalWinFillBrush}"
                        BorderBrush="{ThemeResource FSTRivalWinStrokeBrush}">
                    <TextBlock Text="{x:Bind Item.AheadText, Mode=OneWay}" Style="{StaticResource FSTRivalPillTextStyle}"
                               Foreground="{ThemeResource FSTRivalWinTextBrush}" />
                </Border>
                <Border Style="{StaticResource FSTRivalPillStyle}" Background="{ThemeResource FSTRivalLoseFillBrush}"
                        BorderBrush="{ThemeResource FSTRivalLoseStrokeBrush}">
                    <TextBlock Text="{x:Bind Item.BehindText, Mode=OneWay}" Style="{StaticResource FSTRivalPillTextStyle}"
                               Foreground="{ThemeResource FSTRivalLoseTextBrush}" />
                </Border>
            </local:WrapPanel>
        </Grid>
        <!-- In-card chevron: the row opens a page (batch 7.3). -->
        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"
                  Foreground="{ThemeResource FSTSecondaryTextBrush}" AutomationProperties.AccessibilityView="Raw" />
    </Grid>
</UserControl>
