<UserControl
    x:Class="Festival.App.Controls.LeaderboardsPager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Web Paginator + LeaderboardPaginationFooter (operator batch 6.30): round 40 epx card-surface buttons with chevrons
        (double chevrons for first/last) either side of a small "page / total" badge; no plate behind them.
    -->
    <UserControl.Resources>
        <Style x:Key="PagerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="{ThemeResource FSTCardSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource FSTCardStrokeBrush}" />
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
        <Button x:Name="First" Style="{StaticResource PagerButtonStyle}" ToolTipService.ToolTip="First page"
                AutomationProperties.Name="First page">
            <Grid>
                <FontIcon Glyph="&#xE76B;" FontSize="12" Margin="0,0,8,0" />
                <FontIcon Glyph="&#xE76B;" FontSize="12" Margin="8,0,0,0" />
            </Grid>
        </Button>
        <Button x:Name="Previous" Style="{StaticResource PagerButtonStyle}" ToolTipService.ToolTip="Previous page"
                AutomationProperties.Name="Previous page">
            <FontIcon Glyph="&#xE76B;" FontSize="14" />
        </Button>
        <Border Height="40" Padding="20,0" CornerRadius="6" BorderThickness="1" MinWidth="88"
                Background="{ThemeResource FSTCardSurfaceBrush}" BorderBrush="{ThemeResource FSTCardStrokeBrush}">
            <TextBlock x:Name="Info" VerticalAlignment="Center" TextAlignment="Center" FontSize="13"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>
        <Button x:Name="Next" Style="{StaticResource PagerButtonStyle}" ToolTipService.ToolTip="Next page"
                AutomationProperties.Name="Next page">
            <FontIcon Glyph="&#xE76C;" FontSize="14" />
        </Button>
        <Button x:Name="Last" Style="{StaticResource PagerButtonStyle}" ToolTipService.ToolTip="Last page"
                AutomationProperties.Name="Last page">
            <Grid>
                <FontIcon Glyph="&#xE76C;" FontSize="12" Margin="0,0,8,0" />
                <FontIcon Glyph="&#xE76C;" FontSize="12" Margin="8,0,0,0" />
            </Grid>
        </Button>
    </StackPanel>
</UserControl>
