<UserControl
    x:Class="Festival.App.Controls.SongRowCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Festival.App.Controls"
    IsTabStop="False">
    <!--
        The shared song row card (Songs list, Item Shop list): card surface, 44 epx art with the optional Item Shop bag,
        marquee title and subtitle, a trailing slot, a wrapped second-row slot and the pulsing Item Shop ring. Pages fill
        the slots during phased realization; the list item carries the row's UIA name, so every part here is decorative.
    -->
    <Grid x:Name="Card" MinHeight="64" Padding="10,8,14,8" ColumnSpacing="12" CornerRadius="8"
          BorderThickness="1" Background="{ThemeResource FSTCardSurfaceBrush}" BorderBrush="{ThemeResource FSTCardStrokeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Spans the wrapped second row only while it has content (SetWrapped): a Grid shares a spanning child's height
             across Auto rows, so an empty second row got half the art's height as dead space (operator batch 6.3). -->
        <Grid x:Name="ArtHost" Width="44" Height="44" VerticalAlignment="Center">
            <Border CornerRadius="6" Background="{StaticResource FSTSurfaceMutedBrush}">
                <Image x:Name="ArtImage" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
            </Border>
            <!-- Item Shop bag on songs in the Shop, coloured like the row's pulse (operator batch 7.19);
                 the row's UIA name already carries the Shop state. -->
            <Border x:Name="ShopBadge" Width="18" Height="18" CornerRadius="9" Margin="0,0,-5,-5"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"
                    BorderThickness="1.5" BorderBrush="#FF121826" AutomationProperties.AccessibilityView="Raw">
                <FontIcon x:Name="ShopBadgeGlyph" Glyph="&#xE719;" FontSize="10" Foreground="#FF121826" />
            </Border>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <local:MarqueeText x:Name="TitleText" TextStyle="{StaticResource FSTMarqueeTitleStyle}" />
            <local:MarqueeText x:Name="SubtitleText" TextStyle="{StaticResource FSTMarqueeSecondaryStyle}" />
        </StackPanel>
        <StackPanel x:Name="TrailingPanel" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
        <local:FlowPanel x:Name="SecondaryPanel" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0" Visibility="Collapsed" />
        <!-- Pulsing Item Shop ring over the card edge (green in Shop, gold New, red Leaving). -->
        <local:ShopPulseRing x:Name="ShopRing" Grid.RowSpan="2" Grid.ColumnSpan="3" Margin="-11,-9,-15,-9" />
    </Grid>
</UserControl>
