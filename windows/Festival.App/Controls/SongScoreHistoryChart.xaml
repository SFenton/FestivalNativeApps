<UserControl
    x:Class="Festival.App.Controls.SongScoreHistoryChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <UserControl.Resources>
        <!-- A bar is a bare toggle button (web PressableChartPath; pressed = selected): the fill is its content, focus uses
             the system visual. -->
        <Style x:Key="FSTChartBarButtonStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="8">
        <!-- Each bar is a tab stop; Left/Right also move between bars. -->
        <Canvas x:Name="Plot" Height="260" TabFocusNavigation="Local" XYFocusKeyboardNavigation="Enabled"
                AutomationProperties.AutomationId="fst.history.chart" />
        <!-- Legend (web Legend content): accuracy gradient, gold FC, blue score line (contrast themes: the chart roles). -->
        <StackPanel x:Name="Legend" Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center" Margin="0,8,0,0"
                    AutomationProperties.AccessibilityView="Raw">
            <StackPanel x:Name="LegendAccuracy" Orientation="Horizontal" Spacing="8">
                <Rectangle Width="20" Height="12" RadiusX="2" RadiusY="2" VerticalAlignment="Center"
                           Fill="{ThemeResource FSTChartAccuracyLegendBrush}" Stroke="{ThemeResource FSTChartBarStrokeBrush}" />
                <TextBlock Text="Accuracy" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
            </StackPanel>
            <StackPanel x:Name="LegendFc" Orientation="Horizontal" Spacing="8">
                <Rectangle Width="20" Height="12" RadiusX="2" RadiusY="2" Fill="{ThemeResource FSTChartFcBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Accuracy (FC)" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Canvas Width="24" Height="12" VerticalAlignment="Center">
                    <Line X1="0" Y1="6" X2="18" Y2="6" Stroke="{ThemeResource FSTChartLineBrush}" StrokeThickness="2" />
                    <Ellipse Canvas.Left="15" Canvas.Top="3" Width="6" Height="6" Fill="{ThemeResource FSTChartLineBrush}" />
                </Canvas>
                <TextBlock Text="Score" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
