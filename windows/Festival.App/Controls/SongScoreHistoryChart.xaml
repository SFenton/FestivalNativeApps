<UserControl
    x:Class="Festival.App.Controls.SongScoreHistoryChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <UserControl.Resources>
        <!-- A bar is a bare button (web PressableChartPath): the fill is its content, focus uses the system visual. -->
        <Style x:Key="FSTChartBarButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="8">
        <Canvas x:Name="Plot" Height="260" />
        <!-- Legend (web Legend content): accuracy gradient, gold FC, blue score line. -->
        <StackPanel x:Name="Legend" Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center" Margin="0,8,0,0"
                    AutomationProperties.AccessibilityView="Raw">
            <StackPanel x:Name="LegendAccuracy" Orientation="Horizontal" Spacing="8">
                <Rectangle Width="20" Height="12" RadiusX="2" RadiusY="2" VerticalAlignment="Center">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFDC2828" Offset="0" />
                            <GradientStop Color="#FF2ECC71" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock Text="Accuracy" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="LegendFc" Orientation="Horizontal" Spacing="8">
                <Rectangle Width="20" Height="12" RadiusX="2" RadiusY="2" Fill="#FFFFD700" VerticalAlignment="Center" />
                <TextBlock Text="Accuracy (FC)" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Canvas Width="24" Height="12" VerticalAlignment="Center">
                    <Line X1="0" Y1="6" X2="18" Y2="6" Stroke="#FF4C7DFF" StrokeThickness="2" />
                    <Ellipse Canvas.Left="15" Canvas.Top="3" Width="6" Height="6" Fill="#FF4C7DFF" />
                </Canvas>
                <TextBlock Text="Score" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
