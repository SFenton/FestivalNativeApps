<UserControl
    x:Class="Festival.App.Controls.PlayerProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels">
    <!--
        Player profile body shared by /player/:accountId and the Statistics section (web PlayerPage). Separate cards like
        the web: the player's name as the page title (no avatar or card, issue #97) with Select/Switch/Deselect (never
        navigates), Overview stat cards, then per Settings-visible instrument a header, its Rank History card, its stat cards and its Percentiles table card, then the inline Bands section (issue #312).
    -->
    <UserControl.Resources>
        <DataTemplate x:Key="StatTileTemplate" x:DataType="vm:PlayerStatTile">
            <controls:PlayerStatTileView Tile="{x:Bind}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ScrollViewer x:Name="Scroller" Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}" AutomationProperties.AutomationId="fst.player.available">
            <StackPanel Padding="24,12,24,32" Spacing="12" MaxWidth="1280">
                <!-- Page title (issue #97): the player's name as a plain H1 like other pages' titles, with no avatar or card;
                     Select/Deselect, Quick Links and the selection notices sit under it. The actions wrap (like the Rivals
                     header's Commands) so Quick Links moves to its own line instead of clipping at large text sizes (#285). -->
                <StackPanel x:Name="TitleRow" Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" Style="{StaticResource FSTPageTitleStyle}"
                               TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1"
                               AutomationProperties.AutomationId="fst.player.name" />
                    <controls:WrapPanel x:Name="TitleActions" HorizontalSpacing="8" VerticalSpacing="8">
                        <Button Content="{x:Bind ViewModel.SelectLabel, Mode=OneWay}" Click="OnSelectClick"
                                Style="{StaticResource AccentButtonStyle}" MinHeight="{StaticResource FSTMinTargetSize}"
                                Visibility="{x:Bind ViewModel.CanSelect, Mode=OneWay}"
                                AutomationProperties.AutomationId="fst.player.select" />
                        <Button Content="Deselect Profile" Click="OnDeselectClick" MinHeight="{StaticResource FSTMinTargetSize}" FontWeight="SemiBold"
                                Background="{ThemeResource FSTDangerBackgroundBrush}" Foreground="{ThemeResource FSTDangerForegroundBrush}"
                                BorderBrush="{ThemeResource FSTDangerBorderBrush}"
                                Visibility="{x:Bind ViewModel.CanDeselect, Mode=OneWay}"
                                AutomationProperties.AutomationId="fst.player.deselect">
                            <Button.Resources>
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="FSTDangerBackgroundPointerOverBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="FSTDangerBackgroundPressedBrush" />
                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="FSTDangerForegroundPointerOverBrush" />
                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="FSTDangerForegroundPressedBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="FSTDangerBorderPointerOverBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="FSTDangerBorderPressedBrush" />
                            </Button.Resources>
                        </Button>
                        <controls:QuickLinksMenuButton x:Name="QuickLinksMenu" MinHeight="{StaticResource FSTMinTargetSize}" />
                    </controls:WrapPanel>
                    <TextBlock Text="{x:Bind ViewModel.IdentityNotice, Mode=OneWay}" TextWrapping="Wrap"
                               Foreground="{ThemeResource FSTEmphasisBrush}"
                               Visibility="{x:Bind ViewModel.HasIdentityNotice, Mode=OneWay}"
                               AutomationProperties.AutomationId="fst.player.identity-notice" />
                    <TextBlock Text="{x:Bind ViewModel.ActionError, Mode=OneWay}" TextWrapping="Wrap"
                               Foreground="{ThemeResource FSTEmphasisBrush}" AutomationProperties.LiveSetting="Assertive"
                               Visibility="{x:Bind ViewModel.HasActionError, Mode=OneWay}"
                               AutomationProperties.AutomationId="fst.player.action-error" />
                </StackPanel>

                <!-- Overview: one card per stat -->
                <TextBlock x:Name="OverviewHeading" Text="Overview" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2"
                           AutomationProperties.AutomationId="fst.player.overview" controls:QuickLinkAnchor.Id="global" />
                <ItemsRepeater x:Name="OverviewGrid" controls:TextScaleLayout.ScaleWithText="True" ItemsSource="{x:Bind ViewModel.Overview, Mode=OneWay}"
                               ItemTemplate="{StaticResource StatTileTemplate}"
                               TabFocusNavigation="Local" XYFocusKeyboardNavigation="Enabled">
                    <ItemsRepeater.Layout>
                        <!-- Stat grid (Apple AP3 StatGridColumns): 2 columns at compact, up to 4 wider. -->
                        <UniformGridLayout MinItemWidth="180" MinItemHeight="88" MinColumnSpacing="8" MinRowSpacing="8" MaximumRowsOrColumns="4" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

                <!-- Per-instrument sections -->
                <ItemsRepeater x:Name="InstrumentsRepeater" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="480" TabFocusNavigation="Local" XYFocusKeyboardNavigation="Enabled" ItemsSource="{x:Bind ViewModel.Instruments, Mode=OneWay}" ElementPrepared="OnInstrumentPrepared">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="20" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlayerInstrumentViewModel">
                            <!-- Named group: its tiles and percentile rows repeat Overview/other-instrument names ("Songs Played: 2"),
                                 which Axe flags as ambiguous focusable siblings without a per-instrument parent. -->
                            <controls:AccessibleGroup controls:QuickLinkAnchor.Id="{x:Bind QuickLinkId}" AutomationProperties.Name="{x:Bind Label}"
                                                      AutomationProperties.AutomationId="{x:Bind controls:PlayerProfileView.SectionId(AutomationKey)}">
                            <StackPanel Spacing="12">
                                <!-- Instrument header above its cards (web InstrumentHeader MD) -->
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                                    <controls:InstrumentIcon File="{x:Bind IconFile}" Label="{x:Bind Label}" Width="36" Height="36"
                                                             AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource FSTSectionHeaderStyle}" Margin="0"
                                               VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2"
                                               AutomationProperties.AutomationId="{x:Bind controls:PlayerProfileView.InstrumentId(AutomationKey)}" />
                                </StackPanel>

                                <!-- Empty state (web InstrumentEmptyState) -->
                                <Border Style="{StaticResource FSTCardStyle}" Visibility="{x:Bind IsEmpty}">
                                    <TextBlock Text="{x:Bind EmptyText}" Style="{StaticResource FSTSecondaryTextStyle}" TextWrapping="Wrap"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               AutomationProperties.AutomationId="{x:Bind controls:PlayerProfileView.EmptyId(AutomationKey)}" />
                                </Border>

                                <!-- Rank History card (web RankHistoryChart in GraphCard). Fixed-height placeholder while loading. -->
                                <Border Style="{StaticResource FSTCardStyle}" Visibility="{x:Bind ShowRankHistoryCard, Mode=OneWay}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Rank History" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level3" />
                                        <TextBlock Text="Total Score rank over the last 30 days" Style="{StaticResource FSTSecondaryTextStyle}" FontSize="12" />
                                        <Grid MinHeight="376">
                                            <ProgressRing IsActive="{x:Bind RankHistoryLoading, Mode=OneWay}" Visibility="{x:Bind RankHistoryLoading, Mode=OneWay}"
                                                          Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          AutomationProperties.Name="{x:Bind controls:PlayerProfileView.LoadingHistoryName(Label)}"
                                                          AutomationProperties.AutomationId="{x:Bind controls:PlayerProfileView.RankHistoryLoadingId(AutomationKey)}" />
                                            <StackPanel Spacing="6" Visibility="{x:Bind HasRankHistory, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind RankHistory.Headline, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind RankHistory.TotalScoreLine, Mode=OneWay}" Style="{StaticResource FSTSecondaryTextStyle}" />
                                                <!-- One combined chart (web RankHistoryChart): rank-coloured Total Score bars + rank line, paged. -->
                                                <controls:RankHistoryGraph Model="{x:Bind RankHistory.Combined, Mode=OneWay}" Margin="0,4,0,0"
                                                                           AutomationProperties.AutomationId="{x:Bind controls:PlayerProfileView.RankHistoryId(AutomationKey)}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Visibility="{x:Bind RankHistoryFailed, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind RankHistoryError, Mode=OneWay}" Style="{StaticResource FSTSecondaryTextStyle}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="360" />
                                                <Button Content="Retry" Command="{x:Bind LoadRankHistoryCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Stat cards (global-rank tiles included, placeholders until the read lands) -->
                                <ItemsRepeater controls:TextScaleLayout.ScaleWithText="True" ItemsSource="{x:Bind Stats}" Visibility="{x:Bind HasScores}"
                                               ItemTemplate="{StaticResource StatTileTemplate}"
                                               TabFocusNavigation="Local" XYFocusKeyboardNavigation="Enabled">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="180" MinItemHeight="88" MinColumnSpacing="8" MinRowSpacing="8" MaximumRowsOrColumns="4" ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind RankFailed, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind RankError, Mode=OneWay}" Style="{StaticResource FSTSecondaryTextStyle}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="360" />
                                    <Button Content="Retry" Command="{x:Bind LoadRankCommand}" />
                                </StackPanel>

                                <!-- Percentiles table card (web PlayerPercentileTable) -->
                                <Border Style="{StaticResource FSTCardStyle}" Padding="0" Visibility="{x:Bind HasPercentiles}">
                                    <StackPanel>
                                        <Grid Padding="16,12" BorderBrush="{ThemeResource FSTCardStrokeBrush}" BorderThickness="0,0,0,1">
                                            <TextBlock Text="PERCENTILE" FontSize="12" FontWeight="SemiBold" CharacterSpacing="60"
                                                       Foreground="{ThemeResource FSTSecondaryTextBrush}" AutomationProperties.HeadingLevel="Level3"
                                                       AutomationProperties.Name="Percentiles"
                                                       AutomationProperties.AutomationId="{x:Bind controls:PlayerProfileView.PercentilesId(AutomationKey)}" />
                                            <TextBlock Text="SONGS" FontSize="12" FontWeight="SemiBold" CharacterSpacing="60" HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource FSTSecondaryTextBrush}" AutomationProperties.AccessibilityView="Raw" />
                                        </Grid>
                                        <ItemsRepeater ItemsSource="{x:Bind Percentiles}" TabFocusNavigation="Local" XYFocusKeyboardNavigation="Enabled">
                                            <ItemsRepeater.Layout>
                                                <StackLayout />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PlayerPercentileRow">
                                                    <Border BorderBrush="{ThemeResource FSTCardStrokeBrush}" BorderThickness="0,0,0,1">
                                                        <controls:PlayerPercentileRowView Row="{x:Bind}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </controls:AccessibleGroup>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Bands (web PlayerBandsSection, issue #312): "{name}'s Bands" with a View All link, then Duos/Trios/Quads groups of
                     up to six band cards (BandCardView, as on Player Bands), a No Bands Yet card when empty and View All Bands (N)
                     when the group has more. Read per group after the profile shows; never holds the page spinner. -->
                <controls:AccessibleGroup Margin="0,8,0,0" controls:QuickLinkAnchor.Id="bands"
                                          AutomationProperties.Name="{x:Bind ViewModel.Bands.Title, Mode=OneWay}"
                                          AutomationProperties.AutomationId="fst.player.bands-section">
                    <StackPanel Spacing="12">
                        <!-- Header with the title-row View All link (section-headers R8; same link as the Rivals hub sections). -->
                        <Grid ColumnSpacing="10" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.Bands.Title, Mode=OneWay}" Style="{StaticResource FSTSectionHeaderStyle}" Margin="0"
                                       VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"
                                       AutomationProperties.AutomationId="fst.player.bands" />
                            <HyperlinkButton Grid.Column="1" Content="{x:Bind vm:PlayerProfileBandsViewModel.ListLinkText}" Click="OnBandsListLinkClick" VerticalAlignment="Center"
                                             MinHeight="{StaticResource FSTMinTargetSize}"
                                             AutomationProperties.Name="{x:Bind ViewModel.Bands.ListLinkName, Mode=OneWay}"
                                             AutomationProperties.AutomationId="fst.player.bands-link" />
                        </Grid>

                        <!-- Fluent in-card loading, replaced by the groups or the inline status with Retry. -->
                        <Border Style="{StaticResource FSTCardStyle}" MinHeight="120"
                                Visibility="{x:Bind ViewModel.Bands.IsLoading, Mode=OneWay, FallbackValue=Collapsed}">
                            <ProgressRing IsActive="{x:Bind ViewModel.Bands.IsLoading, Mode=OneWay, FallbackValue=False}" Width="32" Height="32"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Loading bands"
                                          AutomationProperties.AutomationId="fst.player.bands.loading" />
                        </Border>
                        <Border Style="{StaticResource FSTCardStyle}"
                                Visibility="{x:Bind ViewModel.Bands.ShowError, Mode=OneWay, FallbackValue=Collapsed}">
                            <controls:ServiceStatusInline Status="{x:Bind ViewModel.Bands.Status, Mode=OneWay}"
                                                          RetryAutomationId="fst.player.bands.retry" />
                        </Border>

                        <ItemsRepeater TabFocusNavigation="Local" XYFocusKeyboardNavigation="Enabled"
                                       ItemsSource="{x:Bind ViewModel.Bands.Groups, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.Bands.ShowGroups, Mode=OneWay, FallbackValue=Collapsed}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="16" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlayerProfileBandGroup">
                                    <!-- Named group: band cards repeat across groups, so each group is its own UIA parent. -->
                                    <controls:AccessibleGroup AutomationProperties.Name="{x:Bind Title}">
                                        <StackPanel Spacing="8">
                                            <controls:CardHeader Title="{x:Bind Title}" HeadingLevel="Level3" MinHeight="44"
                                                                 TitleAutomationId="{x:Bind HeaderAutomationId}" />
                                            <!-- Rows size to their tallest card (Trios and Quads cards list more members). -->
                                            <ItemsRepeater XYFocusKeyboardNavigation="Enabled" ItemsSource="{x:Bind Cards}" Visibility="{x:Bind HasCards}"
                                                           controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="120">
                                                <ItemsRepeater.Layout>
                                                    <controls:LeaderboardsCardGridLayout MinColumnWidth="320" MaxColumns="3" Spacing="12" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PlayerBandCardViewModel">
                                                        <controls:BandCardView Card="{x:Bind}" />
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                            <!-- Empty group (web InstrumentEmptyState "No bands yet"). -->
                                            <Border Style="{StaticResource FSTCardStyle}" Visibility="{x:Bind IsEmpty}">
                                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                    <TextBlock Text="{x:Bind vm:PlayerProfileBandGroup.EmptyTitle}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                               TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                                                               AutomationProperties.AutomationId="{x:Bind EmptyAutomationId}" />
                                                    <TextBlock Text="{x:Bind vm:PlayerProfileBandGroup.EmptySubtitle}" Style="{StaticResource FSTSecondaryTextStyle}"
                                                               TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Frosted View All Bands (N) card (surface-materials R7), not the purple
                                                 leaderboard CTA. -->
                                            <controls:ViewAllCard Label="{x:Bind ViewAllText}" Tag="{x:Bind ViewAllRoute}" Click="OnBandsViewAllClick"
                                                                  Visibility="{x:Bind HasMore}"
                                                                  AutomationProperties.Name="{x:Bind ViewAllName}"
                                                                  AutomationProperties.AutomationId="{x:Bind ViewAllAutomationId}" />
                                        </StackPanel>
                                    </controls:AccessibleGroup>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </controls:AccessibleGroup>
            </StackPanel>
        </ScrollViewer>

        <controls:QuickLinksPane x:Name="Pane" Grid.Column="1" Width="240" Margin="0,12,24,24" Visibility="Collapsed" />

        <ProgressRing Grid.ColumnSpan="2" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="48" Height="48"
                      AutomationProperties.Name="Loading profile" AutomationProperties.AutomationId="fst.player.loading" />

        <!-- 202: scores still syncing (never an empty profile) -->
        <Border Grid.ColumnSpan="2" Style="{StaticResource FSTCardStyle}" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsSyncing, Mode=OneWay}">
            <StackPanel Spacing="12">
                <TextBlock Text="Scores Are Syncing" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2"
                           AutomationProperties.AutomationId="fst.player.syncing" />
                <TextBlock Text="{x:Bind ViewModel.SyncingMessage, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <Button Content="Retry" Command="{x:Bind ViewModel.Status.RetryCommand}" Style="{StaticResource AccentButtonStyle}" MinWidth="120" />
            </StackPanel>
        </Border>

        <controls:ServiceStatusView Grid.ColumnSpan="2" Status="{x:Bind ViewModel.Status}" VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}" />

        <!-- Statistics with no selection (brief window between deselect and the section hiding) -->
        <TextBlock Grid.ColumnSpan="2" Text="Select a player profile to see statistics." HorizontalAlignment="Center" VerticalAlignment="Center"
                   Style="{StaticResource FSTSecondaryTextStyle}" Visibility="{x:Bind controls:PlayerProfileView.Not(ViewModel.HasAccount), Mode=OneWay}"
                   AutomationProperties.AutomationId="fst.player.no-profile" />
    </Grid>

</UserControl>
