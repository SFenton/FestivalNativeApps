<UserControl
    x:Class="Festival.App.Controls.SongBandPreviewRowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels">
    <!--
        A Song Detail band preview row (web SongBandLeaderboardPreview row, iOS SongBandPreviewSection): rank and the members
        with their instrument icons, then a footer with the team score, FC, accuracy and stars; an in-card chevron because
        the row opens Band Detail. One UIA stop per row: the Button's name reads everything (prefixed "Your band, " for the
        selected player's band) and its parts are Raw. The selected player's band gets the purple player-row surface. The
        surface is a Border behind a transparent Button, so hover/press tint on top of it (as LeaderboardEntryRow).
    -->
    <Grid>
        <Border x:Name="Surface" CornerRadius="12" BorderThickness="1" IsHitTestVisible="False"
                Background="{ThemeResource FSTCardSurfaceBrush}" BorderBrush="{ThemeResource FSTCardStrokeBrush}" />
        <Button x:Name="RowButton" Click="OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                VerticalAlignment="Stretch" Padding="14,10" MinHeight="48" CornerRadius="12" BorderThickness="0" Background="Transparent"
                AutomationProperties.Name="{x:Bind Row.Announcement, Mode=OneWay}"
                AutomationProperties.AutomationId="{x:Bind Row.AutomationId, Mode=OneWay}">
            <Button.Resources>
                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="FSTRowHoverBrush" />
                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="FSTRowPressedBrush" />
                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
            </Button.Resources>
            <Grid ColumnSpacing="12" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="RankText" Text="{x:Bind Row.Rank, Mode=OneWay}" VerticalAlignment="Top" Margin="0,4,0,0"
                           Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AccessibilityView="Raw" />
                <ItemsRepeater x:Name="MembersRepeater" Grid.Column="1" ItemsSource="{x:Bind Row.Members, Mode=OneWay}"
                               ElementPrepared="OnMemberPrepared" AutomationProperties.AccessibilityView="Raw">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:BandMemberRow">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ItemsRepeater ItemsSource="{x:Bind Icons}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="2" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BandInstrumentIcon">
                                            <controls:InstrumentIcon File="{x:Bind File}" Label="{x:Bind Label}" AutomationProperties.AccessibilityView="Raw" />
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <FontIcon x:Name="Chevron" Grid.Column="2" Grid.RowSpan="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                          AutomationProperties.AccessibilityView="Raw" />
                <!-- Web SongBandScoreFooter: team score, FC, accuracy, stars under the members (fits any width). -->
                <Grid x:Name="Footer" Grid.Row="1" Grid.Column="1" ColumnSpacing="6" Padding="0,6,0,0" BorderThickness="0,1,0,0"
                      BorderBrush="{ThemeResource FSTCardStrokeBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ScoreText" Text="{x:Bind Row.Score, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center" TextWrapping="NoWrap" AutomationProperties.AccessibilityView="Raw" />
                    <Border x:Name="FcBadge" Grid.Column="1" CornerRadius="4" Padding="6,1" BorderThickness="1" BorderBrush="{ThemeResource FSTEmphasisStrokeBrush}"
                            Visibility="{x:Bind Row.IsFullCombo, Mode=OneWay}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                        <TextBlock x:Name="FcText" Text="FC" FontSize="12" FontWeight="SemiBold" AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                    <!-- As the Song Band Leaderboard row: contrast themes get a ButtonFace fill with ButtonText text and outline. -->
                    <Border Grid.Column="2" CornerRadius="4" Padding="6,1" BorderThickness="1"
                            Background="{ThemeResource FSTAccuracyPillFillBrush}" BorderBrush="{ThemeResource FSTNeutralPillStrokeBrush}"
                            Visibility="{x:Bind Row.HasAccuracy, Mode=OneWay}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                        <TextBlock Text="{x:Bind Row.Accuracy, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource FSTNeutralPillTextBrush}"
                                   AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                    <controls:StarRow Grid.Column="3" Stars="{x:Bind Row.StarCount, Mode=OneWay}" StarSize="14"
                                      AutomationProperties.AccessibilityView="Raw" />
                </Grid>
            </Grid>
        </Button>
    </Grid>
</UserControl>
