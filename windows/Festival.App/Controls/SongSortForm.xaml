<UserControl
    x:Class="Festival.App.Controls.SongSortForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!-- The Sort flyout's form (songs-sort control), shared by Songs and the Item Shop (issue #379): heading, Sort By and
         Direction radio groups and the red Reset. Changes apply live; light dismiss / Esc closes the host flyout. -->
    <StackPanel x:Name="Root" Width="300" Spacing="12">
        <TextBlock x:Name="TitleBlock" Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource FSTSectionHeaderStyle}" Margin="0"
                   AutomationProperties.HeadingLevel="Level2" />
        <RadioButtons x:Name="ModeGroup" Header="Sort By" ItemsSource="{x:Bind Draft.ModeLabels, Mode=OneWay}"
                      SelectedIndex="{x:Bind Draft.ModeIndex, Mode=TwoWay}" />
        <!-- Direction rows (operator batch 7.21): "Ascending" / "Descending" with the web's description as the subtitle
             beside the arrow. A RadioButtons group like Sort By (issue #218): one tab stop with arrow keys inside, and UIA
             names the group by its header and reports each row's position in the set. -->
        <RadioButtons x:Name="DirectionGroup" Header="Direction" SelectedIndex="{x:Bind Draft.DirectionIndex, Mode=TwoWay}">
            <RadioButton x:Name="AscendingOption" AutomationProperties.Name="Ascending, A–Z, low–high">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE74A;" FontSize="16" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Ascending" />
                        <TextBlock Text="A–Z, low–high" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource FSTSecondaryTextBrush}" />
                    </StackPanel>
                </Grid>
            </RadioButton>
            <RadioButton x:Name="DescendingOption" AutomationProperties.Name="Descending, Z–A, high–low">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE74B;" FontSize="16" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Descending" />
                        <TextBlock Text="Z–A, high–low" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource FSTSecondaryTextBrush}" />
                    </StackPanel>
                </Grid>
            </RadioButton>
        </RadioButtons>
        <!-- Changes apply live; Reset restores the default sort. -->
        <Button x:Name="ResetButton" Content="Reset" HorizontalAlignment="Stretch" Command="{x:Bind Draft.ResetCommand, Mode=OneWay}">
            <Button.Resources>
                <!-- Web Modal reset: a full-width red (btnDanger #C62828) button (operator batch 7.10). -->
                <StaticResource x:Key="ButtonBackground" ResourceKey="FSTDangerBackgroundBrush" />
                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="FSTDangerBackgroundPointerOverBrush" />
                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="FSTDangerBackgroundPressedBrush" />
                <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="FSTDangerBackgroundDisabledBrush" />
                <StaticResource x:Key="ButtonForeground" ResourceKey="FSTDangerForegroundBrush" />
                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="FSTDangerForegroundPointerOverBrush" />
                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="FSTDangerForegroundPressedBrush" />
                <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="FSTDangerForegroundDisabledBrush" />
                <StaticResource x:Key="ButtonBorderBrush" ResourceKey="FSTDangerBorderBrush" />
                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="FSTDangerBorderPointerOverBrush" />
                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="FSTDangerBorderPressedBrush" />
                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
            </Button.Resources>
        </Button>
    </StackPanel>
</UserControl>
