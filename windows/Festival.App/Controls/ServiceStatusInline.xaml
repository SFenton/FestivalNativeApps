<UserControl
    x:Class="Festival.App.Controls.ServiceStatusInline"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!-- Compact failed-read row for one section of a multi-section page (service-status `inline` state): the same
         vocabulary and countdown as the full-page view, but no announcement or live region, so a page of failing
         sections does not flood Narrator. Hosts draw any surface around it. -->
    <StackPanel x:Name="Root" Spacing="8">
        <TextBlock x:Name="TitleBlock" Text="{x:Bind Status.Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="MessageBlock" Text="{x:Bind Status.Message, Mode=OneWay}" TextWrapping="Wrap" />
        <TextBlock x:Name="CountdownBlock" Text="{x:Bind Status.CountdownText, Mode=OneWay}"
                   Visibility="{x:Bind Status.HasCountdown, Mode=OneWay, FallbackValue=Collapsed}"
                   AutomationProperties.Name="{x:Bind Status.CountdownAnnouncement, Mode=OneWay}" />
        <Button x:Name="RetryButton" Content="{x:Bind Status.RetryLabel, Mode=OneWay}" Command="{x:Bind Status.RetryCommand, Mode=OneWay}"
                MinHeight="{StaticResource FSTMinTargetSize}" />
    </StackPanel>
</UserControl>
