<UserControl
    x:Class="Festival.App.Controls.LeaderboardsSongRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls">
    <!-- Solo chart row: rank | name | season, stars (wide only) | accuracy/FC pill | score. The selected player's row is
         bold (web isPlayer); a hairline separates rows inside the card (RowSeparators). -->
    <Grid>
    <Button x:Name="RowButton" Click="OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
            Padding="12,6" MinHeight="44" CornerRadius="6" BorderThickness="1" SizeChanged="OnSizeChanged">
        <Grid x:Name="RowGrid" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RankColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SeasonColumn" Width="Auto" />
                <ColumnDefinition x:Name="StarsColumn" Width="Auto" />
                <ColumnDefinition x:Name="PillColumn" Width="Auto" MinWidth="72" />
                <ColumnDefinition x:Name="ScoreColumn" Width="Auto" MinWidth="88" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RankText" VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="NoWrap" />
            <TextBlock x:Name="NameText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="SeasonText" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource FSTSecondaryTextStyle}" />
            <Border x:Name="StarsHost" Grid.Column="3" VerticalAlignment="Center">
                <controls:StarRow x:Name="StarsView" StarSize="14" AutomationProperties.AccessibilityView="Raw" />
            </Border>
            <Border x:Name="Pill" Grid.Column="4" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="{StaticResource FSTSurfaceMutedBrush}">
                <TextBlock x:Name="PillText" FontSize="12" />
            </Border>
            <TextBlock x:Name="ScoreText" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
        </Grid>
    </Button>
    <Border x:Name="Separator" Height="1" VerticalAlignment="Top" Margin="12,0" Visibility="Collapsed"
            Background="{ThemeResource FSTRowSeparatorBrush}" IsHitTestVisible="False" />
    </Grid>
</UserControl>
