<UserControl
    x:Class="Festival.App.Controls.FirstRunCarousel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:domain="using:Festival.Core.Domain">
    <!-- Content of the first-run ContentDialog: FlipView of slides, pips, live position. -->
    <StackPanel Spacing="12" Width="440" AutomationProperties.AutomationId="fst.first-run.carousel">
        <FlipView x:Name="Slides" Height="300" Background="Transparent" ItemsSource="{x:Bind Carousel.Slides}"
                  SelectedIndex="{x:Bind Carousel.Index, Mode=TwoWay}"
                  AutomationProperties.Name="{x:Bind Carousel.Title}"
                  AutomationProperties.AutomationId="fst.first-run.slides">
            <FlipView.ItemTemplate>
                <DataTemplate x:DataType="domain:FirstRunSlide">
                    <StackPanel Spacing="12" Padding="4,0" AutomationProperties.AutomationId="{x:Bind Id}">
                        <controls:FirstRunIllustration SlideId="{x:Bind Id}" Height="150" />
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Foreground="{ThemeResource FSTSecondaryTextBrush}" />
                    </StackPanel>
                </DataTemplate>
            </FlipView.ItemTemplate>
        </FlipView>
        <Grid>
            <PipsPager x:Name="Pips" HorizontalAlignment="Center" NumberOfPages="{x:Bind Carousel.Slides.Count}"
                       SelectedPageIndex="{x:Bind Carousel.Index, Mode=TwoWay}"
                       Visibility="{x:Bind MultipleSlides}"
                       AutomationProperties.Name="Slides" AutomationProperties.AutomationId="fst.first-run.pips" />
        </Grid>
        <TextBlock Text="{x:Bind Carousel.PositionText, Mode=OneWay}" HorizontalAlignment="Center"
                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource FSTSecondaryTextBrush}"
                   AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="fst.first-run.position" />
    </StackPanel>
</UserControl>
