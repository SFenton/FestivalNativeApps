<UserControl
    x:Class="Festival.App.Controls.RivalPageStates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Festival.App.Controls"
    IsTabStop="False">
    <!-- Non-content states shared by All Rivals, Rival Detail and Rivalry: loading, scrape-freeze/failure, empty, no player. -->
    <Grid>
        <ProgressRing IsActive="{x:Bind Page.IsLoading, Mode=OneWay}" Width="48" Height="48"
                      AutomationProperties.Name="Loading" />
        <local:ServiceStatusView Status="{x:Bind Page.Status, Mode=OneWay}" VerticalAlignment="Center" Margin="16"
                                 Visibility="{x:Bind Page.ShowError, Mode=OneWay}" />
        <StackPanel Visibility="{x:Bind Page.ShowEmpty, Mode=OneWay}" MaxWidth="480" Spacing="8" Margin="16,64,16,0"
                    VerticalAlignment="Top" HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE716;" FontSize="40" Foreground="{ThemeResource FSTSecondaryTextBrush}" />
            <TextBlock Text="{x:Bind Page.EmptyTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center"
                       TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="fst.rivals.page-empty" />
        </StackPanel>
        <StackPanel Visibility="{x:Bind Page.ShowNoPlayer, Mode=OneWay}" MaxWidth="480" Spacing="12" Margin="16,64,16,0"
                    VerticalAlignment="Top" HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE77B;" FontSize="40" Foreground="{ThemeResource FSTSecondaryTextBrush}" />
            <TextBlock Text="No Player Selected" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center"
                       AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="fst.rivals.chooseProfile" />
            <TextBlock Text="Track a player to see their rivals." TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource FSTSecondaryTextBrush}" />
            <Button Content="Select Player" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center"
                    Click="OnSelectPlayer" AutomationProperties.AutomationId="fst.rivals.selectPlayer" />
        </StackPanel>
    </Grid>
</UserControl>
