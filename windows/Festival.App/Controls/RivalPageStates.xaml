<UserControl
    x:Class="Festival.App.Controls.RivalPageStates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Festival.App.Controls"
    IsTabStop="False">
    <!-- Non-content states shared by All Rivals, Rival Detail and Rivalry: loading, scrape-freeze/failure, empty, no player. -->
    <Grid>
        <ProgressRing IsActive="{x:Bind Page.IsLoading, Mode=OneWay}" Width="48" Height="48"
                      AutomationProperties.Name="Loading" AutomationProperties.AutomationId="fst.rivals.page-loading" />
        <local:ServiceStatusView Status="{x:Bind Page.Status, Mode=OneWay}" VerticalAlignment="Center" Margin="16"
                                 Visibility="{x:Bind Page.ShowError, Mode=OneWay}" />
        <!-- Shared empty states (issue #377): centred in the page region, no card. -->
        <local:EmptyStateView Visibility="{x:Bind Page.ShowEmpty, Mode=OneWay}" Glyph="&#xE716;"
                              Title="{x:Bind Page.EmptyTitle, Mode=OneWay}" TitleAutomationId="fst.rivals.page-empty" />
        <local:EmptyStateView Visibility="{x:Bind Page.ShowNoPlayer, Mode=OneWay}" Glyph="&#xE77B;"
                              Title="No Player Selected" Subtitle="Track a player to see their rivals."
                              TitleAutomationId="fst.rivals.chooseProfile">
            <local:EmptyStateView.Action>
                <Button Content="Select Player" Style="{StaticResource AccentButtonStyle}" MinHeight="{StaticResource FSTMinTargetSize}"
                        Click="OnSelectPlayer" AutomationProperties.AutomationId="fst.rivals.selectPlayer" />
            </local:EmptyStateView.Action>
        </local:EmptyStateView>
    </Grid>
</UserControl>
