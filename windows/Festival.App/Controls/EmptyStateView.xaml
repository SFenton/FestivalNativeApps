<UserControl
    x:Class="Festival.App.Controls.EmptyStateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <!-- Shared empty state (empty-error-states R1/R2/R5, issue #377; web components/common/EmptyState): optional icon,
         heading and subtitle centred in the region it fills, on no card and with no Reset Filters button. Failures keep
         ServiceStatusView's card, so empty and failed reads stay visibly distinct. The scroller keeps large text
         reachable in short regions; Compact (web InstrumentEmptyState) sits inside a section and never scrolls. -->
    <UserControl.Resources>
        <Style x:Key="CompactTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
        <Style x:Key="CompactSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource FSTSecondaryTextBrush}" />
        </Style>
    </UserControl.Resources>
    <!-- HorizontalContentAlignment/VerticalContentAlignment state the centring contract on the scroller itself; WinUI's
         ScrollContentPresenter also arranges the stack at least viewport-sized, so its own Center alignment centres it
         in the region (rendered check: songs_journey.py assertcentred, review of #426). -->
    <ScrollViewer x:Name="Scroller" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto" IsTabStop="False"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
        <StackPanel x:Name="Stack" Spacing="8" MaxWidth="480" Padding="12,48" HorizontalAlignment="Center" VerticalAlignment="Center">
            <FontIcon x:Name="IconGlyph" FontSize="40" Foreground="{ThemeResource FSTSecondaryTextBrush}" HorizontalAlignment="Center"
                      Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="TitleBlock" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock x:Name="SubtitleBlock" Style="{StaticResource BodyTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Visibility="Collapsed" />
            <ContentPresenter x:Name="ActionPresenter" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
