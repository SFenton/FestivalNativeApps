<Project Sdk="Microsoft.NET.Sdk">
  <!-- WinUI 3 (Windows App SDK) desktop app: unpackaged, self-contained, x64. -p:FstMsix=true builds the
       Microsoft Store MSIX instead (tools/windows/package_msix.ps1). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Festival.App</RootNamespace>
    <AssemblyName>FestivalScoreTracker</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType Condition="'$(FstMsix)' != 'true'">None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XAML-generated partial classes carry no XML docs. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>0.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Newer C#/WinRT projection (trim/AOT-annotated) than the one bundled with SDK 9.0.304. -->
    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <!-- Framework assemblies still emit trim-analysis warnings; keep them visible but not fatal. -->
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <!-- Generate WinRT vtables for every .NET type the app hands to XAML (needed for NativeAOT/trimming). -->
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
  </PropertyGroup>
  <!-- Release publishes trimmed; pass -p:FstAot=true for NativeAOT (see tools/windows/build.ps1). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <PublishReadyToRun Condition="'$(FstAot)' != 'true'">true</PublishReadyToRun>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FstAot)' == 'true'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <ProjectReference Include="..\Festival.Core\Festival.Core.csproj" />
    <Using Include="Festival.Core.Data" />
    <Using Include="Festival.Core.Domain" />
    <Using Include="Festival.Core.ViewModels" />
  </ItemGroup>
  <!-- Store package: unsigned (the Store signs it), one x64 .msix, logos from tools/windows/store_assets.py. -->
  <PropertyGroup Condition="'$(FstMsix)' == 'true'">
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode>StoreUpload</UapAppxPackageBuildMode>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
  </PropertyGroup>
  <ItemGroup Condition="'$(FstMsix)' == 'true'">
    <AppxManifest Remove="Package.appxmanifest" />
    <AppxManifest Include="Package.appxmanifest" />
    <Content Include="Assets\Store\*.png" />
  </ItemGroup>
  <ItemGroup Condition="'$(FstMsix)' != 'true'">
    <AppxManifest Remove="Package.appxmanifest" />
    <None Remove="Package.appxmanifest" />
  </ItemGroup>
  <!-- Build commit for Settings → App Version (AppVersionInfo.SettingsText): -p:FstGitSha=<sha>, else the SDK's
       SourceLink commit, else `git rev-parse HEAD` (the SDK reader reports "Repository has no commit" in a worktree
       whose branch ref is only in the shared packed-refs; issue #21). A build without git stamps nothing.
       Kept out of InformationalVersion, which the Store build stamps without a commit. -->
  <Target Name="FstStampGitSha" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="InitializeSourceControlInformation">
    <PropertyGroup>
      <FstGitSha Condition="'$(FstGitSha)' == ''">$(SourceRevisionId)</FstGitSha>
    </PropertyGroup>
    <Exec Condition="'$(FstGitSha)' == ''" Command="git rev-parse HEAD" WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true" StandardOutputImportance="low"
          StandardErrorImportance="low" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_FstGitRevParse" />
    </Exec>
    <PropertyGroup Condition="'$(FstGitSha)' == ''">
      <_FstGitRevParse>$(_FstGitRevParse.Trim())</_FstGitRevParse>
      <FstGitSha Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(_FstGitRevParse)', '^[0-9a-fA-F]{40}$'))">$(_FstGitRevParse)</FstGitSha>
    </PropertyGroup>
    <ItemGroup Condition="'$(FstGitSha)' != ''">
      <AssemblyMetadata Include="FstGitSha" Value="$(FstGitSha)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- Brand colours generated from contracts/fluent-tokens.json (read-only; owned by contracts/). -->
    <Page Include="..\..\contracts\generated\windows\BrandTokens.xaml" Link="Themes\BrandTokens.xaml" />
    <Content Include="Assets\Instruments\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Stars\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\licenses.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
