<Window
    x:Class="Festival.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:data="using:Festival.Core.Data"
    xmlns:domain="using:Festival.Core.Domain"
    Title="Festival Score Tracker">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- One artwork backdrop behind the whole window: the title bar and the navigation pane are transparent chrome
             over it (Styles.xaml clears NavigationView's content layer), so its dim scrim covers every edge. -->
        <controls:ArtworkBackground x:Name="Backdrop" Grid.RowSpan="2" />

        <TitleBar x:Name="AppTitleBar" Title="Festival Score Tracker"
                  IsBackButtonVisible="True" IsPaneToggleButtonVisible="True"
                  BackRequested="OnBackRequested" PaneToggleRequested="OnPaneToggleRequested"
                  AutomationProperties.AutomationId="fst.shell.title-bar">
            <!-- Global search (fst.global-search.*, MainWindow.Search.cs): centred box at >= 720 epx, button below. -->
            <TitleBar.Content>
                <AutoSuggestBox x:Name="GlobalSearchBox" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="240" MaxWidth="580"
                                QueryIcon="Find" PlaceholderText="Search songs or players" UpdateTextOnSelect="False"
                                ToolTipService.ToolTip="Search songs and players (Ctrl+E)"
                                AutomationProperties.Name="Search songs and players"
                                AutomationProperties.AutomationId="fst.global-search.open">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="domain:GlobalSuggestion">
                            <Grid ColumnSpacing="10" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:SongArt Art="{x:Bind Art}" Width="32" Height="32" Visibility="{x:Bind IsSong}" />
                                <PersonPicture Width="28" Height="28" DisplayName="{x:Bind Title}" Visibility="{x:Bind IsPlayer}"
                                               AutomationProperties.AccessibilityView="Raw" />
                                <FontIcon Glyph="&#xE721;" FontSize="16" Visibility="{x:Bind IsSeeAll}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" Visibility="{x:Bind HasSubtitle}" FontSize="12"
                                               Foreground="{ThemeResource FSTSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="GlobalSearchButton" Visibility="Collapsed" Padding="8" Background="Transparent" BorderThickness="0"
                        MinWidth="{StaticResource FSTMinTargetSize}" MinHeight="{StaticResource FSTMinTargetSize}"
                        VerticalAlignment="Center" ToolTipService.ToolTip="Search songs and players (Ctrl+E)"
                        AutomationProperties.Name="Search songs and players"
                        AutomationProperties.AutomationId="fst.global-search.open">
                    <FontIcon Glyph="&#xE721;" FontSize="16" />
                </Button>
                <!-- The bell only shows with a selected profile (operator 2026-09-28): notifications are player-scoped. -->
                <ContentControl x:Name="NotificationsHost" VerticalAlignment="Center" IsTabStop="False"
                                Visibility="{x:Bind Shell.HasPlayer, Mode=OneWay}" />
                <!-- Issue #290 (web getProfileClickDestination): with a player the click shows Statistics; anonymous it opens
                     the picker. The picker is an attached flyout so the click can choose; the context menu (right-click,
                     Shift+F10) and Ctrl+Shift+P open it in both states. -->
                <Button x:Name="ProfileButton" Padding="4" Margin="0,0,8,0" Background="Transparent" BorderThickness="0"
                        MinWidth="{StaticResource FSTMinTargetSize}" MinHeight="{StaticResource FSTMinTargetSize}"
                        Click="OnProfileButtonClick" ContextRequested="OnProfileButtonContextRequested"
                        AutomationProperties.Name="{x:Bind Shell.ProfileButtonName, Mode=OneWay}"
                        AutomationProperties.HelpText="{x:Bind Shell.ProfileButtonHelp, Mode=OneWay}"
                        AutomationProperties.AutomationId="fst.shell.profile"
                        ToolTipService.ToolTip="{x:Bind Shell.ProfileButtonToolTip, Mode=OneWay}">
                    <PersonPicture Width="28" Height="28" DisplayName="{x:Bind Shell.ProfileDisplayName, Mode=OneWay}"
                                   AutomationProperties.AccessibilityView="Raw" />
                    <FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="ProfileFlyout" Placement="BottomEdgeAlignedRight" Opened="OnProfileFlyoutOpened"
                                Closed="OnProfileFlyoutClosed">
                            <!-- Profile selection (fst.profile.*): selected summary, Players/Bands target, search, results. -->
                            <StackPanel Width="340" Spacing="12" AutomationProperties.AutomationId="fst.profile.sheet">
                                <StackPanel Spacing="8" Visibility="{x:Bind Shell.HasPlayer, Mode=OneWay}"
                                            AutomationProperties.AutomationId="fst.profile.selected">
                                    <TextBlock Text="Selected Profile" Style="{StaticResource BodyStrongTextBlockStyle}"
                                               AutomationProperties.HeadingLevel="Level2" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <PersonPicture Width="40" Height="40" DisplayName="{x:Bind Shell.ProfileDisplayName, Mode=OneWay}"
                                                       AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Shell.ProfileName, Mode=OneWay}" VerticalAlignment="Center"
                                                   Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="View Profile" Click="OnViewSelectedProfile"
                                                AutomationProperties.AutomationId="fst.profile.view-selected" />
                                        <Button Content="Deselect" Click="OnDeselectProfile"
                                                AutomationProperties.AutomationId="fst.profile.deselect" />
                                    </StackPanel>
                                    <!-- A plain divider: a MenuFlyoutSeparator outside a menu is a focusable Control with no
                                         automation name, so Tab stopped on it silently (issue #254). -->
                                    <Rectangle Height="1" Margin="-4,5,-4,1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                </StackPanel>
                                <TextBlock Text="Find a Profile" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <SelectorBar x:Name="ProfileScope" SelectionChanged="OnProfileScopeChanged"
                                             AutomationProperties.AutomationId="fst.profile.scope">
                                    <SelectorBarItem Text="Players" IsSelected="True" AutomationProperties.AutomationId="fst.profile.scope.players" />
                                    <SelectorBarItem Text="Bands" AutomationProperties.AutomationId="fst.profile.scope.bands" />
                                </SelectorBar>
                                <!-- Native AutoSuggestBox search field (no custom fill); results list below it. -->
                                <AutoSuggestBox x:Name="ProfileSearchBox" PlaceholderText="{x:Bind Shell.SearchPlaceholder, Mode=OneWay}"
                                                QueryIcon="Find" UpdateTextOnSelect="False"
                                                Text="{x:Bind Shell.ProfileQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{x:Bind Shell.IsPlayerScope, Mode=OneWay}" QuerySubmitted="OnProfileSearchSubmitted"
                                                PreviewKeyDown="OnProfileSearchKeyDown"
                                                AutomationProperties.Name="{x:Bind Shell.SearchPlaceholder, Mode=OneWay}"
                                                AutomationProperties.AutomationId="fst.profile.search" />
                                <ListView ItemsSource="{x:Bind Shell.ProfileResults, Mode=OneWay}" MaxHeight="320"
                                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnProfileResultClick"
                                          ContainerContentChanging="OnProfileResultContainer"
                                          AutomationProperties.Name="Players"
                                          AutomationProperties.AutomationId="fst.profile.results">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="domain:GlobalPlayerResult">
                                            <Grid ColumnSpacing="12" Padding="0,6" AutomationProperties.Name="{x:Bind AccessibleName}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <PersonPicture Width="28" Height="28" DisplayName="{x:Bind DisplayName}"
                                                               AutomationProperties.AccessibilityView="Raw" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <!-- Plain centred hint ("Enter at least 2 characters", "Searching…"): no container. -->
                                <TextBlock Text="{x:Bind Shell.ProfileHint, Mode=OneWay}" HorizontalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource FSTSecondaryTextBrush}"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Margin="0,8" AutomationProperties.LiveSetting="Polite"
                                           AutomationProperties.AutomationId="fst.profile.hint" />
                                <Button Content="Retry" Command="{x:Bind Shell.RetrySearchCommand}" HorizontalAlignment="Center"
                                        Visibility="{x:Bind Shell.CanRetrySearch, Mode=OneWay}"
                                        AutomationProperties.AutomationId="fst.profile.retry" />
                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False" IsSettingsVisible="True" OpenPaneLength="240"
                        ItemInvoked="OnNavItemInvoked" DisplayModeChanged="OnNavDisplayModeChanged"
                        AutomationProperties.AutomationId="fst.shell.navigation">
            <Grid x:Name="FrameHost" />
        </NavigationView>
    </Grid>
</Window>
