<Window
    x:Class="Festival.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:data="using:Festival.Core.Data"
    Title="Festival Score Tracker">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Festival Score Tracker"
                  IsBackButtonVisible="True" IsPaneToggleButtonVisible="True"
                  BackRequested="OnBackRequested" PaneToggleRequested="OnPaneToggleRequested"
                  AutomationProperties.AutomationId="fst.shell.title-bar">
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ContentControl x:Name="NotificationsHost" VerticalAlignment="Center" IsTabStop="False" />
                <Button x:Name="ProfileButton" Padding="4" Margin="0,0,8,0" Background="Transparent" BorderThickness="0"
                        AutomationProperties.Name="{x:Bind Shell.ProfileButtonName, Mode=OneWay}"
                        AutomationProperties.AutomationId="fst.shell.profile"
                        ToolTipService.ToolTip="{x:Bind Shell.ProfileName, Mode=OneWay}">
                    <PersonPicture Width="28" Height="28" DisplayName="{x:Bind Shell.ProfileDisplayName, Mode=OneWay}"
                                   AutomationProperties.AccessibilityView="Raw" />
                    <Button.Flyout>
                        <Flyout x:Name="ProfileFlyout" Placement="BottomEdgeAlignedRight" Opened="OnProfileFlyoutOpened">
                            <!-- Profile selection (fst.profile.*): selected summary, Players/Bands target, search, results. -->
                            <StackPanel Width="340" Spacing="12" AutomationProperties.AutomationId="fst.profile.sheet">
                                <StackPanel Spacing="8" Visibility="{x:Bind Shell.HasPlayer, Mode=OneWay}"
                                            AutomationProperties.AutomationId="fst.profile.selected">
                                    <TextBlock Text="Selected Profile" Style="{StaticResource BodyStrongTextBlockStyle}"
                                               AutomationProperties.HeadingLevel="Level2" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <PersonPicture Width="40" Height="40" DisplayName="{x:Bind Shell.ProfileDisplayName, Mode=OneWay}"
                                                       AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Shell.ProfileName, Mode=OneWay}" VerticalAlignment="Center"
                                                   Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="View Profile" Click="OnViewSelectedProfile"
                                                AutomationProperties.AutomationId="fst.profile.view-selected" />
                                        <Button Content="Deselect" Click="OnDeselectProfile"
                                                AutomationProperties.AutomationId="fst.profile.deselect" />
                                    </StackPanel>
                                    <MenuFlyoutSeparator Margin="0,4,0,0" />
                                </StackPanel>
                                <TextBlock Text="Find a Profile" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <SelectorBar x:Name="ProfileScope" SelectionChanged="OnProfileScopeChanged"
                                             AutomationProperties.AutomationId="fst.profile.scope">
                                    <SelectorBarItem Text="Players" IsSelected="True" AutomationProperties.AutomationId="fst.profile.scope.players" />
                                    <SelectorBarItem Text="Bands" AutomationProperties.AutomationId="fst.profile.scope.bands" />
                                </SelectorBar>
                                <TextBox x:Name="ProfileSearchBox" PlaceholderText="{x:Bind Shell.SearchPlaceholder, Mode=OneWay}"
                                         Text="{x:Bind Shell.ProfileQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{x:Bind Shell.IsPlayerScope, Mode=OneWay}" KeyDown="OnProfileSearchKeyDown"
                                         AutomationProperties.Name="{x:Bind Shell.SearchPlaceholder, Mode=OneWay}"
                                         AutomationProperties.AutomationId="fst.profile.search" />
                                <ListView ItemsSource="{x:Bind Shell.ProfileResults, Mode=OneWay}" MaxHeight="320"
                                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnProfileResultClick"
                                          AutomationProperties.Name="Players"
                                          AutomationProperties.AutomationId="fst.profile.results">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="data:PlayerSearchResult">
                                            <Grid ColumnSpacing="12" Padding="0,6" AutomationProperties.Name="{x:Bind DisplayName}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <PersonPicture Width="28" Height="28" DisplayName="{x:Bind DisplayName}"
                                                               AutomationProperties.AccessibilityView="Raw" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="{x:Bind Shell.ProfileHint, Mode=OneWay}" HorizontalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource FSTSecondaryTextStyle}"
                                           Margin="0,8" AutomationProperties.LiveSetting="Polite"
                                           AutomationProperties.AutomationId="fst.profile.hint" />
                                <Button Content="Retry" Command="{x:Bind Shell.RetrySearchCommand}" HorizontalAlignment="Center"
                                        Visibility="{x:Bind Shell.CanRetrySearch, Mode=OneWay}"
                                        AutomationProperties.AutomationId="fst.profile.retry" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False" IsSettingsVisible="True" OpenPaneLength="240"
                        ItemInvoked="OnNavItemInvoked"
                        AutomationProperties.AutomationId="fst.shell.navigation">
            <Grid>
                <controls:ArtworkBackground x:Name="Backdrop" />
                <Grid x:Name="FrameHost" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
