<Window
    x:Class="Festival.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Festival Score Tracker">
    <NavigationView x:Name="Shell" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="True" SelectionChanged="OnSelectionChanged"
                    AutomationProperties.AutomationId="fst.shell.navigation">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Songs" Tag="songs" Icon="Library"
                                AutomationProperties.AutomationId="fst.shell.songs" />
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
