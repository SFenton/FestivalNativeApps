<Page
    x:Class="Festival.App.Pages.BandsPlayerBandsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    Background="Transparent">

    <Grid Padding="24,12,24,0" RowSpacing="8" AutomationProperties.AutomationId="fst.player-bands.screen">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2" MaxWidth="1200" HorizontalAlignment="Stretch">
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource FSTPageTitleStyle}" TextTrimming="CharacterEllipsis"
                       AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="fst.player-bands.title" />
            <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource FSTSecondaryTextStyle}"
                       AutomationProperties.AutomationId="fst.player-bands.subtitle" />
        </StackPanel>

        <!-- Fluent segmented group filter (the web opens a filter sheet for the same four options). -->
        <SelectorBar x:Name="GroupBar" Grid.Row="1" SelectionChanged="OnGroupChanged"
                     AutomationProperties.Name="Band Type" AutomationProperties.AutomationId="fst.player-bands.group-picker">
            <SelectorBarItem Text="All Bands" AutomationProperties.AutomationId="fst.player-bands.group.all" />
            <SelectorBarItem Text="Duos" AutomationProperties.AutomationId="fst.player-bands.group.duos" />
            <SelectorBarItem Text="Trios" AutomationProperties.AutomationId="fst.player-bands.group.trios" />
            <SelectorBarItem Text="Quads" AutomationProperties.AutomationId="fst.player-bands.group.quads" />
        </SelectorBar>

        <Grid Grid.Row="2" Grid.RowSpan="2">
            <ScrollViewer Visibility="{x:Bind ViewModel.ShowRows, Mode=OneWay}" x:Name="Scroller"
                          AutomationProperties.AutomationId="fst.player-bands.list">
                <ItemsRepeater x:Name="Cards" XYFocusKeyboardNavigation="Enabled" ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="120" Margin="0,4,0,16" MaxWidth="1200">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="320" MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlayerBandCardViewModel">
                            <controls:BandCardView Card="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="48" Height="48"
                          AutomationProperties.Name="Loading bands" />

            <controls:ServiceStatusView Status="{x:Bind ViewModel.Status}" VerticalAlignment="Center"
                                        Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}"
                                        AutomationProperties.AutomationId="fst.player-bands.error" />

            <StackPanel Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="8" AutomationProperties.AutomationId="fst.player-bands.empty">
                <TextBlock Text="No bands found" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Shared board pager floating over the cards (web FixedLeaderboardPagination; operator batch 7.4). -->
        <controls:LeaderboardsPager x:Name="Footer" Grid.Row="2" Grid.RowSpan="2" VerticalAlignment="Bottom" Margin="0,0,0,12"
                                    Pager="{x:Bind ViewModel.Pager, Mode=OneWay}" IdPrefix="fst.player-bands" />
    </Grid>
</Page>
