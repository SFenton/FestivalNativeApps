<Page
    x:Class="Festival.App.Pages.BandsSongLeaderboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    Background="Transparent">

    <Grid Padding="24,12,24,0" RowSpacing="8" AutomationProperties.AutomationId="fst.song-band-leaderboard.screen">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Song header: art, title (opens Song Detail), artist line and the band size/entry count. -->
        <Grid ColumnSpacing="16" MaxWidth="1200" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="72" Height="72" CornerRadius="8" Background="{StaticResource FSTSurfaceMutedBrush}">
                <Image x:Name="HeaderArt" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource FSTPageTitleStyle}"
                           AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="fst.song-band-leaderboard.title" />
                <HyperlinkButton Content="{x:Bind ViewModel.SongTitle, Mode=OneWay}" Click="OnSongTitle" Padding="0"
                                 FontWeight="SemiBold" AutomationProperties.AutomationId="fst.song-band-leaderboard.song" />
                <TextBlock Text="{x:Bind ViewModel.SongSubtitle, Mode=OneWay}" Style="{StaticResource FSTSecondaryTextStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource FSTSecondaryTextStyle}"
                           AutomationProperties.AutomationId="fst.song-band-leaderboard.subtitle" />
            </StackPanel>
        </Grid>

        <SelectorBar x:Name="SizeBar" Grid.Row="1" SelectionChanged="OnSizeChanged"
                     AutomationProperties.Name="{x:Bind ViewModel.SwitcherName, Mode=OneWay}"
                     AutomationProperties.AutomationId="fst.song-band-leaderboard.band-type-menu">
            <SelectorBarItem Text="Duos" AutomationProperties.AutomationId="fst.song-band-leaderboard.band-type.Band_Duets" />
            <SelectorBarItem Text="Trios" AutomationProperties.AutomationId="fst.song-band-leaderboard.band-type.Band_Trios" />
            <SelectorBarItem Text="Quads" AutomationProperties.AutomationId="fst.song-band-leaderboard.band-type.Band_Quad" />
        </SelectorBar>

        <Grid Grid.Row="2">
            <ListView x:Name="Rows" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowRows, Mode=OneWay}"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnRowClick" Padding="0,0,0,16" MaxWidth="1200"
                      AutomationProperties.Name="Band scores" AutomationProperties.AutomationId="fst.song-band-leaderboard.list">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,3" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SongBandRow">
                        <Grid Padding="14,10" ColumnSpacing="14" CornerRadius="8" BorderThickness="1"
                              Background="{ThemeResource FSTCardSurfaceBrush}" BorderBrush="{ThemeResource FSTCardStrokeBrush}"
                              AutomationProperties.Name="{x:Bind Announcement}" AutomationProperties.AutomationId="{x:Bind AutomationId}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Rank}" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource FSTSecondaryTextBrush}" />
                            <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind Members}" VerticalAlignment="Center">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BandMemberRow">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ItemsRepeater ItemsSource="{x:Bind Icons}" VerticalAlignment="Center">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Orientation="Horizontal" Spacing="2" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:BandInstrumentIcon">
                                                        <controls:InstrumentIcon File="{x:Bind File}" Label="{x:Bind Label}" />
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind ScoreText}" VerticalAlignment="Center"
                                                       Style="{StaticResource FSTSecondaryTextStyle}"
                                                       Visibility="{x:Bind HasScore}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                                <TextBlock Text="{x:Bind Score}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right" />
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                    <Border CornerRadius="4" Padding="6,1" BorderThickness="1" BorderBrush="{StaticResource FSTGoldBrush}"
                                            Visibility="{x:Bind IsFullCombo}">
                                        <TextBlock Text="FC" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                    <Border CornerRadius="4" Padding="6,1" Background="{StaticResource FSTSurfaceMutedBrush}"
                                            Visibility="{x:Bind HasAccuracy}">
                                        <TextBlock Text="{x:Bind Accuracy}" FontSize="12" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Stars}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource FSTGoldBrush}" Visibility="{x:Bind HasStars}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="48" Height="48"
                          AutomationProperties.Name="Loading band scores" />

            <controls:ServiceStatusView Status="{x:Bind ViewModel.Status}" VerticalAlignment="Center"
                                        Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}"
                                        AutomationProperties.AutomationId="fst.song-band-leaderboard.error" />

            <StackPanel Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="8" AutomationProperties.AutomationId="fst.song-band-leaderboard.empty">
                <TextBlock Text="No band scores found" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <controls:BandsPager Grid.Row="3" Pager="{x:Bind ViewModel.Pager, Mode=OneWay}" IdPrefix="fst.song-band-leaderboard"
                             Margin="0,8,0,12" />
    </Grid>
</Page>
