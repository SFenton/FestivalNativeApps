<Page
    x:Class="Festival.App.Pages.BandsSongLeaderboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:pages="using:Festival.App.Pages"
    xmlns:vm="using:Festival.Core.ViewModels"
    Background="Transparent">

    <Grid Padding="24,12,24,0" RowSpacing="8" AutomationProperties.AutomationId="fst.song-band-leaderboard.screen">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The solo board's song-first header (issue #317): art, song title, artist, then the band size where the solo
             board names its instrument. It stays above the band-size switcher while rows reload; invoking it opens Song Detail
             (web onTitleClick). -->
        <controls:SongLeaderboardHeader x:Name="Header" MaxWidth="1200" HorizontalAlignment="Stretch"
                                        Title="{x:Bind ViewModel.Title, Mode=OneWay}" Artist="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                                        BoardLabel="{x:Bind ViewModel.BoardLabel, Mode=OneWay}" TotalText="{x:Bind ViewModel.TotalText, Mode=OneWay}"
                                        TitleAutomationId="fst.song-band-leaderboard.title" ArtistAutomationId="fst.song-band-leaderboard.artist"
                                        BoardAutomationId="fst.song-band-leaderboard.subtitle"
                                        TotalAutomationId="fst.song-band-leaderboard.total" SongAutomationId="fst.song-band-leaderboard.song"
                                        TitleInvoked="OnSongTitle" />

        <SelectorBar x:Name="SizeBar" Grid.Row="1" SelectionChanged="OnSizeChanged"
                     AutomationProperties.Name="{x:Bind ViewModel.SwitcherName, Mode=OneWay}"
                     AutomationProperties.AutomationId="fst.song-band-leaderboard.band-type-menu">
            <SelectorBarItem Text="Duos" AutomationProperties.AutomationId="fst.song-band-leaderboard.band-type.Band_Duets" />
            <SelectorBarItem Text="Trios" AutomationProperties.AutomationId="fst.song-band-leaderboard.band-type.Band_Trios" />
            <SelectorBarItem Text="Quads" AutomationProperties.AutomationId="fst.song-band-leaderboard.band-type.Band_Quad" />
        </SelectorBar>

        <Grid Grid.Row="2" Grid.RowSpan="2">
            <!-- The rows end at the floating pager through the bottom-chrome ramp (BoardFooterFade, issue #308). The wrapper
                 is the fade source because the load swap animates the ListView's own visual. -->
            <Grid x:Name="BoardFadeSource">
                <ListView x:Name="Rows" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="56" controls:BandScoreFooterPanel.IsSection="True"
                          controls:LoadSwapVisual.Swap="{x:Bind ViewModel.LoadSwap, Mode=OneWay}" controls:LoadSwapVisual.Role="Content"
                          ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowRows, Mode=OneWay}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnRowClick" ContainerContentChanging="OnContainerContentChanging"
                          Padding="0,0,0,16" MaxWidth="1200"
                          AutomationProperties.Name="Band scores" AutomationProperties.AutomationId="fst.song-band-leaderboard.list">
                    <!-- The page's bands as one grouped card (GroupedRows.Apply from OnContainerContentChanging: touching
                         row slices with a hairline between; issue #543, owner-approved native variant of the web's
                         separate band cards). -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SongBandRow">
                            <!--
                                Web SongBandScoreFooter shape: rank + members on top, team score footer below (fits any width), and an in-card
                                chevron because the row opens Band Detail (as the Song Detail preview row). One UIA stop per row: the
                                ListViewItem carries the name and ID (OnContainerContentChanging) and every part is Raw. The selected
                                player's band uses the purple player-row surface in place (web isSelected; Song Detail band preview row).
                                The outer grid is the row's slice of the grouped card (corners and outline set per position).
                            -->
                            <Grid CornerRadius="12" BorderThickness="1"
                                  Background="{x:Bind pages:BandsSongLeaderboardPage.Surface(IsSelected)}"
                                  BorderBrush="{x:Bind pages:BandsSongLeaderboardPage.Stroke(IsSelected)}"
                                  AutomationProperties.AccessibilityView="Raw">
                                <Border x:Name="RowSeparator" Height="1" Margin="12,0" VerticalAlignment="Top" IsHitTestVisible="False"
                                        Visibility="Collapsed" Background="{ThemeResource FSTRowSeparatorBrush}" AutomationProperties.AccessibilityView="Raw" />
                                <Grid Padding="14,10" ColumnSpacing="12" RowSpacing="6" AutomationProperties.AccessibilityView="Raw">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{x:Bind Rank}" VerticalAlignment="Top" Margin="0,4,0,0" Style="{StaticResource BodyStrongTextBlockStyle}"
                                               Foreground="{x:Bind pages:BandsSongLeaderboardPage.Secondary(IsSelected)}" AutomationProperties.AccessibilityView="Raw" />
                                    <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind Members}" AutomationProperties.AccessibilityView="Raw">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="4" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BandMemberRow">
                                                <Grid ColumnSpacing="8" AutomationProperties.AccessibilityView="Raw">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ItemsRepeater ItemsSource="{x:Bind Icons}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                                                        <ItemsRepeater.Layout>
                                                            <StackLayout Orientation="Horizontal" Spacing="2" />
                                                        </ItemsRepeater.Layout>
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:BandInstrumentIcon">
                                                                <controls:InstrumentIcon File="{x:Bind File}" Label="{x:Bind Label}" AutomationProperties.AccessibilityView="Raw" />
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" AutomationProperties.AccessibilityView="Raw" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind ScoreText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                               Style="{StaticResource FSTSecondaryTextStyle}" Visibility="{x:Bind HasScore}"
                                                               Foreground="{x:Bind pages:BandsSongLeaderboardPage.Secondary(OnPlayerRow)}"
                                                               AutomationProperties.AccessibilityView="Raw" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <FontIcon Grid.Column="2" Grid.RowSpan="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                                              AutomationProperties.AccessibilityView="Raw" />
                                    <!-- The score never truncates: the badges move under it when they don't fit (BandScoreFooterPanel, issue #264). -->
                                    <Border Grid.Row="1" Grid.Column="1" Padding="0,6,0,0" BorderThickness="0,1,0,0"
                                            BorderBrush="{ThemeResource FSTCardStrokeBrush}" AutomationProperties.AccessibilityView="Raw">
                                        <controls:BandScoreFooterPanel Spacing="6" AutomationProperties.AccessibilityView="Raw">
                                            <TextBlock Text="{x:Bind Score}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap"
                                                       AutomationProperties.AccessibilityView="Raw" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" AutomationProperties.AccessibilityView="Raw">
                                                <Border CornerRadius="4" Padding="6,1" BorderThickness="1" BorderBrush="{ThemeResource FSTEmphasisStrokeBrush}"
                                                        Visibility="{x:Bind IsFullCombo}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                                                    <TextBlock Text="FC" FontSize="12" FontWeight="SemiBold" AutomationProperties.AccessibilityView="Raw" />
                                                </Border>
                                                <!-- Contrast themes: ButtonFace fill, ButtonText text and outline (design/windows.md contrast roles). -->
                                                <Border CornerRadius="4" Padding="6,1" BorderThickness="1"
                                                        Background="{ThemeResource FSTAccuracyPillFillBrush}" BorderBrush="{ThemeResource FSTNeutralPillStrokeBrush}"
                                                        Visibility="{x:Bind HasAccuracy}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                                                    <TextBlock Text="{x:Bind Accuracy}" FontSize="12" Foreground="{ThemeResource FSTNeutralPillTextBrush}"
                                                               AutomationProperties.AccessibilityView="Raw" />
                                                </Border>
                                                <controls:StarRow Stars="{x:Bind StarCount}" StarSize="14" VerticalAlignment="Center"
                                                                  AutomationProperties.AccessibilityView="Raw" />
                                            </StackPanel>
                                        </controls:BandScoreFooterPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <!-- Paints BoardFadeSource with its rows faded above the pager; never hit-testable, UIA raw view only. -->
            <controls:EdgeFadeLayer x:Name="BoardFadeHost" AutomationProperties.AutomationId="fst.song-band-leaderboard.footer-fade" />

            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="48" Height="48"
                          controls:LoadSwapVisual.Swap="{x:Bind ViewModel.LoadSwap, Mode=OneWay}" controls:LoadSwapVisual.Role="Spinner"
                          AutomationProperties.Name="Loading band scores" />

            <controls:ServiceStatusView Status="{x:Bind ViewModel.Status}" VerticalAlignment="Center"
                                        controls:LoadSwapVisual.Swap="{x:Bind ViewModel.LoadSwap, Mode=OneWay}" controls:LoadSwapVisual.Role="Content"
                                        Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}"
                                        AutomationProperties.AutomationId="fst.song-band-leaderboard.error" />

            <controls:EmptyStateView Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}"
                                     controls:LoadSwapVisual.Swap="{x:Bind ViewModel.LoadSwap, Mode=OneWay}" controls:LoadSwapVisual.Role="Content"
                                     Title="No band scores found" Subtitle="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                                     TitleAutomationId="fst.song-band-leaderboard.empty" />
        </Grid>

        <!-- Contrast themes only: a window-colour plate (footer height plus its bottom margin, sized by BoardFooterFade)
             hides the rows between and behind the footer's controls instead of letting their text show through (scroll-edge
             R7; the song leaderboard's #197 plate, Band Rankings' #209). Never hit-testable. -->
        <Border x:Name="FooterPlate" Grid.Row="2" Grid.RowSpan="2" VerticalAlignment="Bottom" IsHitTestVisible="False"
                Visibility="Collapsed" Background="{ThemeResource FSTFloatingBackplateBrush}" />

        <!-- Floating footer over the rows (BoardFooter): the selected player's band pinned in the shared leaderboard row
             (web FixedLeaderboardPlayerFooter, issue #306; same markup as the Solo board), then the shared board pager (web
             FixedLeaderboardPagination; operator batch 7.4). The pinned row jumps to its page while it is elsewhere, else
             opens Band Detail (pattern leaderboard-row R7, issue #307). It shares the rows' load gate and entrance (issue
             #295) on the first load and when the band size or selected player changes; paging keeps it in place beside the
             spinner, like the web footer (PinnedGate, load-transition R2, issue #270). While hidden, LoadSwapGate drops it
             from UI Automation and the Tab order. Gate and entrance sit on separate elements. -->
        <StackPanel x:Name="Footer" Grid.Row="2" Grid.RowSpan="2" VerticalAlignment="Bottom" Margin="0,0,0,12" Spacing="8" MaxWidth="1200">
            <controls:LoadSwapGate x:Name="SpotlightGate" Visibility="{x:Bind ViewModel.ShowSpotlight, Mode=OneWay}"
                                   controls:LoadSwapVisual.Swap="{x:Bind ViewModel.LoadSwap, Mode=OneWay}" controls:LoadSwapVisual.Role="Content"
                                   controls:LoadSwapVisual.IsGated="{x:Bind ViewModel.PinnedGate.IsGated, Mode=OneWay}">
                <StackPanel x:Name="SpotlightPanel" Spacing="4">
                    <controls:LeaderboardEntryRow Row="{x:Bind ViewModel.Spotlight, Mode=OneWay}" IsFloating="True"
                                                  Command="{x:Bind ViewModel.JumpCommand}"
                                                  RowAutomationId="fst.song-band-leaderboard.spotlight-footer" />
                </StackPanel>
            </controls:LoadSwapGate>
            <controls:LeaderboardsPager Pager="{x:Bind ViewModel.Pager, Mode=OneWay}" IdPrefix="fst.song-band-leaderboard" />
        </StackPanel>
    </Grid>
</Page>
