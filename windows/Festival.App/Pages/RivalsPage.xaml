<Page
    x:Class="Festival.App.Pages.RivalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:data="using:Festival.Core.Data"
    xmlns:domain="using:Festival.Core.Domain"
    xmlns:vm="using:Festival.Core.ViewModels"
    NavigationCacheMode="Enabled"
    Background="Transparent">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Wide" />
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter Target="FindRivalBox.(Grid.Row)" Value="1" />
                        <Setter Target="FindRivalBox.(Grid.Column)" Value="0" />
                        <Setter Target="FindRivalBox.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="FindRivalBox.Width" Value="NaN" />
                        <Setter Target="FindRivalBox.Margin" Value="0,4,0,0" />
                        <Setter Target="Commands.(Grid.Row)" Value="2" />
                        <Setter Target="Header.Padding" Value="16,8,16,8" />
                        <Setter Target="Scroller.Padding" Value="16,0,16,24" />
                        <Setter Target="SongTab.Text" Value="Songs" />
                        <Setter Target="LeaderboardTab.Text" Value="Leaderboard" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Header: title + Find Rival; tab switcher, rank-by and Quick Links (menu below the pane width). -->
        <Grid x:Name="Header" Grid.ColumnSpan="2" Padding="24,12,24,8" ColumnSpacing="16" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Rivals" Style="{StaticResource FSTPageTitleStyle}" VerticalAlignment="Center"
                       AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="fst.rivals.title" />
            <AutoSuggestBox x:Name="FindRivalBox" Grid.Column="1" Width="280" PlaceholderText="Find Rival" QueryIcon="Find"
                            VerticalAlignment="Center" UpdateTextOnSelect="False"
                            ItemsSource="{x:Bind ViewModel.FindRival.Players, Mode=OneWay}"
                            TextChanged="OnFindTextChanged" QuerySubmitted="OnFindSubmitted"
                            AutomationProperties.Name="Find Rival"
                            AutomationProperties.HelpText="{x:Bind ViewModel.FindRival.PlayersHint, Mode=OneWay}"
                            AutomationProperties.AutomationId="fst.rivals.findRival">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="domain:GlobalPlayerResult">
                        <TextBlock Text="{x:Bind DisplayName}" AutomationProperties.Name="{x:Bind AccessibleName}" />
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>

            <controls:WrapPanel x:Name="Commands" Grid.Row="1" Grid.ColumnSpan="2" HorizontalSpacing="12" VerticalSpacing="8"
                                Visibility="{x:Bind controls:RivalsUi.Not(ViewModel.ShowNoPlayer), Mode=OneWay}">
                <SelectorBar x:Name="TabBar" SelectionChanged="OnTabChanged" AutomationProperties.AutomationId="fst.rivals.tab">
                    <SelectorBarItem x:Name="SongTab" Text="Song Rivals" IsSelected="True"
                                     AutomationProperties.AutomationId="fst.rivals.tab.song">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE8D6;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem x:Name="LeaderboardTab" Text="Leaderboard Rivals"
                                     AutomationProperties.AutomationId="fst.rivals.tab.leaderboard">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE9F9;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>
                <ComboBox ItemsSource="{x:Bind ViewModel.MetricLabels}" SelectedIndex="{x:Bind ViewModel.MetricIndex, Mode=TwoWay}"
                          VerticalAlignment="Center" MinWidth="150" Header="{x:Null}" PlaceholderText="Rank By"
                          Visibility="{x:Bind ViewModel.ShowMetricPicker, Mode=OneWay}"
                          AutomationProperties.Name="Rank By" AutomationProperties.AutomationId="fst.rivals.rankBy" />
                <controls:QuickLinksMenuButton x:Name="QuickLinksMenu" />
            </controls:WrapPanel>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" Padding="24,0,24,32" AutomationProperties.AutomationId="fst.rivals">
            <Grid>
                <ItemsRepeater TabFocusNavigation="Local" XYFocusKeyboardNavigation="Enabled" x:Name="SectionsRepeater" ItemsSource="{x:Bind ViewModel.Sections}" MaxWidth="1600" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="360"
                               HorizontalAlignment="Stretch" Margin="0,4,0,0">
                    <ItemsRepeater.Layout>
                        <controls:MasonryLayout MinColumnWidth="360" ColumnSpacing="16" RowSpacing="16" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:RivalSectionViewModel">
                            <!-- Named UIA group: the same rival in several sections is not an ambiguous sibling. -->
                            <controls:AccessibleGroup AutomationProperties.Name="{x:Bind Title}" controls:QuickLinkAnchor.Id="{x:Bind Id}">
                                <StackPanel Spacing="8">
                                <!-- Header above the card (web sectionHeaderClickable): icon, title, View All link (section-headers R8). -->
                                    <Grid Padding="4,0,0,0" ColumnSpacing="10" MinHeight="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:InstrumentIcon File="{x:Bind IconFile}" Width="36" Height="36"
                                                             Visibility="{x:Bind HasIcon}" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{StaticResource FSTSectionHeaderStyle}"
                                               Margin="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="{x:Bind AutomationId}" />
                                    <HyperlinkButton Grid.Column="2" Content="{x:Bind vm:RivalSectionViewModel.ListLinkText}" Tag="{x:Bind ViewAllRoute}" Click="OnRouteClick"
                                                     AutomationProperties.Name="{x:Bind ListLinkName}"
                                                     AutomationProperties.AutomationId="fst.rivals.see-all" />
                                </Grid>
                                <Border Style="{StaticResource FSTCardStyle}" Padding="8,8,8,12">
                                    <StackPanel Spacing="4">
                                        <!-- Fluent in-card loading: an indeterminate ProgressRing, replaced by rows or the inline status (#65). -->
                                        <Grid Visibility="{x:Bind IsLoading, Mode=OneWay}" MinHeight="120">
                                            <ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}" Width="32" Height="32"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          AutomationProperties.Name="{x:Bind LoadingName}"
                                                          AutomationProperties.AutomationId="{x:Bind LoadingAutomationId}" />
                                        </Grid>
                                        <controls:ServiceStatusInline Visibility="{x:Bind ShowError, Mode=OneWay}" Margin="8,4" Status="{x:Bind Status}" />
                                        <ItemsRepeater XYFocusKeyboardNavigation="Enabled" ItemsSource="{x:Bind Rows, Mode=OneWay}" Visibility="{x:Bind ShowRows, Mode=OneWay}"
                                                       controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="52">
                                            <ItemsRepeater.Layout>
                                                <!-- One non-virtualizing column: rows stay realized while the page is cached, so Back
                                                     never re-estimates them and moves the page (#276). -->
                                                <controls:LeaderboardsCardGridLayout MinColumnWidth="0" MaxColumns="1" Spacing="2" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RivalRowItem">
                                                    <!-- Anonymous leaderboard rows (empty account ID, #213) read as text and don't open anything. -->
                                                    <controls:LeaderboardRowButton Style="{StaticResource FSTRivalRowButtonStyle}" Tag="{x:Bind ProfileRoute}" Click="OnRouteClick"
                                                            IsActionable="{x:Bind HasProfile}" IsTabStop="{x:Bind HasProfile}" IsHitTestVisible="{x:Bind HasProfile}"
                                                            AutomationProperties.Name="{x:Bind AccessibleName}"
                                                            AutomationProperties.AutomationId="{x:Bind AutomationId}">
                                                        <controls:RivalRowView Item="{x:Bind}" />
                                                    </controls:LeaderboardRowButton>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                        <Button Content="{x:Bind ViewAllText}" Tag="{x:Bind ViewAllRoute}" Click="OnRouteClick"
                                                Style="{StaticResource FSTViewAllButtonStyle}" Visibility="{x:Bind ShowRows, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind ViewAllName}"
                                                AutomationProperties.AutomationId="{x:Bind ViewAllAutomationId}" />
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                            </controls:AccessibleGroup>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>

        <!-- Shared empty states (issue #377), centred in the region below the header instead of 64 epx down the scroller. -->
        <controls:EmptyStateView Grid.Row="1" Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" Glyph="&#xE716;"
                                 Title="{x:Bind ViewModel.EmptyTitle}" Subtitle="{x:Bind ViewModel.EmptySubtitle, Mode=OneWay}"
                                 TitleAutomationId="fst.rivals.empty" />

        <controls:EmptyStateView Grid.Row="1" Visibility="{x:Bind ViewModel.ShowNoPlayer, Mode=OneWay}" Glyph="&#xE77B;"
                                 Title="No Player Selected" Subtitle="Track a player to see their rivals."
                                 TitleAutomationId="fst.rivals.chooseProfile">
            <controls:EmptyStateView.Action>
                <Button Content="Select Player" Style="{StaticResource AccentButtonStyle}" MinHeight="{StaticResource FSTMinTargetSize}"
                        Click="OnSelectPlayer" AutomationProperties.AutomationId="fst.rivals.selectPlayer" />
            </controls:EmptyStateView.Action>
        </controls:EmptyStateView>

        <controls:QuickLinksPane x:Name="Pane" Grid.Row="1" Grid.Column="1" Width="240" Margin="0,4,24,24" Visibility="Collapsed" />
    </Grid>
</Page>
