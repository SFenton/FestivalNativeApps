<Page
    x:Class="Festival.App.Pages.LeaderboardsSongPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    Background="Transparent">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshInvoked" />
    </Page.KeyboardAccelerators>

    <!-- Solo leaderboard: song header, 25 rows, pinned "your score" row, pager (reading order matches the spec). -->
    <Grid x:Name="PageRoot" Padding="24,12,24,12" RowSpacing="12" MaxWidth="1100">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="HeaderArtHost" Width="80" Height="80" CornerRadius="8" Background="{StaticResource FSTSurfaceMutedBrush}">
                <Image x:Name="HeaderArt" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource FSTPageTitleStyle}" TextWrapping="Wrap"
                           AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="fst.song-leaderboard.title" />
                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource FSTSecondaryTextStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:InstrumentIcon File="{x:Bind ViewModel.IconFile, Mode=OneWay}" Width="20" Height="20"
                                             AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="{x:Bind ViewModel.InstrumentLabel}" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="fst.song-leaderboard.instrument" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" Style="{StaticResource FSTSecondaryTextStyle}" />
            </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" VerticalAlignment="Top"
                     Visibility="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" AutomationProperties.Name="Loading page" />
        <ScrollViewer x:Name="Scroller" Grid.Row="1" Visibility="{x:Bind ViewModel.ShowRows, Mode=OneWay}"
                      AutomationProperties.AutomationId="fst.song-leaderboard.list">
            <Border Style="{StaticResource FSTCardStyle}" Padding="8" Margin="0,4,0,0" VerticalAlignment="Top">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="2" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SongLeaderboardRowViewModel">
                            <controls:LeaderboardsSongRow Row="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Border>
        </ScrollViewer>
        <TextBlock Grid.Row="1" Text="No scores yet." Style="{StaticResource FSTSecondaryTextStyle}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" />
        <ProgressRing Grid.Row="1" Width="48" Height="48" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      AutomationProperties.Name="Loading leaderboard" />
        <controls:ServiceStatusView Grid.Row="1" Status="{x:Bind ViewModel.Status}" VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}" />

        <Border Grid.Row="2" Style="{StaticResource FSTCardStyle}" Padding="8"
                Visibility="{x:Bind ViewModel.ShowSpotlight, Mode=OneWay}"
                AutomationProperties.AutomationId="fst.song-leaderboard.spotlight-footer">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:LeaderboardsSongRow Row="{x:Bind ViewModel.Spotlight, Mode=OneWay}" />
                <Button Grid.Column="1" VerticalAlignment="Center" MinHeight="36" Command="{x:Bind ViewModel.JumpCommand}"
                        Visibility="{x:Bind ViewModel.CanJump, Mode=OneWay}"
                        ToolTipService.ToolTip="Jump to your page" AutomationProperties.Name="Jump to your page"
                        AutomationProperties.AutomationId="fst.song-leaderboard.spotlight-jump">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                        <TextBlock Text="Your page" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <controls:LeaderboardsPager Grid.Row="3" Pager="{x:Bind ViewModel.Pager}"
                                    Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}" />

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="12,8,12,8" />
                        <Setter Target="HeaderArtHost.Width" Value="56" />
                        <Setter Target="HeaderArtHost.Height" Value="56" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
