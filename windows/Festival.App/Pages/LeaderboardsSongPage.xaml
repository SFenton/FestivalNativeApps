<Page
    x:Class="Festival.App.Pages.LeaderboardsSongPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    Background="Transparent">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshInvoked" />
    </Page.KeyboardAccelerators>

    <!-- Solo leaderboard: song header and 25 rows scroll together (the header scrolls away under the title bar, operator
         batch 7.8), then the pinned "your score" row and the pager stay at the bottom (reading order matches the spec). -->
    <Grid x:Name="PageRoot" Padding="24,0,24,12" RowSpacing="8" MaxWidth="1100">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The fade source: its composition visual is hidden while BoardFadeHost paints the rows faded out above the
             footer (BoardFooterFade, issue #93). The header and pager stay while another page loads; only the rows swap
             for the spinner (web PaginatedLeaderboard). -->
        <Grid x:Name="BoardFadeSource" Grid.RowSpan="3" Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}">
            <ScrollViewer x:Name="Scroller" AutomationProperties.AutomationId="fst.song-leaderboard.list">
                <!-- No bottom padding: BoardFooter.Inset already ends the list one row gap (4 epx) above the footer, and
                     padding here doubled it (issue #293). -->
                <StackPanel x:Name="ScrollContent" Spacing="12" Padding="0,12,0,0">
                    <controls:SongLeaderboardHeader x:Name="Header" controls:FadeIn.OnShow="True"
                                                    Title="{x:Bind ViewModel.Title, Mode=OneWay}" Artist="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                                                    BoardIconFile="{x:Bind ViewModel.IconFile, Mode=OneWay}" BoardLabel="{x:Bind ViewModel.InstrumentLabel}"
                                                    TotalText="{x:Bind ViewModel.TotalText, Mode=OneWay}"
                                                    TitleAutomationId="fst.song-leaderboard.title" ArtistAutomationId="fst.song-leaderboard.artist"
                                                    BoardAutomationId="fst.song-leaderboard.instrument" TotalAutomationId="fst.song-leaderboard.total"
                                                    SongAutomationId="fst.song-leaderboard.song" TitleInvoked="OnSongTitle" />
                    <!-- One frosted row per entry, 4 epx apart (web entryRow list, operator batch 7.7). -->
                    <ItemsRepeater XYFocusKeyboardNavigation="Enabled" x:Name="RowsRepeater" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="52"
                                   controls:LoadSwapVisual.Swap="{x:Bind ViewModel.LoadSwap, Mode=OneWay}" controls:LoadSwapVisual.Role="Content"
                                   ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowRows, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SongLeaderboardRowViewModel">
                                <controls:LeaderboardEntryRow Row="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock Text="No scores yet." Style="{StaticResource FSTSecondaryTextStyle}" HorizontalAlignment="Center" Margin="0,48"
                               controls:LoadSwapVisual.Swap="{x:Bind ViewModel.LoadSwap, Mode=OneWay}" controls:LoadSwapVisual.Role="Content"
                               Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <!-- Paints BoardFadeSource with its rows faded above the footer (BoardFooterFade); never hit-testable, UIA raw view only. -->
        <controls:EdgeFadeLayer x:Name="BoardFadeHost" Grid.RowSpan="3" AutomationProperties.AutomationId="fst.song-leaderboard.footer-fade" />
        <ProgressRing Width="48" Height="48" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      controls:LoadSwapVisual.Swap="{x:Bind ViewModel.LoadSwap, Mode=OneWay}" controls:LoadSwapVisual.Role="Spinner"
                      AutomationProperties.Name="Loading leaderboard" />
        <controls:ServiceStatusView Status="{x:Bind ViewModel.Status}" VerticalAlignment="Center"
                                    controls:LoadSwapVisual.Swap="{x:Bind ViewModel.LoadSwap, Mode=OneWay}" controls:LoadSwapVisual.Role="Content"
                                    Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}" />

        <!-- Contrast themes: the footer fade cuts the rows hard at the footer's top and this window-colour plate (footer
             height, sized by BoardFooterFade) backs the footer's controls. Never hit-testable. -->
        <Border x:Name="FooterPlate" Grid.RowSpan="3" VerticalAlignment="Bottom" IsHitTestVisible="False" Visibility="Collapsed"
                Background="{ThemeResource FSTFloatingBackplateBrush}" />

        <!-- Web fixed footer: the pinned "your score" row is a full-width row like the list's, so its rank, name, score and
             accuracy line up with them (operator batch 7.9), then the pager; both float over the rows (BoardFooter).
             "Your Page" sits above the row instead of stealing its width. The pinned row shares the rows' load gate and
             entrance (issue #295) on the first load and when the invalid-score leeway changes: it fades out with the old page,
             keeping its slot so the pager and footer fade stay put, and fades in with the first new row. Paging keeps it in
             place beside the spinner, like the web footer (PinnedGate, load-transition R2, issue #270). While hidden,
             LoadSwapGate drops the row from UI Automation and the Tab order. The gate (XAML
             opacity transition) and the entrance (composition visual) sit on separate elements, as for the rows and their
             repeater: one element can't take both. -->
        <StackPanel x:Name="Footer" Grid.RowSpan="3" VerticalAlignment="Bottom" Spacing="8">
            <controls:LoadSwapGate x:Name="SpotlightGate" Visibility="{x:Bind ViewModel.ShowSpotlight, Mode=OneWay}"
                                   controls:LoadSwapVisual.Swap="{x:Bind ViewModel.LoadSwap, Mode=OneWay}" controls:LoadSwapVisual.Role="Content"
                                   controls:LoadSwapVisual.IsGated="{x:Bind ViewModel.PinnedGate.IsGated, Mode=OneWay}">
                <StackPanel x:Name="SpotlightPanel" Spacing="4">
                    <Button HorizontalAlignment="Right" MinHeight="32" Command="{x:Bind ViewModel.JumpCommand}"
                            Background="{ThemeResource FSTPagerButtonBrush}" BorderBrush="{ThemeResource FSTCardStrokeBrush}"
                            Visibility="{x:Bind ViewModel.CanJump, Mode=OneWay}"
                            ToolTipService.ToolTip="Jump to your page" AutomationProperties.Name="Jump to your page"
                            AutomationProperties.AutomationId="fst.song-leaderboard.spotlight-jump">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                            <TextBlock Text="Your Page" />
                        </StackPanel>
                    </Button>
                    <controls:LeaderboardEntryRow Row="{x:Bind ViewModel.Spotlight, Mode=OneWay}" IsFloating="True"
                                                  RowAutomationId="fst.song-leaderboard.spotlight-footer" />
                </StackPanel>
            </controls:LoadSwapGate>
            <controls:LeaderboardsPager Pager="{x:Bind ViewModel.Pager}" Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}" />
        </StackPanel>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="12,0,12,8" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
