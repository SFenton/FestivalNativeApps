<Page
    x:Class="Festival.App.Pages.LeaderboardsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    NavigationCacheMode="Required"
    Background="Transparent">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshInvoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="Root">
    <!-- Adaptive states live on the page root: an AdaptiveTrigger inside the ScrollViewer never fired, so the actions
         stayed beside the title and truncated it at compact widths. -->
    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
            <VisualState x:Name="Wide">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="760" />
                </VisualState.StateTriggers>
            </VisualState>
            <VisualState x:Name="Compact">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="0" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="PageContent.Padding" Value="12,8,12,24" />
                    <Setter Target="HeaderActions.(Grid.Row)" Value="1" />
                    <Setter Target="HeaderActions.(Grid.Column)" Value="0" />
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <ScrollViewer x:Name="Scroller" AutomationProperties.AutomationId="fst.leaderboards">
        <StackPanel x:Name="PageContent" Padding="24,12,24,32" Spacing="12" MaxWidth="1800">
            <!-- Title and the page action (Rank By). -->
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Leaderboards" Style="{StaticResource FSTPageTitleStyle}" AutomationProperties.HeadingLevel="Level1"
                           VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <DropDownButton x:Name="RankByButton" VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind ViewModel.MetricButtonName, Mode=OneWay}"
                                AutomationProperties.AutomationId="fst.rankings.rank-by-menu">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                        <TextBlock Text="{x:Bind ViewModel.MetricLabel, Mode=OneWay}" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="MetricMenu" Placement="BottomEdgeAlignedRight" Opening="OnMetricMenuOpening" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <controls:QuickLinksMenuButton x:Name="QuickLinksMenu" />
                </StackPanel>
            </Grid>

            <ItemsRepeater TabFocusNavigation="Local" XYFocusKeyboardNavigation="Enabled" ItemsSource="{x:Bind ViewModel.InstrumentCards, Mode=OneWay}"
                           controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="420">
                <ItemsRepeater.Layout>
                    <controls:LeaderboardsCardGridLayout MinColumnWidth="360" MaxColumns="4" Spacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:RankingCardViewModel">
                        <!-- Named UIA group: Narrator announces the chart; equal row names in different cards are not siblings. -->
                        <controls:AccessibleGroup AutomationProperties.Name="{x:Bind Title}" controls:QuickLinkAnchor.Id="{x:Bind QuickLinkId}">
                            <StackPanel Spacing="8">
                                <!-- Header above the card (web RankingCard cardLabel): instrument icon and name only (the Rank By
                                     button already names the metric). -->
                                <controls:CardHeader Title="{x:Bind Title}" IconFile="{x:Bind IconFile}" TitleAutomationId="{x:Bind AutomationId}" />
                                <Border Style="{StaticResource FSTRowsCardStyle}">
                                    <StackPanel Spacing="4">
                                        <controls:LeaderboardsSkeleton Visibility="{x:Bind IsLoading, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind EmptyText}" Visibility="{x:Bind ShowEmpty, Mode=OneWay}" Margin="12,8"
                                                   Style="{StaticResource FSTSecondaryTextStyle}" />
                                        <StackPanel Visibility="{x:Bind ShowError, Mode=OneWay}" Spacing="8" Margin="12,8"
                                                    AutomationProperties.AutomationId="fst.service-status.inline">
                                            <TextBlock Text="{x:Bind Status.Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Status.Message, Mode=OneWay}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Status.CountdownText, Mode=OneWay}"
                                                       AutomationProperties.Name="{x:Bind Status.CountdownAnnouncement, Mode=OneWay}" />
                                            <Button Content="{x:Bind Status.RetryLabel, Mode=OneWay}" Command="{x:Bind Status.RetryCommand}" />
                                        </StackPanel>
                                        <ItemsRepeater XYFocusKeyboardNavigation="Enabled" ItemsSource="{x:Bind Rows, Mode=OneWay}" Visibility="{x:Bind ShowRows, Mode=OneWay}"
                                                       controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="40" controls:RowSeparators.Enabled="True">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="0" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RankingRowViewModel">
                                                    <controls:LeaderboardsRankingRow Row="{x:Bind}" />
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                        <controls:LeaderboardsSpotlight Spotlight="{x:Bind Spotlight}" IdPrefix="{x:Bind SpotlightAutomationId}"
                                                                        Visibility="{x:Bind ShowRows, Mode=OneWay}" />
                                        <Button Content="{x:Bind ViewAllText, Mode=OneWay}" Tag="{x:Bind}" Click="OnViewAll" Style="{StaticResource FSTViewAllButtonStyle}" Margin="8,4,8,8"
                                                Visibility="{x:Bind ShowRows, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewAllName}"
                                                AutomationProperties.AutomationId="{x:Bind ViewAllAutomationId}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </controls:AccessibleGroup>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Grid Margin="0,12,0,0">
                <TextBlock Text="Bands" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
            </Grid>
            <ItemsRepeater TabFocusNavigation="Local" XYFocusKeyboardNavigation="Enabled" ItemsSource="{x:Bind ViewModel.BandCards, Mode=OneWay}"
                           controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="420">
                <ItemsRepeater.Layout>
                    <controls:LeaderboardsCardGridLayout MinColumnWidth="360" MaxColumns="3" Spacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:BandRankingCardViewModel">
                        <!-- Named UIA group: Narrator announces the chart; equal row names in different cards are not siblings. -->
                        <controls:AccessibleGroup AutomationProperties.Name="{x:Bind Title}" controls:QuickLinkAnchor.Id="{x:Bind QuickLinkId}">
                            <StackPanel Spacing="8">
                                <!-- Band-size header above the card: name only, no icon (web band RankingCard). -->
                                <controls:CardHeader Title="{x:Bind Title}" TitleAutomationId="{x:Bind AutomationId}" />
                                <Border Style="{StaticResource FSTRowsCardStyle}">
                                    <StackPanel Spacing="4">
                                        <controls:LeaderboardsSkeleton Visibility="{x:Bind IsLoading, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind EmptyText}" Visibility="{x:Bind ShowEmpty, Mode=OneWay}" Margin="12,8"
                                                   Style="{StaticResource FSTSecondaryTextStyle}" />
                                        <StackPanel Visibility="{x:Bind ShowError, Mode=OneWay}" Spacing="8" Margin="12,8"
                                                    AutomationProperties.AutomationId="fst.service-status.inline">
                                            <TextBlock Text="{x:Bind Status.Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Status.Message, Mode=OneWay}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Status.CountdownText, Mode=OneWay}"
                                                       AutomationProperties.Name="{x:Bind Status.CountdownAnnouncement, Mode=OneWay}" />
                                            <Button Content="{x:Bind Status.RetryLabel, Mode=OneWay}" Command="{x:Bind Status.RetryCommand}" />
                                        </StackPanel>
                                        <ItemsRepeater XYFocusKeyboardNavigation="Enabled" ItemsSource="{x:Bind Rows, Mode=OneWay}" Visibility="{x:Bind ShowRows, Mode=OneWay}"
                                                       controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="40" controls:RowSeparators.Enabled="True">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="0" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:BandRankingRowViewModel">
                                                    <controls:LeaderboardsRankingRow Row="{x:Bind}" />
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                        <Button Content="{x:Bind ViewAllText, Mode=OneWay}" Tag="{x:Bind}" Click="OnViewAll" Style="{StaticResource FSTViewAllButtonStyle}" Margin="8,4,8,8"
                                                Visibility="{x:Bind ShowRows, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewAllName}"
                                                AutomationProperties.AutomationId="{x:Bind ViewAllAutomationId}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </controls:AccessibleGroup>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
    <controls:QuickLinksPane x:Name="Pane" Grid.Column="1" Width="240" Margin="0,64,24,24" Visibility="Collapsed" />
    </Grid>
</Page>
