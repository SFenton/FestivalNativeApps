<Page
    x:Class="Festival.App.Pages.SongDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    Background="Transparent">

    <Grid x:Name="Root">
        <ScrollViewer x:Name="Scroller" Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}" controls:FadeIn.OnShow="True"
                      AutomationProperties.AutomationId="fst.song-detail">
            <StackPanel Padding="24,12,24,32" Spacing="8" MaxWidth="1200" HorizontalAlignment="Stretch">
                <!-- Header: static cover, title, artist · year · duration. -->
                <Grid ColumnSpacing="20" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="128" Height="128" CornerRadius="8" Background="{StaticResource FSTSurfaceMutedBrush}">
                        <Image x:Name="HeaderArt" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.Song.Title, Mode=OneWay}" Style="{StaticResource TitleLargeTextBlockStyle}"
                                   TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1"
                                   AutomationProperties.AutomationId="fst.song-detail.title" />
                        <TextBlock Text="{x:Bind ViewModel.Song.Subtitle, Mode=OneWay}" Style="{StaticResource BodyLargeTextBlockStyle}"
                                   Foreground="{ThemeResource FSTSecondaryTextBrush}" TextWrapping="Wrap" />
                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" Margin="0,8,0,0">
                            <Button Click="OnPathsClick" Visibility="{x:Bind ViewModel.HasPaths, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}"
                                    AutomationProperties.Name="Paths" AutomationProperties.AutomationId="fst.song-detail.paths">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE707;" FontSize="14" />
                                    <TextBlock Text="Paths" />
                                </StackPanel>
                            </Button>
                            <!-- Item Shop: the status (gold New, green in the Shop, red Leaving Tomorrow) breathes in the button's
                                 fill (web shopBreathe*, 3 s); the UIA name carries it ("Open in Item Shop, Leaving Tomorrow"). -->
                            <Button Click="OnShopClick" Visibility="{x:Bind ViewModel.HasShopLink, Mode=OneWay}" Padding="0"
                                    Background="#F5121826" Foreground="White"
                                    AutomationProperties.Name="{x:Bind ViewModel.ShopButtonName, Mode=OneWay}"
                                    AutomationProperties.AutomationId="fst.song-detail.shop"
                                    ToolTipService.ToolTip="Open the official Item Shop page">
                                <Grid>
                                    <controls:ShopPulseFill x:Name="ShopFill" CornerRadius="{StaticResource ControlCornerRadius}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="11,5,11,6">
                                        <FontIcon Glyph="&#xE719;" FontSize="14" />
                                        <TextBlock Text="Item Shop" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <!-- Quick Links: compact windows only (the web offers Song Detail links on mobile only). -->
                            <controls:QuickLinksMenuButton x:Name="QuickLinksMenu" />
                        </controls:WrapPanel>
                    </StackPanel>
                </Grid>

                <InfoBar IsOpen="{x:Bind ViewModel.HasShopIssue, Mode=OneWay}" IsClosable="False" Severity="Warning"
                         Message="{x:Bind ViewModel.ShopIssueText, Mode=OneWay}" AutomationProperties.AutomationId="fst.song-detail.shop-error" />

                <TextBlock Text="Intensity" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2"
                           controls:QuickLinkAnchor.Id="intensity" />
                <Border Style="{StaticResource FSTCardStyle}" AutomationProperties.AutomationId="fst.song-detail.intensity">
                    <ItemsRepeater controls:TextScaleLayout.ScaleWithText="True" ItemsSource="{x:Bind ViewModel.Intensity, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="240" MinItemHeight="36" MinRowSpacing="8" MinColumnSpacing="16"
                                               ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:IntensityRow">
                                <Grid ColumnSpacing="10" AutomationProperties.Name="{x:Bind Announcement}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:InstrumentIcon File="{x:Bind IconFile}" Label="{x:Bind Label}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <controls:DifficultyMeter Grid.Column="2" Raw="{x:Bind Raw}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>

                <TextBlock Text="Leaderboards" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <TextBlock Text="Band Leaderboards:" VerticalAlignment="Center" Style="{StaticResource FSTSecondaryTextStyle}"
                               AutomationProperties.AutomationId="fst.song-detail.band-leaderboards" />
                    <ItemsRepeater TabFocusNavigation="Local" XYFocusKeyboardNavigation="Enabled" ItemsSource="{x:Bind ViewModel.BandLinks, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:BandLeaderboardLink">
                                <HyperlinkButton Content="{x:Bind Label}" Tag="{x:Bind Route}" Click="OnBandLink" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
                <ItemsRepeater TabFocusNavigation="Local" XYFocusKeyboardNavigation="Enabled" x:Name="Boards" ItemsSource="{x:Bind ViewModel.Leaderboards, Mode=OneWay}"
                               ElementPrepared="OnBoardPrepared">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="380" MinRowSpacing="16" MinColumnSpacing="16" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:LeaderboardPreviewViewModel">
                            <!-- Header above the card (web InstrumentCard cardLabel) with the chart's total entries; rows, the
                                 player's own row eleven when outside the top ten, then the accent View Full Leaderboard. -->
                            <controls:AccessibleGroup AutomationProperties.Name="{x:Bind HeaderName, Mode=OneWay}"
                                                      controls:QuickLinkAnchor.Id="{x:Bind QuickLinkId}">
                                <StackPanel Spacing="8">
                                    <controls:CardHeader Title="{x:Bind Title}" IconFile="{x:Bind IconFile}" HeadingLevel="Level3" MinHeight="44"
                                                         Subtitle="{x:Bind TotalEntriesText, Mode=OneWay}" />
                                    <Border Style="{StaticResource FSTCardStyle}" MinHeight="96">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{x:Bind PlayerSummary, Mode=OneWay}" Visibility="{x:Bind ShowPlayerSummary, Mode=OneWay}"
                                                       TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       Foreground="{ThemeResource FSTGoldBrush}" />
                                            <ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}" HorizontalAlignment="Left" Width="24" Height="24"
                                                          Visibility="{x:Bind IsLoading, Mode=OneWay}" />
                                            <TextBlock Text="No scores yet." Visibility="{x:Bind ShowEmpty, Mode=OneWay}"
                                                       Style="{StaticResource FSTSecondaryTextStyle}" />
                                            <StackPanel Visibility="{x:Bind ShowError, Mode=OneWay}" Spacing="8"
                                                        AutomationProperties.AutomationId="fst.service-status.inline">
                                                <TextBlock Text="{x:Bind Status.Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind Status.Message, Mode=OneWay}" TextWrapping="Wrap" />
                                                <Button Content="{x:Bind Status.RetryLabel, Mode=OneWay}" Command="{x:Bind Status.RetryCommand}" />
                                            </StackPanel>
                                            <ItemsRepeater XYFocusKeyboardNavigation="Enabled" ItemsSource="{x:Bind Rows, Mode=OneWay}"
                                                           Visibility="{x:Bind ShowRows, Mode=OneWay}"
                                                           controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="32">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="2" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:LeaderboardRow">
                                                        <Grid ColumnSpacing="12" Height="30" Padding="4,0" CornerRadius="4" AutomationProperties.Name="{x:Bind Announcement}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="56" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="64" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.ColumnSpan="4" Margin="-4,0" CornerRadius="4" Background="#33FFD700" BorderBrush="{ThemeResource FSTGoldBrush}"
                                                                    BorderThickness="1" Visibility="{x:Bind IsSelectedPlayer}" />
                                                            <TextBlock Text="{x:Bind Rank}" VerticalAlignment="Center" Style="{StaticResource FSTSecondaryTextStyle}" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2" Text="{x:Bind Score}" VerticalAlignment="Center"
                                                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                            <Border Grid.Column="3" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center" Background="{StaticResource FSTSurfaceMutedBrush}"
                                                                    Visibility="{x:Bind HasAccuracy}">
                                                                <TextBlock Text="{x:Bind Accuracy}" FontSize="12" />
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                            <Button Content="View Full Leaderboard" Tag="{x:Bind}" Click="OnViewFull" Style="{StaticResource FSTViewAllButtonStyle}"
                                                    Visibility="{x:Bind ShowRows, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewAllName}"
                                                    AutomationProperties.AutomationId="{x:Bind ViewAllAutomationId}" />
                                            <HyperlinkButton Content="{x:Bind HistoryLabel}" Tag="{x:Bind}" Click="OnViewHistory" Padding="0,4"
                                                             Visibility="{x:Bind HasPlayer}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </controls:AccessibleGroup>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="48" Height="48" />
        <controls:ServiceStatusView Status="{x:Bind ViewModel.Status}" VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}" />
    </Grid>
</Page>
