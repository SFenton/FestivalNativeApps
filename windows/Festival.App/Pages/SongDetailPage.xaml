<Page
    x:Class="Festival.App.Pages.SongDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    Background="Transparent">
    <Page.Resources>
        <!-- Score-history list/detail row (web LeaderboardEntry with a date label) in the shared leaderboard row: date, season,
             score, accuracy badge; the personal best is purple with a bold date (web scoreListCardBestStyle + isPlayer). -->
        <DataTemplate x:Key="HistoryRowTemplate" x:DataType="vm:ScoreHistoryListRow">
            <controls:LeaderboardEntryRow Row="{x:Bind}" />
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="Root">
        <ScrollViewer x:Name="Scroller" Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}"
                      ViewChanged="OnScrollerViewChanged" AutomationProperties.AutomationId="fst.song-detail">
            <StackPanel Padding="24,12,24,32" Spacing="8" MaxWidth="1200" HorizontalAlignment="Stretch"
                        BringIntoViewRequested="OnContentBringIntoViewRequested">
                <!-- Header: static cover, title, artist · year · duration. -->
                <Grid x:Name="FullHeader" ColumnSpacing="20" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="128" Height="128" CornerRadius="8" Background="{StaticResource FSTSurfaceMutedBrush}">
                        <Image x:Name="HeaderArt" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                    <!-- Song header title and artist line: one line each across the column, scrolling when they overflow
                         (song-header R2, web SongInfoHeader MarqueeText; issue #315). -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <controls:MarqueeText Text="{x:Bind ViewModel.Song.Title, Mode=OneWay}" TextStyle="{StaticResource TitleLargeTextBlockStyle}"
                                              AutomationProperties.HeadingLevel="Level1"
                                              AutomationProperties.AutomationId="fst.song-detail.title" />
                        <controls:MarqueeText Text="{x:Bind ViewModel.Song.Subtitle, Mode=OneWay}" TextStyle="{StaticResource FSTMarqueeSongHeaderArtistStyle}"
                                              AutomationProperties.AutomationId="fst.song-detail.artist" />
                        <!-- Paths, Item Shop and Quick Links share Fluent's 40 epx touch-target height (FSTMinTargetSize). -->
                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" Margin="0,8,0,0">
                            <Button Click="OnPathsClick" Visibility="{x:Bind ViewModel.HasPaths, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}"
                                    MinHeight="{StaticResource FSTMinTargetSize}"
                                    AutomationProperties.Name="Paths" AutomationProperties.AutomationId="fst.song-detail.paths">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE707;" FontSize="14" />
                                    <TextBlock Text="Paths" />
                                </StackPanel>
                            </Button>
                            <!-- Item Shop: the status (gold New, green in the Shop, red Leaving Tomorrow) breathes in the button's
                                 fill (web shopBreathe*, 3 s); the UIA name carries it ("Open in Item Shop, Leaving Tomorrow"). -->
                            <Button Click="OnShopClick" Visibility="{x:Bind ViewModel.HasShopLink, Mode=OneWay}" Padding="0"
                                    MinHeight="{StaticResource FSTMinTargetSize}" VerticalContentAlignment="Stretch"
                                    Background="{ThemeResource FSTShopButtonSurfaceBrush}" Foreground="{ThemeResource FSTShopBadgeTextBrush}"
                                    AutomationProperties.Name="{x:Bind ViewModel.ShopButtonName, Mode=OneWay}"
                                    AutomationProperties.AutomationId="fst.song-detail.shop"
                                    ToolTipService.ToolTip="Open the official Item Shop page">
                                <Grid>
                                    <controls:ShopPulseFill x:Name="ShopFill" CornerRadius="{StaticResource ControlCornerRadius}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="11,5,11,6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE719;" FontSize="14" />
                                        <TextBlock Text="Item Shop" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <!-- Quick Links: compact windows only (the web offers Song Detail links on mobile only). -->
                            <controls:QuickLinksMenuButton x:Name="QuickLinksMenu" />
                        </controls:WrapPanel>
                    </StackPanel>
                </Grid>

                <InfoBar IsOpen="{x:Bind ViewModel.HasShopIssue, Mode=OneWay}" IsClosable="False" Severity="Warning"
                         Message="{x:Bind ViewModel.ShopIssueText, Mode=OneWay}" AutomationProperties.AutomationId="fst.song-detail.shop-error" />

                <StackPanel x:Name="IntensitySection">
                <TextBlock Text="Intensity" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2"
                           controls:QuickLinkAnchor.Id="intensity" />
                <Border Style="{StaticResource FSTCardStyle}" AutomationProperties.AutomationId="fst.song-detail.intensity">
                    <ItemsRepeater controls:TextScaleLayout.ScaleWithText="True" ItemsSource="{x:Bind ViewModel.Intensity, Mode=OneWay}"
                                   SizeChanged="OnIntensitySizeChanged">
                        <ItemsRepeater.Layout>
                            <!-- Web IntensityCard: icon + bars cells (106 epx). 3 per row at compact/medium (3×3 for nine
                                 charts), one row at wide (OnIntensitySizeChanged). -->
                            <UniformGridLayout x:Name="IntensityLayout" MinItemWidth="106" MinItemHeight="36" MinRowSpacing="8"
                                               MinColumnSpacing="16" ItemsStretch="Fill" MaximumRowsOrColumns="3" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:IntensityRow">
                                <Grid ColumnSpacing="8" AutomationProperties.Name="{x:Bind Announcement}"
                                      ToolTipService.ToolTip="{x:Bind Label}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:InstrumentIcon File="{x:Bind IconFile}" Label="{x:Bind Label}" Width="36" Height="36"
                                                             VerticalAlignment="Center" />
                                    <controls:DifficultyMeter Grid.Column="1" Raw="{x:Bind Raw}" VerticalAlignment="Center"
                                                              HorizontalAlignment="Left" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>
                </StackPanel>

                <!-- Score history (web ScoreHistoryChart in GraphCard): selected player only; hidden when there is none. -->
                <StackPanel x:Name="HistorySection" Spacing="8" Margin="0,16,0,0" Visibility="{x:Bind ViewModel.History.IsVisible, Mode=OneWay}"
                            controls:QuickLinkAnchor.Id="score-history">
                    <Border x:Name="HistoryCard" Style="{StaticResource FSTCardStyle}" Padding="16,20">
                        <StackPanel Spacing="12">
                            <controls:InstrumentSelector x:Name="HistorySelector" IdPrefix="fst.history.instrument" Required="True"
                                                         Visibility="{x:Bind ViewModel.History.ShowChart, Mode=OneWay}" />
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.History.Title}" FontSize="22" FontWeight="Bold" TextAlignment="Center"
                                           AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="fst.history" />
                                <TextBlock Text="{x:Bind ViewModel.History.Subtitle}" TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{ThemeResource FSTSecondaryTextBrush}" Opacity="0.8"
                                           Visibility="{x:Bind ViewModel.History.ShowChart, Mode=OneWay}"
                                           AutomationProperties.AutomationId="fst.history.subtitle" />
                            </StackPanel>
                            <!-- The chart's plot carries fst.history.chart (a UserControl has no UIA peer). -->
                            <controls:SongScoreHistoryChart x:Name="HistoryChart" Model="{x:Bind ViewModel.History}" Visibility="{x:Bind ViewModel.History.ShowChart, Mode=OneWay}" />
                            <!-- Selected bar's detail row (web detail card; half width on desktop); the row itself is fst.history.detail.
                                 Stretch, centred by MaxWidth: a Center host arranged the row at its content width after it
                                 planned its columns for the wider measure width, so large text drew the season over the score.
                                 The slot keeps the row's height (empty) after a chart switch closes it, so the card keeps its size (issue #261). -->
                            <Grid x:Name="HistoryDetailSlot" Visibility="{x:Bind ViewModel.History.ShowDetailSlot, Mode=OneWay}">
                            <ContentControl x:Name="HistoryDetail" Content="{x:Bind ViewModel.History.SelectedRow, Mode=OneWay}" ContentTemplate="{StaticResource HistoryRowTemplate}"
                                            HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" MaxWidth="560" MinWidth="280"
                                            Visibility="{x:Bind ViewModel.History.HasSelectedPoint, Mode=OneWay}" IsTabStop="False" />
                            </Grid>
                            <!-- Pager row: kept (empty) while another chart pages, so switching charts keeps the card's size (issue #61). -->
                            <Grid x:Name="HistoryPagerSlot" MinHeight="40" Visibility="{x:Bind ViewModel.History.ShowPagerSlot, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center"
                                        Visibility="{x:Bind ViewModel.History.ShowPaging, Mode=OneWay}">
                                <Button Command="{x:Bind ViewModel.History.BackPageCommand}" IsEnabled="{x:Bind ViewModel.History.CanGoBack, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.History.ShowPageJumps, Mode=OneWay}" Width="40" Height="40" CornerRadius="20" Padding="0"
                                        AutomationProperties.Name="Back one page" ToolTipService.ToolTip="Back one page"
                                        AutomationProperties.AutomationId="fst.history.page-back">
                                    <FontIcon Glyph="&#xE892;" FontSize="12" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.History.BackEntryCommand}" IsEnabled="{x:Bind ViewModel.History.CanGoBack, Mode=OneWay}"
                                        Width="40" Height="40" CornerRadius="20" Padding="0"
                                        AutomationProperties.Name="Back one entry" ToolTipService.ToolTip="Back one entry"
                                        AutomationProperties.AutomationId="fst.history.entry-back">
                                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.History.ForwardEntryCommand}" IsEnabled="{x:Bind ViewModel.History.CanGoForward, Mode=OneWay}"
                                        Width="40" Height="40" CornerRadius="20" Padding="0"
                                        AutomationProperties.Name="Forward one entry" ToolTipService.ToolTip="Forward one entry"
                                        AutomationProperties.AutomationId="fst.history.entry-forward">
                                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.History.ForwardPageCommand}" IsEnabled="{x:Bind ViewModel.History.CanGoForward, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.History.ShowPageJumps, Mode=OneWay}" Width="40" Height="40" CornerRadius="20" Padding="0"
                                        AutomationProperties.Name="Forward one page" ToolTipService.ToolTip="Forward one page"
                                        AutomationProperties.AutomationId="fst.history.page-forward">
                                    <FontIcon Glyph="&#xE893;" FontSize="12" />
                                </Button>
                            </StackPanel>
                            </Grid>
                            <!-- 202: still preparing (paused, never "no history"). -->
                            <StackPanel Spacing="8" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.History.ShowSyncing, Mode=OneWay}">
                                <TextBlock Text="This player's score history is still being prepared. Try again shortly." TextWrapping="Wrap"
                                           TextAlignment="Center" AutomationProperties.LiveSetting="Polite"
                                           AutomationProperties.AutomationId="fst.history.message" />
                                <Button Content="Retry" HorizontalAlignment="Center" Command="{x:Bind ViewModel.History.RetryCommand}"
                                        AutomationProperties.Name="Retry score history" AutomationProperties.AutomationId="fst.history.retry" />
                            </StackPanel>
                            <controls:ServiceStatusInline HorizontalAlignment="Center" IsCentered="True"
                                                          Visibility="{x:Bind ViewModel.History.ShowError, Mode=OneWay}"
                                                          Status="{x:Bind ViewModel.History.Status}"
                                                          TitleAutomationId="fst.history.error" RetryAutomationId="fst.history.retry" />
                        </StackPanel>
                    </Border>
                    <!-- Sort applies to the list (Fluent command menu; web list order is Score, descending). -->
                    <DropDownButton HorizontalAlignment="Right" Visibility="{x:Bind ViewModel.History.ShowChart, Mode=OneWay}"
                                    MinHeight="{StaticResource FSTMinTargetSize}"
                                    AutomationProperties.Name="{x:Bind ViewModel.History.SortAnnouncement, Mode=OneWay}"
                                    AutomationProperties.AutomationId="fst.history.sort.open">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                            <TextBlock Text="{x:Bind ViewModel.History.SortLabel, Mode=OneWay}" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedRight" Opening="OnSortMenuOpening">
                                <RadioMenuFlyoutItem Text="Date" GroupName="mode" Tag="Date" Click="OnSortModeClick" AutomationProperties.AutomationId="fst.history.sort.mode.date" />
                                <RadioMenuFlyoutItem Text="Score" GroupName="mode" Tag="Score" Click="OnSortModeClick" AutomationProperties.AutomationId="fst.history.sort.mode.score" />
                                <RadioMenuFlyoutItem Text="Accuracy" GroupName="mode" Tag="Accuracy" Click="OnSortModeClick" AutomationProperties.AutomationId="fst.history.sort.mode.accuracy" />
                                <RadioMenuFlyoutItem Text="Season" GroupName="mode" Tag="Season" Click="OnSortModeClick" AutomationProperties.AutomationId="fst.history.sort.mode.season" />
                                <MenuFlyoutSeparator />
                                <RadioMenuFlyoutItem Text="Ascending" GroupName="direction" Tag="asc" Click="OnSortDirectionClick" AutomationProperties.AutomationId="fst.history.sort.direction.ascending" />
                                <RadioMenuFlyoutItem Text="Descending" GroupName="direction" Tag="desc" Click="OnSortDirectionClick" AutomationProperties.AutomationId="fst.history.sort.direction.descending" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Reset" Command="{x:Bind ViewModel.History.ResetSortCommand}" AutomationProperties.AutomationId="fst.history.sort.reset" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <ItemsRepeater x:Name="HistoryRows" ItemsSource="{x:Bind ViewModel.History.Rows, Mode=OneWay}" ItemTemplate="{StaticResource HistoryRowTemplate}"
                                   Visibility="{x:Bind ViewModel.History.ShowChart, Mode=OneWay}" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="56"
                                   AutomationProperties.Name="Score history" AutomationProperties.AutomationId="fst.history.rows">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <Button x:Name="HistoryViewAll" Content="{x:Bind ViewModel.History.ViewAllText}" Command="{x:Bind ViewModel.History.ViewAllCommand}"
                            Style="{StaticResource FSTViewAllButtonStyle}" Visibility="{x:Bind ViewModel.History.CanViewAll, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.History.ViewAllName, Mode=OneWay}"
                            AutomationProperties.AutomationId="{x:Bind ViewModel.History.ViewAllAutomationId}" />
                </StackPanel>

                <StackPanel x:Name="LeaderboardsSection">
                <TextBlock Text="Leaderboards" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
                </StackPanel>
                <!-- Every card and row stays realized (issue #195): a virtualized element is not in the Tab order, so a
                     single-column compact window skipped the lower charts' rows and the band sections. The card grid is
                     non-virtualizing (one card per instrument) and the rows keep a 20-viewport cache. -->
                <ItemsRepeater TabFocusNavigation="Local" XYFocusKeyboardNavigation="Enabled" x:Name="Boards" ItemsSource="{x:Bind ViewModel.Leaderboards, Mode=OneWay}"
                               ElementPrepared="OnBoardPrepared">
                    <ItemsRepeater.Layout>
                        <!-- At most two cards per row (web isTwoCol), even on wide windows; two already at a portrait tablet.
                             Each row is as tall as its tallest card (CSS grid rows), so a card with row eleven or a failure
                             never clips, which UniformGridLayout (every item sized from the first) did. -->
                        <controls:LeaderboardsCardGridLayout MinColumnWidth="320" MaxColumns="2" Spacing="16" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:LeaderboardPreviewViewModel">
                            <!-- Header above the card (web InstrumentCard cardLabel) with the chart's total entries; rows, the
                                 player's own row eleven when outside the top ten, then the accent View Full Leaderboard. -->
                            <controls:AccessibleGroup AutomationProperties.Name="{x:Bind HeaderName, Mode=OneWay}"
                                                      controls:QuickLinkAnchor.Id="{x:Bind QuickLinkId}">
                                <StackPanel Spacing="8">
                                    <controls:CardHeader Title="{x:Bind Title}" IconFile="{x:Bind IconFile}" HeadingLevel="Level3" MinHeight="44"
                                                         Subtitle="{x:Bind TotalEntriesText, Mode=OneWay}" />
                                    <!-- No card around the rows: each is its own frosted row (web InstrumentCard cardBody,
                                         operator batch 7.7); loading, empty and failed charts sit on their own card. -->
                                    <StackPanel Spacing="4">
                                        <Border Style="{StaticResource FSTCardStyle}" MinHeight="96" Visibility="{x:Bind ShowPlaceholder, Mode=OneWay}">
                                            <StackPanel Spacing="8">
                                                <ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}" HorizontalAlignment="Left" Width="24" Height="24"
                                                              Visibility="{x:Bind IsLoading, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind EmptyText}" Visibility="{x:Bind ShowEmpty, Mode=OneWay}" TextWrapping="Wrap"
                                                           Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource FSTSecondaryTextBrush}" />
                                                <controls:ServiceStatusInline Visibility="{x:Bind ShowError, Mode=OneWay}" Status="{x:Bind Status}" />
                                            </StackPanel>
                                        </Border>
                                        <!-- Top-ten rows open the player; the player's own row eleven opens the full board at their
                                             page (web InstrumentCardRowLink). -->
                                        <ItemsRepeater XYFocusKeyboardNavigation="Enabled" ItemsSource="{x:Bind Rows, Mode=OneWay}" VerticalCacheLength="20"
                                                       Visibility="{x:Bind ShowRows, Mode=OneWay}"
                                                       controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="52">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="4" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LeaderboardRow">
                                                    <controls:LeaderboardEntryRow Row="{x:Bind}" />
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                        <Button Content="{x:Bind ViewAllText}" Tag="{x:Bind}" Click="OnViewFull" Style="{StaticResource FSTViewAllButtonStyle}"
                                                Visibility="{x:Bind ShowRows, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewAllName}"
                                                AutomationProperties.AutomationId="{x:Bind ViewAllAutomationId}" />
                                    </StackPanel>
                                </StackPanel>
                            </controls:AccessibleGroup>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Band previews (web SongBandLeaderboardPreview, iOS SongBandPreviewSection, issue #34/#64): one section per band
                     size after the instrument cards, all from one keyless /bands/all read that never holds the page spinner.
                     Rows open Band Detail; the selected player's band is purple in place or appended after the top ten. -->
                <ItemsRepeater TabFocusNavigation="Local" XYFocusKeyboardNavigation="Enabled" x:Name="BandBoards" Margin="0,16,0,0"
                               ItemsSource="{x:Bind ViewModel.BandPreviews, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <!-- Trios and Quads rows (three or four members) are taller than Duos: rows size to their tallest card. -->
                        <controls:LeaderboardsCardGridLayout MinColumnWidth="320" MaxColumns="2" Spacing="16" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SongBandPreviewViewModel">
                            <controls:AccessibleGroup AutomationProperties.Name="{x:Bind HeaderName, Mode=OneWay}"
                                                      controls:QuickLinkAnchor.Id="{x:Bind QuickLinkId}">
                                <StackPanel Spacing="8">
                                    <controls:CardHeader Title="{x:Bind Title}" HeadingLevel="Level3" MinHeight="44"
                                                         Subtitle="{x:Bind Subtitle, Mode=OneWay}"
                                                         TitleAutomationId="{x:Bind HeaderAutomationId}" />
                                    <StackPanel Spacing="4">
                                        <Border Style="{StaticResource FSTCardStyle}" MinHeight="96" Visibility="{x:Bind ShowPlaceholder, Mode=OneWay}">
                                            <StackPanel Spacing="8">
                                                <ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}" HorizontalAlignment="Left" Width="24" Height="24"
                                                              Visibility="{x:Bind IsLoading, Mode=OneWay}" AutomationProperties.Name="Loading band scores"
                                                              AutomationProperties.AutomationId="{x:Bind LoadingAutomationId}" />
                                                <TextBlock Text="{x:Bind EmptyText}" Visibility="{x:Bind ShowEmpty, Mode=OneWay}" TextWrapping="Wrap"
                                                           Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource FSTSecondaryTextBrush}"
                                                           AutomationProperties.AutomationId="{x:Bind EmptyAutomationId}" />
                                                <controls:ServiceStatusInline Visibility="{x:Bind ShowError, Mode=OneWay}" Status="{x:Bind Status}"
                                                                              RetryAutomationId="{x:Bind RetryAutomationId}" />
                                            </StackPanel>
                                        </Border>
                                        <ItemsRepeater XYFocusKeyboardNavigation="Enabled" ItemsSource="{x:Bind Rows, Mode=OneWay}" VerticalCacheLength="20"
                                                       Visibility="{x:Bind ShowRows, Mode=OneWay}" controls:BandScoreFooterPanel.IsSection="True"
                                                       controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="96">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="4" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SongBandPreviewRow">
                                                    <controls:SongBandPreviewRowView Row="{x:Bind}" />
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                        <Button Content="{x:Bind ViewAllText}" Tag="{x:Bind}" Click="OnBandViewFull" Style="{StaticResource FSTViewAllButtonStyle}"
                                                Visibility="{x:Bind ShowRows, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewAllName}"
                                                AutomationProperties.AutomationId="{x:Bind ViewAllAutomationId}" />
                                    </StackPanel>
                                </StackPanel>
                            </controls:AccessibleGroup>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <!-- Compact header pinned once the full header scrolls away (web sticky song header): art, title, Paths. -->
        <Border x:Name="PinnedHeader" VerticalAlignment="Top" Visibility="Collapsed" Padding="24,8" controls:FadeIn.OnShow="True"
                Background="{ThemeResource FSTPinnedHeaderBrush}" BorderBrush="{ThemeResource FSTCardStrokeBrush}" BorderThickness="0,0,0,1"
                AutomationProperties.AutomationId="fst.song-detail.pinned-header">
            <Grid ColumnSpacing="12" MaxWidth="1152">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="6" Background="{StaticResource FSTSurfaceMutedBrush}">
                    <Image x:Name="PinnedArt" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <controls:MarqueeText Text="{x:Bind ViewModel.Song.Title, Mode=OneWay}" TextStyle="{StaticResource FSTMarqueeTitleStyle}"
                                          AutomationProperties.AutomationId="fst.song-detail.pinned-title" />
                    <controls:MarqueeText Text="{x:Bind ViewModel.Song.Subtitle, Mode=OneWay}" TextStyle="{StaticResource FSTMarqueeCaptionStyle}"
                                          AutomationProperties.AutomationId="fst.song-detail.pinned-artist" />
                </StackPanel>
                <Button Grid.Column="2" Click="OnPathsClick" Visibility="{x:Bind ViewModel.HasPaths, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center" AutomationProperties.Name="Paths" AutomationProperties.AutomationId="fst.song-detail.pinned-paths">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE707;" FontSize="14" />
                        <TextBlock Text="Paths" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Web ArcSpinner: shown until every section is ready, then faded out (500 ms) before the content staggers in. -->
        <ProgressRing x:Name="Spinner" IsActive="True" Width="48" Height="48" AutomationProperties.Name="Loading song" />
        <controls:ServiceStatusView Status="{x:Bind ViewModel.Status}" VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}" />
    </Grid>
</Page>
