<Page
    x:Class="Festival.App.Pages.BandsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    Background="Transparent">

    <!-- /bands without an ID: the web BandPage's "Band not found" empty state (operator 2026-09-28: no hub). -->
    <Grid Padding="24,12,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Band" Style="{StaticResource FSTPageTitleStyle}" AutomationProperties.HeadingLevel="Level1"
                   AutomationProperties.AutomationId="fst.bands.title" />
        <!-- Shared empty state (issue #377): centred, scrolls when large text or a short window would clip it. -->
        <controls:EmptyStateView x:Name="NotFound" Grid.Row="1" Title="Band not found"
                                 Subtitle="This band link is missing an ID and cannot be resolved."
                                 TitleAutomationId="fst.bands.not-found" SubtitleAutomationId="fst.bands.not-found.message"
                                 RegionAutomationId="fst.bands.screen" />
    </Grid>
</Page>
