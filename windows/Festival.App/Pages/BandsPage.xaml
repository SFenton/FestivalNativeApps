<Page
    x:Class="Festival.App.Pages.BandsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <!-- /bands without an ID: the web BandPage's "Band not found" empty state (operator 2026-09-28: no hub). -->
    <Grid Padding="24,12,24,32" AutomationProperties.AutomationId="fst.bands.screen">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Band" Style="{StaticResource FSTPageTitleStyle}" AutomationProperties.HeadingLevel="Level1"
                   AutomationProperties.AutomationId="fst.bands.title" />
        <StackPanel Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560"
                    AutomationProperties.AutomationId="fst.bands.not-found">
            <TextBlock Text="Band not found" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center"
                       HorizontalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock Text="This band link is missing an ID and cannot be resolved." TextAlignment="Center"
                       TextWrapping="Wrap" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
