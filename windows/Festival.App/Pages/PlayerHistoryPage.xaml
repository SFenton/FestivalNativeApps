<Page
    x:Class="Festival.App.Pages.PlayerHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    Background="Transparent">
    <!--
        /songs/:songId/:instrument/history (web PlayerHistoryPage), opened by Song Detail's "View All Scores" (view-all-cta
        R8, issue #324): the song-first header (song-leaderboard-header) with the page's Sort beside it stays fixed, then every
        score as a shared leaderboard row (date label, personal best highlighted wherever the sort puts it). Sort applies at
        once from a DropDownButton menu (Fluent command menu, like Songs' SortButton); a new order returns to the top.
    -->
    <Grid x:Name="PageRoot" Padding="24,12,24,0" RowSpacing="12" MaxWidth="1100">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:SongLeaderboardHeader x:Name="Header" controls:FadeIn.OnShow="True"
                                            Title="{x:Bind ViewModel.Title, Mode=OneWay}" Artist="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                                            BoardIconFile="{x:Bind ViewModel.IconFile, Mode=OneWay}" BoardLabel="{x:Bind ViewModel.InstrumentLabel}"
                                            TitleAutomationId="fst.history.title" ArtistAutomationId="fst.history.artist"
                                            BoardAutomationId="fst.history.instrument" TotalAutomationId="fst.history.total"
                                            SongAutomationId="fst.history.song" TitleInvoked="OnSongTitle" />
            <DropDownButton Grid.Column="1" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.ShowRows, Mode=OneWay}"
                            MinHeight="{StaticResource FSTMinTargetSize}"
                            AutomationProperties.Name="{x:Bind ViewModel.SortAnnouncement, Mode=OneWay}"
                            AutomationProperties.AutomationId="fst.history.sort.open">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                    <TextBlock Text="{x:Bind ViewModel.SortLabel, Mode=OneWay}" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedRight" Opening="OnSortMenuOpening">
                        <RadioMenuFlyoutItem Text="Date" GroupName="mode" Tag="Date" Click="OnSortModeClick" AutomationProperties.AutomationId="fst.history.sort.mode.date" />
                        <RadioMenuFlyoutItem Text="Score" GroupName="mode" Tag="Score" Click="OnSortModeClick" AutomationProperties.AutomationId="fst.history.sort.mode.score" />
                        <RadioMenuFlyoutItem Text="Accuracy" GroupName="mode" Tag="Accuracy" Click="OnSortModeClick" AutomationProperties.AutomationId="fst.history.sort.mode.accuracy" />
                        <RadioMenuFlyoutItem Text="Season" GroupName="mode" Tag="Season" Click="OnSortModeClick" AutomationProperties.AutomationId="fst.history.sort.mode.season" />
                        <MenuFlyoutSeparator />
                        <RadioMenuFlyoutItem Text="Ascending" GroupName="direction" Tag="asc" Click="OnSortDirectionClick" AutomationProperties.AutomationId="fst.history.sort.direction.ascending" />
                        <RadioMenuFlyoutItem Text="Descending" GroupName="direction" Tag="desc" Click="OnSortDirectionClick" AutomationProperties.AutomationId="fst.history.sort.direction.descending" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Reset" Click="OnSortResetClick" AutomationProperties.AutomationId="fst.history.sort.reset" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- One frosted row per score, 4 epx apart, like the song leaderboard (web LeaderboardEntry list). -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" Visibility="{x:Bind ViewModel.ShowRows, Mode=OneWay}"
                      AutomationProperties.AutomationId="fst.history.list">
            <ItemsRepeater x:Name="RowsRepeater" XYFocusKeyboardNavigation="Enabled" Margin="0,0,0,16"
                           ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="52"
                           AutomationProperties.Name="Score history" AutomationProperties.AutomationId="fst.history.rows">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScoreHistoryListRow">
                        <controls:LeaderboardEntryRow Row="{x:Bind}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="48" Height="48"
                      AutomationProperties.Name="Loading score history" />

        <Border Grid.Row="1" Style="{StaticResource FSTCardStyle}" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.ShowMessage, Mode=OneWay}">
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind ViewModel.MessageTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="fst.history.message" />
                <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <Button Content="Retry" Command="{x:Bind ViewModel.LoadCommand}" Visibility="{x:Bind ViewModel.CanRetryMessage, Mode=OneWay}"
                        AutomationProperties.Name="Retry score history" AutomationProperties.AutomationId="fst.history.retry" />
            </StackPanel>
        </Border>

        <controls:ServiceStatusView Grid.Row="1" Status="{x:Bind ViewModel.Status}" VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}" />

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="12,8,12,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
