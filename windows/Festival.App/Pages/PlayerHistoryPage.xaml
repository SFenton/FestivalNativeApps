<Page
    x:Class="Festival.App.Pages.PlayerHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    Background="Transparent">
    <!--
        /songs/:songId/:instrument/history: the selected player's score changes. Sort applies immediately from a
        DropDownButton menu (Fluent command menu), the personal best follows the sort, and the chart is a native addition.
    -->
    <Grid Padding="24,12,24,16" RowSpacing="12" MaxWidth="1100">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:InstrumentIcon File="{x:Bind ViewModel.IconFile, Mode=OneWay}" Label="{x:Bind ViewModel.InstrumentLabel}"
                                     Width="36" Height="36" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource FSTPageTitleStyle}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level1"
                           AutomationProperties.AutomationId="fst.history" />
                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource FSTSecondaryTextStyle}"
                           AutomationProperties.AutomationId="fst.history.subtitle" />
            </StackPanel>
            <DropDownButton Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.ShowRows, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.SortAnnouncement, Mode=OneWay}"
                            AutomationProperties.AutomationId="fst.history.sort.open">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                    <TextBlock Text="{x:Bind ViewModel.SortLabel, Mode=OneWay}" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedRight" Opening="OnSortMenuOpening">
                        <RadioMenuFlyoutItem Text="Date" GroupName="mode" Tag="Date" Click="OnSortModeClick" AutomationProperties.AutomationId="fst.history.sort.mode.date" />
                        <RadioMenuFlyoutItem Text="Score" GroupName="mode" Tag="Score" Click="OnSortModeClick" AutomationProperties.AutomationId="fst.history.sort.mode.score" />
                        <RadioMenuFlyoutItem Text="Accuracy" GroupName="mode" Tag="Accuracy" Click="OnSortModeClick" AutomationProperties.AutomationId="fst.history.sort.mode.accuracy" />
                        <RadioMenuFlyoutItem Text="Season" GroupName="mode" Tag="Season" Click="OnSortModeClick" AutomationProperties.AutomationId="fst.history.sort.mode.season" />
                        <MenuFlyoutSeparator />
                        <RadioMenuFlyoutItem Text="Ascending" GroupName="direction" Tag="asc" Click="OnSortDirectionClick" AutomationProperties.AutomationId="fst.history.sort.direction.ascending" />
                        <RadioMenuFlyoutItem Text="Descending" GroupName="direction" Tag="desc" Click="OnSortDirectionClick" AutomationProperties.AutomationId="fst.history.sort.direction.descending" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Reset" Command="{x:Bind ViewModel.ResetSortCommand}" AutomationProperties.AutomationId="fst.history.sort.reset" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- Loaded: chart (2+ dated rows) + virtualized rows -->
        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="64" SelectionMode="None" IsItemClickEnabled="False"
                  Visibility="{x:Bind ViewModel.ShowRows, Mode=OneWay}" AutomationProperties.AutomationId="fst.history.rows"
                  AutomationProperties.Name="Score history">
            <ListView.Header>
                <Border Style="{StaticResource FSTCardStyle}" Margin="0,0,0,12" Visibility="{x:Bind ViewModel.HasChart, Mode=OneWay}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Score Over Time" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                        <controls:ScoreHistoryChart Model="{x:Bind ViewModel.Chart, Mode=OneWay}" AutomationProperties.AutomationId="fst.history.chart" />
                    </StackPanel>
                </Border>
            </ListView.Header>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ScoreHistoryRow">
                    <Border Style="{StaticResource FSTCardStyle}" Padding="16,10" AutomationProperties.Name="{x:Bind Announcement}"
                            BorderBrush="{x:Bind controls:PlayerBrushes.Highlight(IsHighScore)}">
                        <Grid ColumnSpacing="12" RowSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{x:Bind Score}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"
                                       Foreground="{x:Bind controls:PlayerBrushes.Stars(IsHighScore)}" />
                            <controls:StarRow Grid.Column="1" Stars="{x:Bind StarCount}" StarSize="14" HorizontalAlignment="Right"
                                              AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Grid.Row="1" Text="{x:Bind Detail}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource FSTSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <Border CornerRadius="4" Padding="6,2" Background="{ThemeResource FSTSurfaceMutedBrush}" Visibility="{x:Bind HasAccuracy}">
                                    <TextBlock Text="{x:Bind Accuracy}" FontSize="12" />
                                </Border>
                                <Border CornerRadius="4" Padding="6,2" Background="{ThemeResource FSTGoldBrush}" Visibility="{x:Bind IsFullCombo}">
                                    <TextBlock Text="FC" FontSize="12" FontWeight="SemiBold" Foreground="Black" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="48" Height="48"
                      AutomationProperties.Name="Loading score history" />

        <Border Grid.Row="1" Style="{StaticResource FSTCardStyle}" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.ShowMessage, Mode=OneWay}">
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind ViewModel.MessageTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="fst.history.message" />
                <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <Button Content="Retry" Command="{x:Bind ViewModel.LoadCommand}" Visibility="{x:Bind ViewModel.CanRetryMessage, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <controls:ServiceStatusView Grid.Row="1" Status="{x:Bind ViewModel.Status}" VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}" />
    </Grid>
</Page>
