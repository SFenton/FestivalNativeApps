<Page
    x:Class="Festival.App.Pages.RivalDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    Background="Transparent">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide" />
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter Target="ProfileButton.(Grid.Row)" Value="1" />
                        <Setter Target="ProfileButton.(Grid.Column)" Value="0" />
                        <Setter Target="ProfileButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="Header.Padding" Value="16,8,16,8" />
                        <Setter Target="Scroller.Padding" Value="16,0,16,24" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="Header" Padding="24,12,24,8" ColumnSpacing="16" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource FSTPageTitleStyle}" TextWrapping="Wrap"
                           AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="fst.rival-detail.title" />
                <!-- Subtitle (#604): "Rivals", or "{icon} {Instrument} Rivals" for a single-instrument scope. The icon is
                     decorative (Raw) and sized to the body line like SongLeaderboardHeader's board line, so Narrator
                     reads the subtitle once (page-tools-and-nav-chrome R23). The gap is the icon's margin, not ColumnSpacing, so plain
                     "Rivals" stays aligned with the title when the icon is collapsed. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:InstrumentIcon File="{x:Bind ViewModel.SubtitleIconFile, Mode=OneWay}" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Visibility="{x:Bind ViewModel.HasSubtitleIcon, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource FSTSecondaryTextStyle}"
                               TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="fst.rival-detail.subtitle" />
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                           Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}" AutomationProperties.AutomationId="fst.rival-detail.summary" controls:FadeIn.OnShow="True" />
            </StackPanel>
            <!-- Shares the compact header row with Quick Links (40 epx): same height (issue #72 touch targets). -->
            <Button x:Name="ProfileButton" Grid.Column="1" VerticalAlignment="Top" Click="OnViewProfile" MinHeight="{StaticResource FSTMinTargetSize}"
                    AutomationProperties.Name="{x:Bind ViewModel.ViewProfileLabel, Mode=OneWay}"
                    AutomationProperties.AutomationId="fst.rival-detail.view-profile">
                <!-- Grid, not a horizontal StackPanel: the label gets a finite width and wraps at 200% text instead of clipping. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE77B;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ViewProfileLabel, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <!-- Quick Links: compact windows only (the web offers Rival Detail links on mobile only). Declared after View
                 Profile so Tab and Narrator follow the compact row left to right. -->
            <controls:QuickLinksMenuButton x:Name="QuickLinksMenu" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" />
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" Padding="24,0,24,32" Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}"
                      AutomationProperties.AutomationId="fst.rival-detail">
            <ItemsRepeater TabFocusNavigation="Local" XYFocusKeyboardNavigation="Enabled" ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}" MaxWidth="1600" Margin="0,4,0,0" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="360">
                <ItemsRepeater.Layout>
                    <controls:MasonryLayout MinColumnWidth="400" ColumnSpacing="16" RowSpacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:RivalCategoryItem">
                        <!-- Named UIA group: a song in several categories is not an ambiguous sibling. -->
                        <controls:AccessibleGroup AutomationProperties.Name="{x:Bind Title}" controls:QuickLinkAnchor.Id="{x:Bind QuickLinkId}">
                            <StackPanel Spacing="8">
                            <!-- Header above the card (web RivalDetailPage section header): title in its sentiment colour, subtitle. -->
                            <StackPanel Padding="4,0" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}"
                                           Foreground="{x:Bind controls:RivalsUi.Sentiment(Sentiment)}" AutomationProperties.HeadingLevel="Level2"
                                           AutomationProperties.AutomationId="{x:Bind AutomationId}" />
                                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource FSTSecondaryTextBrush}" />
                            </StackPanel>
                            <Border Style="{StaticResource FSTCardStyle}" Padding="8,8,8,12">
                                <StackPanel Spacing="4">
                                    <!-- One card per category: the rows share it with an inset hairline between them, like Apple's
                                         FestivalGlassSection rows (RowSeparators; issue #603). -->
                                    <ItemsRepeater XYFocusKeyboardNavigation="Enabled" ItemsSource="{x:Bind Preview}" controls:RowSeparators.Enabled="True">
                                        <ItemsRepeater.Layout>
                                            <controls:LeaderboardsCardGridLayout MaxColumns="1" MinColumnWidth="0" Spacing="2" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RivalSongItem">
                                                <Button Style="{StaticResource FSTRivalRowButtonStyle}" Tag="{x:Bind Route}" Click="OnRouteClick"
                                                        AutomationProperties.Name="{x:Bind AccessibleName}"
                                                        AutomationProperties.AutomationId="{x:Bind AutomationId}">
                                                    <Grid>
                                                        <Border x:Name="RowSeparator" Height="1" Margin="0,-6,0,0" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"
                                                                Background="{ThemeResource FSTRowSeparatorBrush}" AutomationProperties.AccessibilityView="Raw" />
                                                        <controls:RivalSongRowView Item="{x:Bind}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <!-- The shared View All button after the rows, like the hub's View All Rivals (view-all-cta R6, #321). -->
                                    <Button Content="{x:Bind ViewAllText}" Tag="{x:Bind ViewAllRoute}" Click="OnRouteClick"
                                            Style="{StaticResource FSTViewAllButtonStyle}"
                                            AutomationProperties.Name="{x:Bind ViewAllName}"
                                            AutomationProperties.AutomationId="{x:Bind ViewAllAutomationId}" />
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </controls:AccessibleGroup>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <controls:RivalPageStates Grid.Row="1" Page="{x:Bind ViewModel}" />
    </Grid>
</Page>
