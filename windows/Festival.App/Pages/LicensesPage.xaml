<Page
    x:Class="Festival.App.Pages.LicensesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Festival.Core.ViewModels"
    Background="Transparent">
    <Page.Resources>
        <DataTemplate x:Key="LicenseRowTemplate" x:DataType="vm:LicenseRowViewModel">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,10" Margin="0,0,0,4"
                    Background="{ThemeResource FSTCardSurfaceBrush}" BorderBrush="{ThemeResource FSTCardStrokeBrush}"
                    CornerRadius="{StaticResource OverlayCornerRadius}" Click="OnRowClick" Tag="{x:Bind}"
                    AutomationProperties.Name="{x:Bind AccessibleName}" AutomationProperties.AutomationId="{x:Bind AutomationId}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource FSTSecondaryTextBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="4" Padding="8,2"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <TextBlock Text="{x:Bind License}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer AutomationProperties.AutomationId="fst.licenses">
        <StackPanel Padding="24,12,24,32" Spacing="4" MaxWidth="880" HorizontalAlignment="Left">
            <TextBlock Text="Licenses" Style="{StaticResource FSTPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="{x:Bind ViewModel.Summary}" Style="{StaticResource FSTSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                       AutomationProperties.AutomationId="fst.licenses.summary" />
            <TextBlock Text="Packages" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2"
                       Visibility="{x:Bind ViewModel.HasNoPackages, Converter={StaticResource FSTInverseVisibility}}" />
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Packages}" ItemTemplate="{StaticResource LicenseRowTemplate}"
                           AutomationProperties.AutomationId="fst.licenses.packages" />
            <TextBlock Text="Bundled Assets" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Assets}" ItemTemplate="{StaticResource LicenseRowTemplate}" />
        </StackPanel>
    </ScrollViewer>
</Page>
