<Page
    x:Class="Festival.App.Pages.LicensesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    Background="Transparent">
    <Page.Resources>
        <!-- Web packageRow inside one frosted card: name + "NuGet · version", license badge, chevron; a hairline between
             entries and the shared row hover/press fills (Styles.xaml FSTRow*Brush), which map to system colours under a
             contrast theme. Text and chevron inherit the button foreground so hover/press keep the theme's pair
             (Highlight / HighlightText). When the row is narrow for the text size the badge moves under the name
             (OnRowContentSizeChanged, Core LicenseRowLayout) and the name wraps rather than truncating. -->
        <DataTemplate x:Key="LicenseRowTemplate" x:DataType="vm:LicenseRowViewModel">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,12" CornerRadius="0"
                    BorderThickness="0,0,0,1" Click="OnRowClick" Tag="{x:Bind}"
                    AutomationProperties.Name="{x:Bind AccessibleName}" AutomationProperties.AutomationId="{x:Bind AutomationId}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="FSTRowHoverBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="FSTRowPressedBrush" />
                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="FSTRowSeparatorBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="FSTRowSeparatorBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="FSTRowSeparatorBrush" />
                </Button.Resources>
                <Grid ColumnSpacing="12" SizeChanged="OnRowContentSizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <Border Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" CornerRadius="4" Padding="8,2" MaxWidth="220"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <TextBlock Text="{x:Bind License}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <FontIcon Grid.Column="2" Grid.RowSpan="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                              AutomationProperties.AccessibilityView="Raw" />
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer AutomationProperties.AutomationId="fst.licenses" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <!-- The Grid takes the viewport width so the MaxWidth column centres (a MaxWidth child placed directly in the
             ScrollViewer was centred in a wider extent and clipped on the right). -->
        <Grid>
        <StackPanel Padding="24,12,24,32" Spacing="4" MaxWidth="1100" HorizontalAlignment="Stretch" controls:FadeIn.OnShow="True">
            <TextBlock Text="Licenses" Style="{StaticResource FSTPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="{x:Bind ViewModel.Summary}" Style="{StaticResource FSTSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"
                       AutomationProperties.AutomationId="fst.licenses.summary" />
            <Border Style="{StaticResource FSTCardStyle}" Padding="0" Visibility="{x:Bind ViewModel.HasNoPackages, Converter={StaticResource FSTInverseVisibility}}">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Packages}" ItemTemplate="{StaticResource LicenseRowTemplate}"
                               TabFocusNavigation="Local" XYFocusKeyboardNavigation="Enabled"
                               AutomationProperties.Name="Packages" AutomationProperties.AutomationId="fst.licenses.packages" />
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
