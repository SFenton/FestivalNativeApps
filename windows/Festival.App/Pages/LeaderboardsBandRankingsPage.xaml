<Page
    x:Class="Festival.App.Pages.LeaderboardsBandRankingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    Background="Transparent">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshInvoked" />
    </Page.KeyboardAccelerators>

    <!-- Band Rankings: header + band size / Rank By switchers, 25 rows, pager. -->
    <Grid x:Name="PageRoot" Padding="24,12,24,12" RowSpacing="12" MaxWidth="1100">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Wide pages (>= 1100 epx) show the rankings beside the chosen band's detail (operator 2026-09-28: two
             populated columns, never an empty detail). ApplySplit sets the widths. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Grid ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource FSTPageTitleStyle}"
                           AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="fst.band-rankings.title" />
                <TextBlock Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" Style="{StaticResource FSTSecondaryTextStyle}" />
            </StackPanel>
            <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <DropDownButton MinHeight="{StaticResource FSTMinTargetSize}" AutomationProperties.Name="{x:Bind ViewModel.BandTypeButtonName, Mode=OneWay}"
                                AutomationProperties.AutomationId="fst.band-rankings.band-type-menu">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE716;" FontSize="18" />
                        <TextBlock x:Name="BandSizeText" Text="Band Size" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="BandTypeMenu" Placement="BottomEdgeAlignedRight" Opening="OnBandTypeMenuOpening" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton MinHeight="{StaticResource FSTMinTargetSize}" AutomationProperties.Name="{x:Bind ViewModel.MetricButtonName, Mode=OneWay}"
                                AutomationProperties.AutomationId="fst.band-rankings.rank-by-menu">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8CB;" FontSize="18" />
                        <TextBlock Text="{x:Bind ViewModel.MetricLabel, Mode=OneWay}" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="MetricMenu" Placement="BottomEdgeAlignedRight" Opening="OnMetricMenuOpening" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!-- One frosted row per band, 4 epx apart (web entryRow list, operator batch 7.7), scrolling on beneath the
             floating pager (BoardFooter). -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" Grid.RowSpan="2" Visibility="{x:Bind ViewModel.ShowRows, Mode=OneWay}"
                      controls:LoadSwapVisual.Swap="{x:Bind ViewModel.LoadSwap, Mode=OneWay}" controls:LoadSwapVisual.Role="Content"
                      AutomationProperties.AutomationId="fst.band-rankings.list">
            <ItemsRepeater x:Name="RowsRepeater" XYFocusKeyboardNavigation="Enabled" Margin="0,4,0,0" VerticalAlignment="Top"
                           ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="52"
                           ElementPrepared="OnRowPrepared">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:BandRankingRowViewModel">
                        <controls:LeaderboardEntryRow Row="{x:Bind}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Style="{StaticResource FSTSecondaryTextStyle}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                   AutomationProperties.AutomationId="fst.band-rankings.empty"
                   controls:LoadSwapVisual.Swap="{x:Bind ViewModel.LoadSwap, Mode=OneWay}" controls:LoadSwapVisual.Role="Content"
                   Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" />
        <ProgressRing Grid.Row="1" Width="48" Height="48" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      controls:LoadSwapVisual.Swap="{x:Bind ViewModel.LoadSwap, Mode=OneWay}" controls:LoadSwapVisual.Role="Spinner"
                      AutomationProperties.Name="Loading rankings" />
        <controls:ServiceStatusView Grid.Row="1" Status="{x:Bind ViewModel.Status}" VerticalAlignment="Center"
                                    controls:LoadSwapVisual.Swap="{x:Bind ViewModel.LoadSwap, Mode=OneWay}" controls:LoadSwapVisual.Role="Content"
                                    Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}" />

        <!-- Contrast themes only: a window-colour plate (pager height, sized in code) hides the rows between and behind the
             floating pager's buttons instead of letting their borders and text show through (issue #209, as the song
             leaderboard's #197 plate). Never hit-testable. -->
        <Border x:Name="FooterPlate" Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Bottom" IsHitTestVisible="False"
                Visibility="Collapsed" Background="{ThemeResource FSTFloatingBackplateBrush}" />
        <controls:LeaderboardsPager x:Name="Footer" Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Bottom" Pager="{x:Bind ViewModel.Pager}"
                                    Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}" SizeChanged="OnFooterSizeChanged" />

        <Frame x:Name="DetailFrame" Grid.Column="1" Grid.RowSpan="3" Margin="12,-12,-24,-12" Visibility="Collapsed"
               IsNavigationStackEnabled="False" AutomationProperties.Name="Band details"
               AutomationProperties.AutomationId="fst.band-rankings.detail-pane" />

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Actions.(Grid.Row)" Value="1" />
                        <Setter Target="Actions.(Grid.Column)" Value="0" />
                        <Setter Target="Actions.HorizontalAlignment" Value="Left" />
                        <Setter Target="PageRoot.Padding" Value="12,8,12,8" />
                        <Setter Target="BandSizeText.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
