<Page
    x:Class="Festival.App.Pages.AllRivalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="Header" Padding="24,12,24,8" ColumnSpacing="12" MaxWidth="960" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:InstrumentIcon File="{x:Bind ViewModel.IconFile, Mode=OneWay}" Width="36" Height="36" VerticalAlignment="Center"
                                     Visibility="{x:Bind ViewModel.HasIcon, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource FSTPageTitleStyle}" TextWrapping="Wrap"
                           AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="fst.all-rivals.title" />
                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource FSTSecondaryTextStyle}"
                           TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasSubtitle, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <ListView x:Name="RivalList" controls:FadeIn.Together="True" controls:FadeIn.RowHeight="56" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" MaxWidth="960"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnRivalClick" Padding="24,0,24,32"
                  ContainerContentChanging="OnContainerContentChanging"
                  Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}"
                  AutomationProperties.Name="Rivals" AutomationProperties.AutomationId="fst.all-rivals.list">
            <!-- The rivals as one grouped card that fades in as one (GroupedRows.ApplyToContainer from OnContainerContentChanging:
                 touching row slices with a hairline between; issue #603, like Apple's FestivalGlassSection and the #543
                 boards; load-transition R11). -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:RivalRowItem">
                    <!-- The row's slice of the card (corners and outline set per position). -->
                    <Grid CornerRadius="12" BorderThickness="1" Background="{ThemeResource FSTCardSurfaceBrush}" BorderBrush="{ThemeResource FSTCardStrokeBrush}"
                          AutomationProperties.AccessibilityView="Raw">
                        <Border x:Name="RowSeparator" Height="1" Margin="12,0" VerticalAlignment="Top" IsHitTestVisible="False"
                                Visibility="Collapsed" Background="{ThemeResource FSTRowSeparatorBrush}" AutomationProperties.AccessibilityView="Raw" />
                        <controls:RivalRowView Item="{x:Bind}" Margin="12,4" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <controls:RivalPageStates Grid.Row="1" Page="{x:Bind ViewModel}" />
    </Grid>
</Page>
