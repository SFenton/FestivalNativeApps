<Page
    x:Class="Festival.App.Pages.AllRivalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="Header" Padding="24,12,24,8" ColumnSpacing="12" MaxWidth="960" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:InstrumentIcon File="{x:Bind ViewModel.IconFile, Mode=OneWay}" Width="36" Height="36" VerticalAlignment="Center"
                                     Visibility="{x:Bind ViewModel.HasIcon, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource FSTPageTitleStyle}" TextWrapping="Wrap"
                           AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="fst.all-rivals.title" />
                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource FSTSecondaryTextStyle}" />
            </StackPanel>
        </Grid>

        <ListView x:Name="RivalList" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="56" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" MaxWidth="960"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnRivalClick" Padding="24,0,24,32"
                  ContainerContentChanging="OnContainerContentChanging"
                  Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}"
                  AutomationProperties.Name="Rivals" AutomationProperties.AutomationId="fst.all-rivals.list">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="12,4" />
                    <Setter Property="Margin" Value="0,2" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="{ThemeResource FSTCardSurfaceBrush}" />
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:RivalRowItem">
                    <controls:RivalRowView Item="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <controls:RivalPageStates Grid.Row="1" Page="{x:Bind ViewModel}" />
    </Grid>
</Page>
