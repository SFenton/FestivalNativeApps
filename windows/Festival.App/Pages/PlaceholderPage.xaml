<Page
    x:Class="Festival.App.Pages.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <!-- Typed route not yet ported on Windows: shows its title and web path. -->
    <StackPanel Padding="24,12,24,24" Spacing="16">
        <TextBlock x:Name="TitleText" Style="{StaticResource FSTPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
        <Border Style="{StaticResource FSTCardStyle}" MaxWidth="560" HorizontalAlignment="Left">
            <StackPanel Spacing="8">
                <TextBlock Text="Coming Soon" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="This page is not available in the Windows app yet." TextWrapping="Wrap" />
                <TextBlock x:Name="PathText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource FSTSecondaryTextBrush}" IsTextSelectionEnabled="True"
                           AutomationProperties.AutomationId="fst.placeholder.route" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
