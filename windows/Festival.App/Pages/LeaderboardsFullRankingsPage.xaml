<Page
    x:Class="Festival.App.Pages.LeaderboardsFullRankingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    Background="Transparent">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshInvoked" />
    </Page.KeyboardAccelerators>

    <!-- Full Rankings: header + switchers, 25 rows, pinned "your rank" row, pager. -->
    <Grid x:Name="PageRoot" Padding="24,12,24,12" RowSpacing="12" MaxWidth="1100">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Wide pages (>= 1100 epx) show the rankings beside the chosen player's profile (operator 2026-09-28: two
             populated columns). ApplySplit sets the widths. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="Header" ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:InstrumentIcon File="{x:Bind ViewModel.IconFile, Mode=OneWay}" Width="32" Height="32"
                                         AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource FSTPageTitleStyle}"
                               AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="fst.full-rankings.title" />
                    <TextBlock Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" Style="{StaticResource FSTSecondaryTextStyle}" />
                </StackPanel>
            </Grid>
            <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <DropDownButton MinHeight="{StaticResource FSTMinTargetSize}" AutomationProperties.Name="{x:Bind ViewModel.InstrumentButtonName, Mode=OneWay}"
                                AutomationProperties.AutomationId="fst.full-rankings.instrument-menu">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:InstrumentIcon File="{x:Bind ViewModel.IconFile, Mode=OneWay}" Width="18" Height="18"
                                                 AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="InstrumentText" Text="Instrument" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="InstrumentMenu" Placement="BottomEdgeAlignedRight" ShouldConstrainToRootBounds="True" Opening="OnInstrumentMenuOpening" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton MinHeight="{StaticResource FSTMinTargetSize}" AutomationProperties.Name="{x:Bind ViewModel.MetricButtonName, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ShowRankBy, Mode=OneWay}"
                                AutomationProperties.AutomationId="fst.rankings.rank-by-menu">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- Same 18 epx height as the instrument icon beside it (operator 2026-09-28): the icon is never shrunk. -->
                        <FontIcon Glyph="&#xE8CB;" FontSize="18" />
                        <TextBlock Text="{x:Bind ViewModel.MetricLabel, Mode=OneWay}" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="MetricMenu" Placement="BottomEdgeAlignedRight" ShouldConstrainToRootBounds="True" Opening="OnMetricMenuOpening" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!-- One frosted row per entry, 4 epx apart (web entryRow list, operator batch 7.7); the rows end at the floating
             footer (BoardFooter) through the bottom-chrome ramp (BoardFooterFade, issue #308). The wrapper is the fade
             source because the load swap animates the ScrollViewer's own visual. -->
        <Grid x:Name="BoardFadeSource" Grid.Row="1" Grid.RowSpan="3">
            <ScrollViewer x:Name="Scroller" Visibility="{x:Bind ViewModel.ShowRows, Mode=OneWay}"
                          controls:LoadSwapVisual.Swap="{x:Bind ViewModel.LoadSwap, Mode=OneWay}" controls:LoadSwapVisual.Role="Content"
                          AutomationProperties.AutomationId="fst.full-rankings.list">
                <ItemsRepeater XYFocusKeyboardNavigation="Enabled" x:Name="RowsRepeater" Margin="0,4,0,0" VerticalAlignment="Top"
                               ElementPrepared="OnRowPrepared"
                               controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="52"
                               ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:RankingRowViewModel">
                            <controls:LeaderboardEntryRow Row="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
        <!-- Paints BoardFadeSource with its rows faded above the footer; never hit-testable, UIA raw view only. -->
        <controls:EdgeFadeLayer x:Name="BoardFadeHost" Grid.Row="1" Grid.RowSpan="3" AutomationProperties.AutomationId="fst.full-rankings.footer-fade" />
        <controls:EmptyStateView Grid.Row="1" Title="No ranked players yet." TitleAutomationId="fst.full-rankings.empty"
                                 controls:LoadSwapVisual.Swap="{x:Bind ViewModel.LoadSwap, Mode=OneWay}" controls:LoadSwapVisual.Role="Content"
                                 Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" />
        <ProgressRing Grid.Row="1" Width="48" Height="48" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      controls:LoadSwapVisual.Swap="{x:Bind ViewModel.LoadSwap, Mode=OneWay}" controls:LoadSwapVisual.Role="Spinner"
                      AutomationProperties.Name="Loading rankings" />
        <controls:ServiceStatusView x:Name="RowsStatus" Grid.Row="1" Status="{x:Bind ViewModel.Status}" VerticalAlignment="Center"
                                    controls:LoadSwapVisual.Swap="{x:Bind ViewModel.LoadSwap, Mode=OneWay}" controls:LoadSwapVisual.Role="Content"
                                    Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}" />

        <!-- Contrast themes: the footer fade cuts the rows hard at the footer's top and this window-colour plate (footer
             height, sized by BoardFooterFade) backs the footer's controls (issue #208, as the song leaderboard). Never
             hit-testable. -->
        <Border x:Name="FooterPlate" Grid.Row="1" Grid.RowSpan="3" VerticalAlignment="Bottom" IsHitTestVisible="False" Visibility="Collapsed"
                Background="{ThemeResource FSTFloatingBackplateBrush}" />

        <!-- Web fixed footer: the pinned "your rank" row, then the pager, floating over the rows. The pinned row shares the
             rows' load gate (song board SpotlightGate, load-transition R2, issue #270) on the first load and when the
             instrument or Rank By changes: it fades out with the old page so the old value never shows beside the spinner,
             and enters with the first row. Paging, F5 and retry keep it in place, like the web footer (footerAnimKey is the
             instrument and metric, not the page); PinnedGate decides. A row that newly appears mid-reload joins the gate.
             LoadSwapGate keeps the slot and, while hidden, drops the row from UI Automation and the Tab order.
             The gate (opacity) and the entrance (composition) sit on separate elements (0xc000027b, issue #295). -->
        <StackPanel x:Name="Footer" Grid.Row="1" Grid.RowSpan="3" VerticalAlignment="Bottom" Spacing="8">
            <controls:LoadSwapGate x:Name="SpotlightGate" Visibility="{x:Bind ViewModel.Spotlight.IsVisible, Mode=OneWay}"
                                   controls:LoadSwapVisual.Swap="{x:Bind ViewModel.LoadSwap, Mode=OneWay}" controls:LoadSwapVisual.Role="Content"
                                   controls:LoadSwapVisual.IsGated="{x:Bind ViewModel.PinnedGate.IsGated, Mode=OneWay}">
                <controls:LeaderboardsSpotlight x:Name="FooterSpotlight" Spotlight="{x:Bind ViewModel.Spotlight, Mode=OneWay}"
                                                IdPrefix="fst.full-rankings.spotlight-footer" IsFloating="True" />
            </controls:LoadSwapGate>
            <controls:LeaderboardsPager x:Name="BoardPager" Pager="{x:Bind ViewModel.Pager}"
                                        Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}" />
        </StackPanel>

        <Frame x:Name="DetailFrame" Grid.Column="1" Grid.RowSpan="4" Margin="12,-12,-24,-12" Visibility="Collapsed"
               IsNavigationStackEnabled="False" AutomationProperties.Name="Player profile"
               AutomationProperties.AutomationId="fst.full-rankings.detail-pane" />

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Actions.(Grid.Row)" Value="1" />
                        <Setter Target="Actions.(Grid.Column)" Value="0" />
                        <Setter Target="Actions.HorizontalAlignment" Value="Left" />
                        <Setter Target="PageRoot.Padding" Value="12,8,12,8" />
                        <Setter Target="InstrumentText.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
