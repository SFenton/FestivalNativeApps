<Page
    x:Class="Festival.App.Pages.LeaderboardsFullRankingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    Background="Transparent">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshInvoked" />
    </Page.KeyboardAccelerators>

    <!-- Full Rankings: header + switchers, 25 rows, pinned "your rank" row, pager. -->
    <Grid x:Name="PageRoot" Padding="24,12,24,12" RowSpacing="12" MaxWidth="1100">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Header" ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:InstrumentIcon File="{x:Bind ViewModel.IconFile, Mode=OneWay}" Width="32" Height="32"
                                         AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource FSTPageTitleStyle}"
                               AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="fst.full-rankings.title" />
                    <TextBlock Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" Style="{StaticResource FSTSecondaryTextStyle}" />
                </StackPanel>
            </Grid>
            <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <DropDownButton AutomationProperties.Name="{x:Bind ViewModel.InstrumentButtonName, Mode=OneWay}"
                                AutomationProperties.AutomationId="fst.full-rankings.instrument-menu">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:InstrumentIcon File="{x:Bind ViewModel.IconFile, Mode=OneWay}" Width="18" Height="18"
                                                 AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="InstrumentText" Text="Instrument" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="InstrumentMenu" Placement="BottomEdgeAlignedRight" Opening="OnInstrumentMenuOpening" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton AutomationProperties.Name="{x:Bind ViewModel.MetricButtonName, Mode=OneWay}"
                                AutomationProperties.AutomationId="fst.rankings.rank-by-menu">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                        <TextBlock Text="{x:Bind ViewModel.MetricLabel, Mode=OneWay}" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="MetricMenu" Placement="BottomEdgeAlignedRight" Opening="OnMetricMenuOpening" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" VerticalAlignment="Top"
                     Visibility="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" AutomationProperties.Name="Loading page" />
        <ScrollViewer x:Name="Scroller" Grid.Row="1" Visibility="{x:Bind ViewModel.ShowRows, Mode=OneWay}"
                      AutomationProperties.AutomationId="fst.full-rankings.list">
            <Border Style="{StaticResource FSTCardStyle}" Padding="8" Margin="0,4,0,0" VerticalAlignment="Top">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="2" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:RankingRowViewModel">
                            <controls:LeaderboardsRankingRow Row="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Border>
        </ScrollViewer>
        <TextBlock Grid.Row="1" Text="No ranked players yet." Style="{StaticResource FSTSecondaryTextStyle}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" />
        <ProgressRing Grid.Row="1" Width="48" Height="48" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      AutomationProperties.Name="Loading rankings" />
        <controls:ServiceStatusView Grid.Row="1" Status="{x:Bind ViewModel.Status}" VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}" />

        <Border Grid.Row="2" Style="{StaticResource FSTCardStyle}" Padding="8"
                Visibility="{x:Bind ViewModel.Spotlight.IsVisible, Mode=OneWay}">
            <controls:LeaderboardsSpotlight Spotlight="{x:Bind ViewModel.Spotlight, Mode=OneWay}"
                                            IdPrefix="fst.full-rankings.spotlight-footer"
                                            JumpAutomationId="fst.full-rankings.spotlight-jump" />
        </Border>

        <controls:LeaderboardsPager Grid.Row="3" Pager="{x:Bind ViewModel.Pager}"
                                    Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}" />

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Actions.(Grid.Row)" Value="1" />
                        <Setter Target="Actions.(Grid.Column)" Value="0" />
                        <Setter Target="Actions.HorizontalAlignment" Value="Left" />
                        <Setter Target="PageRoot.Padding" Value="12,8,12,8" />
                        <Setter Target="InstrumentText.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
