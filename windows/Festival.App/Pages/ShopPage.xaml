<Page
    x:Class="Festival.App.Pages.ShopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    NavigationCacheMode="Required"
    Background="Transparent">
    <Page.Resources>
        <!-- The Songs filter flyout's ToggleRow (SongsPage FilterToggleTemplate, text rows): label, description, trailing switch. -->
        <DataTemplate x:Key="ShopFilterToggleTemplate" x:DataType="vm:FilterToggleRow">
            <Grid ColumnSpacing="12" MinHeight="40" Padding="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource FSTSecondaryTextStyle}" FontSize="12" TextWrapping="Wrap"
                               Visibility="{x:Bind HasDescription}" />
                </StackPanel>
                <!-- Named by the label like the Songs rows; the description is the switch's HelpText, so Narrator also reads
                     what "Available" means (neither New nor Leaving Tomorrow). -->
                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsOn, Mode=TwoWay}" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                              OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"
                              AutomationProperties.Name="{x:Bind Label}" AutomationProperties.HelpText="{x:Bind Description}"
                              AutomationProperties.AutomationId="{x:Bind AutomationId}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="Root" Padding="24,12,12,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="Header" ColumnSpacing="12" Margin="0,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Item Shop" Style="{StaticResource FSTPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" VerticalAlignment="Bottom" Margin="0,0,0,4"
                       Style="{StaticResource FSTSecondaryTextStyle}" Visibility="{x:Bind ViewModel.ShowOffers, Mode=OneWay}"
                       AutomationProperties.AutomationId="fst.shop.count" />
            <!-- Sort, Filter and the layout toggle wrap onto a second line instead of clipping at large text sizes
                 (page-tools-and-nav-chrome R11). -->
            <controls:WrapPanel x:Name="HeaderActions" Grid.Column="2" HorizontalSpacing="8" VerticalSpacing="8"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <!-- Issue #379: the Songs Sort flyout (shared SongSortForm) with the Item Shop's Title, Artist, Year and Duration
                 modes. Changes apply live and persist; gold while the sort isn't Title ascending, like Songs. -->
            <DropDownButton x:Name="SortButton" AutomationProperties.Name="Sort Item Shop" MinHeight="{StaticResource FSTMinTargetSize}"
                            Visibility="{x:Bind ViewModel.ShowOffers, Mode=OneWay}"
                            AutomationProperties.HelpText="{x:Bind ViewModel.SortDescription, Mode=OneWay}"
                            AutomationProperties.AutomationId="fst.shop.sort">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                    <TextBlock x:Name="SortLabel" Text="{x:Bind ViewModel.SortSummary, Mode=OneWay}" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <Flyout x:Name="SortFlyout" Placement="BottomEdgeAlignedRight" ShouldConstrainToRootBounds="True" Opening="OnSortOpening">
                        <controls:SongSortForm Draft="{x:Bind ViewModel.SortDraft}" Title="Sort Item Shop" IdPrefix="fst.shop.sort" />
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <!-- Issues #19, #376: New / Available / Leaving Tomorrow include switches (all on by default) in the Songs filter
                 flyout's layout (title, switch rows, red Reset). Changes apply live; light dismiss / Esc closes. Gold while a
                 switch is off, like Songs. -->
            <DropDownButton x:Name="FilterButton" AutomationProperties.Name="Filter Item Shop" MinHeight="{StaticResource FSTMinTargetSize}"
                            Visibility="{x:Bind ViewModel.ShowOffers, Mode=OneWay}"
                            AutomationProperties.AutomationId="fst.shop.filter">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71C;" FontSize="14" />
                    <TextBlock Text="Filter" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <Flyout x:Name="FilterFlyout" Placement="BottomEdgeAlignedRight" ShouldConstrainToRootBounds="True" Opening="OnFilterOpening">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="MaxWidth" Value="520" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <Grid x:Name="FilterForm" Width="400" RowSpacing="0" AutomationProperties.AutomationId="fst.shop.filter.form">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Filter Item Shop" Style="{StaticResource FSTSectionHeaderStyle}" Margin="16,16,16,8"
                                       AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="fst.shop.filter.title" />
                            <ScrollViewer Grid.Row="1" Padding="16,0,16,0">
                                <StackPanel Spacing="4" Padding="0,0,0,12">
                                    <TextBlock Text="Choose which Item Shop songs to show. Turn a switch off to hide those songs."
                                               Style="{StaticResource FSTSecondaryTextStyle}" TextWrapping="Wrap" FontSize="12" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.FilterRows}" ItemTemplate="{StaticResource ShopFilterToggleTemplate}" IsTabStop="False" />
                                </StackPanel>
                            </ScrollViewer>
                            <Grid Grid.Row="2" Padding="16,12,16,16" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource FSTCardStrokeBrush}">
                                <Button Content="Reset" HorizontalAlignment="Stretch" MinHeight="{StaticResource FSTMinTargetSize}" Command="{x:Bind ViewModel.ResetFilterCommand}"
                                        AutomationProperties.Name="Reset Item Shop Filters" AutomationProperties.AutomationId="fst.shop.filter.reset">
                                    <Button.Resources>
                                        <!-- Web Modal reset: a full-width red (btnDanger #C62828) button, as in the Songs filter flyout. -->
                                        <StaticResource x:Key="ButtonBackground" ResourceKey="FSTDangerBackgroundBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="FSTDangerBackgroundPointerOverBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="FSTDangerBackgroundPressedBrush" />
                                        <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="FSTDangerBackgroundDisabledBrush" />
                                        <StaticResource x:Key="ButtonForeground" ResourceKey="FSTDangerForegroundBrush" />
                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="FSTDangerForegroundPointerOverBrush" />
                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="FSTDangerForegroundPressedBrush" />
                                        <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="FSTDangerForegroundDisabledBrush" />
                                        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="FSTDangerBorderBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="FSTDangerBorderPointerOverBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="FSTDangerBorderPressedBrush" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Grid>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button Click="OnToggleView" Visibility="{x:Bind ViewModel.CanToggleView, Mode=OneWay}" MinHeight="{StaticResource FSTMinTargetSize}"
                    AutomationProperties.Name="{x:Bind ViewModel.ToggleLabel, Mode=OneWay}"
                    AutomationProperties.AutomationId="fst.shop.view-toggle">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="ToggleGlyph" Glyph="&#xE8FD;" FontSize="14" />
                    <TextBlock Text="{x:Bind ViewModel.ToggleLabel, Mode=OneWay}" />
                </StackPanel>
            </Button>
            </controls:WrapPanel>
        </Grid>

        <!-- Notices: catalogue links unavailable; a saved Duration sort paused to title order (catalogue-sort R7, #379). -->
        <StackPanel x:Name="Notices" Grid.Row="1" Spacing="8" Margin="0,0,12,0">
        <InfoBar x:Name="DetailsNotice" IsOpen="{x:Bind ViewModel.HasSongDetailsIssue, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasSongDetailsIssue, Mode=OneWay}" IsClosable="False" Severity="Warning"
                 Message="{x:Bind ViewModel.SongDetailsIssue, Mode=OneWay}"
                 AutomationProperties.AutomationId="fst.shop.song-details-error" />
        <InfoBar x:Name="SortPausedNotice" IsOpen="{x:Bind ViewModel.HasSortPause, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasSortPause, Mode=OneWay}" IsClosable="False" Severity="Informational"
                 Message="{x:Bind ViewModel.SortPaused, Mode=OneWay}"
                 AutomationProperties.AutomationId="fst.shop.sort-paused" />
        </StackPanel>

        <Grid Grid.Row="2">
            <!-- Grid: the web's ShopCard tiles (square, full-bleed art, title/artist scrim, Leaving Tomorrow pill; 2-5 columns,
                 at most 1040 epx wide like the web's 1080 content column). The tile opens Song Detail (or the official Item
                 Shop when the song isn't in the catalogue); the purchase link is in its context menu, so the tile carries no
                 extra button (operator batch 6.9). New/Leaving tiles pulse gold/red like the web's ShopCard. -->
            <ScrollViewer x:Name="GridScroller" Visibility="{x:Bind ViewModel.ShowGrid, Mode=OneWay}" Padding="0,0,12,24"
                          SizeChanged="OnGridSizeChanged" AutomationProperties.AutomationId="fst.shop.grid">
                <!-- One Tab stop for the whole grid (like Fluent's GridView); arrow keys move between tiles. The live Shop has
                     well over a hundred tiles, so a stop per tile (TabFocusNavigation="Local") made the page unusable by keyboard. -->
                <ItemsRepeater XYFocusKeyboardNavigation="Enabled" TabFocusNavigation="Once" x:Name="OfferGrid" controls:FadeIn.Stagger="True"
                               HorizontalAlignment="Left"
                               controls:FadeIn.RowHeight="220" ItemsSource="{x:Bind ViewModel.Offers, Mode=OneWay}"
                               ElementPrepared="OnGridPrepared" ElementClearing="OnElementClearing">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout x:Name="TileLayout" MinItemWidth="200" MinItemHeight="200" MinRowSpacing="10" MinColumnSpacing="10"
                                           ItemsStretch="None" MaximumRowsOrColumns="2" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShopOfferItem">
                            <Grid x:Name="Tile" Width="200" Height="200" CornerRadius="8" Background="{ThemeResource FSTSurfaceMutedBrush}">
                                <Button x:Name="TileButton" Padding="0" BorderThickness="0" Background="Transparent" CornerRadius="8"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="OnTileClick" Tag="{x:Bind}"
                                        AutomationProperties.Name="{x:Bind TileName}" AutomationProperties.AutomationId="{x:Bind TileAutomationId}">
                                    <Button.ContextFlyout>
                                        <MenuFlyout ShouldConstrainToRootBounds="True">
                                            <MenuFlyoutItem Text="Open in Item Shop" Click="OnExternalClick" Tag="{x:Bind}"
                                                            AutomationProperties.Name="{x:Bind ExternalName}"
                                                            AutomationProperties.AutomationId="{x:Bind ExternalAutomationId}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE7BF;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.ContextFlyout>
                                    <Grid>
                                        <Image x:Name="Art" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                                        <Rectangle AutomationProperties.AccessibilityView="Raw">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0.55" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0" />
                                                    <GradientStop Color="#CC000000" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Border VerticalAlignment="Bottom" Background="{ThemeResource FSTShopTileCaptionBrush}">
                                            <StackPanel Padding="16" Spacing="4">
                                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16"
                                                           Foreground="{ThemeResource FSTShopTileTextBrush}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock Text="{x:Bind Offer.Artist}" Style="{StaticResource BodyTextBlockStyle}"
                                                           Foreground="{ThemeResource FSTShopTileTextBrush}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Button>
                                <!-- Wraps rather than clipping at large text sizes (a compact tile at 200% text cut it to "Leaving Tomorro"). -->
                                <Border x:Name="BadgePill" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Padding="8,3"
                                        CornerRadius="10" Visibility="{x:Bind IsLeaving}" IsHitTestVisible="False">
                                    <TextBlock x:Name="BadgeLabel" Text="{x:Bind BadgeText}" FontSize="12" FontWeight="Bold"
                                               TextWrapping="WrapWholeWords" TextAlignment="Center" />
                                </Border>
                                <controls:ShopPulseRing x:Name="ShopRing" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- List: the shared Songs row (SongRowCard) for the List preference on wider windows; ShopPage adds the
                 New / Leaving Tomorrow badge and the official Item Shop cart button to its trailing slot. -->
            <ListView x:Name="OfferList" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="68" ItemsSource="{x:Bind ViewModel.Offers, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowList, Mode=OneWay}"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnListClick" Padding="0,0,12,24"
                      ContainerContentChanging="OnListContainerChanging"
                      AutomationProperties.Name="Item Shop" AutomationProperties.AutomationId="fst.shop.list">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ShopOfferItem">
                        <controls:SongRowCard Title="{x:Bind Title}" Subtitle="{x:Bind Subtitle}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="48" Height="48" AutomationProperties.Name="Loading Item Shop"
                          AutomationProperties.AutomationId="fst.shop.loading" />
            <!-- Held while the first tiles' art decodes (and after a List/Grid switch), then the layout fades in (6.41).
                 Collapsed while idle so UI Automation never reports an inactive "Loading" ring. -->
            <ProgressRing x:Name="RevealRing" IsActive="False" Visibility="Collapsed" Width="48" Height="48"
                          AutomationProperties.Name="Loading Item Shop" />

            <controls:ServiceStatusView Status="{x:Bind ViewModel.Status}" VerticalAlignment="Center"
                                        Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}"
                                        AutomationProperties.AutomationId="fst.shop.error" />

            <!-- Empty states: the shared EmptyStateView (empty-error-states R2/R5, issue #377), with no card and no Reset
                 Filters button. Web ShopPage copy ("No songs in the Item Shop" / "Check back later…"). -->
            <controls:EmptyStateView Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" Glyph="&#xE719;"
                                     Title="No Songs in the Item Shop" Subtitle="Check back later. The shop updates regularly."
                                     TitleAutomationId="fst.shop.empty" RegionAutomationId="fst.shop.empty-region" />

            <!-- Every offer is hidden by the page filter: distinct copy from the genuine empty Shop; the filter button
                 above is the way back (web Songs filtered-empty model; the web Shop has no filters). -->
            <controls:EmptyStateView Visibility="{x:Bind ViewModel.ShowNoMatches, Mode=OneWay}"
                                     Title="No Item Shop songs match your filters" Subtitle="Try changing your filters to see more songs."
                                     TitleAutomationId="fst.shop.filter.empty" SubtitleAutomationId="fst.shop.filter.empty-message"
                                     RegionAutomationId="fst.shop.filter.empty-region" />

            <controls:EmptyStateView Visibility="{x:Bind ViewModel.IsHidden, Mode=OneWay}"
                                     Title="Item Shop Is Hidden" Subtitle="Turn off Hide Item Shop in Settings to see today's songs."
                                     TitleAutomationId="fst.shop.hidden" />
        </Grid>
    </Grid>
</Page>
