<Page
    x:Class="Festival.App.Pages.ShopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid x:Name="Root" Padding="24,12,12,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12" Margin="0,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Item Shop" Style="{StaticResource FSTPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" VerticalAlignment="Bottom" Margin="0,0,0,4"
                       Style="{StaticResource FSTSecondaryTextStyle}" Visibility="{x:Bind ViewModel.ShowOffers, Mode=OneWay}"
                       AutomationProperties.AutomationId="fst.shop.count" />
            <Button Grid.Column="2" Click="OnToggleView" Visibility="{x:Bind ViewModel.CanToggleView, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.ToggleLabel, Mode=OneWay}"
                    AutomationProperties.AutomationId="fst.shop.view-toggle">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="ToggleGlyph" Glyph="&#xE8FD;" FontSize="14" />
                    <TextBlock Text="{x:Bind ViewModel.ToggleLabel, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasSongDetailsIssue, Mode=OneWay}" IsClosable="False" Severity="Warning"
                 Message="{x:Bind ViewModel.SongDetailsIssue, Mode=OneWay}" Margin="0,0,12,0"
                 AutomationProperties.AutomationId="fst.shop.song-details-error" />

        <Grid Grid.Row="2">
            <!-- Grid: artwork-first cards (wide windows). -->
            <ScrollViewer x:Name="GridScroller" Visibility="{x:Bind ViewModel.ShowGrid, Mode=OneWay}" Padding="0,0,12,24"
                          AutomationProperties.AutomationId="fst.shop.grid">
                <ItemsRepeater XYFocusKeyboardNavigation="Enabled" x:Name="OfferGrid" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="260" ItemsSource="{x:Bind ViewModel.Offers, Mode=OneWay}"
                               ElementPrepared="OnGridPrepared" ElementClearing="OnElementClearing">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="200" MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShopOfferItem">
                            <Border x:Name="Card" Style="{StaticResource FSTCardStyle}" Padding="8">
                                <StackPanel Spacing="6">
                                    <Button x:Name="ArtButton" Padding="0" BorderThickness="0" Background="Transparent"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnExternalClick"
                                            AutomationProperties.Name="{x:Bind ExternalName}" ToolTipService.ToolTip="Open official Item Shop">
                                        <Grid x:Name="ArtGrid" CornerRadius="6" Background="{StaticResource FSTSurfaceMutedBrush}" SizeChanged="OnArtGridSizeChanged">
                                            <Image x:Name="Art" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                                            <Rectangle AutomationProperties.AccessibilityView="Raw">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0.45" EndPoint="0,1">
                                                        <GradientStop Color="#00000000" Offset="0" />
                                                        <GradientStop Color="#D9000000" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <StackPanel VerticalAlignment="Bottom" Padding="10" Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="White"
                                                           TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Offer.Artist}" Foreground="#FFD7DEE8" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border x:Name="BadgePill" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8,3"
                                                    CornerRadius="10" Visibility="{x:Bind HasBadge}">
                                                <TextBlock x:Name="BadgeLabel" Text="{x:Bind BadgeText}" FontSize="12" FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <HyperlinkButton Content="View Song Details" Padding="2,4" Click="OnDetailClick"
                                                     Visibility="{x:Bind HasSongDetail}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- List: compact rows (compact windows and the List preference). -->
            <ListView x:Name="OfferList" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="64" ItemsSource="{x:Bind ViewModel.Offers, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowList, Mode=OneWay}"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnListClick" Padding="0,0,12,24"
                      ContainerContentChanging="OnListContainerChanging"
                      AutomationProperties.Name="Item Shop" AutomationProperties.AutomationId="fst.shop.list">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ShopOfferItem">
                        <Grid x:Name="Row" MinHeight="72" Padding="10,8" ColumnSpacing="12" CornerRadius="8" BorderThickness="1"
                              Background="{ThemeResource FSTCardSurfaceBrush}" BorderBrush="{ThemeResource FSTCardStrokeBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="56" Height="56" CornerRadius="6" Background="{StaticResource FSTSurfaceMutedBrush}">
                                <Image x:Name="Art" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap" MaxLines="2" />
                                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource FSTSecondaryTextStyle}" />
                                <Border x:Name="BadgePill" HorizontalAlignment="Left" Padding="8,2" CornerRadius="10" Margin="0,2,0,0"
                                        Visibility="{x:Bind HasBadge}">
                                    <TextBlock x:Name="BadgeLabel" Text="{x:Bind BadgeText}" FontSize="12" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="2" Width="44" Height="44" Padding="0" CornerRadius="22" Click="OnExternalClick"
                                    AutomationProperties.Name="{x:Bind ExternalName}" ToolTipService.ToolTip="Open official Item Shop">
                                <FontIcon Glyph="&#xE719;" FontSize="16" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="48" Height="48"
                          AutomationProperties.Name="Loading Item Shop" />

            <controls:ServiceStatusView Status="{x:Bind ViewModel.Status}" VerticalAlignment="Center"
                                        Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}"
                                        AutomationProperties.AutomationId="fst.shop.error" />

            <Border Style="{StaticResource FSTCardStyle}" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"
                    Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <FontIcon Glyph="&#xE719;" FontSize="32" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="No Songs in the Item Shop" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="fst.shop.empty" />
                    <TextBlock Text="Check back later. The shop updates regularly." HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{x:Bind ViewModel.IsHidden, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12" MaxWidth="440">
                <TextBlock Text="Item Shop Is Hidden" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"
                           AutomationProperties.AutomationId="fst.shop.hidden" />
                <TextBlock Text="Turn off Hide Item Shop in Settings to see today's songs." HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
