<Page
    x:Class="Festival.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    xmlns:services="using:Festival.App.Services"
    NavigationCacheMode="Required"
    Background="Transparent">
    <Page.Resources>
        <services:LeewayThumbConverter x:Key="FSTLeeway" />
        <!-- Right-align bare switches like Windows Settings cards (the default reserves room for On/Off text). -->
        <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>
        <!-- Setting row: title + description on the left, control on the right (Windows Settings card layout). -->
        <Style x:Key="SettingTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource FSTSecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource FSTSecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,-4,0,8" />
        </Style>
        <!-- Feedback rows: a full-width, borderless settings row that opens a dialog. -->
        <Style x:Key="FeedbackRowStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="56" />
            <!-- A 1 epx border (transparent until a contrast theme's hover outline) sits in the -1 margin, so content
                 keeps the 0,8,4,8 inset. -->
            <Setter Property="Margin" Value="-1,0" />
            <Setter Property="Padding" Value="0,7,4,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SettingSwitchStyle" TargetType="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Web ReorderList row: grip dots + semibold label on a subtle surface; drag anywhere on the row to reorder.
             Move Up/Down stay for keyboard and Narrator users (the web's keyboard sensor). -->
        <DataTemplate x:Key="ReorderRowTemplate" x:DataType="vm:ReorderItemViewModel">
            <Grid ColumnSpacing="16" MinHeight="48" Padding="16,0,8,0" Background="{ThemeResource FSTReorderRowBrush}"
                  BorderBrush="{ThemeResource FSTReorderStrokeBrush}" BorderThickness="0,0,0,1"
                  AutomationProperties.Name="{x:Bind AccessibleName}"
                  AutomationProperties.AutomationId="{x:Bind AutomationId}">
                <Grid.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Width="12" Height="18" VerticalAlignment="Center" Fill="{ThemeResource FSTDeemphasisTextBrush}"
                      AutomationProperties.AccessibilityView="Raw">
                    <Path.Data>
                        <GeometryGroup>
                            <EllipseGeometry Center="3,3" RadiusX="1.5" RadiusY="1.5" />
                            <EllipseGeometry Center="9,3" RadiusX="1.5" RadiusY="1.5" />
                            <EllipseGeometry Center="3,9" RadiusX="1.5" RadiusY="1.5" />
                            <EllipseGeometry Center="9,9" RadiusX="1.5" RadiusY="1.5" />
                            <EllipseGeometry Center="3,15" RadiusX="1.5" RadiusY="1.5" />
                            <EllipseGeometry Center="9,15" RadiusX="1.5" RadiusY="1.5" />
                        </GeometryGroup>
                    </Path.Data>
                </Path>
                <TextBlock Grid.Column="1" Text="{x:Bind Label}" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button Grid.Column="2" Command="{x:Bind MoveUpCommand}" Padding="8,4" Background="Transparent" BorderThickness="0"
                        AutomationProperties.Name="{x:Bind MoveUpName}"
                        ToolTipService.ToolTip="Move up">
                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                </Button>
                <Button Grid.Column="3" Command="{x:Bind MoveDownCommand}" Padding="8,4" Background="Transparent" BorderThickness="0"
                        AutomationProperties.Name="{x:Bind MoveDownName}"
                        ToolTipService.ToolTip="Move down">
                    <FontIcon Glyph="&#xE70D;" FontSize="12" />
                </Button>
            </Grid>
        </DataTemplate>
        <Style x:Key="ReorderItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style x:Key="ReorderListStyle" TargetType="ListView">
            <Setter Property="SelectionMode" Value="None" />
            <Setter Property="CanDragItems" Value="True" />
            <Setter Property="CanReorderItems" Value="True" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource FSTReorderStrokeBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemTemplate" Value="{StaticResource ReorderRowTemplate}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ReorderItemStyle}" />
        </Style>
        <Style x:Key="SubsettingTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <!-- One column (Quick Links menu or pane) below Core SettingsDetails.SplitWidth; from it the list/detail layout
         (issue #371): the list in a fixed ListColumn and the selected setting's options in the DetailHost. -->
    <Grid x:Name="Root" SizeChanged="OnRootSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="Auto" />
        </Grid.ColumnDefinitions>

        <ScrollViewer x:Name="Scroller" controls:FadeIn.OnShow="True" AutomationProperties.AutomationId="fst.settings">
            <StackPanel Padding="24,12,24,32" Spacing="4" MaxWidth="880" HorizontalAlignment="Left">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Settings" Style="{StaticResource FSTPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
                    <Border x:Name="MenuHost" Grid.Column="1" VerticalAlignment="Center">
                        <controls:QuickLinksMenuButton x:Name="QuickLinksMenu" />
                    </Border>
                </Grid>

                <!-- App Settings -->
                <StackPanel controls:QuickLinkAnchor.Id="app-settings">
                    <TextBlock Text="App Settings" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="General Festival Score Tracker app settings." Style="{StaticResource SectionSubtitleStyle}" />
                    <Border Style="{StaticResource FSTCardStyle}" Padding="16,8">
                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="12" MinHeight="56">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="Show Instrument Icons" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Display instrument icons on each song row showing which parts have leaderboard scores or FCs." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Style="{StaticResource SettingSwitchStyle}" MinWidth="0" Width="52" IsOn="{x:Bind ViewModel.ShowInstrumentIcons, Mode=TwoWay}"
                                              AutomationProperties.Name="Show Instrument Icons"
                                              AutomationProperties.AutomationId="fst.settings.show-instrument-icons" />
                            </Grid>
                            <Grid ColumnSpacing="12" MinHeight="56">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="Enable Independent Song Row Visual Order" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="When enabled, the metadata display order on song rows is controlled separately from sort priority. When disabled, metadata follows sort priority order." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Style="{StaticResource SettingSwitchStyle}" MinWidth="0" Width="52" IsOn="{x:Bind ViewModel.EnableVisualOrder, Mode=TwoWay}"
                                              AutomationProperties.Name="Enable Independent Song Row Visual Order"
                                              AutomationProperties.AutomationId="fst.settings.enable-visual-order" />
                            </Grid>
                            <!-- List/detail (issue #371): the multi-option settings below become chevron rows (collapsed in one
                                 column); their *Body elements move into the detail card while selected (code-behind). -->
                            <controls:SettingsDetailRow x:Name="SongRowOrderRow" Tag="SongRowOrder" Click="OnDetailRowClick" Visibility="{x:Bind SplitVisibility(ViewModel.HasSongRowOrderRow, IsSplit), Mode=OneWay}"
                                                        AutomationProperties.AutomationId="fst.settings.detail-row.song-row-order" />
                            <!-- Web: the order list appears directly under the switch while it is on (no expander). -->
                            <StackPanel x:Name="SongRowOrderInline" Visibility="{x:Bind InlineVisibility(ViewModel.EnableVisualOrder, IsSplit), Mode=OneWay}" Padding="0,0,0,8" Spacing="4">
                                <TextBlock Text="Song Row Visual Order" Style="{StaticResource SubsettingTitleStyle}" AutomationProperties.HeadingLevel="Level3" />
                                <TextBlock Text="When filtering to a single instrument in the song list, extra metadata is displayed. Choose the order it appears in on the bottom row."
                                           Style="{StaticResource SettingDescriptionStyle}" />
                                <StackPanel x:Name="SongRowOrderBody" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.VisualOrderSummary, Mode=OneWay}" Style="{StaticResource SettingDescriptionStyle}"
                                               Visibility="{x:Bind ViewModel.HasVisibleMetadata, Mode=OneWay, Converter={StaticResource FSTInverseVisibility}}" />
                                    <ListView Style="{StaticResource ReorderListStyle}" ItemsSource="{x:Bind ViewModel.SongRowOrder, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.HasVisibleMetadata, Mode=OneWay}" DragItemsCompleted="OnReorderCompleted"
                                              AutomationProperties.Name="Song Row Visual Order"
                                              AutomationProperties.AutomationId="fst.settings.song-row-order" />
                                </StackPanel>
                            </StackPanel>
                            <controls:SettingsDetailRow x:Name="PathDefaultViewRow" Tag="PathDefaultView" Click="OnDetailRowClick" Visibility="{x:Bind SplitVisibility(x:True, IsSplit), Mode=OneWay}"
                                                        Value="{x:Bind ViewModel.PathDefaultViewValue, Mode=OneWay}"
                                                        AutomationProperties.AutomationId="fst.settings.detail-row.path-default-view" />
                            <!-- Web: title, description, then Image/Text radio buttons (not a dropdown). -->
                            <StackPanel x:Name="PathDefaultViewInline" Spacing="4" Padding="0,8" Visibility="{x:Bind InlineVisibility(x:True, IsSplit), Mode=OneWay}">
                                <TextBlock Text="CHOpt Path Default View" Style="{StaticResource SettingTitleStyle}" AutomationProperties.HeadingLevel="Level3" />
                                <TextBlock Text="Choose whether CHOpt paths open as an image or text table by default." Style="{StaticResource SettingDescriptionStyle}" />
                                <RadioButtons x:Name="PathDefaultViewBody" SelectedIndex="{x:Bind ViewModel.PathDefaultViewIndex, Mode=TwoWay}" Margin="0,4,0,0"
                                              AutomationProperties.Name="CHOpt Path Default View"
                                              AutomationProperties.AutomationId="fst.settings.path-default-view">
                                    <RadioButton Content="Image" AutomationProperties.AutomationId="fst.settings.path-default-view.image" />
                                    <RadioButton Content="Text" AutomationProperties.AutomationId="fst.settings.path-default-view.text" />
                                </RadioButtons>
                            </StackPanel>
                            <controls:SettingsDetailRow x:Name="PathColumnOrderRow" Tag="PathColumnOrder" Click="OnDetailRowClick" Visibility="{x:Bind SplitVisibility(x:True, IsSplit), Mode=OneWay}"
                                                        AutomationProperties.AutomationId="fst.settings.detail-row.path-column-order" />
                            <StackPanel x:Name="PathColumnOrderInline" Padding="0,8" Spacing="4" Visibility="{x:Bind InlineVisibility(x:True, IsSplit), Mode=OneWay}">
                                <TextBlock Text="CHOpt Text Path Column Order" Style="{StaticResource SettingTitleStyle}" AutomationProperties.HeadingLevel="Level3" />
                                <TextBlock Text="Choose the order columns appear in the CHOpt text path view."
                                           Style="{StaticResource SettingDescriptionStyle}" />
                                <ListView x:Name="PathColumnOrderBody" Style="{StaticResource ReorderListStyle}" ItemsSource="{x:Bind ViewModel.PathColumnOrder, Mode=OneWay}"
                                          DragItemsCompleted="OnReorderCompleted"
                                          AutomationProperties.Name="CHOpt Text Path Column Order"
                                          AutomationProperties.AutomationId="fst.settings.path-column-order" />
                            </StackPanel>
                            <Grid ColumnSpacing="12" MinHeight="56">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="Filter Invalid Scores" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="When enabled, the app will attempt to filter out invalid leaderboard values based on the maximum score derived from the CHOpt path." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Style="{StaticResource SettingSwitchStyle}" MinWidth="0" Width="52" IsOn="{x:Bind ViewModel.FilterInvalidScores, Mode=TwoWay}"
                                              AutomationProperties.Name="Filter Invalid Scores"
                                              AutomationProperties.AutomationId="fst.settings.filter-invalid-scores" />
                            </Grid>
                            <controls:SettingsDetailRow x:Name="LeewayRow" Tag="Leeway" Click="OnDetailRowClick" Visibility="{x:Bind SplitVisibility(ViewModel.HasLeewayRow, IsSplit), Mode=OneWay}"
                                                        Value="{x:Bind ViewModel.LeewayValue, Mode=OneWay}"
                                                        AutomationProperties.AutomationId="fst.settings.detail-row.leeway" />
                            <StackPanel x:Name="LeewayInline" Visibility="{x:Bind InlineVisibility(ViewModel.FilterInvalidScores, IsSplit), Mode=OneWay}">
                                <StackPanel x:Name="LeewayBody" Padding="0,0,0,8">
                                    <Slider Header="{x:Bind ViewModel.LeewayText, Mode=OneWay}" Minimum="-5" Maximum="5" StepFrequency="0.1"
                                            SmallChange="0.1" LargeChange="1" TickFrequency="1" TickPlacement="Outside"
                                            Value="{x:Bind ViewModel.Leeway, Mode=TwoWay}" ThumbToolTipValueConverter="{StaticResource FSTLeeway}"
                                            AutomationProperties.Name="Maximum Score Leeway"
                                            AutomationProperties.ItemStatus="{x:Bind ViewModel.LeewayValue, Mode=OneWay}"
                                            AutomationProperties.AutomationId="fst.settings.leeway" />
                                    <TextBlock Text="{x:Bind ViewModel.LeewayDescription, Mode=OneWay}" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                            </StackPanel>
                            <Grid ColumnSpacing="12" MinHeight="56">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="Enable Experimental Leaderboard Ranks" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Enable this to see more ranking mechanisms in the Leaderboards page." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Style="{StaticResource SettingSwitchStyle}" MinWidth="0" Width="52" IsOn="{x:Bind ViewModel.ExperimentalRanks, Mode=TwoWay}"
                                              AutomationProperties.Name="Enable Experimental Leaderboard Ranks"
                                              AutomationProperties.AutomationId="fst.settings.experimental-ranks" />
                            </Grid>
                            <!-- Feedback (issue #78): shown only when /api/features reports feedback; each row opens its form dialog (.agents/controls/feedback-form/windows.md). -->
                            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.FeedbackAvailable, Mode=OneWay}">
                                <StackPanel.Resources>
                                    <ResourceDictionary>
                                        <ResourceDictionary.MergedDictionaries>
                                            <ResourceDictionary Source="ms-appx:///Themes/NavRowButtonResources.xaml" />
                                        </ResourceDictionary.MergedDictionaries>
                                    </ResourceDictionary>
                                </StackPanel.Resources>
                            <Button Style="{StaticResource FeedbackRowStyle}" Click="OnFeedbackClick" Tag="Bug"
                                    AutomationProperties.Name="Report an Issue"
                                    AutomationProperties.HelpText="Tell us about something that isn't working right."
                                    AutomationProperties.AutomationId="fst.settings.feedback.bug">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="Report an Issue" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="Tell us about something that isn't working right." Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="14" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource FeedbackRowStyle}" Click="OnFeedbackClick" Tag="Feature"
                                    AutomationProperties.Name="Request a Feature"
                                    AutomationProperties.HelpText="Suggest something new for Festival Score Tracker."
                                    AutomationProperties.AutomationId="fst.settings.feedback.feature">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="Request a Feature" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="Suggest something new for Festival Score Tracker." Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="14" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                </Grid>
                            </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- List/detail (issue #371): each section below is one chevron row (the Licenses row look) whose options open in
                     the detail pane; the sections themselves collapse. Shown only in the split layout. -->
                <StackPanel x:Name="SectionRows" Spacing="12" Margin="0,8,0,0" Visibility="{x:Bind SplitVisibility(x:True, IsSplit), Mode=OneWay}">
                    <controls:SettingsDetailRow x:Name="ItemShopRow" Tag="ItemShop" IsSection="True" Click="OnDetailRowClick"
                                                AutomationProperties.AutomationId="fst.settings.detail-row.item-shop" />
                    <controls:SettingsDetailRow x:Name="InstrumentsRow" Tag="Instruments" IsSection="True" Click="OnDetailRowClick"
                                                AutomationProperties.AutomationId="fst.settings.detail-row.show-instruments" />
                    <controls:SettingsDetailRow x:Name="MetadataRow" Tag="Metadata" IsSection="True" Click="OnDetailRowClick"
                                                Description="{x:Bind ViewModel.MetadataDescription, Mode=OneWay}"
                                                AutomationProperties.AutomationId="fst.settings.detail-row.show-metadata" />
                    <controls:SettingsDetailRow x:Name="AccessibilityRow" Tag="Accessibility" IsSection="True" Click="OnDetailRowClick"
                                                AutomationProperties.AutomationId="fst.settings.detail-row.accessibility" />
                    <controls:SettingsDetailRow x:Name="VersionRow" Tag="Version" IsSection="True" Click="OnDetailRowClick"
                                                AutomationProperties.AutomationId="fst.settings.detail-row.version" />
                    <controls:SettingsDetailRow x:Name="ServiceInfoRow" Tag="ServiceInfo" IsSection="True" Click="OnDetailRowClick"
                                                AutomationProperties.AutomationId="fst.settings.detail-row.service-info" />
                    <controls:SettingsDetailRow x:Name="FirstRunRow" Tag="FirstRun" IsSection="True" Click="OnDetailRowClick"
                                                AutomationProperties.AutomationId="fst.settings.detail-row.first-run" />
                    <controls:SettingsDetailRow x:Name="LicensesRow" Tag="Licenses" IsSection="True" Click="OnDetailRowClick"
                                                AutomationProperties.AutomationId="fst.settings.detail-row.licenses" />
                    <controls:SettingsDetailRow x:Name="PrivacyPolicyRow" Tag="PrivacyPolicy" IsSection="True" Click="OnDetailRowClick"
                                                AutomationProperties.AutomationId="fst.settings.detail-row.privacy-policy" />
                </StackPanel>

                <!-- Item Shop -->
                <StackPanel controls:QuickLinkAnchor.Id="item-shop" Visibility="{x:Bind InlineVisibility(x:True, IsSplit), Mode=OneWay}">
                    <TextBlock Text="Item Shop" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="Control how Item Shop availability is displayed." Style="{StaticResource SectionSubtitleStyle}" />
                    <Border x:Name="ItemShopCard" Style="{StaticResource FSTCardStyle}" Padding="16,8">
                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="12" MinHeight="56">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="Disable Item Shop Highlighting" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Turn off green, gold, and red pulsing Item Shop highlights." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Style="{StaticResource SettingSwitchStyle}" MinWidth="0" Width="52" IsOn="{x:Bind ViewModel.DisableShopHighlighting, Mode=TwoWay}"
                                              IsEnabled="{x:Bind ViewModel.CanToggleShopHighlight, Mode=OneWay}"
                                              AutomationProperties.Name="Disable Item Shop Highlighting"
                                              AutomationProperties.AutomationId="fst.settings.shop-highlights" />
                            </Grid>
                            <Grid ColumnSpacing="12" MinHeight="56">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="Hide Item Shop" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Hide all Item Shop UI elements including navigation, buttons, and sort options." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Style="{StaticResource SettingSwitchStyle}" MinWidth="0" Width="52" IsOn="{x:Bind ViewModel.HideShop, Mode=TwoWay}"
                                              AutomationProperties.Name="Hide Item Shop"
                                              AutomationProperties.AutomationId="fst.settings.hide-shop" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Show Instruments -->
                <StackPanel controls:QuickLinkAnchor.Id="show-instruments" Visibility="{x:Bind InlineVisibility(x:True, IsSplit), Mode=OneWay}">
                    <TextBlock Text="Show Instruments" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="Choose which instruments to display throughout the app." Style="{StaticResource SectionSubtitleStyle}" />
                    <Border x:Name="InstrumentsCard" Style="{StaticResource FSTCardStyle}" Padding="16,8">
                        <!-- Non-virtualizing stack (#546): a virtualizing StackLayout realizes nothing while off screen, so the
                             page extent above later sections is an estimate (What's New moved after scrolling to it) and a
                             Quick Links jump landed before its first toggle existed to take focus. -->
                        <ItemsRepeater TabFocusNavigation="Local" XYFocusKeyboardNavigation="Enabled" ItemsSource="{x:Bind ViewModel.Instruments}">
                            <ItemsRepeater.Layout>
                                <controls:LeaderboardsCardGridLayout MinColumnWidth="0" MaxColumns="1" Spacing="0" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:InstrumentToggle">
                                    <Grid ColumnSpacing="12" MinHeight="48">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:InstrumentIcon File="{x:Bind IconFile}" Label="{x:Bind Label}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Label}" />
                                            <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource SettingDescriptionStyle}"
                                                       Visibility="{x:Bind IsEnabled, Mode=OneWay, Converter={StaticResource FSTInverseVisibility}}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="2" Style="{StaticResource SettingSwitchStyle}" MinWidth="0" Width="52" IsOn="{x:Bind IsOn, Mode=TwoWay}" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                                      AutomationProperties.Name="{x:Bind Label}"
                                                      AutomationProperties.HelpText="{x:Bind Description, Mode=OneWay}"
                                                      AutomationProperties.AutomationId="{x:Bind AutomationId}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>
                </StackPanel>

                <!-- Show Instrument Metadata -->
                <StackPanel controls:QuickLinkAnchor.Id="show-metadata" Visibility="{x:Bind InlineVisibility(x:True, IsSplit), Mode=OneWay}">
                    <TextBlock Text="Show Instrument Metadata" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{x:Bind ViewModel.MetadataDescription, Mode=OneWay}" Style="{StaticResource SectionSubtitleStyle}" />
                    <Border x:Name="MetadataCard" Style="{StaticResource FSTCardStyle}" Padding="16,8">
                        <ItemsRepeater TabFocusNavigation="Local" XYFocusKeyboardNavigation="Enabled" ItemsSource="{x:Bind ViewModel.Metadata}">
                            <ItemsRepeater.Layout>
                                <controls:LeaderboardsCardGridLayout MinColumnWidth="0" MaxColumns="1" Spacing="0" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:MetadataToggle">
                                    <Grid ColumnSpacing="12" MinHeight="48">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{x:Bind Label}" />
                                            <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource SettingDescriptionStyle}"
                                                       Visibility="{x:Bind IsEnabled, Mode=OneWay, Converter={StaticResource FSTInverseVisibility}}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" Style="{StaticResource SettingSwitchStyle}" MinWidth="0" Width="52" IsOn="{x:Bind IsOn, Mode=TwoWay}" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                                      AutomationProperties.Name="{x:Bind Label}"
                                                      AutomationProperties.HelpText="{x:Bind Description, Mode=OneWay}"
                                                      AutomationProperties.AutomationId="{x:Bind AutomationId}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>
                </StackPanel>

                <!-- Accessibility (native additive section) -->
                <StackPanel controls:QuickLinkAnchor.Id="accessibility" Visibility="{x:Bind InlineVisibility(x:True, IsSplit), Mode=OneWay}">
                    <TextBlock Text="Accessibility" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="Off follows Windows; On adds an app override. Narrator and text size are managed in Windows Settings."
                               Style="{StaticResource SectionSubtitleStyle}" />
                    <Border x:Name="AccessibilityCard" Style="{StaticResource FSTCardStyle}" Padding="16,8">
                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="12" MinHeight="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Reduce Motion" Style="{StaticResource SettingTitleStyle}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" Style="{StaticResource SettingSwitchStyle}" MinWidth="0" Width="52" IsOn="{x:Bind ViewModel.ReduceMotion, Mode=TwoWay}"
                                              AutomationProperties.Name="Reduce Motion" AutomationProperties.AutomationId="fst.settings.reduce-motion" />
                            </Grid>
                            <Grid ColumnSpacing="12" MinHeight="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Disable Animated Artwork" Style="{StaticResource SettingTitleStyle}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" Style="{StaticResource SettingSwitchStyle}" MinWidth="0" Width="52" IsOn="{x:Bind ViewModel.DisableAnimatedArtwork, Mode=TwoWay}"
                                              AutomationProperties.Name="Disable Animated Artwork" AutomationProperties.AutomationId="fst.settings.disable-artwork-animation" />
                            </Grid>
                            <Grid ColumnSpacing="12" MinHeight="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="Increase Contrast" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Brighter secondary text and stronger card outlines." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Style="{StaticResource SettingSwitchStyle}" MinWidth="0" Width="52" IsOn="{x:Bind ViewModel.MoreContrast, Mode=TwoWay}"
                                              AutomationProperties.Name="Increase Contrast" AutomationProperties.AutomationId="fst.settings.more-contrast" />
                            </Grid>
                            <Grid ColumnSpacing="12" MinHeight="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="Reduce Transparency" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Replaces translucent cards with solid surfaces." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Style="{StaticResource SettingSwitchStyle}" MinWidth="0" Width="52" IsOn="{x:Bind ViewModel.LessTransparency, Mode=TwoWay}"
                                              AutomationProperties.Name="Reduce Transparency" AutomationProperties.AutomationId="fst.settings.less-transparency" />
                            </Grid>
                            <Grid ColumnSpacing="12" MinHeight="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="Hide Artwork (Save Data)" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Skips album art downloads and shows the brand background." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Style="{StaticResource SettingSwitchStyle}" MinWidth="0" Width="52" IsOn="{x:Bind ViewModel.SaveData, Mode=TwoWay}"
                                              AutomationProperties.Name="Hide Artwork (Save Data)" AutomationProperties.AutomationId="fst.settings.save-data" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Version -->
                <StackPanel controls:QuickLinkAnchor.Id="version" Visibility="{x:Bind InlineVisibility(x:True, IsSplit), Mode=OneWay}">
                    <TextBlock Text="Festival Score Tracker Version" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="Festival Score Tracker information to help with debugging." Style="{StaticResource SectionSubtitleStyle}" />
                    <Border x:Name="VersionCard" Style="{StaticResource FSTCardStyle}">
                        <!-- Label/value pairs: values share a right column while everything fits, else every value moves under
                             its label (narrow window, 200% text, long release version) instead of clipping the label. -->
                        <controls:SettingValueGrid>
                            <TextBlock Text="App Version" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.AppVersion}" Foreground="{ThemeResource FSTSecondaryTextBrush}" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True" AutomationProperties.AutomationId="fst.settings.app-version" />
                            <TextBlock Text="Build Configuration" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.BuildConfiguration}" Foreground="{ThemeResource FSTSecondaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="Service Version" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.ServiceVersion, Mode=OneWay}" Foreground="{ThemeResource FSTSecondaryTextBrush}" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True" AutomationProperties.AutomationId="fst.settings.service-version" />
                            <!-- Replays the launch What's New dialog (web: the changelog under Version). -->
                            <TextBlock Text="What's New" TextWrapping="Wrap" />
                            <Button Content="Show" Click="OnShowWhatsNew"
                                    AutomationProperties.Name="Show What's New"
                                    AutomationProperties.AutomationId="fst.settings.whats-new" />
                        </controls:SettingValueGrid>
                    </Border>
                </StackPanel>

                <!-- Service Info (web SettingsServiceProgressCard): live update state, phase progress, last publication. Percent and
                     units are spoken on the phase row rather than printed (web parity); band discovery adds its attempt line, and
                     each newly accepted attempt count is announced once from that line (code-behind, issue #275). -->
                <StackPanel controls:QuickLinkAnchor.Id="service-info" Visibility="{x:Bind InlineVisibility(x:True, IsSplit), Mode=OneWay}">
                    <TextBlock Text="Service Info" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="Live leaderboard update status, exact phase progress when available, and publication timing." Style="{StaticResource SectionSubtitleStyle}" />
                    <!-- Test IDs sit on the TextBlocks: a Border, Grid or unnamed StackPanel has no UIA element (issue #275). -->
                    <Border x:Name="ServiceInfoCard" Style="{StaticResource FSTCardStyle}" Padding="16,8">
                        <StackPanel Spacing="4">
                            <!-- settings-value-row R1 (issue #539): the process state sits trailing while the title and state fit
                                 beside each other at their natural widths, else it moves under the state text (measured, not by
                                 text size). The state text is supporting text: it wraps under the title and doesn't count. -->
                            <controls:SettingValueGrid MinHeight="40" Margin="0,8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Leaderboard Service State" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.ServiceInfo.StateDescription, Mode=OneWay}" Style="{StaticResource SettingDescriptionStyle}"
                                               AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="fst.settings.service-info.state" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.ServiceInfo.ProcessStateText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                               VerticalAlignment="Center" AutomationProperties.AutomationId="fst.settings.service-info.process" />
                                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.ServiceInfo.ShowsSpinner, Mode=OneWay}"
                                                  Visibility="{x:Bind ViewModel.ServiceInfo.ShowsSpinner, Mode=OneWay}"
                                                  AutomationProperties.AccessibilityView="Raw" AutomationProperties.AutomationId="fst.settings.service-info.spinner" />
                                </StackPanel>
                            </controls:SettingValueGrid>
                            <StackPanel Spacing="4" Padding="0,4,0,8" Visibility="{x:Bind ViewModel.ServiceInfo.HasPhase, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind ViewModel.ServiceInfo.PhaseAccessibleName, Mode=OneWay}"
                                        AutomationProperties.AutomationId="fst.settings.service-info.phase">
                                <StackPanel.Resources>
                                    <x:Double x:Key="ProgressBarTrackHeight">8</x:Double>
                                    <CornerRadius x:Key="ProgressBarTrackCornerRadius">4</CornerRadius>
                                </StackPanel.Resources>
                                <TextBlock Text="{x:Bind ViewModel.ServiceInfo.PhaseTitle, Mode=OneWay}" Style="{StaticResource SettingTitleStyle}" />
                                <!-- Unknown totals show an empty track rather than a looping shimmer (no idle animation). -->
                                <ProgressBar Height="8" MinHeight="8" CornerRadius="4" Maximum="100" Value="{x:Bind ViewModel.ServiceInfo.BarPercent, Mode=OneWay}"
                                             Foreground="{ThemeResource FSTProgressFillBrush}" Background="{ThemeResource FSTProgressTrackBrush}"
                                             Visibility="{x:Bind ViewModel.ServiceInfo.HasBar, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="ServiceAttemptText" Text="{x:Bind ViewModel.ServiceInfo.AttemptText, Mode=OneWay}" Style="{StaticResource SettingDescriptionStyle}"
                                           Visibility="{x:Bind ViewModel.ServiceInfo.HasAttempt, Mode=OneWay}"
                                           AutomationProperties.AutomationId="fst.settings.service-info.attempt" />
                            </StackPanel>
                            <StackPanel Spacing="4" MinHeight="56" Padding="0,8" Visibility="{x:Bind ViewModel.ServiceInfo.HasLastPublished, Mode=OneWay}">
                                <TextBlock Text="Last Successful Publication" Style="{StaticResource SettingTitleStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.ServiceInfo.LastPublished, Mode=OneWay}" Style="{StaticResource SettingDescriptionStyle}"
                                           AutomationProperties.AutomationId="fst.settings.service-info.last-published" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- First Run Guides -->
                <StackPanel controls:QuickLinkAnchor.Id="first-run" Visibility="{x:Bind InlineVisibility(x:True, IsSplit), Mode=OneWay}">
                    <TextBlock Text="First Run Guides" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="Re-visit the first run experience for each page." Style="{StaticResource SectionSubtitleStyle}" />
                    <Border x:Name="FirstRunCard" Style="{StaticResource FSTCardStyle}" Padding="16,8">
                        <!-- Web btnPrimary: translucent blue chip with a blue outline (lightweight styling scoped to this card);
                             system button colours under a contrast theme. -->
                        <Border.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries>
                                    <ResourceDictionary Source="ms-appx:///Themes/FirstRunButtonResources.xaml" />
                                </ResourceDictionary.MergedDictionaries>
                            </ResourceDictionary>
                        </Border.Resources>
                        <ItemsRepeater TabFocusNavigation="Local" XYFocusKeyboardNavigation="Enabled" ItemsSource="{x:Bind ViewModel.FirstRunPages}">
                            <ItemsRepeater.Layout>
                                <controls:LeaderboardsCardGridLayout MinColumnWidth="0" MaxColumns="1" Spacing="0" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:FirstRunReplayItem">
                                    <Grid ColumnSpacing="12" MinHeight="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <Button Grid.Column="1" Content="Show" Click="OnReplayClick" Tag="{x:Bind Page}" MinWidth="80"
                                                FontWeight="SemiBold" BorderThickness="1" CornerRadius="4" Padding="20,6"
                                                AutomationProperties.Name="{x:Bind ButtonName}"
                                                AutomationProperties.AutomationId="{x:Bind AutomationId}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>
                </StackPanel>

                <!-- Licenses: web navigation row — the section header itself is the link, with a trailing chevron (no card). -->
                <StackPanel controls:QuickLinkAnchor.Id="licenses" Visibility="{x:Bind InlineVisibility(x:True, IsSplit), Mode=OneWay}" Margin="0,8,0,0">
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="-1,0" Padding="0,3,4,3" Click="OnLicensesClick"
                            Background="Transparent" BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}"
                            AutomationProperties.Name="Licenses" AutomationProperties.HelpText="Open source package license details."
                            AutomationProperties.AutomationId="fst.settings.licenses">
                        <Button.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries>
                                    <ResourceDictionary Source="ms-appx:///Themes/NavRowButtonResources.xaml" />
                                </ResourceDictionary.MergedDictionaries>
                            </ResourceDictionary>
                        </Button.Resources>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Licenses" Style="{StaticResource FSTSectionHeaderStyle}" Margin="0,0,0,8" />
                                <TextBlock Text="Open source package license details." Style="{StaticResource SettingDescriptionStyle}" />
                            </StackPanel>
                            <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="18" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Privacy Policy (issue #98): the same navigation row; opens the shared policy in a ContentDialog. -->
                <StackPanel controls:QuickLinkAnchor.Id="privacy-policy" Visibility="{x:Bind InlineVisibility(x:True, IsSplit), Mode=OneWay}" Margin="0,8,0,0">
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="-1,0" Padding="0,3,4,3" Click="OnPrivacyPolicyClick"
                            Background="Transparent" BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}"
                            AutomationProperties.Name="Privacy Policy" AutomationProperties.HelpText="How Festival Score Tracker handles your information."
                            AutomationProperties.AutomationId="fst.settings.privacy-policy">
                        <Button.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries>
                                    <ResourceDictionary Source="ms-appx:///Themes/NavRowButtonResources.xaml" />
                                </ResourceDictionary.MergedDictionaries>
                            </ResourceDictionary>
                        </Button.Resources>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Privacy Policy" Style="{StaticResource FSTSectionHeaderStyle}" Margin="0,0,0,8" />
                                <TextBlock Text="How Festival Score Tracker handles your information." Style="{StaticResource SettingDescriptionStyle}" />
                            </StackPanel>
                            <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="18" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Reset: web resetRow — header and description, red "Reset All Settings" beside them. -->
                <Grid controls:QuickLinkAnchor.Id="reset" ColumnSpacing="24" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Reset Settings" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Text="Restore all settings to their default values. Your profile, song filters and navigation stay."
                                   Style="{StaticResource SettingDescriptionStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Reset All Settings" Click="OnResetClick" VerticalAlignment="Center"
                            FontWeight="SemiBold" CornerRadius="4" Padding="16,8" MinWidth="180"
                            AutomationProperties.AutomationId="fst.settings.reset">
                        <Button.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries>
                                    <ResourceDictionary Source="ms-appx:///Themes/DangerButtonResources.xaml" />
                                </ResourceDictionary.MergedDictionaries>
                            </ResourceDictionary>
                        </Button.Resources>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- List/detail trailing pane (issue #371). Nothing selected: the centred placeholder (the Rivals empty-state shape:
             icon, subtitle heading, secondary line). Selected: the setting's title and description over its moved card or
             body, or Licenses in the frame. One backdrop and no drawn divider (split-panes). -->
        <Grid x:Name="DetailHost" Grid.Column="1" Visibility="Collapsed">
            <ScrollViewer x:Name="PlaceholderScroller" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="480" Padding="24"
                            AutomationProperties.AutomationId="fst.settings.detail.placeholder">
                    <FontIcon Glyph="&#xE713;" FontSize="40" Foreground="{ThemeResource FSTSecondaryTextBrush}"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="PlaceholderTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Center" AutomationProperties.HeadingLevel="Level2"
                               AutomationProperties.AutomationId="fst.settings.detail.placeholder.title" />
                    <TextBlock x:Name="PlaceholderMessage" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"
                               Foreground="{ThemeResource FSTSecondaryTextBrush}"
                               AutomationProperties.AutomationId="fst.settings.detail.placeholder.message" />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="DetailScroller" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="fst.settings.detail">
                <!-- Full pane width up to the page's 880 epx content width, left-aligned like the one-column page. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="928" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Padding="24,12,24,32" Spacing="4">
                        <TextBlock x:Name="DetailTitle" Style="{StaticResource FSTPageTitleStyle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1"
                                   AutomationProperties.AutomationId="fst.settings.detail.title" />
                        <TextBlock x:Name="DetailDescription" Style="{StaticResource SectionSubtitleStyle}" Margin="0,0,0,8"
                                   AutomationProperties.AutomationId="fst.settings.detail.description" />
                        <!-- A moved section card (Item Shop … First Run Guides) or the inline Privacy Policy card. -->
                        <StackPanel x:Name="DetailBody" />
                        <!-- A moved App Settings body (order list, Image/Text choice, leeway slider) keeps a card around it. -->
                        <Border x:Name="DetailCard" Style="{StaticResource FSTCardStyle}" Padding="16,8" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Frame x:Name="DetailFrame" IsNavigationStackEnabled="False" Visibility="Collapsed" />
        </Grid>

        <controls:QuickLinksPane x:Name="Pane" Grid.Column="1" Width="240" Margin="0,64,24,24" Visibility="Collapsed"
                                 Model="{x:Bind ViewModel.QuickLinks}" />
    </Grid>
</Page>
