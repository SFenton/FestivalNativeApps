<Page
    x:Class="Festival.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    NavigationCacheMode="Required"
    Background="Transparent">
    <ScrollViewer AutomationProperties.AutomationId="fst.settings">
        <StackPanel Padding="24,12,24,32" Spacing="4" MaxWidth="880" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource FSTPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,8" />

            <TextBlock Text="Profile" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource FSTCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.ProfileText, Mode=OneWay}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Deselect Player" Command="{x:Bind ViewModel.DeselectPlayerCommand}"
                            Visibility="{x:Bind ViewModel.HasPlayer, Mode=OneWay}"
                            AutomationProperties.AutomationId="fst.settings.deselect-player" />
                </Grid>
            </Border>

            <TextBlock Text="Instruments" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource FSTCardStyle}" Padding="16,8">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Instruments}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:InstrumentToggle">
                            <Grid ColumnSpacing="12" MinHeight="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:InstrumentIcon File="{x:Bind IconFile}" Label="{x:Bind Label}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Label}" />
                                    <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource FSTSecondaryTextBrush}"
                                               Visibility="{x:Bind IsEnabled, Mode=OneWay, Converter={StaticResource FSTInverseVisibility}}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsOn, Mode=TwoWay}" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                              OnContent="" OffContent="" MinWidth="0"
                                              AutomationProperties.Name="{x:Bind Label}"
                                              AutomationProperties.HelpText="{x:Bind Description, Mode=OneWay}"
                                              AutomationProperties.AutomationId="{x:Bind AutomationId}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Border>

            <TextBlock Text="Accessibility" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource FSTCardStyle}" Padding="16,8">
                <StackPanel>
                    <ToggleSwitch Header="Reduce Motion" IsOn="{x:Bind ViewModel.ReduceMotion, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="fst.settings.reduce-motion" />
                    <ToggleSwitch Header="Disable Animated Artwork" IsOn="{x:Bind ViewModel.DisableAnimatedArtwork, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="fst.settings.disable-animated-artwork" />
                    <ToggleSwitch Header="Hide Artwork (Save Data)" IsOn="{x:Bind ViewModel.SaveData, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="fst.settings.save-data" />
                    <TextBlock Text="These only add to the Windows animation and transparency settings; they never turn system effects back on."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Margin="0,4,0,8"
                               Foreground="{ThemeResource FSTSecondaryTextBrush}" />
                </StackPanel>
            </Border>

            <TextBlock Text="About" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource FSTCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="VersionText" />
                    <TextBlock Text="{x:Bind ViewModel.ServiceOrigin}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource FSTSecondaryTextBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
