<Page
    x:Class="Festival.App.Pages.SongsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    xmlns:pages="using:Festival.App.Pages"
    xmlns:data2="using:Microsoft.UI.Xaml.Data"
    NavigationCacheMode="Required"
    Background="Transparent">
    <Page.Resources>
        <CollectionViewSource x:Name="GroupedSongs" IsSourceGrouped="True" />
        <!-- Web ToggleRow: label (or stars / intensity bars), optional description, trailing switch. -->
        <DataTemplate x:Key="FilterToggleTemplate" x:DataType="vm:FilterToggleRow">
            <Grid ColumnSpacing="12" MinHeight="40" Padding="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" Visibility="{x:Bind ShowText}" />
                    <controls:StarRow Stars="{x:Bind Stars}" StarSize="14" HorizontalAlignment="Left" AutomationProperties.AccessibilityView="Raw" />
                    <controls:DifficultyMeter Raw="{x:Bind BarsRaw}" HorizontalAlignment="Left" Visibility="{x:Bind ShowBars}"
                                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource FSTSecondaryTextStyle}" FontSize="12" TextWrapping="Wrap"
                               Visibility="{x:Bind HasDescription}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsOn, Mode=TwoWay}" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                              OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"
                              AutomationProperties.Name="{x:Bind Label}" AutomationProperties.AutomationId="{x:Bind AutomationId}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="Root" Padding="24,12,12,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Wide windows (page >= 1100 epx) split into the list and the selected song's detail (operator 2026-09-28:
             two populated columns, never an empty detail pane). SongsPage.ApplySplit sets the widths. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Songs" Style="{StaticResource FSTPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" VerticalAlignment="Bottom" Margin="0,0,0,4"
                       Style="{StaticResource FSTSecondaryTextStyle}" Visibility="{x:Bind ViewModel.ShowList, Mode=OneWay}"
                       AutomationProperties.AutomationId="fst.songs.count" />
        </StackPanel>

        <!-- Search, Sort, Filter and Jump (page actions). -->
        <Grid x:Name="Actions" Grid.Row="1" ColumnSpacing="8" RowSpacing="8" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SearchColumn" Width="*" MaxWidth="440" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Centred: the action buttons beside it are 40 epx tall (FSTMinTargetSize), the box keeps Fluent's 32. -->
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search songs or artists" QueryIcon="Find" VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            QuerySubmitted="OnSearchSubmitted"
                            AutomationProperties.Name="Search songs"
                            AutomationProperties.AutomationId="fst.songs.search" />

            <StackPanel x:Name="ActionButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <DropDownButton x:Name="SortButton" AutomationProperties.Name="Sort Songs" MinHeight="{StaticResource FSTMinTargetSize}"
                            AutomationProperties.HelpText="{x:Bind ViewModel.SortDescription, Mode=OneWay}"
                            AutomationProperties.AutomationId="fst.songs.sort">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                    <TextBlock x:Name="SortLabel" Text="{x:Bind ViewModel.SortSummary, Mode=OneWay}" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <Flyout x:Name="SortFlyout" Placement="BottomEdgeAlignedLeft" Opening="OnSortOpening">
                        <StackPanel Width="300" Spacing="12" AutomationProperties.AutomationId="fst.songs.sort.form">
                            <TextBlock Text="Sort Songs" Style="{StaticResource FSTSectionHeaderStyle}" Margin="0"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <RadioButtons Header="Sort By" ItemsSource="{x:Bind ViewModel.SortDraft.ModeLabels, Mode=OneWay}"
                                          SelectedIndex="{x:Bind ViewModel.SortDraft.ModeIndex, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="fst.songs.sort.mode" />
                            <!-- Direction rows (operator batch 7.21): "Ascending" / "Descending" with the web's description as the
                                 subtitle beside the arrow. A RadioButtons group like Sort By (issue #218): one tab stop with arrow
                                 keys inside, and UIA names the group by its header and reports each row's position in the set. -->
                            <RadioButtons Header="Direction" SelectedIndex="{x:Bind ViewModel.SortDraft.DirectionIndex, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="fst.songs.sort.direction">
                                <RadioButton AutomationProperties.Name="Ascending, A–Z, low–high" AutomationProperties.AutomationId="fst.songs.sort.direction.ascending">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE74A;" FontSize="16" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Ascending" />
                                            <TextBlock Text="A–Z, low–high" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource FSTSecondaryTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </RadioButton>
                                <RadioButton AutomationProperties.Name="Descending, Z–A, high–low" AutomationProperties.AutomationId="fst.songs.sort.direction.descending">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE74B;" FontSize="16" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Descending" />
                                            <TextBlock Text="Z–A, high–low" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource FSTSecondaryTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </RadioButton>
                            </RadioButtons>
                            <!-- Changes apply live; Reset restores the default sort. Light dismiss / Esc closes. -->
                            <Button Content="Reset" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.SortDraft.ResetCommand}"
                                    AutomationProperties.AutomationId="fst.songs.sort.reset">
                                    <Button.Resources>
                                        <!-- Web Modal reset: a full-width red (btnDanger #C62828) button (operator batch 7.10). -->
                                        <StaticResource x:Key="ButtonBackground" ResourceKey="FSTDangerBackgroundBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="FSTDangerBackgroundPointerOverBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="FSTDangerBackgroundPressedBrush" />
                                        <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="FSTDangerBackgroundDisabledBrush" />
                                        <StaticResource x:Key="ButtonForeground" ResourceKey="FSTDangerForegroundBrush" />
                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="FSTDangerForegroundPointerOverBrush" />
                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="FSTDangerForegroundPressedBrush" />
                                        <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="FSTDangerForegroundDisabledBrush" />
                                        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="FSTDangerBorderBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="FSTDangerBorderPointerOverBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="FSTDangerBorderPressedBrush" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                                    </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <DropDownButton x:Name="FilterButton" AutomationProperties.Name="Filter Songs" MinHeight="{StaticResource FSTMinTargetSize}"
                            Visibility="{x:Bind ViewModel.ShowFilterButton, Mode=OneWay}"
                            AutomationProperties.AutomationId="fst.songs.filter">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71C;" FontSize="14" />
                    <TextBlock x:Name="FilterLabel" Text="Filter" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <Flyout x:Name="FilterFlyout" Placement="BottomEdgeAlignedLeft" Opening="OnFilterOpening">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="MaxWidth" Value="520" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <!-- Web FilterModal order (6.32/7.17): Global and Individual Score & FC toggles (player), Item Shop, then
                             Selected Instrument Filters (Instrument Selector revealing Season / Percentile / Stars / Song
                             Intensity switches with Select All / Clear All). Changes apply live; Reset clears everything. -->
                        <Grid x:Name="FilterForm" Width="440" MaxHeight="680" RowSpacing="0" AutomationProperties.AutomationId="fst.songs.filter.form">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Filter Songs" Style="{StaticResource FSTSectionHeaderStyle}" Margin="16,16,16,8"
                                       AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="fst.songs.filter.title" />
                            <ScrollViewer Grid.Row="1" Padding="16,0,16,0">
                                <StackPanel Spacing="8" Padding="0,0,0,12">
                                    <StackPanel Padding="0,8,0,0">
                                        <TextBlock Text="General" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level3"
                                                   AutomationProperties.AutomationId="fst.songs.filter.general" />
                                        <TextBlock Text="General filters that apply to all songs."
                                                   Style="{StaticResource FSTSecondaryTextStyle}" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.FilterDraft.GeneralSections, Mode=OneWay}" IsTabStop="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GeneralFilterSection">
                                                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                          AutomationProperties.Name="{x:Bind Title}" AutomationProperties.AutomationId="{x:Bind AutomationId}">
                                                    <Expander.Header>
                                                        <StackPanel Padding="0,8">
                                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                            <TextBlock Text="{x:Bind Hint}" Style="{StaticResource FSTSecondaryTextStyle}" TextWrapping="Wrap" FontSize="12" />
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" Margin="0,0,-8,0">
                                                            <HyperlinkButton Content="Select All" Command="{x:Bind SelectAllCommand}"
                                                                             AutomationProperties.Name="{x:Bind SelectAllName}" AutomationProperties.AutomationId="{x:Bind SelectAllId}" />
                                                            <HyperlinkButton Content="Clear All" Command="{x:Bind ClearAllCommand}"
                                                                             AutomationProperties.Name="{x:Bind ClearAllName}" AutomationProperties.AutomationId="{x:Bind ClearAllId}" />
                                                        </StackPanel>
                                                        <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource FilterToggleTemplate}" IsTabStop="False" />
                                                    </StackPanel>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                              Visibility="{x:Bind ViewModel.FilterDraft.ShowShopFilter, Mode=OneWay}"
                                              AutomationProperties.Name="Item Shop" AutomationProperties.AutomationId="fst.songs.filter.shop">
                                        <Expander.Header>
                                            <StackPanel Padding="0,8">
                                                <TextBlock Text="Item Shop" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="Filter songs by whether they are available in the Item Shop."
                                                           Style="{StaticResource FSTSecondaryTextStyle}" TextWrapping="Wrap" FontSize="12" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.FilterDraft.ShopRows, Mode=OneWay}" ItemTemplate="{StaticResource FilterToggleTemplate}" IsTabStop="False" />
                                    </Expander>

                                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                              AutomationProperties.Name="Double Bass" AutomationProperties.AutomationId="fst.songs.filter.double-bass">
                                        <Expander.Header>
                                            <StackPanel Padding="0,8">
                                                <TextBlock Text="Double Bass" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="Filter songs that have or don't have double bass charts for Pro Drums."
                                                           Style="{StaticResource FSTSecondaryTextStyle}" TextWrapping="Wrap" FontSize="12" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.FilterDraft.DoubleBassRows, Mode=OneWay}" ItemTemplate="{StaticResource FilterToggleTemplate}" IsTabStop="False" />
                                    </Expander>

                                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.FilterDraft.ShowScoreFilters, Mode=OneWay}">
                                        <!-- Web Accordions start collapsed. -->
                                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                  AutomationProperties.Name="Global Score &amp; FC Toggles" AutomationProperties.AutomationId="fst.songs.filter.score.global">
                                            <Expander.Header>
                                                <StackPanel Padding="0,8">
                                                    <TextBlock Text="Global Score &amp; FC Toggles" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <TextBlock Text="Toggles that impact visible instruments. Turning these on or off will enable or disable them across the instruments shown in app settings."
                                                               Style="{StaticResource FSTSecondaryTextStyle}" TextWrapping="Wrap" FontSize="12" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.FilterDraft.GlobalRows, Mode=OneWay}" ItemTemplate="{StaticResource FilterToggleTemplate}" IsTabStop="False" />
                                        </Expander>

                                        <StackPanel Padding="0,8,0,0">
                                            <TextBlock Text="Individual Score &amp; FC Toggles" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level3"
                                                       AutomationProperties.AutomationId="fst.songs.filter.score-sections" />
                                            <TextBlock Text="Toggles that impact individual instruments. These filters are computed per-instrument and then combined with other instruments."
                                                       Style="{StaticResource FSTSecondaryTextStyle}" TextWrapping="Wrap" FontSize="12" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.FilterDraft.ScoreRows, Mode=OneWay}" IsTabStop="False"
                                                      AutomationProperties.AutomationId="fst.songs.filter.score.instrument">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ScoreFilterChartRow">
                                                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                              AutomationProperties.Name="{x:Bind Label}" AutomationProperties.AutomationId="{x:Bind AutomationId}">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                                                                <controls:InstrumentIcon File="{x:Bind IconFile}" Label="{x:Bind Label}" Width="28" Height="28" />
                                                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <ItemsControl ItemsSource="{x:Bind Toggles}" ItemTemplate="{StaticResource FilterToggleTemplate}" IsTabStop="False" />
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <InfoBar IsOpen="{x:Bind ViewModel.FilterDraft.HasHiddenScoreChecks, Mode=OneWay}" IsClosable="False" Severity="Informational"
                                                 Message="Some checks are on instruments hidden in Settings. They're saved but inactive, and your next change removes them."
                                                 AutomationProperties.AutomationId="fst.songs.score-filter-hidden" />
                                    </StackPanel>

                                    <StackPanel Spacing="8" Padding="0,8,0,0" Visibility="{x:Bind ViewModel.FilterDraft.ShowInstrumentFilters, Mode=OneWay}">
                                        <StackPanel>
                                            <TextBlock Text="Selected Instrument Filters" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level3"
                                                       AutomationProperties.AutomationId="fst.songs.filter.instrument-filters" />
                                            <TextBlock Text="Select an instrument to only show its metadata on each song row. When none is selected, all instruments are shown."
                                                       Style="{StaticResource FSTSecondaryTextStyle}" TextWrapping="Wrap" FontSize="12" />
                                        </StackPanel>
                                        <controls:InstrumentSelector x:Name="FilterInstrumentPicker" DeferSelection="True" IdPrefix="fst.songs.filter.instrument"
                                                                     SelectionChanged="OnFilterInstrumentChanged">
                                            <controls:InstrumentSelector.DetailContent>
                                                <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Bind ViewModel.FilterDraft.BucketSections, Mode=OneWay}" IsTabStop="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Spacing="8" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:FilterBucketSection">
                                                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                      AutomationProperties.Name="{x:Bind Title}" AutomationProperties.AutomationId="{x:Bind AutomationId}">
                                                                <Expander.Header>
                                                                    <StackPanel Padding="0,8">
                                                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                                        <TextBlock Text="{x:Bind Hint}" Style="{StaticResource FSTSecondaryTextStyle}" TextWrapping="Wrap" FontSize="12" />
                                                                    </StackPanel>
                                                                </Expander.Header>
                                                                <StackPanel>
                                                                    <!-- Web BulkActions as trailing text actions (7.17). -->
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" Margin="0,0,-8,0">
                                                                        <HyperlinkButton Content="Select All" Command="{x:Bind SelectAllCommand}"
                                                                                         AutomationProperties.Name="{x:Bind SelectAllName}" AutomationProperties.AutomationId="{x:Bind SelectAllId}" />
                                                                        <HyperlinkButton Content="Clear All" Command="{x:Bind ClearAllCommand}"
                                                                                         AutomationProperties.Name="{x:Bind ClearAllName}" AutomationProperties.AutomationId="{x:Bind ClearAllId}" />
                                                                    </StackPanel>
                                                                    <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource FilterToggleTemplate}" IsTabStop="False" />
                                                                </StackPanel>
                                                            </Expander>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </controls:InstrumentSelector.DetailContent>
                                        </controls:InstrumentSelector>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- Changes apply live; Reset clears every filter. Light dismiss / Esc closes. -->
                            <Grid Grid.Row="2" Padding="16,12,16,16" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource FSTCardStrokeBrush}">
                            <Button Content="Reset" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.FilterDraft.ResetCommand}"
                                    AutomationProperties.Name="Reset Song Filters" AutomationProperties.AutomationId="fst.songs.filter.reset">
                                    <Button.Resources>
                                        <!-- Web Modal reset: a full-width red (btnDanger #C62828) button (operator batch 7.10). -->
                                        <StaticResource x:Key="ButtonBackground" ResourceKey="FSTDangerBackgroundBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="FSTDangerBackgroundPointerOverBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="FSTDangerBackgroundPressedBrush" />
                                        <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="FSTDangerBackgroundDisabledBrush" />
                                        <StaticResource x:Key="ButtonForeground" ResourceKey="FSTDangerForegroundBrush" />
                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="FSTDangerForegroundPointerOverBrush" />
                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="FSTDangerForegroundPressedBrush" />
                                        <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="FSTDangerForegroundDisabledBrush" />
                                        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="FSTDangerBorderBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="FSTDangerBorderPointerOverBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="FSTDangerBorderPressedBrush" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                                    </Button.Resources>
                            </Button>
                            </Grid>
                        </Grid>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <!-- Fades in and out as the sort or results change (control spec: never appear/disappear abruptly). -->
            <Button x:Name="JumpButton" Click="OnJumpClick" Visibility="{x:Bind ViewModel.HasJumpIndex, Mode=OneWay}"
                    controls:FadeIn.OnShow="True" controls:FadeIn.OnHide="True"
                    MinWidth="{StaticResource FSTMinTargetSize}" MinHeight="{StaticResource FSTMinTargetSize}"
                    AutomationProperties.Name="Jump to Section" ToolTipService.ToolTip="Jump to section (Ctrl+Minus)"
                    AutomationProperties.AutomationId="fst.songs.section-index-button">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                    <TextBlock x:Name="JumpLabel" Text="Jump" />
                </StackPanel>
            </Button>
            </StackPanel>
        </Grid>

        <!-- Pause and status notices: saved choices that can't apply right now, and player-score state. -->
        <ItemsRepeater x:Name="Notices" TabFocusNavigation="Local" XYFocusKeyboardNavigation="Enabled" Grid.Row="2" Margin="0,0,12,0" ItemsSource="{x:Bind ViewModel.Notices, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.HasNotices, Mode=OneWay}" AutomationProperties.AutomationId="fst.songs.notices">
            <ItemsRepeater.Layout>
                <StackLayout Spacing="6" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:SongNotice">
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="{x:Bind Message}"
                             AutomationProperties.AutomationId="{x:Bind AutomationId}" />
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Sticky section header (operator batches 3 + 5): the current section's label sits in its own row above the
                 list's viewport, so rows scroll away beneath the list's top edge and never show through it. The in-list
                 headers scroll up into it; the first section's in-list header is omitted (this bar names it). Rows fade
                 out over a 40 epx linear ramp at the list's top edge once scrolled, cut short near a section title (TopEdgeFade
                 on ListFadeSource, issues #49, #308). -->
            <!-- A level-2 heading for UIA too: it is the only header of the first section and names the current one.
                 StickyBar clips it so the next section's title can push it up and out (issue #288). -->
            <Grid x:Name="StickyBar" SizeChanged="OnStickyBarSizeChanged">
                <TextBlock x:Name="StickyHeader" Style="{StaticResource FSTSectionHeaderStyle}" Margin="0,0,0,8" Visibility="Collapsed"
                           AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="fst.songs.section-header" />
            </Grid>
            <!-- The fade source: its composition visual is hidden while ListFadeHost paints the faded copy. Zoom's own XAML
                 opacity (the reveal) stays independent of it. -->
            <Grid x:Name="ListFadeSource" Grid.Row="1">
            <SemanticZoom x:Name="Zoom" Visibility="{x:Bind ViewModel.ShowList, Mode=OneWay}" Opacity="0"
                          CanChangeViews="{x:Bind ViewModel.HasJumpIndex, Mode=OneWay}"
                          IsZoomOutButtonEnabled="{x:Bind ViewModel.HasJumpIndex, Mode=OneWay}">
                <SemanticZoom.ZoomedInView>
                    <ListView x:Name="SongList" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="68" ItemsSource="{x:Bind GroupedSongs.View, Mode=OneWay}"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnSongClick"
                              ContainerContentChanging="OnContainerContentChanging"
                              Padding="0,0,12,24"
                              AutomationProperties.Name="Songs"
                              AutomationProperties.AutomationId="fst.songs.list">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <!-- In-list headers scroll with the rows (sticky ones let rows show through, audit 30); StickyHeader pins
                             the current label above the viewport instead. -->
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel AreStickyGroupHeadersEnabled="False" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.GroupStyle>
                            <GroupStyle HidesIfEmpty="True">
                                <!-- No template divider, padding or minimum height: an empty header takes no space. -->
                                <GroupStyle.HeaderContainerStyle>
                                    <Style TargetType="ListViewHeaderItem">
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewHeaderItem">
                                                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.HeaderContainerStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="pages:SongGroup">
                                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource FSTSectionHeaderStyle}" Margin="0,12,0,8"
                                                   Visibility="{x:Bind ShowInlineHeader}"
                                                   Loaded="OnGroupHeaderLoaded" DataContextChanged="OnGroupHeaderDataContextChanged"
                                                   AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                                   AutomationProperties.HeadingLevel="Level2" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SongRowItem">
                                <!-- The shared song row (also the Item Shop list row); SongsPage fills its slots per phase. -->
                                <controls:SongRowCard Title="{x:Bind Title}" Subtitle="{x:Bind Subtitle}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </SemanticZoom.ZoomedInView>
                <SemanticZoom.ZoomedOutView>
                    <!-- Fills the page (transparent) so a click beside the letters closes the index (operator batch 6.1);
                         the letters stay centred through the panel's alignment. -->
                    <GridView x:Name="JumpIndex" ItemsSource="{x:Bind GroupedSongs.View.CollectionGroups, Mode=OneWay}" Background="Transparent"
                              Tapped="OnJumpIndexTapped"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SelectionMode="None"
                              AutomationProperties.Name="Jump to section"
                              AutomationProperties.AutomationId="fst.songs.section-index">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Loaded="OnJumpPanelLoaded" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="data2:ICollectionViewGroup">
                                <TextBlock Text="{x:Bind ((pages:SongGroup)Group).Label}" Style="{StaticResource SubtitleTextBlockStyle}"
                                           Margin="12" MinWidth="48" TextAlignment="Center" />
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </SemanticZoom.ZoomedOutView>
            </SemanticZoom>
            </Grid>
            <!-- Paints ListFadeSource with its top edge faded while the fade is on (TopEdgeFade); never hit-testable. Raw-view
                 ItemStatus names the edge state for UI tests (hidden, hard-edge, top, clear, fading). -->
            <controls:EdgeFadeLayer x:Name="ListFadeHost" Grid.Row="1" AutomationProperties.AutomationId="fst.songs.edge-fade" />
            <!-- Issue #288: the next section's title, drawn here from the edge fade's full depth (40 epx) up to the bar, where it pushes
                 StickyHeader out (the in-list heading turns transparent meanwhile but stays the UIA heading, so this copy
                 is Raw). Positions follow the scroll on the compositor; nothing animates on its own. -->
            <Canvas x:Name="PushLayer" Grid.RowSpan="2" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                <TextBlock x:Name="IncomingHeader" Style="{StaticResource FSTSectionHeaderStyle}" Margin="0" Visibility="Collapsed"
                           AutomationProperties.AccessibilityView="Raw" />
            </Canvas>

            <ProgressRing Grid.RowSpan="2" x:Name="LoadingRing" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="48" Height="48"
                          AutomationProperties.Name="Loading songs" />

            <controls:ServiceStatusView Grid.RowSpan="2" Status="{x:Bind ViewModel.Status}" VerticalAlignment="Center"
                                        Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}"
                                        AutomationProperties.AutomationId="fst.songs.error" />

            <StackPanel Grid.RowSpan="2" Visibility="{x:Bind ViewModel.ShowInvalidFilter, Mode=OneWay}" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Spacing="12" MaxWidth="420">
                <TextBlock Text="Saved Filters Can't Be Read" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="fst.songs.filter-invalid" />
                <TextBlock Text="Your saved player score filters are damaged, so songs can't be filtered safely. Reset filters to continue."
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <Button Content="Reset Filters" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.ClearFilterCommand}" AutomationProperties.AutomationId="fst.songs.filter-reset-invalid" />
            </StackPanel>

            <StackPanel Grid.RowSpan="2" Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Spacing="12" AutomationProperties.AutomationId="fst.songs.empty">
                <TextBlock Text="No Results" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                <Button Content="Clear Filters" HorizontalAlignment="Center" Command="{x:Bind ViewModel.ClearFilterCommand}"
                        Visibility="{x:Bind ViewModel.IsFilterActive, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <Frame x:Name="DetailFrame" Grid.Column="1" Grid.RowSpan="4" Margin="12,-12,0,0" Visibility="Collapsed"
               IsNavigationStackEnabled="False" AutomationProperties.Name="Song details"
               AutomationProperties.AutomationId="fst.songs.detail-pane" />
    </Grid>
</Page>
