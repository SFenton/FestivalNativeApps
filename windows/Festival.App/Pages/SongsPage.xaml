<Page
    x:Class="Festival.App.Pages.SongsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    xmlns:pages="using:Festival.App.Pages"
    xmlns:data2="using:Microsoft.UI.Xaml.Data"
    NavigationCacheMode="Required"
    Background="Transparent">
    <Page.Resources>
        <CollectionViewSource x:Name="GroupedSongs" IsSourceGrouped="True" />
        <Style x:Key="SongTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
        <Style x:Key="SongSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource FSTSecondaryTextBrush}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="Root" Padding="24,12,12,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Songs" Style="{StaticResource FSTPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" VerticalAlignment="Bottom" Margin="0,0,0,4"
                       Style="{StaticResource FSTSecondaryTextStyle}" Visibility="{x:Bind ViewModel.ShowList, Mode=OneWay}"
                       AutomationProperties.AutomationId="fst.songs.count" />
        </StackPanel>

        <!-- Search, Sort, Filter and Jump (page actions). -->
        <Grid x:Name="Actions" Grid.Row="1" ColumnSpacing="8" RowSpacing="8" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SearchColumn" Width="*" MaxWidth="440" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search songs or artists" QueryIcon="Find"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            QuerySubmitted="OnSearchSubmitted"
                            AutomationProperties.Name="Search songs"
                            AutomationProperties.AutomationId="fst.songs.search" />

            <StackPanel x:Name="ActionButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <DropDownButton x:Name="SortButton" AutomationProperties.Name="Sort Songs"
                            AutomationProperties.AutomationId="fst.songs.sort">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                    <TextBlock x:Name="SortLabel" Text="{x:Bind ViewModel.SortSummary, Mode=OneWay}" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <Flyout x:Name="SortFlyout" Placement="BottomEdgeAlignedLeft" Opening="OnSortOpening">
                        <StackPanel Width="300" Spacing="12" AutomationProperties.AutomationId="fst.songs.sort.form">
                            <TextBlock Text="Sort Songs" Style="{StaticResource FSTSectionHeaderStyle}" Margin="0"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <RadioButtons Header="Sort By" ItemsSource="{x:Bind ViewModel.SortDraft.ModeLabels, Mode=OneWay}"
                                          SelectedIndex="{x:Bind ViewModel.SortDraft.ModeIndex, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="fst.songs.sort.mode" />
                            <ToggleSwitch Header="Direction" OnContent="Ascending" OffContent="Descending"
                                          IsOn="{x:Bind ViewModel.SortDraft.Ascending, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="fst.songs.sort.direction" />
                            <!-- Changes apply live; Reset restores the default sort. Light dismiss / Esc closes. -->
                            <Button Content="Reset" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.SortDraft.ResetCommand}"
                                    AutomationProperties.AutomationId="fst.songs.sort.reset" />
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <DropDownButton x:Name="FilterButton" AutomationProperties.Name="Filter Songs"
                            Visibility="{x:Bind ViewModel.ShowFilterButton, Mode=OneWay}"
                            AutomationProperties.AutomationId="fst.songs.filter">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71C;" FontSize="14" />
                    <TextBlock x:Name="FilterLabel" Text="Filter" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <Flyout x:Name="FilterFlyout" Placement="BottomEdgeAlignedLeft" Opening="OnFilterOpening">
                        <Grid Width="400" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer MaxHeight="520" Padding="0,0,16,0" AutomationProperties.AutomationId="fst.songs.filter.form">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Filter Songs" Style="{StaticResource FSTSectionHeaderStyle}" Margin="0"
                                       AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="fst.songs.filter.title" />
                            <ComboBox Header="Instrument" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.FilterDraft.InstrumentChoices, Mode=OneWay}"
                                      SelectedIndex="{x:Bind ViewModel.FilterDraft.InstrumentIndex, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="fst.songs.filter.instrument" />
                            <Slider Header="Lowest Difficulty" Minimum="1" Maximum="7" StepFrequency="1" TickFrequency="1"
                                    TickPlacement="Outside" SnapsTo="StepValues"
                                    Value="{x:Bind ViewModel.FilterDraft.MinDifficulty, Mode=TwoWay}"
                                    AutomationProperties.AutomationId="fst.songs.filter.min-difficulty" />
                            <Slider Header="Highest Difficulty" Minimum="1" Maximum="7" StepFrequency="1" TickFrequency="1"
                                    TickPlacement="Outside" SnapsTo="StepValues"
                                    Value="{x:Bind ViewModel.FilterDraft.MaxDifficulty, Mode=TwoWay}"
                                    AutomationProperties.AutomationId="fst.songs.filter.max-difficulty" />
                            <InfoBar IsOpen="{x:Bind pages:SongsPage.Not(ViewModel.FilterDraft.IsRangeValid), Mode=OneWay}" IsClosable="False"
                                     Severity="Warning" Message="The lowest difficulty must not exceed the highest." />

                            <TextBlock Text="Item Shop" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level3" />
                            <CheckBox Content="In Item Shop" IsChecked="{x:Bind ViewModel.FilterDraft.InShop, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.FilterDraft.ShopEnabled, Mode=OneWay}"
                                      AutomationProperties.AutomationId="fst.songs.filter.in-shop" />
                            <CheckBox Content="Leaving Tomorrow" IsChecked="{x:Bind ViewModel.FilterDraft.LeavingTomorrow, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.FilterDraft.ShopEnabled, Mode=OneWay}"
                                      AutomationProperties.AutomationId="fst.songs.filter.leaving" />

                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.FilterDraft.ShowScoreFilters, Mode=OneWay}">
                                <TextBlock Text="Player Scores" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level3"
                                           AutomationProperties.AutomationId="fst.songs.filter.score-sections" />
                                <TextBlock Text="Checks on one instrument must all match; any checked instrument can match."
                                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource FSTSecondaryTextBrush}" />
                                <Grid ColumnSpacing="8" RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <ToggleSwitch Header="Missing Scores" IsOn="{x:Bind ViewModel.FilterDraft.AllMissingScores, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="fst.songs.filter.score.global.missing-scores" />
                                    <ToggleSwitch Grid.Column="1" Header="Has Scores" IsOn="{x:Bind ViewModel.FilterDraft.AllHasScores, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="fst.songs.filter.score.global.has-scores" />
                                    <ToggleSwitch Grid.Row="1" Header="Missing FCs" IsOn="{x:Bind ViewModel.FilterDraft.AllMissingFCs, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="fst.songs.filter.score.global.missing-fcs" />
                                    <ToggleSwitch Grid.Row="1" Grid.Column="1" Header="Has FCs" IsOn="{x:Bind ViewModel.FilterDraft.AllHasFCs, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="fst.songs.filter.score.global.has-fcs" />
                                </Grid>
                                <Expander Header="Per Instrument" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          AutomationProperties.AutomationId="fst.songs.filter.score.instrument">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="No Score" Style="{StaticResource CaptionTextBlockStyle}" TextAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Score" Style="{StaticResource CaptionTextBlockStyle}" TextAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="No FC" Style="{StaticResource CaptionTextBlockStyle}" TextAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="FC" Style="{StaticResource CaptionTextBlockStyle}" TextAlignment="Center" />
                                        </Grid>
                                        <ItemsRepeater TabFocusNavigation="Local" XYFocusKeyboardNavigation="Enabled" ItemsSource="{x:Bind ViewModel.FilterDraft.ScoreRows, Mode=OneWay}">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ScoreFilterChartRow">
                                                    <Grid ColumnSpacing="4" MinHeight="36">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="56" />
                                                            <ColumnDefinition Width="56" />
                                                            <ColumnDefinition Width="56" />
                                                            <ColumnDefinition Width="56" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <controls:InstrumentIcon File="{x:Bind IconFile}" Label="{x:Bind Label}" Width="20" Height="20" />
                                                            <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Center" IsChecked="{x:Bind MissingScores, Mode=TwoWay}"
                                                                  AutomationProperties.Name="{x:Bind MissingScoresName}" />
                                                        <CheckBox Grid.Column="2" MinWidth="0" HorizontalAlignment="Center" IsChecked="{x:Bind HasScores, Mode=TwoWay}"
                                                                  AutomationProperties.Name="{x:Bind HasScoresName}" />
                                                        <CheckBox Grid.Column="3" MinWidth="0" HorizontalAlignment="Center" IsChecked="{x:Bind MissingFCs, Mode=TwoWay}"
                                                                  AutomationProperties.Name="{x:Bind MissingFCsName}" />
                                                        <CheckBox Grid.Column="4" MinWidth="0" HorizontalAlignment="Center" IsChecked="{x:Bind HasFCs, Mode=TwoWay}"
                                                                  AutomationProperties.Name="{x:Bind HasFCsName}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </Expander>
                                <!-- Web percentile/stars filters (one instrument selected): one band and one star level. -->
                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.FilterDraft.ShowScoreBand, Mode=OneWay}">
                                    <ComboBox Header="Percentile" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.FilterDraft.PercentileChoices}"
                                              SelectedIndex="{x:Bind ViewModel.FilterDraft.PercentileIndex, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="fst.songs.filter.percentile" />
                                    <ComboBox Header="Stars" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.FilterDraft.StarsChoices}"
                                              SelectedIndex="{x:Bind ViewModel.FilterDraft.StarsIndex, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="fst.songs.filter.stars" />
                                </StackPanel>
                                <InfoBar IsOpen="{x:Bind ViewModel.FilterDraft.HasHiddenScoreChecks, Mode=OneWay}" IsClosable="False" Severity="Informational"
                                         Message="Some checks are on instruments hidden in Settings. They're saved but inactive, and Apply removes them."
                                         AutomationProperties.AutomationId="fst.songs.score-filter-hidden" />
                            </StackPanel>

                        </StackPanel>
                        </ScrollViewer>
                            <!-- Changes apply live; Reset clears every filter. Light dismiss / Esc closes. -->
                            <Button Grid.Row="1" Content="Reset" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.FilterDraft.ResetCommand}"
                                    AutomationProperties.AutomationId="fst.songs.filter.reset" />
                        </Grid>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <Button x:Name="JumpButton" Click="OnJumpClick" Visibility="{x:Bind ViewModel.HasJumpIndex, Mode=OneWay}"
                    AutomationProperties.Name="Jump to Section" ToolTipService.ToolTip="Jump to section (Ctrl+Minus)"
                    AutomationProperties.AutomationId="fst.songs.section-index-button">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                    <TextBlock x:Name="JumpLabel" Text="Jump" />
                </StackPanel>
            </Button>
            </StackPanel>
        </Grid>

        <!-- Pause and status notices: saved choices that can't apply right now, and player-score state. -->
        <ItemsRepeater TabFocusNavigation="Local" XYFocusKeyboardNavigation="Enabled" Grid.Row="2" Margin="0,0,12,0" ItemsSource="{x:Bind ViewModel.Notices, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.HasNotices, Mode=OneWay}" AutomationProperties.AutomationId="fst.songs.notices">
            <ItemsRepeater.Layout>
                <StackLayout Spacing="6" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="{x:Bind}" />
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <Grid Grid.Row="3">
            <SemanticZoom x:Name="Zoom" Visibility="{x:Bind ViewModel.ShowList, Mode=OneWay}" Opacity="0"
                          CanChangeViews="{x:Bind ViewModel.HasJumpIndex, Mode=OneWay}"
                          IsZoomOutButtonEnabled="{x:Bind ViewModel.HasJumpIndex, Mode=OneWay}">
                <SemanticZoom.ZoomedInView>
                    <ListView x:Name="SongList" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="68" ItemsSource="{x:Bind GroupedSongs.View, Mode=OneWay}"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnSongClick"
                              ContainerContentChanging="OnContainerContentChanging"
                              Padding="0,0,12,24"
                              AutomationProperties.Name="Songs"
                              AutomationProperties.AutomationId="fst.songs.list">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <!-- Section headers scroll with the rows like the web's (audit 30: sticky headers let rows show through). -->
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel AreStickyGroupHeadersEnabled="False" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.GroupStyle>
                            <GroupStyle HidesIfEmpty="True">
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="pages:SongGroup">
                                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource FSTSectionHeaderStyle}" Visibility="{x:Bind HasLabel}"
                                                   AutomationProperties.HeadingLevel="Level2" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SongRowItem">
                                <Grid x:Name="Card" MinHeight="64" Padding="10,8,14,8" ColumnSpacing="12" CornerRadius="8"
                                      BorderThickness="1" Background="{ThemeResource FSTCardSurfaceBrush}" BorderBrush="{ThemeResource FSTCardStrokeBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- Spans the wrapped second row only while it has content (SongsPage.BuildTrailing): a Grid shares a spanning
                                         child's height across Auto rows, so an empty second row got half the art's height
                                         as dead space under anonymous rows (operator batch 6.3). -->
                                    <Border x:Name="ArtHost" Width="44" Height="44" CornerRadius="6" VerticalAlignment="Center"
                                            Background="{StaticResource FSTSurfaceMutedBrush}">
                                        <Image x:Name="Art" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <controls:MarqueeText x:Name="TitleText" Text="{x:Bind Title}" TextStyle="{StaticResource SongTitleStyle}" />
                                        <controls:MarqueeText x:Name="SubtitleText" Text="{x:Bind Subtitle}" TextStyle="{StaticResource SongSubtitleStyle}" />
                                    </StackPanel>
                                    <StackPanel x:Name="Trailing" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
                                    <controls:FlowPanel x:Name="Secondary" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0" Visibility="Collapsed" />
                                    <!-- Pulsing Item Shop ring over the card edge (green in Shop, gold New, red Leaving). -->
                                    <controls:ShopPulseRing x:Name="ShopRing" Grid.RowSpan="2" Grid.ColumnSpan="3" Margin="-11,-9,-15,-9" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </SemanticZoom.ZoomedInView>
                <SemanticZoom.ZoomedOutView>
                    <GridView ItemsSource="{x:Bind GroupedSongs.View.CollectionGroups, Mode=OneWay}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" SelectionMode="None"
                              AutomationProperties.Name="Jump to section"
                              AutomationProperties.AutomationId="fst.songs.section-index">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="data2:ICollectionViewGroup">
                                <TextBlock Text="{x:Bind ((pages:SongGroup)Group).Label}" Style="{StaticResource SubtitleTextBlockStyle}"
                                           Margin="12" MinWidth="48" TextAlignment="Center" />
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </SemanticZoom.ZoomedOutView>
            </SemanticZoom>

            <ProgressRing x:Name="LoadingRing" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="48" Height="48"
                          AutomationProperties.Name="Loading songs" />

            <controls:ServiceStatusView Status="{x:Bind ViewModel.Status}" VerticalAlignment="Center"
                                        Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}"
                                        AutomationProperties.AutomationId="fst.songs.error" />

            <StackPanel Visibility="{x:Bind ViewModel.ShowInvalidFilter, Mode=OneWay}" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Spacing="12" MaxWidth="420">
                <TextBlock Text="Saved Filters Can't Be Read" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="fst.songs.filter-invalid" />
                <TextBlock Text="Your saved player score filters are damaged, so songs can't be filtered safely. Reset filters to continue."
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <Button Content="Reset Filters" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.ClearFilterCommand}" AutomationProperties.AutomationId="fst.songs.filter-reset-invalid" />
            </StackPanel>

            <StackPanel Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Spacing="12" AutomationProperties.AutomationId="fst.songs.empty">
                <TextBlock Text="No Results" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                <Button Content="Clear Filters" HorizontalAlignment="Center" Command="{x:Bind ViewModel.ClearFilterCommand}"
                        Visibility="{x:Bind ViewModel.IsFilterActive, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
