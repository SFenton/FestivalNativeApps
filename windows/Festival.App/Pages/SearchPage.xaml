<Page
    x:Class="Festival.App.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:domain="using:Festival.Core.Domain"
    Background="Transparent">

    <!-- Global search results (fst.global-search.*): field, All/Songs/Players/Bands scopes, Songs → Players sections. -->
    <Grid Padding="24,12,24,0" RowSpacing="8" MaxWidth="768" HorizontalAlignment="Stretch"
          AutomationProperties.AutomationId="fst.global-search.surface">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Search" Style="{StaticResource FSTPageTitleStyle}" AutomationProperties.HeadingLevel="Level1"
                   AutomationProperties.AutomationId="fst.global-search.title" />

        <AutoSuggestBox x:Name="PageField" Grid.Row="1" HorizontalAlignment="Stretch" QueryIcon="Find"
                        PlaceholderText="Search songs or players"
                        Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        QuerySubmitted="OnQuerySubmitted" PreviewKeyDown="OnFieldKeyDown"
                        ToolTipService.ToolTip="Search songs and players (Ctrl+E)"
                        AutomationProperties.Name="Search songs and players"
                        AutomationProperties.AutomationId="fst.global-search.field" />

        <SelectorBar x:Name="ScopeBar" Grid.Row="2" SelectionChanged="OnScopeChanged"
                     AutomationProperties.Name="Search scope" AutomationProperties.AutomationId="fst.global-search.scope">
            <SelectorBarItem Text="All" AutomationProperties.AutomationId="fst.global-search.scope.all" />
            <SelectorBarItem Text="Songs" AutomationProperties.AutomationId="fst.global-search.scope.songs" />
            <SelectorBarItem Text="Players" AutomationProperties.AutomationId="fst.global-search.scope.players" />
            <SelectorBarItem Text="Bands" AutomationProperties.AutomationId="fst.global-search.scope.bands" />
        </SelectorBar>

        <Grid Grid.Row="3">
            <ScrollViewer x:Name="Results" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Search results"
                          AutomationProperties.AutomationId="fst.global-search.results">
                <StackPanel HorizontalAlignment="Stretch" Spacing="16" Padding="0,4,0,24">
                    <!-- Songs -->
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.ShowSongsSection, Mode=OneWay}">
                        <TextBlock Text="Songs" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2"
                                   AutomationProperties.AutomationId="fst.global-search.section.songs" />
                        <TextBlock Text="{x:Bind ViewModel.SongsFailedText}" Style="{StaticResource FSTSecondaryTextStyle}" TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.SongsFailed, Mode=OneWay}" />
                        <Border Style="{StaticResource FSTCardStyle}" Padding="4" Visibility="{x:Bind ViewModel.HasSongRows, Mode=OneWay}">
                            <ListView x:Name="SongsList" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="56" ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}" SelectionMode="None"
                                      IsItemClickEnabled="True" ItemClick="OnSongClick" ContainerContentChanging="OnSongContainer"
                                      ScrollViewer.VerticalScrollMode="Disabled" AutomationProperties.Name="Songs">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="domain:GlobalSongResult">
                                        <Grid ColumnSpacing="12" Padding="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <controls:SongArt Art="{x:Bind Art}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <controls:MarqueeText Text="{x:Bind Title}" TextStyle="{StaticResource FSTMarqueeTitleStyle}" />
                                                <controls:MarqueeText Text="{x:Bind Artist}" TextStyle="{StaticResource FSTMarqueeSecondaryStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </StackPanel>

                    <!-- Players -->
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.ShowPlayersSection, Mode=OneWay}">
                        <TextBlock Text="Players" Style="{StaticResource FSTSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2"
                                   AutomationProperties.AutomationId="fst.global-search.section.players" />
                        <ProgressRing IsActive="{x:Bind ViewModel.PlayersLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.PlayersLoading, Mode=OneWay}"
                                      Width="28" Height="28" HorizontalAlignment="Left" Margin="0,8"
                                      AutomationProperties.Name="Searching players"
                                      AutomationProperties.AutomationId="fst.global-search.players-loading" />
                        <Border Style="{StaticResource FSTCardStyle}" Padding="4" Visibility="{x:Bind ViewModel.HasPlayerRows, Mode=OneWay}">
                            <ListView x:Name="PlayersList" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="48" ItemsSource="{x:Bind ViewModel.Players, Mode=OneWay}" SelectionMode="None"
                                      IsItemClickEnabled="True" ItemClick="OnPlayerClick" ContainerContentChanging="OnPlayerContainer"
                                      ScrollViewer.VerticalScrollMode="Disabled" AutomationProperties.Name="Players">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="domain:GlobalPlayerResult">
                                        <Grid ColumnSpacing="12" Padding="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <PersonPicture Width="36" Height="36" DisplayName="{x:Bind DisplayName}"
                                                           AutomationProperties.AccessibilityView="Raw" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <controls:MarqueeText Text="{x:Bind DisplayName}" TextStyle="{StaticResource FSTMarqueeTitleStyle}" />
                                                <controls:MarqueeText Text="{x:Bind Subtitle}" TextStyle="{StaticResource FSTMarqueeSecondaryStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.PlayersEmpty, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.NoPlayersText}" Style="{StaticResource FSTSecondaryTextStyle}" />
                            <Button Content="Retry" Command="{x:Bind ViewModel.RetryCommand}"
                                    AutomationProperties.Name="Retry player search"
                                    AutomationProperties.AutomationId="fst.global-search.retry" />
                        </StackPanel>
                        <controls:ServiceStatusView Status="{x:Bind ViewModel.PlayersStatus}" HorizontalAlignment="Left"
                                                    Visibility="{x:Bind ViewModel.PlayersFailed, Mode=OneWay}"
                                                    AutomationProperties.AutomationId="fst.global-search.players-error" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="480"
                        Visibility="{x:Bind ViewModel.HasHint, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.Hint, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap"
                           Style="{StaticResource FSTSecondaryTextStyle}" AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.AutomationId="fst.global-search.hint" />
                <Button Content="Retry" Command="{x:Bind ViewModel.RetryCommand}" HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.CanRetryAll, Mode=OneWay}"
                        AutomationProperties.Name="Retry search"
                        AutomationProperties.AutomationId="fst.global-search.retry" />
            </StackPanel>

            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          Width="40" Height="40" VerticalAlignment="Top" Margin="0,48,0,0"
                          AutomationProperties.Name="Searching" />

            <!-- Bands: shown but never requested (the service's band search GET can write). -->
            <InfoBar IsOpen="{x:Bind ViewModel.IsBandsScope, Mode=OneWay}" IsClosable="False" Severity="Informational"
                     VerticalAlignment="Top" Margin="0,4,0,0" Title="Band search unavailable"
                     Message="{x:Bind ViewModel.BandsExplanation}"
                     AutomationProperties.AutomationId="fst.global-search.bands-unavailable">
                <InfoBar.ActionButton>
                    <HyperlinkButton Content="Band Rankings" Click="OnBandRankings"
                                     AutomationProperties.AutomationId="fst.global-search.bands-unavailable.rankings" />
                </InfoBar.ActionButton>
            </InfoBar>
        </Grid>
    </Grid>
</Page>
