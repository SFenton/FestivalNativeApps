<Page
    x:Class="Festival.App.Pages.RivalryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide" />
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter Target="Actions.(Grid.Row)" Value="1" />
                        <Setter Target="Actions.(Grid.Column)" Value="0" />
                        <Setter Target="Actions.HorizontalAlignment" Value="Left" />
                        <Setter Target="Header.Padding" Value="16,8,16,8" />
                        <Setter Target="SongList.Padding" Value="16,0,16,24" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="Header" Padding="24,12,24,8" ColumnSpacing="16" RowSpacing="8" MaxWidth="1040">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource FSTPageTitleStyle}" TextWrapping="Wrap"
                           AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="fst.rivalry.title" />
                <!-- Section title over the rival's name (#604), then the section's description on its own line. -->
                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource FSTSecondaryTextStyle}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="fst.rivalry.subtitle" />
                <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource FSTSecondaryTextBrush}" Visibility="{x:Bind ViewModel.HasDescription, Mode=OneWay}" Margin="0,4,0,0"
                           AutomationProperties.AutomationId="fst.rivalry.description" />
            </StackPanel>
            <Grid x:Name="Actions" Grid.Column="1" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{x:Bind ViewModel.SortLabels}" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                          Header="Sort By" MinWidth="170" Margin="0,0,8,0" Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}"
                          AutomationProperties.Name="Sort By" AutomationProperties.AutomationId="fst.rivalry.sort" />
                <!-- Star column: at narrow widths and large text the label trims instead of running off the window. -->
                <Button Grid.Column="1" Click="OnViewProfile" AutomationProperties.Name="{x:Bind ViewModel.ViewProfileLabel, Mode=OneWay}"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" AutomationProperties.AutomationId="fst.rivalry.view-profile">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE77B;" FontSize="16" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ViewProfileLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Button>
            </Grid>
        </Grid>

        <ListView x:Name="SongList" controls:FadeIn.Together="True" controls:FadeIn.RowHeight="92" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" MaxWidth="1040"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnSongClick" Padding="24,0,24,32"
                  ContainerContentChanging="OnContainerContentChanging"
                  Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}"
                  AutomationProperties.Name="Songs" AutomationProperties.AutomationId="fst.rivalry.list">
            <!-- The category's songs as one grouped card that fades in as one (GroupedRows.ApplyToContainer from
                 OnContainerContentChanging: touching row slices with a hairline between; issue #603, like Apple's
                 FestivalGlassSection and the #543 boards; load-transition R11). -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:RivalSongItem">
                    <!-- The row's slice of the card (corners and outline set per position). -->
                    <Grid CornerRadius="12" BorderThickness="1" Background="{ThemeResource FSTCardSurfaceBrush}" BorderBrush="{ThemeResource FSTCardStrokeBrush}"
                          AutomationProperties.AccessibilityView="Raw">
                        <Border x:Name="RowSeparator" Height="1" Margin="12,0" VerticalAlignment="Top" IsHitTestVisible="False"
                                Visibility="Collapsed" Background="{ThemeResource FSTRowSeparatorBrush}" AutomationProperties.AccessibilityView="Raw" />
                        <controls:RivalSongRowView Item="{x:Bind}" Margin="12,10" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <controls:RivalPageStates Grid.Row="1" Page="{x:Bind ViewModel}" />
    </Grid>
</Page>
