<Page
    x:Class="Festival.App.Pages.RivalryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Festival.App.Controls"
    xmlns:vm="using:Festival.Core.ViewModels"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide" />
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter Target="Actions.(Grid.Row)" Value="1" />
                        <Setter Target="Actions.(Grid.Column)" Value="0" />
                        <Setter Target="Actions.HorizontalAlignment" Value="Left" />
                        <Setter Target="Header.Padding" Value="16,8,16,8" />
                        <Setter Target="SongList.Padding" Value="16,0,16,24" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="Header" Padding="24,12,24,8" ColumnSpacing="16" RowSpacing="8" MaxWidth="1040">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource FSTPageTitleStyle}" TextWrapping="Wrap"
                           AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="fst.rivalry.title" />
                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource FSTSecondaryTextBrush}" />
            </StackPanel>
            <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <ComboBox ItemsSource="{x:Bind ViewModel.SortLabels}" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                          MinWidth="170" Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}"
                          AutomationProperties.Name="Sort Songs" AutomationProperties.AutomationId="fst.rivalry.sort" />
                <Button Click="OnViewProfile" AutomationProperties.Name="{x:Bind ViewModel.ViewProfileLabel, Mode=OneWay}"
                        AutomationProperties.AutomationId="fst.rivalry.view-profile">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE77B;" FontSize="16" />
                        <TextBlock Text="{x:Bind ViewModel.ViewProfileLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ListView x:Name="SongList" controls:FadeIn.Stagger="True" controls:FadeIn.RowHeight="64" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" MaxWidth="1040"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnSongClick" Padding="24,0,24,32"
                  ContainerContentChanging="OnContainerContentChanging"
                  Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}"
                  AutomationProperties.Name="Songs" AutomationProperties.AutomationId="fst.rivalry.list">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="12,10" />
                    <Setter Property="Margin" Value="0,3" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="{ThemeResource FSTCardSurfaceBrush}" />
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:RivalSongItem">
                    <controls:RivalSongRowView Item="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <controls:RivalPageStates Grid.Row="1" Page="{x:Bind ViewModel}" />
    </Grid>
</Page>
