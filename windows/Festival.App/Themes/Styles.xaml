<!--
    Shared Fluent content styles. Cards are solid, semi-opaque surfaces (no in-app acrylic): a blur over
    the animated artwork would be recomputed every frame. High contrast replaces the brand brushes.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Festival.App.Services"
    xmlns:controls="using:Festival.App.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- Mutated at runtime to opaque when Windows transparency effects are off. -->
            <SolidColorBrush x:Key="FSTCardSurfaceBrush" Color="#C7121826" />
            <SolidColorBrush x:Key="FSTCardStrokeBrush" Color="#14FFFFFF" />
            <!-- Linked card buttons (Player Profile stat cards): hover/press surfaces and the hover outline. -->
            <SolidColorBrush x:Key="FSTCardSurfacePointerOverBrush" Color="#D91C2436" />
            <SolidColorBrush x:Key="FSTCardSurfacePressedBrush" Color="#D9161D2C" />
            <SolidColorBrush x:Key="FSTCardStrokePointerOverBrush" Color="#33FFFFFF" />
            <!-- Hairline between the rows of a multi-row card (operator batch 6.5) and the row hover/press fills, which
                 cover the whole row from card edge to card edge (6.2). -->
            <SolidColorBrush x:Key="FSTRowSeparatorBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="FSTRowHoverBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="FSTRowPressedBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="FSTSectionHeaderBrush" Color="#FFFFFFFF" />
            <!-- Pinned page headers (Song Detail): the web headerFrosted tint, near-opaque instead of a per-frame blur. -->
            <SolidColorBrush x:Key="FSTPinnedHeaderBrush" Color="#F70B0318" />
            <!-- Text is white by default over the dimmed artwork (operator 2026-09-28): "secondary" lines differ by size and
                 weight, not by a gray tint. Only true de-emphasis (timestamps) uses the web's textSecondary tint. -->
            <SolidColorBrush x:Key="FSTSecondaryTextBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="FSTDeemphasisTextBrush" Color="#FFD7DEE8" />
            <SolidColorBrush x:Key="FSTMeterFilledBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="FSTMeterEmptyBrush" Color="#FF666666" />
            <!-- Loading indicators are white/neutral, never the accent (audit 6; web loader spinner). -->
            <SolidColorBrush x:Key="FSTLoadingBrush" Color="#FFFFFFFF" />
            <!-- Leaderboard rows (Controls/LeaderboardEntryRow, operator batch 7.7): the selected player's row is the web's
                 purpleHighlight fill + purpleHighlightBorder; rankings ratings are accentBlueBright; the row whose
                 destination fills a detail column gets the muted surface. -->
            <SolidColorBrush x:Key="FSTPlayerRowBrush" Color="#BF4B0F63" />
            <SolidColorBrush x:Key="FSTPlayerRowStrokeBrush" Color="#807C3AED" />
            <SolidColorBrush x:Key="FSTPlayerRowTextBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="FSTCurrentRowBrush" Color="#E6223047" />
            <SolidColorBrush x:Key="FSTRatingTextBrush" Color="#FF4C7DFF" />
            <!-- Board pager (web Paginator): textSecondary chevrons and page text, cardBackground page badge. -->
            <SolidColorBrush x:Key="FSTPagerGlyphBrush" Color="#FFD7DEE8" />
            <SolidColorBrush x:Key="FSTPagerBadgeBrush" Color="#FF0B1220" />
            <!-- Opaque stand-ins for the web's frosted surfaces on controls that float over scrolling rows (pager buttons,
                 pinned row backplate): a solid colour instead of a per-frame backdrop blur. -->
            <SolidColorBrush x:Key="FSTPagerButtonBrush" Color="#FF121826" />
            <SolidColorBrush x:Key="FSTFloatingBackplateBrush" Color="#FF0B1220" />
            <!-- Contrast roles (design/windows.md, Contrast themes): brand hues here, system colours under a contrast theme.
                 Status chips, emphasis (gold) text and outlines, stat values, Top 1% and current-season pills, accuracy/difficulty
                 pills, Shop borders and badges, and destructive (red) buttons. -->
            <SolidColorBrush x:Key="FSTStatusFcFillBrush" Color="#FFFFD700" />
            <SolidColorBrush x:Key="FSTStatusFcStrokeBrush" Color="#FFCFA500" />
            <SolidColorBrush x:Key="FSTStatusScoredFillBrush" Color="#FF2ECC71" />
            <SolidColorBrush x:Key="FSTStatusScoredStrokeBrush" Color="#FF1E7F46" />
            <SolidColorBrush x:Key="FSTStatusMissingFillBrush" Color="#FFC62828" />
            <SolidColorBrush x:Key="FSTStatusMissingStrokeBrush" Color="#FF8B0000" />
            <SolidColorBrush x:Key="FSTStatusAmberFillBrush" Color="#FFF5A623" />
            <SolidColorBrush x:Key="FSTStatusAmberStrokeBrush" Color="#FFAB7419" />
            <SolidColorBrush x:Key="FSTStatusNoneFillBrush" Color="#FF223047" />
            <SolidColorBrush x:Key="FSTStatusNoneStrokeBrush" Color="#FF1E2A3A" />
            <SolidColorBrush x:Key="FSTEmphasisBrush" Color="#FFFFD700" />
            <SolidColorBrush x:Key="FSTEmphasisStrokeBrush" Color="#FFCFA500" />
            <SolidColorBrush x:Key="FSTStatBlueBrush" Color="#FF2D82E6" />
            <SolidColorBrush x:Key="FSTStatGreenBrush" Color="#FF2ECC71" />
            <SolidColorBrush x:Key="FSTTopOneFillBrush" Color="#FFFFD700" />
            <SolidColorBrush x:Key="FSTTopOneTextBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="FSTCurrentSeasonFillBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="FSTCurrentSeasonTextBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="FSTNeutralPillFillBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="FSTNeutralPillTextBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="FSTNeutralPillStrokeBrush" Color="#00000000" />
            <!-- Gold-outline pill (Player Profile Top 1–5% rows): no fill over the card; Window under a contrast theme so
                 the pill stays readable on the Highlight row hover. -->
            <SolidColorBrush x:Key="FSTGoldPillFillBrush" Color="#00000000" />
            <!-- Band Detail song rows' "Top N%" pill (web purple percentile badge). -->
            <SolidColorBrush x:Key="FSTPercentilePillFillBrush" Color="#FF7C3AED" />
            <SolidColorBrush x:Key="FSTPercentilePillTextBrush" Color="#FFFFFFFF" />
            <!-- Notifications flag pill (issue #229): white text and the web's translucent ring around the FLAG_COLORS fill. -->
            <SolidColorBrush x:Key="FSTNotificationFlagTextBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="FSTNotificationFlagStrokeBrush" Color="#2EFFFFFF" />
            <!-- Notifications row card (issue #272): web NotificationRow surfaceSubtle/borderSubtle, the web surfaceElevated
                 hover, and the gold unread dot (UNREAD_DOT_COLOR). Flat opaque fills inside the flyout (surface-materials R6). -->
            <SolidColorBrush x:Key="FSTNotificationRowSurfaceBrush" Color="#FF162133" />
            <SolidColorBrush x:Key="FSTNotificationRowStrokeBrush" Color="#FF1E2A3A" />
            <SolidColorBrush x:Key="FSTNotificationRowPointerOverBrush" Color="#FF1A2940" />
            <SolidColorBrush x:Key="FSTNotificationRowPressedBrush" Color="#FF131C2C" />
            <SolidColorBrush x:Key="FSTNotificationUnreadDotBrush" Color="#FFFACC15" />
            <!-- Rank History chart gridlines (web CartesianGrid stroke; the glass border tint). -->
            <SolidColorBrush x:Key="FSTChartGridBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="FSTAccuracyPillFillBrush" Color="#FF223047" />
            <SolidColorBrush x:Key="FSTMutedPillFillBrush" Color="#FF223047" />
            <SolidColorBrush x:Key="FSTShopNewBrush" Color="#FFFFD700" />
            <SolidColorBrush x:Key="FSTShopLeavingBrush" Color="#FFC62828" />
            <SolidColorBrush x:Key="FSTShopBadgeTextBrush" Color="#FFFFFFFF" />
            <!-- Shop: the New badge's dark pill (gold text) and the tile caption over art + its dark scrim. -->
            <SolidColorBrush x:Key="FSTShopNewBadgeSurfaceBrush" Color="#E6121826" />
            <SolidColorBrush x:Key="FSTShopTileTextBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="FSTShopTileCaptionBrush" Color="Transparent" />
            <!-- Song Detail's Item Shop button surface under its breathing status fill (web shopButton). -->
            <SolidColorBrush x:Key="FSTShopButtonSurfaceBrush" Color="#F5121826" />
            <SolidColorBrush x:Key="FSTDangerBackgroundBrush" Color="#FFC62828" />
            <SolidColorBrush x:Key="FSTDangerBackgroundPointerOverBrush" Color="#FFD84343" />
            <SolidColorBrush x:Key="FSTDangerBackgroundPressedBrush" Color="#FFA82020" />
            <SolidColorBrush x:Key="FSTDangerBackgroundDisabledBrush" Color="#59C62828" />
            <SolidColorBrush x:Key="FSTDangerForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="FSTDangerForegroundPointerOverBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="FSTDangerForegroundPressedBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="FSTDangerForegroundDisabledBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="FSTDangerBorderBrush" Color="#FFC62828" />
            <SolidColorBrush x:Key="FSTDangerBorderPointerOverBrush" Color="#FFD84343" />
            <SolidColorBrush x:Key="FSTDangerBorderPressedBrush" Color="#FFA82020" />
            <!-- Score History chart (Controls/SongScoreHistoryChart): axis hairlines, the blue score line, the purple selected-bar
                 stroke, gold FC bars and the red→green accuracy legend (bars are coloured by accuracy in code). -->
            <SolidColorBrush x:Key="FSTChartAxisBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="FSTChartLineBrush" Color="#FF4C7DFF" />
            <SolidColorBrush x:Key="FSTChartDotStrokeBrush" Color="Transparent" />
            <SolidColorBrush x:Key="FSTChartSelectedStrokeBrush" Color="#FF7C3AED" />
            <SolidColorBrush x:Key="FSTChartFcBrush" Color="#FFFFD700" />
            <SolidColorBrush x:Key="FSTChartBarBrush" Color="Transparent" />
            <SolidColorBrush x:Key="FSTChartBarStrokeBrush" Color="Transparent" />
            <LinearGradientBrush x:Key="FSTChartAccuracyLegendBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FFDC2828" Offset="0" />
                <GradientStop Color="#FF2ECC71" Offset="1" />
            </LinearGradientBrush>
            <!-- Settings (issue #214): reorder-list rows and stroke, Service Info progress bar. Its scoped button styling lives in
                 Themes/*ButtonResources.xaml theme dictionaries so a live contrast switch re-resolves it. -->
            <SolidColorBrush x:Key="FSTReorderRowBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="FSTReorderStrokeBrush" Color="#1AFFFFFF" />
            <!-- Instrument Selector (issue #222): web statusGreen selected disc, white hover wash, no ring outside contrast themes. -->
            <SolidColorBrush x:Key="FSTInstrumentSelectedBrush" Color="#FF2ECC71" />
            <SolidColorBrush x:Key="FSTInstrumentHoverBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="FSTInstrumentRingBrush" Color="Transparent" />
            <SolidColorBrush x:Key="FSTInstrumentRingDisabledBrush" Color="Transparent" />
            <SolidColorBrush x:Key="FSTInstrumentRingHoverBrush" Color="Transparent" />
            <SolidColorBrush x:Key="FSTProgressFillBrush" Color="#FF7C3AED" />
            <SolidColorBrush x:Key="FSTProgressTrackBrush" Color="#FF223047" />
            <!-- CHOpt Paths text table (issue #223): muted captions and em dashes, unlit fret pills, Overdrive bar. Lit pills
                 keep the web FRET_COLORS (SongPathsView), so FSTPathFretOnBrush only applies under a contrast theme. -->
            <SolidColorBrush x:Key="FSTPathCaptionBrush" Color="#FF8899AA" />
            <SolidColorBrush x:Key="FSTPathFretOnStrokeBrush" Color="Transparent" />
            <SolidColorBrush x:Key="FSTPathFretOnBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="FSTPathFretOffBrush" Color="#FF223047" />
            <SolidColorBrush x:Key="FSTPathFretOffStrokeBrush" Color="#FF1E2A3A" />
            <SolidColorBrush x:Key="FSTPathOdTrackBrush" Color="#FF162133" />
            <SolidColorBrush x:Key="FSTPathOdFillBrush" Color="#FFF5A623" />
            <!--
                Shell chrome over the artwork backdrop (MainWindow): the docked pane and the content area are transparent,
                so the backdrop's dim scrim is the only layer (no Mica, no LayerFill, no 1 px content border). The pane
                only gets a surface when it overlays content (LeftMinimal flyout, rail opened over content): in-app
                acrylic, blurred only while that overlay is open. Less Transparency / transparency off switch it to
                its opaque fallback (MainWindow.ApplyTransparency).
            -->
            <AcrylicBrush x:Key="FSTOverlayPaneBrush" TintColor="#FF121826" TintOpacity="0.72" TintLuminosityOpacity="0.85"
                          FallbackColor="#FF121826" />
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="FSTOverlayPaneBrush" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <!-- Title-bar chrome over the dimmed artwork is white, active or not (operator batch 6.6): the WinUI TitleBar
                 otherwise grays its title and glyphs while the window is inactive. -->
            <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TitleBarDeactivatedForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TitleBarBackButtonForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TitleBarPaneToggleButtonForeground" Color="#FFFFFFFF" />
            <!-- Accent (primary) buttons use the brand purple (web accentPurple #7C3AED), not the Windows accent colour:
                 Paths, "View all", Apply-free dialogs' primary actions. Contrast themes keep the system colours. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF7C3AED" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF8B52F0" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF6A2BD6" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="FSTCardSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FSTCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <!-- The card keeps its Window surface (its texts are WindowText) and shows interaction with a Highlight outline. -->
            <SolidColorBrush x:Key="FSTCardSurfacePointerOverBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FSTCardSurfacePressedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FSTCardStrokePointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FSTRowSeparatorBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="FSTRowHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FSTRowPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FSTSectionHeaderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTPinnedHeaderBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FSTSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTDeemphasisTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTMeterFilledBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTMeterEmptyBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="FSTLoadingBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <!-- Selection semantics: the selected player's row is Highlight / HighlightText like a selected list item. -->
            <SolidColorBrush x:Key="FSTPlayerRowBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FSTPlayerRowStrokeBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="FSTPlayerRowTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="FSTCurrentRowBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FSTRatingTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTPagerGlyphBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="FSTPagerBadgeBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FSTPagerButtonBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="FSTFloatingBackplateBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <!-- Contrast roles: Highlight/HighlightText = emphasis and selection, ButtonFace/ButtonText = pills and buttons,
                 Window/WindowText = surfaces and text, GrayText = absent. Meaning never rests on hue alone (shape, text, UIA name). -->
            <SolidColorBrush x:Key="FSTStatusFcFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FSTStatusFcStrokeBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="FSTStatusScoredFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FSTStatusScoredStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTStatusMissingFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FSTStatusMissingStrokeBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="FSTStatusAmberFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FSTStatusAmberStrokeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FSTStatusNoneFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FSTStatusNoneStrokeBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="FSTEmphasisBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTEmphasisStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTStatBlueBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTStatGreenBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTTopOneFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FSTTopOneTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="FSTCurrentSeasonFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FSTCurrentSeasonTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="FSTNeutralPillFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="FSTNeutralPillTextBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="FSTNeutralPillStrokeBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="FSTGoldPillFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <!-- Percentile pills become plain system pills (outlined by FSTNeutralPillStrokeBrush). -->
            <SolidColorBrush x:Key="FSTPercentilePillFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="FSTPercentilePillTextBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <!-- Notification flags become outlined system pills; the flag word, not its hue, carries the meaning. -->
            <SolidColorBrush x:Key="FSTNotificationFlagTextBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="FSTNotificationFlagStrokeBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <!-- Row cards are Window/WindowText; hover and press use Highlight, so the row's text inherits HighlightText. -->
            <SolidColorBrush x:Key="FSTNotificationRowSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FSTNotificationRowStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTNotificationRowPointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FSTNotificationRowPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FSTNotificationUnreadDotBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTChartGridBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTAccuracyPillFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="FSTMutedPillFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="FSTShopNewBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FSTShopLeavingBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FSTShopBadgeTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="FSTShopNewBadgeSurfaceBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <!-- Tile captions sit on a Window plate in WindowText, so contrast never depends on the art or scrim. -->
            <SolidColorBrush x:Key="FSTShopTileTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTShopTileCaptionBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <!-- Same Highlight as the status fill, so the breathe never exposes a non-system surface under HighlightText. -->
            <SolidColorBrush x:Key="FSTShopButtonSurfaceBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FSTDangerBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="FSTDangerBackgroundPointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FSTDangerBackgroundPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FSTDangerBackgroundDisabledBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="FSTDangerForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="FSTDangerForegroundPointerOverBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="FSTDangerForegroundPressedBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="FSTDangerForegroundDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="FSTDangerBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="FSTDangerBorderPointerOverBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="FSTDangerBorderPressedBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <!-- Chart: WindowText axes and outlined bars, FC bars filled in WindowText, the selection and score line in Highlight
                 (dots ringed in Window so they show over a filled bar). Values are also in each bar's UIA name and the list. -->
            <SolidColorBrush x:Key="FSTChartAxisBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTChartLineBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FSTChartDotStrokeBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FSTChartSelectedStrokeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FSTChartFcBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTChartBarBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FSTChartBarStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTChartAccuracyLegendBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <!-- Settings reorder lists and Service Info progress bar. -->
            <SolidColorBrush x:Key="FSTReorderRowBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FSTReorderStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <!-- Instrument Selector: the selected disc is Highlight (selection), every circle gets a ButtonText ring (GrayText when
                 disabled) so the targets have edges, and hover turns the ring Highlight; a hover fill would look selected. -->
            <SolidColorBrush x:Key="FSTInstrumentSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FSTInstrumentHoverBrush" Color="Transparent" />
            <SolidColorBrush x:Key="FSTInstrumentRingBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="FSTInstrumentRingDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="FSTInstrumentRingHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FSTProgressFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FSTProgressTrackBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <!-- CHOpt Paths table: lit pills are Highlight with a WindowText edge, unlit ones Window with a GrayText outline
                 (told apart by fill, not hue); the Overdrive bar is Highlight on a GrayText track. -->
            <SolidColorBrush x:Key="FSTPathCaptionBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTPathFretOnStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTPathFretOnBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FSTPathFretOffBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FSTPathFretOffStrokeBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="FSTPathOdTrackBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="FSTPathOdFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- NavigationView's content card (1,1,0,0 stroke, 8 px top-left radius) would inset the page from the backdrop. -->
    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
    <Thickness x:Key="NavigationViewMinimalContentGridBorderThickness">0</Thickness>
    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
    <!-- The first pane item lines up with the page title beside it (operator 2026-09-28, Android pane rule): the default
         3 epx top margin left it ~7 epx above the title's centre. -->
    <Thickness x:Key="NavigationViewPaneContentGridMargin">-1,10,-1,3</Thickness>
    <CornerRadius x:Key="NavigationViewMinimalContentGridCornerRadius">0</CornerRadius>

    <!-- The title bar's search, bell and avatar keep full opacity while the window is inactive (it often sits inactive
         beside a game; operator batch 6.6). -->
    <x:Double x:Key="TitleBarDeactivatedOpacity">1</x:Double>

    <!-- Fluent's minimum touch target (40x40 epx, "Guidelines for touch targets"). The title-bar search and profile
         buttons and the page Sort/Filter/Jump/Quick Links buttons use it as MinWidth/MinHeight, so a tap just beside
         the glyph still lands on the button (issue #72; HitTargetMarkupTests guards it). -->
    <x:Double x:Key="FSTMinTargetSize">40</x:Double>

    <services:InverseVisibilityConverter x:Key="FSTInverseVisibility" />

    <!-- MenuFlyout presenters are UIA Menus and need a name (Axe); the invoking button already names the choice. -->
    <Style TargetType="MenuFlyoutPresenter">
        <Setter Property="AutomationProperties.Name" Value="Options" />
    </Style>

    <!-- Every ProgressRing/ProgressBar is white (neutral) rather than accent-coloured, with no caption beside it. -->
    <Style TargetType="ProgressRing">
        <Setter Property="Foreground" Value="{ThemeResource FSTLoadingBrush}" />
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{ThemeResource FSTLoadingBrush}" />
    </Style>

    <!-- Fluent card: 8 px corner radius, 1 px stroke, 16 px padding. -->
    <Style x:Key="FSTCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FSTCardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource FSTCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- A card of rows (Leaderboards, Search results): a 4 epx inset so each row's hover fill spans the card, rows carry
         their own 12 epx side padding (operator batch 6.4: no double inset) and hairlines between them. -->
    <Style x:Key="FSTRowsCardStyle" TargetType="Border" BasedOn="{StaticResource FSTCardStyle}">
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- ListView rows inside a rows card: no item margin, 12 epx sides, the brand hover/press fills over the whole row. -->
    <Style x:Key="FSTCardListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- White Title Case section header (Apple FestivalSectionHeader equivalent). -->
    <Style x:Key="FSTSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource FSTSectionHeaderBrush}" />
        <Setter Property="Margin" Value="0,8,0,8" />
    </Style>

    <Style x:Key="FSTSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource FSTSecondaryTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Full-width accent "View all" call to action below a card's rows (web ViewFullLeaderboardCta / Rivals viewAllButton):
         Song Detail's View Full Leaderboard, Leaderboards' View All Rankings and Rivals' View All Rivals. Consumers set no
         layout overrides, so every one has the same gap, height and fill (issue #268). Contrast themes draw the accent
         button as HighlightText on Highlight; without HighContrastAdjustment None WinUI paints a Window backplate box
         behind the label (same as ServiceStatusView's Retry; issues #264, #268). -->
    <Style x:Key="FSTViewAllButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="HighContrastAdjustment" Value="None" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="{StaticResource FSTMinTargetSize}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Frosted "View all" card (surface-materials R7; web PlayerBandsSection BandViewAllCard, frostedCard at
         Layout.entryRowHeight 48 px): the canonical card surface and stroke, full width, 48 epx minimum height; the
         control centres its label and chevron and swaps in the card hover/press fills. Profile Bands' View All Bands (N)
         (issue #312). Consumers set no layout or colour overrides (ViewAllCardTests). -->
    <x:Double x:Key="FSTViewAllCardMinHeight">48</x:Double>
    <Style TargetType="controls:ViewAllCard">
        <Setter Property="Background" Value="{ThemeResource FSTCardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource FSTCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="{StaticResource FSTViewAllCardMinHeight}" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <!-- Instrument / band header above a card (web InstrumentHeader MD): 36 epx icon, bold title, optional subtitle. -->
    <Style x:Key="FSTCardHeaderTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource FSTSectionHeaderBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="FSTCardHeaderSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource FSTSecondaryTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Marquee (Controls/MarqueeText) copy styles for song titles and artists in rows and cards. -->
    <Style x:Key="FSTMarqueeTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
    <Style x:Key="FSTMarqueeSecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource FSTSecondaryTextBrush}" />
    </Style>
    <Style x:Key="FSTMarqueeCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource FSTSecondaryTextBrush}" />
    </Style>
    <!-- Song Detail hero artist line (artist · year · duration) under the large title. -->
    <Style x:Key="FSTMarqueeSongHeaderArtistStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyLargeTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource FSTSecondaryTextBrush}" />
    </Style>

    <!-- Notification flag pill (web NotificationRow flag: FLAG_COLORS fill set in code, 2 epx stroke, 8 epx radius, 2/4 epx
         padding). Built in code by Controls/NotificationRowVisuals. -->
    <Style x:Key="FSTNotificationFlagPillStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource FSTNotificationFlagStrokeBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="FSTNotificationFlagTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource FSTNotificationFlagTextBrush}" />
    </Style>

    <Style x:Key="FSTPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource FSTSectionHeaderBrush}" />
    </Style>
</ResourceDictionary>
