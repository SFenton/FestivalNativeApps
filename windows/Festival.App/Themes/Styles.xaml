<!--
    Shared Fluent content styles. Cards are solid, semi-opaque surfaces (no in-app acrylic): a blur over
    the animated artwork would be recomputed every frame. High contrast replaces the brand brushes.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Festival.App.Services">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- Mutated at runtime to opaque when Windows transparency effects are off. -->
            <SolidColorBrush x:Key="FSTCardSurfaceBrush" Color="#C7121826" />
            <SolidColorBrush x:Key="FSTCardStrokeBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="FSTSectionHeaderBrush" Color="#FFFFFFFF" />
            <!-- Text is white by default over the dimmed artwork (operator 2026-09-28): "secondary" lines differ by size and
                 weight, not by a gray tint. Only true de-emphasis (timestamps) uses the web's textSecondary tint. -->
            <SolidColorBrush x:Key="FSTSecondaryTextBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="FSTDeemphasisTextBrush" Color="#FFD7DEE8" />
            <SolidColorBrush x:Key="FSTMeterFilledBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="FSTMeterEmptyBrush" Color="#FF666666" />
            <!--
                Shell chrome over the artwork backdrop (MainWindow): the docked pane and the content area are transparent,
                so the backdrop's dim scrim is the only layer (no Mica, no LayerFill, no 1 px content border). The pane
                only gets a surface when it overlays content (LeftMinimal flyout, rail opened over content): in-app
                acrylic, blurred only while that overlay is open. Less Transparency / transparency off switch it to
                its opaque fallback (MainWindow.ApplyTransparency).
            -->
            <AcrylicBrush x:Key="FSTOverlayPaneBrush" TintColor="#FF121826" TintOpacity="0.72" TintLuminosityOpacity="0.85"
                          FallbackColor="#FF121826" />
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="FSTOverlayPaneBrush" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="FSTCardSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FSTCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTSectionHeaderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTDeemphasisTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTMeterFilledBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FSTMeterEmptyBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- NavigationView's content card (1,1,0,0 stroke, 8 px top-left radius) would inset the page from the backdrop. -->
    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
    <Thickness x:Key="NavigationViewMinimalContentGridBorderThickness">0</Thickness>
    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="NavigationViewMinimalContentGridCornerRadius">0</CornerRadius>

    <services:InverseVisibilityConverter x:Key="FSTInverseVisibility" />

    <!-- MenuFlyout presenters are UIA Menus and need a name (Axe); the invoking button already names the choice. -->
    <Style TargetType="MenuFlyoutPresenter">
        <Setter Property="AutomationProperties.Name" Value="Options" />
    </Style>

    <!-- Fluent card: 8 px corner radius, 1 px stroke, 16 px padding. -->
    <Style x:Key="FSTCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FSTCardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource FSTCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- White Title Case section header (Apple FestivalSectionHeader equivalent). -->
    <Style x:Key="FSTSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource FSTSectionHeaderBrush}" />
        <Setter Property="Margin" Value="0,8,0,8" />
    </Style>

    <Style x:Key="FSTSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource FSTSecondaryTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="FSTPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource FSTSectionHeaderBrush}" />
    </Style>
</ResourceDictionary>
