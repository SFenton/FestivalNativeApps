<Project>
  <!-- Every Windows assembly records the commit it was built from as AssemblyMetadata("FSTGitSHA"), which
       Settings → App Version shows after the release version (Festival.Core/Domain/AppVersionInfo.cs, issue #21).
       -p:FstGitSha=<sha> overrides; otherwise the SDK's source-control commit (SourceRevisionId), then
       `git rev-parse HEAD` (the SDK reader reports "Repository has no commit" in a worktree whose branch ref is
       only in the shared packed-refs). A build without git stamps nothing. -->
  <Target Name="FstStampGitSha" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="InitializeSourceControlInformation">
    <PropertyGroup>
      <_FstGitSha>$(FstGitSha)</_FstGitSha>
      <_FstGitSha Condition="'$(_FstGitSha)' == ''">$(SourceRevisionId)</_FstGitSha>
    </PropertyGroup>
    <Exec Condition="'$(_FstGitSha)' == ''" Command="git rev-parse HEAD" WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true" StandardOutputImportance="low"
          StandardErrorImportance="low" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_FstGitRevParse" />
    </Exec>
    <PropertyGroup Condition="'$(_FstGitSha)' == ''">
      <_FstGitRevParse>$(_FstGitRevParse.Trim())</_FstGitRevParse>
      <_FstGitSha Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(_FstGitRevParse)', '^[0-9a-fA-F]{40}$'))">$(_FstGitRevParse)</_FstGitSha>
    </PropertyGroup>
    <ItemGroup Condition="'$(_FstGitSha)' != ''">
      <AssemblyMetadata Include="FSTGitSHA" Value="$(_FstGitSha)" />
    </ItemGroup>
  </Target>
</Project>
