<Project Sdk="Microsoft.NET.Sdk">
  <!-- Logic tests for Festival.Core; coverage via coverlet (Cobertura) gated at 95% lines. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Festival.Core.Data" />
    <Using Include="Festival.Core.Domain" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.10.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Festival.Core\Festival.Core.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared synthetic fixtures (read-only; owned by contracts/). -->
    <None Include="..\..\contracts\fixtures\songs-demo.json" Link="fixtures\songs-demo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\contracts\fixtures\publication.json" Link="fixtures\publication.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\contracts\fixtures\rivals-list-demo.json" Link="fixtures\rivals-list-demo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\contracts\fixtures\leaderboard-rivals-demo.json" Link="fixtures\leaderboard-rivals-demo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\contracts\fixtures\rival-detail-demo.json" Link="fixtures\rival-detail-demo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\contracts\fixtures\leaderboard-rival-detail-demo.json" Link="fixtures\leaderboard-rival-detail-demo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\contracts\fixtures\rivals-all-demo.json" Link="fixtures\rivals-all-demo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\contracts\fixtures\*band*-demo.json" Link="fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Suggestions parity fixture + Apple reference output (tools/windows/suggestion_parity). -->
    <None Include="Fixtures\suggestions-parity*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
