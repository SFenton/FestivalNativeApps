#if os(iOS)
import FestivalCore
import FestivalDesign
import UIKit

// MARK: - Rivals hub

/// `/rivals`: the selected player's rivals hub (``RivalsScreen``). A Song / Leaderboard
/// segmented tab; under Song a Common Rivals card (every visible instrument's lists
/// intersected), a cross-instrument Combo card when Settings derive one, and one card per
/// visible instrument; under Leaderboard a Rank By menu (experimental ranks only) and one
/// card per instrument. Each card loads on its own, hides when empty, and registers its
/// own Quick Links entry once it has rows.
final class UKRivalsViewController: UKRivalsPageViewController {
    private enum Tab: Int {
        case song, leaderboard
        var title: String { self == .song ? "Song" : "Leaderboard" }
    }

    private var tab: Tab = .song
    private var selectedRankBy: RivalRankMetric = .totalscore
    private let sections = UIStackView()
    private var rankByHolder: UIView?

    private struct Snapshot: Hashable {
        let instruments: [Instrument]
        let experimentalRanks: Bool
    }

    override init(context: UKContext) {
        super.init(context: context)
        ukSetPageTitle("Rivals")
    }

    @available(*, unavailable)
    required init?(coder: NSCoder) { fatalError("init(coder:) is not used") }

    override var columnInsets: (top: CGFloat, bottom: CGFloat) { (8, 24) }

    override var settingsSignature: AnyHashable { snapshot() }

    private func snapshot() -> Snapshot {
        Snapshot(
            instruments: UKRivalsInstruments.visible(),
            experimentalRanks: UKSettings.bool(ExperimentalRanks.storageKey, default: ExperimentalRanks.defaultValue)
        )
    }

    private var experimentalRanks: Bool { snapshot().experimentalRanks }
    private var rankBy: RivalRankMetric { selectedRankBy.coerced(experimentalRanks: experimentalRanks) }

    // MARK: Tools

    override var pageTools: [UKPageTool] {
        return [Self.tool(title: "Find Rival", symbol: "magnifyingglass", identifier: "fst.rivals.findRival") { [weak self] in
            self?.presentFindRival()
        }]
    }

    private func presentFindRival() {
        let sheet = UKFindRivalViewController(context: context.with { $0.surface = .sheet })
        UKSheet.present(sheet, from: self, title: "Find Rival", closeIdentifier: "fst.rivals.findRival.close")
    }

    // MARK: Build

    override func build() {
        guard session.selectedPlayer != nil else {
            showChooseProfile()
            return
        }
        makeQuickLinks()
        let picker = UISegmentedControl(items: [Tab.song.title, Tab.leaderboard.title])
        picker.selectedSegmentIndex = tab.rawValue
        picker.accessibilityIdentifier = "fst.rivals.tab"
        picker.accessibilityLabel = "View"
        picker.setTitleTextAttributes([.foregroundColor: BrandUIColors.textPrimary, .font: UKFont.font(.footnote, weight: .medium)], for: .normal)
        picker.addAction(UIAction { [weak self, weak picker] _ in
            guard let self, let picker, let tab = Tab(rawValue: picker.selectedSegmentIndex) else { return }
            self.tab = tab
            self.renderSections()
        }, for: .valueChanged)
        add(picker.ukPadded())
        sections.axis = .vertical
        sections.spacing = 20
        add(sections)
        renderSections()
    }

    private func renderSections() {
        sections.arrangedSubviews.forEach { $0.removeFromSuperview() }
        clearQuickLinks()
        rankByHolder = nil
        let instruments = UKRivalsInstruments.visible()
        guard !instruments.isEmpty else {
            sections.addArrangedSubview(UKFootnoteLabel("Enable at least one instrument in Settings to see rivals.").ukPadded())
            return
        }
        switch tab {
        case .song:
            if instruments.count >= 2 { sections.addArrangedSubview(commonSection(instruments)) }
            if let scope = RivalCombo.deriveScope(visible: instruments) { sections.addArrangedSubview(comboSection(scope)) }
            let detailScope = RivalDetailScopes.hubScope(visible: instruments)
            for instrument in instruments { sections.addArrangedSubview(songSection(instrument, detailScope: detailScope)) }
        case .leaderboard:
            if experimentalRanks { sections.addArrangedSubview(rankByMenu()) }
            let metric = rankBy
            for instrument in instruments { sections.addArrangedSubview(leaderboardSection(instrument, rankBy: metric)) }
        }
    }

    // MARK: Sections

    private func track<Value>(_ section: UKRivalLoadingSection<Value>, _ entry: QuickLinkSection) -> UKRivalLoadingSection<Value> {
        section.onLoadedChange = { [weak self, weak section] loaded in
            guard let self, let section else { return }
            if loaded { self.registerQuickLink(entry, view: section) } else { self.unregisterQuickLink(id: entry.id) }
        }
        section.start()
        return section
    }

    private func commonSection(_ instruments: [Instrument]) -> UIView {
        let session = session
        let context = context
        let scope = RivalScope.song(instruments: instruments.map(\.rawValue))
        let section = UKRivalLoadingSection<(above: [RivalSummary], below: [RivalSummary])>(
            load: {
                var lists: [RivalsListResponse] = []
                for instrument in instruments { lists.append(try await session.rivalsList(instrument: instrument)) }
                return RivalCommonRivals.intersect(lists)
            },
            present: { state, retry in
                switch state {
                case .loading:
                    return UKRivalCards.section(title: "Common Rivals", rows: [UKRivalCards.spinnerRow()])
                case let .failed(issue):
                    return UKRivalCards.section(title: "Common Rivals", rows: [UKRivalCards.failureRow(issue, scope: "rivals.common", retry: retry)])
                case let .loaded(result) where result.above.isEmpty && result.below.isEmpty:
                    return nil
                case let .loaded(result):
                    let rows = UKRivalCards.preview(above: result.above, below: result.below).map {
                        UKRivalCards.rivalRow($0.rival, direction: $0.direction, scope: scope, identifier: "fst.rivals.row.\($0.rival.accountId)", context: context)
                    }
                    return UKRivalCards.section(
                        title: "Common Rivals", rows: rows,
                        action: UKRivalCards.viewAll(route: .allRivals(scope: scope), identifier: "fst.rivals.common.view-all", card: "Common Rivals", context: context)
                    )
                }
            }
        )
        return track(section, QuickLinkSection(id: "common", title: "Common Rivals", icon: .system("person.2.fill")))
    }

    private func comboSection(_ comboScope: RivalComboScope) -> UIView {
        let session = session
        let context = context
        let scope = RivalScope.combo(token: comboScope.token, instruments: comboScope.instruments.map(\.rawValue))
        let title = "\(comboScope.label) Rivals"
        let section = UKRivalLoadingSection<RivalsListResponse>(
            load: { try await session.rivalsComboList(token: comboScope.token) },
            present: { state, retry in
                switch state {
                case .loading:
                    return UKRivalCards.section(title: title, rows: [UKRivalCards.spinnerRow()])
                case let .failed(issue):
                    return UKRivalCards.section(title: title, rows: [UKRivalCards.failureRow(issue, scope: "rivals.combo.\(comboScope.token)", retry: retry)])
                case let .loaded(response) where response.isEmpty:
                    return nil
                case let .loaded(response):
                    let rows = UKRivalCards.preview(above: response.above, below: response.below).map {
                        UKRivalCards.rivalRow($0.rival, direction: $0.direction, scope: scope, identifier: "fst.rivals.row.\($0.rival.accountId)", context: context)
                    }
                    return UKRivalCards.section(
                        title: title, rows: rows,
                        action: UKRivalCards.viewAll(route: .allRivals(scope: scope), identifier: "fst.rivals.combo.view-all", card: title, context: context)
                    )
                }
            }
        )
        return track(section, QuickLinkSection(id: "combo", title: title, icon: .system("music.note")))
    }

    private func songSection(_ instrument: Instrument, detailScope: RivalScope?) -> UIView {
        let session = session
        let context = context
        let section = UKRivalLoadingSection<RivalsListResponse>(
            load: { try await session.rivalsList(instrument: instrument) },
            present: { state, retry in
                UKRivalCards.songCard(scope: .instrument(instrument), state: state, detailScope: detailScope, context: context, retry: retry)
            }
        )
        return track(section, QuickLinkSection(id: instrument.rawValue, title: "\(instrument.label) Rivals", icon: .instrument(instrument)))
    }

    private func leaderboardSection(_ instrument: Instrument, rankBy: RivalRankMetric) -> UIView {
        let session = session
        let context = context
        let title = "\(instrument.label) Rivals"
        let scope = RivalScope.leaderboard(instrument: instrument.rawValue, rankBy: rankBy)
        let section = UKRivalLoadingSection<LeaderboardRivalsListResponse>(
            load: { try await session.leaderboardRivals(instrument: instrument, rankBy: rankBy) },
            present: { state, retry in
                let header = UKInstrumentSectionHeaderView(scope: .instrument(instrument), title: title)
                switch state {
                case .loading:
                    return UKRivalCards.section(header: header, rows: [UKRivalCards.spinnerRow()])
                case let .failed(issue):
                    return UKRivalCards.section(header: header, rows: [UKRivalCards.failureRow(issue, scope: "rivals.leaderboard.\(instrument.rawValue)", retry: retry)])
                case let .loaded(response) where response.isEmpty:
                    return nil
                case let .loaded(response):
                    let rows = UKRivalCards.preview(above: response.above, below: response.below).map {
                        UKRivalCards.rivalRow($0.rival, direction: $0.direction, scope: scope, identifier: "fst.rivals.row.\($0.rival.accountId)", context: context)
                    }
                    return UKRivalCards.section(
                        header: header, rows: rows,
                        action: UKRivalCards.viewAll(
                            route: .allRivals(scope: scope), identifier: "fst.rivals.leaderboard.\(instrument.rawValue).view-all",
                            card: title, context: context
                        )
                    )
                }
            }
        )
        return track(section, QuickLinkSection(id: instrument.rawValue, title: title, icon: .instrument(instrument)))
    }

    // MARK: Rank By

    /// The Leaderboard tab's Rank By menu, shown only with experimental ranks.
    private func rankByMenu() -> UIView {
        var configuration = UIButton.Configuration.plain()
        configuration.image = UIImage(systemName: "arrow.up.arrow.down")
        configuration.imagePadding = 6
        configuration.baseForegroundColor = BrandUIColors.textPrimary
        var title = AttributedString(rankBy.label)
        title.font = UKFont.font(.footnote, weight: .semibold)
        configuration.attributedTitle = title
        let button = UIButton(configuration: configuration)
        button.menu = UIMenu(children: RivalRankMetric.enabled(experimentalRanks: experimentalRanks).map { metric in
            UIAction(title: metric.label) { [weak self] _ in
                self?.selectedRankBy = metric
                self?.renderSections()
            }
        })
        button.showsMenuAsPrimaryAction = true
        button.accessibilityIdentifier = "fst.rivals.rankBy"
        button.translatesAutoresizingMaskIntoConstraints = false
        button.heightAnchor.constraint(greaterThanOrEqualToConstant: 44).isActive = true
        button.widthAnchor.constraint(greaterThanOrEqualToConstant: 44).isActive = true
        let holder = UIView()
        holder.addSubview(button)
        NSLayoutConstraint.activate([
            button.trailingAnchor.constraint(equalTo: holder.trailingAnchor),
            button.topAnchor.constraint(equalTo: holder.topAnchor), button.bottomAnchor.constraint(equalTo: holder.bottomAnchor),
            button.leadingAnchor.constraint(greaterThanOrEqualTo: holder.leadingAnchor),
        ])
        return holder.ukPadded()
    }
}
#endif
